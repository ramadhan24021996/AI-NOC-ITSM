# Database Configuration (Internal Docker Name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=osi_system
DB_PASSWORD=SecurePassword_123!

# Redis Configuration (Internal Docker Name)
REDIS_HOST=redis
REDIS_PORT=6379

# NATS Configuration (Internal Docker Name)
NATS_HOST=nats
NATS_PORT=4222

# Security & Tokens
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
OSI_SECURITY_KEY="YOUR_OSI_SECURITY_KEY_HERE"
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Nginx External Port Mappings
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=9443

# Telegram Bot configurations
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=7794987703
AUTHORIZED_ADMINS=7794987703

# Development Mode
DEV_MODE=true

# ── Enterprise DNS / DHCP External Service Config (Layer 8) ──────────────────
ENTERPRISE_DNS_PRIMARY=192.168.1.1
ENTERPRISE_DNS_SECONDARY=192.168.1.2
ENTERPRISE_DNS_PORT=53
ENTERPRISE_DNS_DOMAIN=corp.local

ENTERPRISE_DHCP_SERVER=192.168.1.1
ENTERPRISE_DHCP_PORT=67
ENTERPRISE_DHCP_RANGE_START=192.168.1.100
ENTERPRISE_DHCP_RANGE_END=192.168.1.254

ENTERPRISE_DNS_API_URL=http://192.168.1.1:8081/api/v1
ENTERPRISE_DNS_API_KEY=changeme_dns_api_key_2026

ENTERPRISE_LDAP_HOST=192.168.1.1
ENTERPRISE_LDAP_PORT=389
ENTERPRISE_LDAP_BASE_DN=DC=corp,DC=local
ENTERPRISE_LDAP_BIND_DN=CN=svc-osi,OU=ServiceAccounts,DC=corp,DC=local
ENTERPRISE_LDAP_BIND_PASSWORD=changeme_ldap_password_2026

# [FASE0] IP LAN internal server untuk port agent (18800/18802/9998). Jangan 0.0.0.0.
AGENT_BIND_IP=127.0.0.1
