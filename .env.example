# ==============================================================================
# OSI AI-NOC-ITSM — Environment Configuration Template (.env.example)
# Copy to .env (`cp .env.example .env`) and fill in all required secrets.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ── Database Configuration (PostgreSQL + pgvector) ────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=osi_system
DB_USER=postgres
DB_PASSWORD=

# ── Redis Configuration ───────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Dedicated Redis password (falls back to OSI_SECURITY_KEY if left empty)
REDIS_PASSWORD=

# ── NATS JetStream Configuration ──────────────────────────────────────────────
NATS_HOST=nats
NATS_PORT=4222
# Dedicated NATS authentication token (must be URL-safe alphanumeric/hyphen/underscore)
NATS_TOKEN=

# ── Core Platform Security & API Keys ─────────────────────────────────────────
# Generate strong random secrets (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=
OSI_SECURITY_KEY=

# LLM Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ── Management UI Credentials (pgAdmin & Kafka UI) ────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_PASSWORD=
KAFKA_UI_PASSWORD=
KAFKA_UI_READONLY=true
KAFKA_UI_DYNAMIC_CONFIG=false

# ── Nginx Reverse Proxy & Network Bindings ────────────────────────────────────
PROXY_HTTP_PORT=8099
PROXY_HTTPS_PORT=9443

# Bind IP for agent ingestion ports (18800/18802/9998) and Portainer (9000/9444).
# Default is 127.0.0.1 (fail-closed). Set to internal LAN IP if remote access is required.
AGENT_BIND_IP=127.0.0.1
PORTAINER_BIND_IP=127.0.0.1

# ── Telegram Bot & Alerting Configuration ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
AUTHORIZED_ADMINS=YOUR_ADMIN_TELEGRAM_ID_HERE

# ── Runtime Flags & External Integrations ─────────────────────────────────────
DEV_MODE=false
ENABLE_CHAOS_MONKEY=false
N8N_URL=http://host.docker.internal:5678

# ── Core Network Services (DNS / DHCP / LDAP) ─────────────────────────────────
ENTERPRISE_DNS_PRIMARY=192.168.1.1
ENTERPRISE_DNS_SECONDARY=192.168.1.2
ENTERPRISE_DNS_PORT=53
ENTERPRISE_DNS_DOMAIN=corp.local

ENTERPRISE_DHCP_SERVER=192.168.1.1
ENTERPRISE_DHCP_PORT=67
ENTERPRISE_DHCP_RANGE_START=192.168.1.100
ENTERPRISE_DHCP_RANGE_END=192.168.1.254

ENTERPRISE_DNS_API_URL=http://192.168.1.1:8081/api/v1
ENTERPRISE_DNS_API_KEY=

ENTERPRISE_LDAP_HOST=192.168.1.1
ENTERPRISE_LDAP_PORT=389
ENTERPRISE_LDAP_BASE_DN=DC=corp,DC=local
ENTERPRISE_LDAP_BIND_DN=CN=svc-osi,OU=ServiceAccounts,DC=corp,DC=local
ENTERPRISE_LDAP_BIND_PASSWORD=
