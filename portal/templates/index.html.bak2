<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Orchestrator Dashboard</title>
<script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
<script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@300;400;600;700&display=swap');

  :root {
    --bg-void: #020408;
    --bg-deep: #050d15;
    --bg-panel: #071525;
    --bg-card: #0a1e30;
    --cyan: #00e5ff;
    --cyan-dim: #007a8a;
    --green: #00ff9d;
    --green-dim: #005c3a;
    --amber: #ffb300;
    --amber-dim: #7a5500;
    --red: #ff3d5a;
    --red-dim: #7a1020;
    --purple: #b04dff;
    --blue: #1e7fff;
    --text-primary: #c8e6f0;
    --text-secondary: #6a9ab5;
    --text-muted: #2d5a72;
    --border: #0d3a52;
    --glow-cyan: 0 0 20px rgba(0,229,255,0.3);
    --glow-green: 0 0 20px rgba(0,255,157,0.3);
    --glow-amber: 0 0 20px rgba(255,179,0,0.3);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg-void);
    color: var(--text-primary);
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Grid noise background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  /* Scanline overlay */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.15) 2px, rgba(0,0,0,0.15) 4px);
    pointer-events: none;
    z-index: 1;
  }

  .app { position: relative; z-index: 2; }

  /* ── Header ── */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background: linear-gradient(90deg, rgba(0,229,255,0.08) 0%, transparent 60%);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .logo {
    font-family: 'Orbitron', monospace;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 4px;
    color: var(--cyan);
    text-shadow: var(--glow-cyan);
  }
  .logo span { color: var(--green); }

  .header-center {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .status-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-family: 'Share Tech Mono', monospace;
    letter-spacing: 1px;
    border: 1px solid;
  }
  .status-pill.online { border-color: var(--green); color: var(--green); background: rgba(0,255,157,0.08); }
  .status-pill.sync { border-color: var(--cyan); color: var(--cyan); background: rgba(0,229,255,0.08); }
  .pulse { width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: pulse 1.5s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }

  .header-time {
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    color: var(--text-secondary);
    text-align: right;
  }

  /* ── Layout ── */
  .main { padding: 16px 20px; display: grid; gap: 16px; }

  /* ── KPI Row ── */
  .kpi-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }

  .kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px 16px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent, var(--cyan));
    box-shadow: 0 0 10px var(--accent, var(--cyan));
  }
  .kpi-card:hover { border-color: var(--accent, var(--cyan)); box-shadow: 0 0 15px rgba(0,229,255,0.1); }

  .kpi-label { font-size: 10px; letter-spacing: 1.5px; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 6px; }
  .kpi-value {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 700;
    color: var(--accent, var(--cyan));
    text-shadow: 0 0 10px var(--accent, var(--cyan));
    line-height: 1;
  }
  .kpi-sub { font-size: 10px; color: var(--text-muted); margin-top: 4px; }
  .kpi-trend { position: absolute; top: 14px; right: 14px; font-size: 11px; }
  .up { color: var(--green); }
  .down { color: var(--red); }

  /* ── Three Columns ── */
  .three-col { display: grid; grid-template-columns: 280px 1fr 280px; gap: 16px; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* ── Panel ── */
  .panel {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(0,229,255,0.04);
  }
  .panel-title {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--cyan);
    flex: 1;
  }
  .panel-badge {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 3px;
    background: rgba(0,229,255,0.12);
    color: var(--cyan);
    border: 1px solid rgba(0,229,255,0.3);
  }
  .panel-body { padding: 12px 14px; }

  /* ── Architecture Layers ── */
  .layers { display: flex; flex-direction: column; gap: 6px; }

  .layer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 5px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .layer::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--lc, var(--cyan));
  }
  .layer:hover { border-color: var(--lc, var(--cyan)); background: rgba(0,229,255,0.05); transform: translateX(2px); }

  .layer-num {
    font-family: 'Orbitron', monospace;
    font-size: 9px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,229,255,0.15);
    color: var(--lc, var(--cyan));
    border: 1px solid var(--lc, var(--cyan));
    flex-shrink: 0;
    font-weight: 700;
  }
  .layer-info { flex: 1; }
  .layer-name { font-size: 11px; font-weight: 600; color: var(--text-primary); letter-spacing: 0.5px; }
  .layer-desc { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
  .layer-status {
    font-family: 'Share Tech Mono', monospace;
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 2px;
    background: rgba(0,255,157,0.1);
    color: var(--green);
    border: 1px solid rgba(0,255,157,0.3);
  }
  .layer-status.warn { background: rgba(255,179,0,0.1); color: var(--amber); border-color: rgba(255,179,0,0.3); }

  /* ── RCA Engine ── */
  .rca-steps { display: flex; flex-direction: column; gap: 5px; }

  .rca-step {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 4px;
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border);
    transition: all 0.2s;
  }
  .rca-step:hover { border-color: rgba(176,77,255,0.4); background: rgba(176,77,255,0.05); }
  .rca-step.active { border-color: rgba(176,77,255,0.6); background: rgba(176,77,255,0.1); }
  .rca-step.done { border-color: rgba(0,255,157,0.4); background: rgba(0,255,157,0.05); }

  .rca-icon { font-size: 14px; width: 20px; text-align: center; flex-shrink: 0; }
  .rca-info { flex: 1; }
  .rca-title { font-size: 11px; font-weight: 600; color: var(--text-primary); }
  .rca-subtitle { font-size: 10px; color: var(--text-muted); margin-top: 1px; }

  .score-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 80px;
    flex-shrink: 0;
  }
  .bar-track { flex: 1; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 2px; transition: width 1s ease; }
  .bar-val { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--text-secondary); width: 24px; text-align: right; }

  /* ── Confidence Meter ── */
  .confidence-meter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px;
  }
  .meter-ring {
    position: relative;
    width: 120px;
    height: 120px;
  }
  .meter-ring svg { transform: rotate(-90deg); }
  .meter-ring .ring-bg { fill: none; stroke: var(--border); stroke-width: 8; }
  .meter-ring .ring-fill {
    fill: none;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 339.3;
    stroke-dashoffset: 33.9; /* 90% */
    stroke: var(--green);
    filter: drop-shadow(0 0 6px var(--green));
    animation: ringFill 2s ease forwards;
  }
  @keyframes ringFill {
    from { stroke-dashoffset: 339.3; }
    to { stroke-dashoffset: 33.9; }
  }
  .meter-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .meter-pct {
    font-family: 'Orbitron', monospace;
    font-size: 26px;
    font-weight: 900;
    color: var(--green);
    text-shadow: var(--glow-green);
    line-height: 1;
  }
  .meter-label { font-size: 9px; color: var(--text-muted); letter-spacing: 1px; }
  .verdict-badge {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    padding: 4px 14px;
    border-radius: 3px;
    background: rgba(0,255,157,0.12);
    color: var(--green);
    border: 1px solid rgba(0,255,157,0.4);
    letter-spacing: 1px;
  }

  /* ── Approval Flow ── */
  .approval-flow { display: flex; flex-direction: column; gap: 8px; }

  .flow-step {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: rgba(0,0,0,0.25);
    position: relative;
  }
  .flow-step.active-step { border-color: rgba(255,179,0,0.5); background: rgba(255,179,0,0.06); }
  .flow-step.done-step { border-color: rgba(0,255,157,0.4); background: rgba(0,255,157,0.04); }

  .flow-icon { font-size: 16px; width: 24px; text-align: center; }
  .flow-info { flex: 1; }
  .flow-name { font-size: 12px; font-weight: 600; }
  .flow-detail { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
  .flow-action {
    font-size: 10px;
    font-family: 'Share Tech Mono', monospace;
    padding: 3px 10px;
    border-radius: 3px;
    border: 1px solid;
  }
  .flow-action.approve { color: var(--green); border-color: var(--green); background: rgba(0,255,157,0.1); }
  .flow-action.reject { color: var(--red); border-color: var(--red); background: rgba(255,61,90,0.1); }
  .flow-action.wait { color: var(--amber); border-color: var(--amber); background: rgba(255,179,0,0.1); animation: blink 1s ease-in-out infinite; }
  @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

  .connector {
    width: 2px;
    height: 10px;
    background: var(--border);
    margin: -2px 0 -2px 23px;
    position: relative;
  }
  .connector.active-conn { background: var(--amber); box-shadow: 0 0 6px var(--amber); }

  /* ── Guru Besar ── */
  .guru-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }

  .guru-card {
    padding: 12px 10px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: rgba(0,0,0,0.3);
    text-align: center;
    transition: all 0.3s;
  }
  .guru-card:hover { border-color: rgba(176,77,255,0.5); transform: translateY(-2px); box-shadow: 0 4px 20px rgba(176,77,255,0.15); }
  .guru-emoji { font-size: 22px; margin-bottom: 6px; }
  .guru-name { font-size: 10px; font-weight: 700; color: var(--purple); letter-spacing: 0.5px; }
  .guru-desc { font-size: 9px; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
  .guru-progress {
    margin-top: 8px;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .guru-bar { height: 100%; background: var(--purple); box-shadow: 0 0 6px var(--purple); }

  /* ── Monitoring Grid ── */
  .monitor-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }

  .monitor-card {
    padding: 12px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: rgba(0,0,0,0.25);
  }
  .monitor-icon { font-size: 18px; margin-bottom: 6px; }
  .monitor-title { font-size: 11px; font-weight: 600; color: var(--text-primary); }
  .monitor-subtitle { font-size: 10px; color: var(--text-muted); margin-top: 2px; }

  /* ── Activity Feed ── */
  .feed { display: flex; flex-direction: column; gap: 4px; max-height: 220px; overflow-y: auto; }
  .feed::-webkit-scrollbar { width: 3px; }
  .feed::-webkit-scrollbar-track { background: var(--bg-void); }
  .feed::-webkit-scrollbar-thumb { background: var(--cyan-dim); border-radius: 2px; }

  .feed-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 3px;
    border-left: 2px solid;
    background: rgba(0,0,0,0.2);
    font-size: 10px;
    animation: slideIn 0.4s ease;
  }
  @keyframes slideIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
  .feed-item.ok { border-color: var(--green); }
  .feed-item.err { border-color: var(--red); }
  .feed-item.info { border-color: var(--cyan); }
  .feed-item.warn { border-color: var(--amber); }
  .feed-time { font-family: 'Share Tech Mono', monospace; color: var(--text-muted); flex-shrink: 0; }
  .feed-msg { flex: 1; color: var(--text-secondary); }
  .feed-src { font-family: 'Share Tech Mono', monospace; font-size: 9px; color: var(--text-muted); }

  /* ── Metric Sparklines ── */
  .sparkline-row { display: flex; gap: 8px; }
  .spark-card { flex: 1; padding: 10px 12px; border-radius: 4px; border: 1px solid var(--border); background: rgba(0,0,0,0.25); }
  .spark-label { font-size: 9px; letter-spacing: 1px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
  .spark-val { font-family: 'Orbitron', monospace; font-size: 18px; font-weight: 700; line-height: 1; }
  .spark-canvas { margin-top: 8px; }

  /* ── Storage Chain ── */
  .storage-chain { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .storage-node {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: rgba(0,0,0,0.3);
    font-size: 10px;
    white-space: nowrap;
  }
  .storage-node .sn-icon { font-size: 14px; }
  .storage-node .sn-name { font-weight: 600; color: var(--text-primary); }
  .storage-node .sn-detail { font-size: 9px; color: var(--text-muted); }
  .chain-arrow { color: var(--cyan-dim); font-size: 14px; }

  /* ── Notification / Telegram ── */
  .notif-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: rgba(0,0,0,0.2);
    margin-bottom: 6px;
    font-size: 11px;
  }
  .notif-badge {
    width: 8px; height: 8px; border-radius: 50%;
    flex-shrink: 0;
  }
  .notif-badge.green { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .notif-badge.amber { background: var(--amber); box-shadow: 0 0 6px var(--amber); }
  .notif-badge.red { background: var(--red); box-shadow: 0 0 6px var(--red); }

  /* ── Scrollbar global ── */
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg-void); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  /* ── Responsive ── */
  @media (max-width: 1200px) {
    .kpi-row { grid-template-columns: repeat(3, 1fr); }
    .three-col { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    .three-col, .two-col { grid-template-columns: 1fr; }
    .guru-grid { grid-template-columns: 1fr; }
  }
  .nav-tabs {
    display: flex;
    gap: 15px;
    padding: 10px 30px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--cyan-dim);
    background: var(--bg-panel);
  }
  .nav-tab {
    padding: 10px 20px;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
  }
  .nav-tab:hover {
    color: var(--cyan);
  }
  .nav-tab.active {
    color: var(--cyan);
    border-bottom-color: var(--cyan);
    text-shadow: 0 0 10px var(--cyan);
  }

  /* Specific Styled Tabs */
  .nav-tab.tab-causal-dag-btn {
    color: var(--red);
  }
  .nav-tab.tab-causal-dag-btn:hover, .nav-tab.tab-causal-dag-btn.active {
    border-bottom-color: var(--red);
    text-shadow: 0 0 10px var(--red);
  }

  .nav-tab.tab-groundtruth-btn {
    color: var(--cyan);
  }
  .nav-tab.tab-groundtruth-btn:hover, .nav-tab.tab-groundtruth-btn.active {
    border-bottom-color: var(--cyan);
    text-shadow: 0 0 10px var(--cyan);
  }

  .nav-tab.tab-fleet-btn {
    color: var(--amber);
  }
  .nav-tab.tab-fleet-btn:hover, .nav-tab.tab-fleet-btn.active {
    border-bottom-color: var(--amber);
    text-shadow: 0 0 10px var(--amber);
  }

  .nav-tab.tab-audit-btn {
    color: var(--green);
  }
  .nav-tab.tab-audit-btn:hover, .nav-tab.tab-audit-btn.active {
    border-bottom-color: var(--green);
    text-shadow: 0 0 10px var(--green);
  }

  .nav-tab.tab-sop-lifecycle-btn {
    color: #d946ef;
  }
  .nav-tab.tab-sop-lifecycle-btn:hover, .nav-tab.tab-sop-lifecycle-btn.active {
    border-bottom-color: #d946ef;
    text-shadow: 0 0 10px #d946ef;
  }

  .tab-pane {
    display: none;
    animation: fadeIn 0.4s ease;
  }
  .tab-pane.active {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* SOP Lifecycle Kanban Board */
  .kanban-board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 20px;
  }
  @media (max-width: 1200px) {
    .kanban-board { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .kanban-board { grid-template-columns: 1fr; }
  }
  .kanban-column {
    background: rgba(16, 22, 34, 0.4);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-height: 500px;
    backdrop-filter: blur(10px);
  }
  .kanban-column-header {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--border);
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  /* Color themes for columns */
  .column-draft { border-top: 4px solid #64748b; }
  .column-candidate { border-top: 4px solid #f97316; }
  .column-validated { border-top: 4px solid #a855f7; }
  .column-production { border-top: 4px solid #22c55e; }
  
  .column-draft .kanban-column-header { color: #94a3b8; }
  .column-candidate .kanban-column-header { color: #fb923c; }
  .column-validated .kanban-column-header { color: #c084fc; }
  .column-production .kanban-column-header { color: #4ade80; }
  
  .sop-card {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    padding: 15px;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    overflow: hidden;
  }
  .sop-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }
  .sop-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .sop-card-tag {
    font-size: 14px;
    font-weight: 700;
    color: var(--cyan);
    font-family: monospace;
  }
  .sop-card-confidence {
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: bold;
  }
  .conf-high { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
  .conf-med { background: rgba(249, 115, 22, 0.15); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.3); }
  
  .sop-card-pattern {
    font-size: 12px;
    color: var(--text-muted);
    font-style: italic;
    line-height: 1.4;
  }
  .sop-card-steps-title {
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    margin-top: 5px;
  }
  .sop-card-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sop-card-steps li {
    font-size: 12px;
    color: var(--text-primary);
    padding-left: 15px;
    position: relative;
  }
  .sop-card-steps li::before {
    content: "•";
    color: var(--cyan);
    position: absolute;
    left: 0;
    top: 0;
  }
  .sop-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 10px;
    margin-top: 5px;
    font-size: 11px;
    color: var(--text-muted);
  }
  .sop-promote-btn {
    background: linear-gradient(135deg, #a855f7, #d946ef);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .sop-promote-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 0 10px rgba(217, 70, 239, 0.5);
  }
  .sop-badge-active {
    color: #4ade80;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Connected Devices Grid */
  .device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 15px;
    margin-top: 20px;
  }
  .device-card {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  }
  .device-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 10px;
    margin-bottom: 10px;
  }
  .device-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--cyan);
  }
  .device-status {
    font-size: 10px;
    padding: 3px 6px;
    border-radius: 4px;
    background: rgba(0, 255, 157, 0.1);
    color: var(--green);
    border: 1px solid var(--green);
  }
  .device-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin-bottom: 15px;
  }
  .metric-box {
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 8px;
    border-radius: 4px;
    text-align: center;
  }
  .metric-label {
    font-size: 9px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .metric-val {
    font-size: 14px;
    font-family: 'Share Tech Mono', monospace;
    color: #fff;
  }
  .printer-list {
    background: rgba(0,0,0,0.15);
    padding: 10px;
    border-radius: 4px;
    border-left: 2px solid var(--purple);
  }
  .printer-item {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    margin-bottom: 5px;
  }
  .printer-name { color: var(--text); }
  .printer-status { color: var(--amber); }

  /* Modal Styles */
  .gov-modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0,0,0,0.8);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
  }
  .gov-modal-content {
    background: var(--bg-panel);
    border: 1px solid var(--cyan);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 95%;
    max-width: 1100px;
    max-height: 80vh;
    border-radius: 8px;
    box-shadow: 0 0 30px rgba(0, 229, 255, 0.2);
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.3s ease;
  }
  #govModalBody {
    overflow-y: auto;
    padding: 20px;
    flex: 1;
    min-height: 0;
  }
  #govModalBody::-webkit-scrollbar {
    width: 8px;
  }
  #govModalBody::-webkit-scrollbar-thumb {
    background: var(--cyan);
    border-radius: 3px;
  }
  .gov-modal-close {
    color: var(--text-muted);
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    transition: color 0.3s;
  }
  .gov-modal-close:hover {
    color: var(--red);
  }
  .gov-modal-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--cyan);
    margin-bottom: 15px;
    border-bottom: 1px solid rgba(0,229,255,0.2);
    padding-bottom: 10px;
  }
  .gov-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    table-layout: fixed;
  }
  .gov-table th, .gov-table td {
    padding: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    text-align: left;
    word-wrap: break-word;
  }
  .gov-table th {
    color: var(--text-muted);
    font-weight: 600;
    position: sticky;
    top: 0;
    background: var(--bg-panel);
    z-index: 2;
  }
  .gov-table tbody tr:hover {
    background: rgba(255,255,255,0.02);
  }

</style>
</head>
<body>
<div class="app">

<!-- ── HEADER ── -->
<header>
  <div class="logo">AI·ORCH<span>OS</span></div>
  <div class="header-center">
    <button onclick="pushOtaUpdate('btnPushOtaMain', 'otaIconMain')" id="btnPushOtaMain" style="background: linear-gradient(135deg, #1976D2, #0d47a1); color: white; border: none; padding: 6px 12px; border-radius: 4px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; margin-right: 15px; box-shadow: 0 0 10px rgba(25, 118, 210, 0.5); transition: transform 0.2s;">
      <span id="otaIconMain">☁️</span> Push OTA Update
    </button>
    <div class="status-pill online"><span class="pulse"></span>SISTEM AKTIF</div>
    <div class="status-pill sync"><span class="pulse"></span>RAG SYNC</div>
  </div>
  <div class="header-time">
    <div id="clock" style="font-size:14px;color:var(--cyan)">--:--:--</div>
    <div id="date">Kamis, 04 Juni 2026</div>
  </div>
</header>

<!-- ── MAIN ── -->
<div class="main">

  <div class="nav-tabs">
    <button class="nav-tab active" onclick="switchTab(event, 'tab-overview')">OVERVIEW</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-rca')">GROUND TRUTH & RCA</button>
    <button class="nav-tab tab-causal-dag-btn" onclick="switchTab(event, 'tab-causal-dag')">🕸️ CAUSAL DAG</button>
    <button class="nav-tab tab-groundtruth-btn" onclick="switchTab(event, 'tab-groundtruth')">🧠 AI TRAINING FEEDBACK</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-triage')">INCIDENT TRIAGE</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-gov')">GOVERNANCE</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-logs')">LIVE LOGS & STORAGE</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-issues')">PC CLIENT ISSUES</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-aimodels')">AI MODELS & KEYS</button>
    <button class="nav-tab" onclick="switchTab(event, 'tab-advrca')">🏛️ ADVANCED RCA</button>
    <button class="nav-tab tab-fleet-btn" onclick="switchTab(event, 'tab-fleet')">⚙️ FLEET MANAGEMENT</button>
    <button class="nav-tab tab-audit-btn" onclick="switchTab(event, 'tab-audit')">🛡️ SERVER HEALTH AUDIT</button>
    <button class="nav-tab tab-sop-lifecycle-btn" onclick="switchTab(event, 'tab-sop-lifecycle')">📖 SOP LIFECYCLE</button>
    <button class="nav-refresh-btn" onclick="refreshCurrentTab()" style="margin-left: auto; background: rgba(0, 255, 255, 0.1); border: 1px solid var(--cyan); color: var(--cyan); padding: 8px 15px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-family: 'Rajdhani', sans-serif; font-size: 14px; font-weight: bold; transition: all 0.2s;" onmouseover="this.style.background='rgba(0, 255, 255, 0.2)'" onmouseout="this.style.background='rgba(0, 255, 255, 0.1)'">
      <i class="fas fa-sync-alt" id="refresh-icon"></i> REFRESH TAB AKTIF
    </button>
  </div>

  <div class="tab-pane active" id="tab-overview">
  <!-- KPI Row -->
  <div class="kpi-row">
    <div class="kpi-card" style="--accent:var(--green)">
      <div class="kpi-label">Tiket Selesai</div>
      <div class="kpi-value" id="kpi-tiket-selesai">847</div>
      <div class="kpi-sub">Hari ini</div>
      <div class="kpi-trend up">↑ 12%</div>
    </div>
    <div class="kpi-card" style="--accent:var(--cyan)">
      <div class="kpi-label">Confidence Score</div>
      <div class="kpi-value" id="kpi-confidence-score">95%</div>
      <div class="kpi-sub">Rata-rata AI</div>
      <div class="kpi-trend up">↑ 3%</div>
    </div>
    <div class="kpi-card" style="--accent:var(--amber)">
      <div class="kpi-label">Event Aktif</div>
      <div class="kpi-value" id="kpi-event-aktif">23</div>
      <div class="kpi-sub">Dalam Antrian</div>
      <div class="kpi-trend up">↑ 5</div>
    </div>
    <div class="kpi-card" style="--accent:var(--purple)">
      <div class="kpi-label">RCA Akurasi</div>
      <div class="kpi-value" id="kpi-rca-akurasi">91%</div>
      <div class="kpi-sub">7 Hari Terakhir</div>
      <div class="kpi-trend up">↑ 2%</div>
    </div>
    <div class="kpi-card" style="--accent:var(--red)">
      <div class="kpi-label">Incident Suppress</div>
      <div class="kpi-value" id="kpi-suppress">50&rarr;1</div>
      <div class="kpi-sub">Deduplikasi</div>
      <div class="kpi-trend down">↓ Noise</div>
    </div>
    <div class="kpi-card" style="--accent:var(--blue)">
      <div class="kpi-label">Recommended Fixes</div>
      <div class="kpi-value" id="kpi-fixes-val">TCP</div>
      <div class="kpi-sub" id="kpi-fixes-sub">Port 10000 Ready</div>
      <div class="kpi-trend up">✓ LIVE</div>
    </div>
  </div>
  
  <!-- Connected Devices Container -->
  <div class="panel" style="margin-top: 20px;">
    <div class="panel-header">
      <div class="panel-title">CONNECTED AGENTS & PERIPHERALS</div>
      <div class="panel-badge" id="connected-count">0 ONLINE</div>
    </div>
    <div class="panel-body">
      <div class="device-grid" id="device-grid">
         <!-- Injected via JS -->
      </div>
    </div>
  </div>

  </div><!-- End of tab-overview -->

  <div class="tab-pane" id="tab-rca">
  <!-- Row 2: Three columns -->
  <div class="three-col">

    <!-- Left: Architecture Layers -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">ARCHITECTURE LAYERS</div>
        <div class="panel-badge">7 LAYER</div>
      </div>
      <div class="panel-body">
        <div class="layers" id="rca-layers">
          <div class="layer" style="--lc:var(--cyan)">
            <div class="layer-num">7</div>
            <div class="layer-info">
              <div class="layer-name">MONITORING</div>
              <div class="layer-desc">Netdata · Digital Twin · KPI</div>
            </div>
            <div class="layer-status">LIVE</div>
          </div>
          <div class="layer" style="--lc:var(--purple)">
            <div class="layer-num">6</div>
            <div class="layer-info">
              <div class="layer-name">AUDIT & LEARNING</div>
              <div class="layer-desc">PostgreSQL · Cold Storage · AI Dataset</div>
            </div>
            <div class="layer-status">SYNC</div>
          </div>
          <div class="layer" style="--lc:var(--amber)">
            <div class="layer-num">5</div>
            <div class="layer-info">
              <div class="layer-name">HUMAN APPROVAL</div>
              <div class="layer-desc">IT Operator · Web Dashboard</div>
            </div>
            <div class="layer-status warn">PENDING</div>
          </div>
          <div class="layer" style="--lc:var(--blue)">
            <div class="layer-num">4</div>
            <div class="layer-info">
              <div class="layer-name">AI INTELLIGENCE</div>
              <div class="layer-desc">DeepSeek Core · RAG · Orchestrator</div>
            </div>
            <div class="layer-status">ACTIVE</div>
          </div>
          <div class="layer" style="--lc:var(--green)">
            <div class="layer-num">3</div>
            <div class="layer-info">
              <div class="layer-name">EVENT GOVERNANCE</div>
              <div class="layer-desc">Priority Queue · SLA · Suppressor</div>
            </div>
            <div class="layer-status">LIVE</div>
          </div>
          <div class="layer" style="--lc:var(--red)">
            <div class="layer-num">2</div>
            <div class="layer-info">
              <div class="layer-name">STREAM PROCESSING</div>
              <div class="layer-desc">Redis Pub/Sub · Normalizer · Cache</div>
            </div>
            <div class="layer-status">LIVE</div>
          </div>
          <div class="layer" style="--lc:var(--text-secondary)">
            <div class="layer-num">1</div>
            <div class="layer-info">
              <div class="layer-name">ENDPOINT & EDGE</div>
              <div class="layer-desc">PC Agent · FTP Buffer · OTA Updater</div>
            </div>
            <div class="layer-status">LIVE</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Center: RCA Engine + Confidence -->
    <div style="display:flex;flex-direction:column;gap:12px;">

      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">AI RCA ENGINE — SCIENTIFIC INVESTIGATION</div>
          <div class="panel-badge">9 TAHAP</div>
        </div>
        <div class="panel-body">
          <style>
            .rca-step { cursor: pointer; transition: all 0.3s; position: relative; }
            .rca-step:hover { background: rgba(255,255,255,0.05); }
            .rca-desc { display: none; margin-top: 8px; font-size: 11px; color: var(--text-muted); border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px; line-height: 1.4; font-weight: normal; }
            .rca-step.expanded .rca-desc { display: block; }
            .rca-step.expanded { padding-bottom: 12px; }
          </style>
          <div class="rca-steps" id="rca-steps-list">
            <div class="rca-step done" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">🔎</div>
              <div class="rca-info">
                <div class="rca-title">1. Evidence Collector</div>
                <div class="rca-subtitle">Windows Log · Ping · Spooler · Netdata · API</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Mengumpulkan data mentah secara real-time dari berbagai sumber (Log Windows, Ping, antrean Spooler, metrik Netdata, API) sebagai bukti insiden.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:100%;background:var(--green)"></div></div><div class="bar-val" style="color:var(--green)">✓</div></div>
            </div>
            <div class="rca-step done" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">⏱️</div>
              <div class="rca-info">
                <div class="rca-title">2. Temporal Analysis</div>
                <div class="rca-subtitle">Kronologi 08:00 Normal → 08:05 Error</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Menganalisis kronologi kejadian dan membandingkan kondisi sistem saat normal dengan saat terjadi error untuk menemukan titik awal kegagalan.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:100%;background:var(--green)"></div></div><div class="bar-val" style="color:var(--green)">✓</div></div>
            </div>
            <div class="rca-step done" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">🧠</div>
              <div class="rca-info">
                <div class="rca-title">3. Hypothesis Engine</div>
                <div class="rca-subtitle">Kabel Putus 40% · Spooler Mati 60%</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Merumuskan hipotesis kemungkinan penyebab (contoh: kabel putus, layanan mati) berdasarkan bukti yang terkumpul.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:60%;background:var(--amber)"></div></div><div class="bar-val">60%</div></div>
            </div>
            <div class="rca-step done" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">🕸️</div>
              <div class="rca-info">
                <div class="rca-title">4. Cross-System Correlation</div>
                <div class="rca-subtitle">Web → DB → POS → Printer</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Mencari hubungan sebab-akibat antar sistem di jaringan (misal: apakah DB mati menyebabkan Web down lalu merambat ke mesin Kasir).</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:85%;background:var(--cyan)"></div></div><div class="bar-val">85%</div></div>
            </div>
            <div class="rca-step done" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">🔗</div>
              <div class="rca-info">
                <div class="rca-title">5. Causal Graph Engine</div>
                <div class="rca-subtitle">Sebab-Akibat Pasti</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Membangun grafik sebab-akibat terarah untuk mengonfirmasi "Root Cause" utama dari rentetan gejala yang muncul.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:90%;background:var(--cyan)"></div></div><div class="bar-val">90%</div></div>
            </div>
            <div class="rca-step done" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">🧪</div>
              <div class="rca-info">
                <div class="rca-title">6. Auto Validation Engine</div>
                <div class="rca-subtitle">Ping Otomatis · SNMP Check</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Melakukan pemeriksaan otomatis secara langsung (contoh: auto-ping) untuk memastikan hipotesis terkuat memang benar-benar terjadi.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:93%;background:var(--green)"></div></div><div class="bar-val">93%</div></div>
            </div>
            <div class="rca-step active" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">🎯</div>
              <div class="rca-info">
                <div class="rca-title">7. Root Cause Verification</div>
                <div class="rca-subtitle">Evidence Score + Temporal + Validation</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Mensintesis skor bukti, probabilitas kausal, dan hasil validasi menjadi satu kesimpulan final tentang inti kerusakan.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:95%;background:var(--purple)"></div></div><div class="bar-val" style="color:var(--purple)">95%</div></div>
            </div>
            <div class="rca-step active" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">📊</div>
              <div class="rca-info">
                <div class="rca-title">8. Confidence Score</div>
                <div class="rca-subtitle">Root Cause 95% Valid — Score > 75% ✓</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Menilai tingkat keyakinan (Confidence Score). Jika skor > 75%, maka kesimpulan AI dinyatakan valid secara ilmiah.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:95%;background:var(--green)"></div></div><div class="bar-val" style="color:var(--green)">95%</div></div>
            </div>
            <div class="rca-step" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">📝</div>
              <div class="rca-info">
                <div class="rca-title">9. Recommendation</div>
                <div class="rca-subtitle">Lanjut ke Approval → Confidence &gt; 75%</div>
                <div class="rca-desc"><strong>Fungsi:</strong> Menyusun draf perbaikan, rekomendasi tindakan teknis, atau perintah self-healing otomatis kepada IT Operator.</div>
              </div>
              <div class="score-bar"><div class="bar-track"><div class="bar-fill" style="width:0%;background:var(--amber)" id="recBar"></div></div><div class="bar-val" id="recVal">→</div></div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Right: Confidence + Approval Flow -->
    <div style="display:flex;flex-direction:column;gap:12px;">

      <!-- Confidence Meter -->
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">CONFIDENCE METER</div>
        </div>
        <div class="panel-body">
          <div class="confidence-meter" id="rca-confidence-meter-container">
            <div class="meter-ring">
              <svg width="120" height="120" viewBox="0 0 120 120">
                <circle class="ring-bg" cx="60" cy="60" r="54"/>
                <circle class="ring-fill" id="rca-ring-fill" cx="60" cy="60" r="54"/>
              </svg>
              <div class="meter-center">
                <div class="meter-pct" id="rca-meter-pct">95%</div>
                <div class="meter-label" id="rca-meter-label">VALID</div>
              </div>
            </div>
            <div class="verdict-badge" id="rca-verdict-badge">✅ READY FOR APPROVAL</div>
            <div id="rca-threshold-desc" style="font-size:10px;color:var(--text-muted);text-align:center;margin-top:4px;">Score &gt; 75% threshold terpenuhi<br>Kirim draft ke IT Operator</div>
          </div>
        </div>
      </div>

      <!-- Human Approval Flow -->
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">HUMAN APPROVAL FLOW</div>
          <div class="panel-badge">LAYER 5</div>
        </div>
        <div class="panel-body">
          <div class="approval-flow" id="rca-approval-flow">
            <div class="flow-step done-step">
              <div class="flow-icon">🧠</div>
              <div class="flow-info">
                <div class="flow-name" style="color:var(--cyan)">AI Kirim Draft</div>
                <div class="flow-detail">Beserta Confidence Score 95%</div>
              </div>
              <div class="flow-action approve">SENT</div>
            </div>
            <div class="connector active-conn"></div>
            <div class="flow-step active-step">
              <div class="flow-icon">👨‍💻</div>
              <div class="flow-info">
                <div class="flow-name" style="color:var(--amber)">IT Operator</div>
                <div class="flow-detail">Melihat Confidence 95% di Chat/UI</div>
              </div>
              <div class="flow-action wait">REVIEWING</div>
            </div>
            <div class="connector active-conn"></div>
            <div class="flow-step">
              <div class="flow-icon">⚖️</div>
              <div class="flow-info">
                <div class="flow-name">Approve / Reject</div>
                <div class="flow-detail">Keputusan Akhir — Web Dashboard</div>
              </div>
              <div style="display:flex;gap:4px;">
                <div class="flow-action approve">✅</div>
                <div class="flow-action reject">❌</div>
              </div>
            </div>
            <div class="connector"></div>
            <div class="flow-step" style="border-color:rgba(0,229,255,0.3)">
              <div class="flow-icon">🔁</div>
              <div class="flow-info">
                <div class="flow-name">Feedback Loop</div>
                <div class="flow-detail">✅ DNA Record · ❌ Post-Mortem</div>
              </div>
              <div class="flow-action" style="color:var(--cyan);border-color:var(--cyan);background:rgba(0,229,255,0.1)">AUTO</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  
</div>
</div><!-- End of tab-rca -->

