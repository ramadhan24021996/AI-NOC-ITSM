      </div>
      <div class="panel-body">
        <div class="guru-grid" id="ai-models-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px;">
          <!-- Injected via JS -->
          <div style="text-align:center; padding:20px; color:var(--text-muted);">Memuat konfigurasi AI...</div>
        </div>
      </div>
    </div>
  
  <div class="panel" style="grid-column: 1 / -1; margin-top: 16px;">
    <div class="panel-header">
      <div class="panel-title">AI JUDGE CONSENSUS LOG</div>
    </div>
    <div class="panel-body" style="max-height: 500px; overflow-y: auto;">
      <table class="gov-table">
        <thead><tr style="position: sticky; top: 0; background: var(--bg-panel); z-index: 10;"><th>Timestamp</th><th>DeepSeek Verdict</th><th>Gemini Verdict</th><th>Consensus Status</th></tr></thead>
        <tbody id="consensus-tbody">
          <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:30px;">Menunggu insiden baru...</td></tr>
        </tbody>
      </table>
    </div>
  <div class="panel" style="grid-column: 1 / -1; margin-top: 16px; border-color: rgba(255, 61, 90, 0.3);">
    <div class="panel-header">
      <div class="panel-title">📉 AI MODEL DRIFT & CONFIDENCE PENALTY MONITOR</div>
      <button onclick="retrainClassifierModel()" style="background:rgba(255,61,90,0.1); border:1px solid var(--red); color:var(--red); padding:4px 8px; border-radius:4px; cursor:pointer; font-weight:bold; font-size:11px;" id="btn-retrain-model">🔄 RETRAIN OFFLINE MODEL</button>
    </div>
    <div class="panel-body">
      <div style="font-size:12px; color:var(--text-muted); margin-bottom:12px;">
        Memantau penalti kepercayaan rata-rata per kategori RCA akibat koreksi operator. Jika penalti meningkat tajam (misalnya kategori SLOW sering mendapat penalti), model klasifikasi lokal mengalami bias/drift dan perlu dilatih ulang menggunakan tombol di kanan atas.
      </div>
      <div id="drift-metrics-container" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px;">
        <div style="text-align:center; padding:15px; color:var(--text-muted);">Memuat data drift...</div>
      </div>
    </div>
  </div>

  <div class="panel" style="grid-column: 1 / -1; margin-top: 16px; border-color: rgba(0, 188, 212, 0.3);">
    <div class="panel-header">
      <div class="panel-title">🛡️ REAL-TIME AI OBSERVABILITY & GUARDRAILS</div>
      <div class="panel-badge" style="background:var(--cyan); color:var(--bg-panel); font-weight:bold;">ACTIVE MONITORING</div>
    </div>
    <div class="panel-body">
      <div style="font-size:12px; color:var(--text-muted); margin-bottom:16px;">
        Memantau integritas keputusan LLM secara real-time. Mencakup deteksi halusinasi logika, pergeseran pemikiran (drift), pemblokiran perintah berbahaya di sandbox, serta kegagalan prompt API.
      </div>
      
      <!-- Metrics Cards Grid -->
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:20px;">
        <!-- Card 1: Shield / Sandbox Blocks -->
        <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(0,188,212,0.2); padding:15px; border-radius:6px; text-align:center;">
          <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; font-weight:bold; letter-spacing:1px;">Security Shield Blocks</div>
          <div style="font-size:32px; font-weight:bold; color:var(--cyan); margin:8px 0;" id="obs-blocked-commands">0</div>
          <div style="font-size:10px; color:var(--text-muted);">Command berbahaya dicegah sandbox</div>
        </div>
        
        <!-- Card 2: Hallucination Rate -->
        <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,59,59,0.2); padding:15px; border-radius:6px; text-align:center;">
          <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; font-weight:bold; letter-spacing:1px;">Hallucination Rate</div>
          <div style="font-size:32px; font-weight:bold; color:var(--red); margin:8px 0;" id="obs-hallucination-rate">0.0%</div>
          <div style="font-size:10px; color:var(--text-muted);"><span id="obs-hallucination-count">0</span> kegagalan logika terdeteksi</div>
        </div>

        <!-- Card 3: Drift Alerts -->
        <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,179,0,0.2); padding:15px; border-radius:6px; text-align:center;">
          <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; font-weight:bold; letter-spacing:1px;">Reasoning Drift Alerts</div>
          <div style="font-size:32px; font-weight:bold; color:var(--amber); margin:8px 0;" id="obs-drift-alerts">0</div>
          <div style="font-size:10px; color:var(--text-muted);">Penurunan drastis confidence score</div>
        </div>

        <!-- Card 4: Prompt Failures -->
        <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(156,39,176,0.2); padding:15px; border-radius:6px; text-align:center;">
          <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; font-weight:bold; letter-spacing:1px;">LLM API Failures</div>
          <div style="font-size:32px; font-weight:bold; color:var(--purple); margin:8px 0;" id="obs-prompt-failures">0</div>
          <div style="font-size:10px; color:var(--text-muted);" id="obs-failures-split">Semua model stabil</div>
        </div>
      </div>

      <!-- Split Layout: Supervision Logs & Prompt Failures -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
        <!-- Supervision Log Column -->
        <div style="background:rgba(0,0,0,0.2); border:1px solid var(--border); padding:12px; border-radius:6px;">
          <div style="font-weight:bold; color:var(--text-primary); font-size:13px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
            <span>📋 RECENT SUPERVISION TRAILS</span>
            <span style="font-size:10px; font-weight:normal; color:var(--text-muted);">Last 20 evaluations</span>
          </div>
          <div style="max-height: 250px; overflow-y: auto;">
            <table class="gov-table" style="font-size:11px;">
              <thead>
                <tr>
                  <th>Waktu</th>
                  <th>Agent</th>
                  <th>Drift</th>
                  <th>Logika</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="obs-supervision-tbody">
                <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:15px;">Belum ada riwayat supervisi...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Prompt Failure Column -->
        <div style="background:rgba(0,0,0,0.2); border:1px solid var(--border); padding:12px; border-radius:6px;">
          <div style="font-weight:bold; color:var(--text-primary); font-size:13px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
            <span>⚠️ API PROMPT FAILURES LOG</span>
            <span style="font-size:10px; font-weight:normal; color:var(--text-muted);">Last 20 error events</span>
          </div>
          <div style="max-height: 250px; overflow-y: auto;">
            <table class="gov-table" style="font-size:11px;">
              <thead>
                <tr>
                  <th>Waktu</th>
                  <th>Model</th>
                  <th>Pertanyaan</th>
                  <th>Error</th>
                </tr>
              </thead>
              <tbody id="obs-failures-tbody">
                <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:15px;">Tidak ada error prompt tercatat.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

</div><!-- End of tab-aimodels -->

<div class="tab-pane" id="tab-advrca">
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <!-- Web Availability Monitor -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">🌐 WEB AVAILABILITY MONITOR</div>
        <div class="panel-badge" id="web-avail-badge">CHECKING...</div>
      </div>
      <div class="panel-body">
        <div style="font-size:11px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px;">URL Diagnostic Pipeline</div>
        <div id="web-avail-pipeline" style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px;">
          <div class="storage-node" id="wa-dns"><span class="sn-icon">🔍</span><div><div class="sn-name">DNS Resolve</div><div class="sn-detail" id="wa-dns-val">--</div></div></div>
          <span class="chain-arrow">→</span>
          <div class="storage-node" id="wa-ping"><span class="sn-icon">📡</span><div><div class="sn-name">Ping</div><div class="sn-detail" id="wa-ping-val">--</div></div></div>
          <span class="chain-arrow">→</span>
          <div class="storage-node" id="wa-tcp"><span class="sn-icon">🔌</span><div><div class="sn-name">TCP 443</div><div class="sn-detail" id="wa-tcp-val">--</div></div></div>
          <span class="chain-arrow">→</span>
          <div class="storage-node" id="wa-http"><span class="sn-icon">🌍</span><div><div class="sn-name">HTTP Status</div><div class="sn-detail" id="wa-http-val">--</div></div></div>
          <span class="chain-arrow">→</span>
          <div class="storage-node" id="wa-resp"><span class="sn-icon">⏱️</span><div><div class="sn-name">Response</div><div class="sn-detail" id="wa-resp-val">-- ms</div></div></div>
        </div>
        <div style="font-size:11px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px;">Browser Error Collector</div>
        <div id="wa-browser-error" style="padding:10px; background:rgba(0,0,0,0.3); border-radius:6px; border:1px solid rgba(255,255,255,0.05); color:var(--green); font-size:13px;">No browser errors detected</div>
        <div style="margin-top:16px;font-size:11px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px;">RCA ENGINE RESULT</div>
        <table class="gov-table" style="font-size:12px;">
          <thead><tr><th>Gejala</th><th>Evidence</th><th>Root Cause</th><th>Confidence</th></tr></thead>
          <tbody id="web-rca-tbody">
            <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:20px;">Menunggu data dari agent...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <!-- Endpoint Stability Monitor -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">🖥️ ENDPOINT STABILITY MONITOR</div>
        <div class="panel-badge" id="ep-stab-badge">SCANNING...</div>
      </div>
      <div class="panel-body">
        <div style="font-size:11px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px;">Hardware & Driver Status</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:16px;">
          <div style="padding:12px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,255,255,0.05);">
            <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;">GPU Status</div>
            <div id="ep-gpu" style="font-size:16px;font-weight:600;color:var(--green);margin-top:4px;">--</div>
          </div>
          <div style="padding:12px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,255,255,0.05);">
            <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;">Temperature</div>
            <div id="ep-temp" style="font-size:16px;font-weight:600;color:var(--cyan);margin-top:4px;">--</div>
          </div>
          <div style="padding:12px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,255,255,0.05);">
            <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;">SMART Disk</div>
            <div id="ep-smart" style="font-size:16px;font-weight:600;color:var(--green);margin-top:4px;">--</div>
          </div>
          <div style="padding:12px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,255,255,0.05);">
            <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;">Last Heartbeat</div>
            <div id="ep-heartbeat" style="font-size:16px;font-weight:600;color:var(--green);margin-top:4px;">--</div>
          </div>
        </div>
        <div style="font-size:11px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px;">Critical Event Detection (24h)</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:16px;">
          <div id="ev-kernel41" style="padding:10px;background:rgba(0,0,0,0.3);border-radius:6px;border:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;gap:8px;">
            <span style="font-size:18px;">⚡</span>
            <div><div style="font-size:11px;color:var(--text-muted);">Kernel-Power 41</div><div style="font-weight:600;color:var(--green);" id="ev-kernel41-val">Not Detected</div></div>
          </div>
          <div id="ev-display4101" style="padding:10px;background:rgba(0,0,0,0.3);border-radius:6px;border:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;gap:8px;">
            <span style="font-size:18px;">🖥️</span>
            <div><div style="font-size:11px;color:var(--text-muted);">Display Driver 4101</div><div style="font-weight:600;color:var(--green);" id="ev-display4101-val">Not Detected</div></div>
          </div>
          <div id="ev-disk153" style="padding:10px;background:rgba(0,0,0,0.3);border-radius:6px;border:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;gap:8px;">
            <span style="font-size:18px;">💾</span>
            <div><div style="font-size:11px;color:var(--text-muted);">Disk Error 153</div><div style="font-weight:600;color:var(--green);" id="ev-disk153-val">Not Detected</div></div>
          </div>
          <div id="ev-apphang" style="padding:10px;background:rgba(0,0,0,0.3);border-radius:6px;border:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;gap:8px;">
            <span style="font-size:18px;">🔄</span>
            <div><div style="font-size:11px;color:var(--text-muted);">App Hang 1002</div><div style="font-weight:600;color:var(--green);" id="ev-apphang-val">Not Detected</div></div>
          </div>
        </div>
        <div style="font-size:11px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px;">ENDPOINT RCA ENGINE</div>
        <table class="gov-table" style="font-size:12px;">
          <thead><tr><th>Gejala</th><th>Evidence</th><th>Root Cause</th><th>Confidence</th></tr></thead>
          <tbody id="ep-rca-tbody">
            <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:20px;">Menunggu data dari agent...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <!-- Aggregated RCA per Agent -->
  <div class="panel" style="margin-top:16px;">
    <div class="panel-header">
      <div class="panel-title">🤖 PER-AGENT ADVANCED TELEMETRY</div>
      <div class="panel-badge" id="adv-agent-count">0 AGENTS</div>
    </div>
    <div class="panel-body">
      <table class="gov-table" style="font-size:12px;">
        <thead><tr><th>Agent</th><th>GPU</th><th>SMART</th><th>Temp</th><th>DNS</th><th>HTTP</th><th>Resp(ms)</th><th>Kernel41</th><th>VGA4101</th><th>Disk153</th><th>AppHang</th><th>Status</th></tr></thead>
        <tbody id="adv-agent-tbody">
          <tr><td colspan="12" style="text-align:center;color:var(--text-muted);padding:20px;">Menunggu data telemetri...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div><!-- End of tab-advrca -->

<!-- ======================================= -->
<!-- FLEET MANAGEMENT TAB                      -->
<!-- ======================================= -->
<div class="tab-pane" id="tab-fleet">
  <div class="three-col" style="grid-template-columns: 1fr 1fr 1.5fr; gap: 20px;">
    
    <!-- SITES -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">🏢 SITE PROFILES</div>
        <button onclick="refreshFleetSites()" style="background:none;border:none;color:var(--cyan);cursor:pointer;"><i class="fas fa-sync-alt"></i></button>
      </div>
      <div class="panel-body">
        <form id="fleetSiteForm" onsubmit="saveFleetSite(event)" style="display:flex; flex-direction:column; gap:8px; margin-bottom:15px; padding-bottom:15px; border-bottom:1px solid var(--border);">
          <input type="text" id="siteId" placeholder="Site ID (e.g. SITE_A)" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
          <input type="text" id="siteName" placeholder="Site Name" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
          <div style="display:grid; grid-template-columns:2fr 1fr; gap:8px;">
            <input type="text" id="routerIp" placeholder="Router IP" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
            <input type="number" id="routerPort" placeholder="Router Port (e.g. 10001)" value="10001" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <input type="text" id="dnsPrimary" placeholder="DNS Primary (e.g. 8.8.8.8)" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
            <input type="text" id="dnsSecondary" placeholder="DNS Secondary (e.g. 1.1.1.1)" style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
          </div>
          <button type="submit" style="background:rgba(0,255,157,0.1); border:1px solid var(--green); color:var(--green); padding:6px; border-radius:4px; cursor:pointer; font-weight:bold;">➕ ADD / UPDATE SITE</button>
        </form>
        <div id="fleet-sites-list" style="display:flex; flex-direction:column; gap:8px; max-height:400px; overflow-y:auto;">
        </div>
      </div>
    </div>

    <!-- PRINTERS -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">🖨️ NETWORK PRINTERS</div>
        <button onclick="refreshFleetPrinters()" style="background:none;border:none;color:var(--cyan);cursor:pointer;"><i class="fas fa-sync-alt"></i></button>
      </div>
      <div class="panel-body">
        <form id="fleetPrinterForm" onsubmit="saveFleetPrinter(event)" style="display:flex; flex-direction:column; gap:8px; margin-bottom:15px; padding-bottom:15px; border-bottom:1px solid var(--border);">
          <select id="printerSiteId" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
            <option value="">-- Select Site --</option>
          </select>
          <input type="text" id="printerName" placeholder="Printer Name (e.g. EPSON_KASIR)" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
          <input type="text" id="printerIp" placeholder="Printer IP" required style="background:rgba(0,0,0,0.3); border:1px solid var(--border); color:white; padding:6px; border-radius:4px; font-size:11px;">
          <button type="submit" style="background:rgba(0,255,157,0.1); border:1px solid var(--green); color:var(--green); padding:6px; border-radius:4px; cursor:pointer; font-weight:bold;">➕ ADD PRINTER</button>
        </form>
        <div id="fleet-printers-list" style="display:flex; flex-direction:column; gap:8px; max-height:400px; overflow-y:auto;">
        </div>
      </div>
    </div>

    <!-- DEVICES -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">💻 DEVICE ENROLLMENTS</div>
        <button onclick="refreshFleetDevices()" style="background:none;border:none;color:var(--cyan);cursor:pointer;"><i class="fas fa-sync-alt"></i></button>
      </div>
      <div class="panel-body">
        <div id="fleet-devices-list" style="display:flex; flex-direction:column; gap:8px; max-height:550px; overflow-y:auto;">
        </div>
      </div>
    </div>

    </div>

    <!-- FLEET TOPOLOGY -->
    <div class="panel" style="margin-top: 20px;">
      <div class="panel-header">
        <div class="panel-title">🌳 FLEET TOPOLOGY</div>
        <button onclick="refreshFleetTopology()" style="background:none;border:none;color:var(--cyan);cursor:pointer;"><i class="fas fa-sync-alt"></i></button>
      </div>
      <div class="panel-body">
        <div id="fleet-topology-list" style="display:flex; flex-direction:column; gap:8px; font-family: monospace; font-size: 13px; color: var(--text-muted); background: rgba(0,0,0,0.2); padding: 10px; border-radius: 4px; border: 1px solid var(--border);">
        </div>
      </div>
    </div>

  </div><!-- /tab-fleet -->

  <!-- ======================================= -->
  <!-- SERVER HEALTH AUDIT TAB                 -->
  <!-- ======================================= -->
  <div class="tab-pane" id="tab-audit">
    <div id="audit-watchdog-alert" style="display:none; background:var(--red); color:#fff; padding:10px; border-radius:4px; margin-bottom:15px; font-weight:bold; text-align:center;">
      CRITICAL: System Auditor hasn't reported in over 90 seconds!
    </div>
    <div class="two-col" style="grid-template-columns: 1fr 2fr; gap: 20px;">
      
      <!-- AUDIT SUMMARY -->
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">🛡️ SYSTEM HEALTH AUDIT</div>
          <button onclick="fetchSystemAudit()" style="background:none;border:none;color:var(--cyan);cursor:pointer;"><i class="fas fa-sync-alt"></i></button>
        </div>
        <div class="panel-body" style="text-align:center;">
          <div class="confidence-meter" style="margin-top:20px;">
            <div class="meter-ring">
              <svg viewBox="0 0 120 120" width="120" height="120">
                <circle class="ring-bg" cx="60" cy="60" r="54"></circle>
                <circle class="ring-fill" id="audit-score-ring" cx="60" cy="60" r="54"></circle>
              </svg>
              <div class="meter-center">
                <div class="meter-pct" id="audit-score-pct">--%</div>
                <div class="meter-label">SCORE</div>
              </div>
            </div>
            <div class="verdict-badge" id="audit-verdict" style="margin-top:10px;">UNKNOWN</div>
          </div>
          <div style="margin-top:20px; text-align:left; font-size:12px;">
            <div style="color:var(--text-muted); margin-bottom:5px;">Last Audit: <span id="audit-timestamp" style="color:var(--text-primary); font-family:monospace;">--</span></div>
            <div style="color:var(--text-muted); margin-bottom:5px;">Duration: <span id="audit-duration" style="color:var(--text-primary); font-family:monospace;">--</span> ms</div>
            <div style="color:var(--text-muted); margin-bottom:5px;">Version: <span id="audit-version" style="color:var(--text-primary); font-family:monospace;">--</span></div>
            <div style="color:var(--red); font-weight:bold; margin-bottom:5px;">Critical Issues:</div>
            <div id="audit-criticals" style="color:var(--text-primary); font-family:monospace;">None</div>
          </div>
        </div>
      </div>

      <!-- AUDIT DETAILS -->
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">🧠 AI ROOT CAUSE ANALYSIS & COMPONENTS</div>
        </div>
        <div class="panel-body">
          <div style="background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:4px; padding:12px; margin-bottom:15px; font-family:monospace; font-size:12px; white-space:pre-wrap;" id="audit-ai-analysis">
            No analysis available.
          </div>
          <div class="monitor-grid" id="audit-components-grid">
            <!-- Populated via JS -->
          </div>
        </div>
      </div>
      
      <!-- AUDIT HISTORY -->
      <div class="panel" style="grid-column: 1 / -1;">
        <div class="panel-header">
          <div class="panel-title">📜 AUDIT HISTORY & OUTAGES</div>
        </div>
        <div class="panel-body">
          <table class="data-table">
            <thead>
              <tr>
                <th>TIME</th>
                <th>DURATION (Secs)</th>
                <th>STATUS</th>
                <th>FAILED COMPONENTS</th>
              </tr>
            </thead>
            <tbody id="audit-history-list">
              <!-- populated via js -->
            </tbody>
          </table>
        </div>
      </div>
      
    </div>
  </div>

  <!-- ======================================= -->
  <!-- SOP LIFECYCLE TAB (KANBAN BOARD)         -->
  <!-- ======================================= -->
  <div class="tab-pane" id="tab-sop-lifecycle">
    <div style="background:rgba(0,0,0,0.2); border:1px solid var(--border); border-radius:6px; padding:15px; margin-bottom:20px; display:flex; align-items:center; gap:15px;">
      <div style="background:rgba(217, 70, 239, 0.1); border:1px solid #d946ef; border-radius:50%; width:40px; height:40px; display:flex; align-items:center; justify-content:center; color:#d946ef; font-size:18px;">
        <i class="fas fa-book-open"></i>
      </div>
      <div>
        <h3 style="margin:0; font-family:'Rajdhani',sans-serif; font-size:18px; color:#fff;">SOP LIFECYCLE MANAGEMENT</h3>
        <p style="margin:0; font-size:12px; color:var(--text-muted);">Tinjau transisi dan otorisasi prosedur operasional standar otonom hasil pembelajaran kecerdasan artifisial (AI).</p>
      </div>
    </div>
    
    <div class="kanban-board" id="sop-kanban-board">
      
      <!-- DRAFT COLUMN -->
      <div class="kanban-column column-draft">
        <div class="kanban-column-header">
          <span>📝 Draft</span>
          <span class="badge" id="count-draft" style="background:#64748b; color:white; font-size:11px; padding:2px 6px; border-radius:10px;">0</span>
        </div>
        <div class="kanban-column-body" id="col-body-draft" style="display:flex; flex-direction:column; gap:15px; flex:1; overflow-y:auto;">
          <!-- Card populated via JS -->
        </div>
      </div>
      
      <!-- CANDIDATE COLUMN -->
      <div class="kanban-column column-candidate">
        <div class="kanban-column-header">
          <span>⚡ Candidate</span>
          <span class="badge" id="count-candidate" style="background:#f97316; color:white; font-size:11px; padding:2px 6px; border-radius:10px;">0</span>
        </div>
        <div class="kanban-column-body" id="col-body-candidate" style="display:flex; flex-direction:column; gap:15px; flex:1; overflow-y:auto;">
          <!-- Card populated via JS -->
        </div>
      </div>
      
      <!-- VALIDATED COLUMN -->
      <div class="kanban-column column-validated">
        <div class="kanban-column-header">
          <span>🔬 Validated</span>
          <span class="badge" id="count-validated" style="background:#a855f7; color:white; font-size:11px; padding:2px 6px; border-radius:10px;">0</span>
        </div>
        <div class="kanban-column-body" id="col-body-validated" style="display:flex; flex-direction:column; gap:15px; flex:1; overflow-y:auto;">
          <!-- Card populated via JS -->
        </div>
      </div>
      
      <!-- PRODUCTION COLUMN -->
      <div class="kanban-column column-production">
        <div class="kanban-column-header">
          <span>🚀 Production</span>
          <span class="badge" id="count-production" style="background:#22c55e; color:white; font-size:11px; padding:2px 6px; border-radius:10px;">0</span>
        </div>
        <div class="kanban-column-body" id="col-body-production" style="display:flex; flex-direction:column; gap:15px; flex:1; overflow-y:auto;">
          <!-- Card populated via JS -->
        </div>
      </div>
      
    </div>
  </div>

  </div><!-- /main -->
</div><!-- /app -->

<!-- Governance Modal HTML -->
<div id="govModal" class="gov-modal">
  <div class="gov-modal-content">
    <span class="gov-modal-close" onclick="closeGovModal()">&times;</span>
    <div class="gov-modal-title" id="govModalTitle">Detail</div>
    <div id="govModalBody">Loading data...</div>
  </div>
</div>

<script>
  // Clock
  function updateClock() {
    const now = new Date();
    document.getElementById('clock').textContent =
      now.toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
  }
  setInterval(updateClock, 1000);
  updateClock();

  // Animate recommendation bar
  setTimeout(() => {
    document.getElementById('recBar').style.width = '100%';
    document.getElementById('recVal').textContent = '→';
    document.getElementById('recVal').style.color = 'var(--green)';
  }, 2500);

  // Socket.IO Realtime Feed Integration
  const socket = io();
  
  // Load initial devices on page load (don't wait for WebSocket)
  socket.on('connect', function() {
    console.log("✅ Connected to server - Loading initial devices...");
    fetch('/api/devices')
      .then(r => r.json())
      .then(devices => {
        console.log(`📡 Initial load: ${devices.length} devices`);
        if(devices && devices.length > 0) {
          // Manually trigger the devices_update handler with initial data
          document.getElementById('connected-count').innerText = devices.length + " ONLINE";
          let html = "";
          devices.forEach(d => {
            let hasError = (d.status && d.status.toLowerCase() !== 'online');
            let cardStyle = hasError ? "border-color: var(--red); box-shadow: 0 4px 15px rgba(255, 61, 90, 0.2);" : "";
            let statusStyle = hasError ? "color: var(--red); border-color: var(--red); background: rgba(255, 61, 90, 0.1);" : "";
            
            html += `
              <div class="device-card" style="cursor:pointer; ${cardStyle}" onclick="if(window.showAgentDeepDetail) window.showAgentDeepDetail('${d.name}')">
                <div class="device-header">
                  <div class="device-name">💻 ${d.name}</div>
                  <div class="device-status" style="${statusStyle}">${d.status}</div>
                </div>
                <div class="device-metrics">
                  <div class="metric-box">
                    <div class="metric-label">CPU</div>
                    <div class="metric-val" style="color:${hasError ? 'var(--red)' : 'var(--cyan)'}">${d.cpu || '—'}</div>
                  </div>
                  <div class="metric-box">
                    <div class="metric-label">RAM</div>
                    <div class="metric-val" style="color:${hasError ? 'var(--red)' : 'var(--purple)'}">${d.ram || '—'}</div>
                  </div>
                  <div class="metric-box">
                    <div class="metric-label">NET</div>
                    <div class="metric-val" style="color:${hasError ? 'var(--red)' : 'var(--green)'}">${d.network || '—'}</div>
                  </div>
                </div>
                <div class="printer-list" style="opacity:0.5"><span class="printer-item">No Peripherals Detected</span></div>
              </div>
            `;
          });
          document.getElementById('device-grid').innerHTML = html;
        } else {
          console.warn("⚠️  No devices returned from API");
          document.getElementById('connected-count').innerText = "0 ONLINE";
        }
      })
      .catch(e => console.error("Error loading devices:", e));
  });
  
  socket.on('incident_event', function(data) {
    addFeedItem('err', data.issue || data.message || 'Unknown Incident', data.layer || 'ENDPOINT');
  });
  let systemLogRefreshTimer = null;
  socket.on('system_log', function(data) {
    const cls = data.type === 'error' ? 'err' : (data.type === 'warning' ? 'warn' : (data.type === 'success' ? 'ok' : 'info'));
    addFeedItem(cls, data.message || 'System log', data.source || 'SYSTEM');
    
    // Auto-refresh PC Client Issues tab when Orchestrator logs a new activity
    if (document.getElementById('tab-issues').classList.contains('active')) {
      if(!systemLogRefreshTimer) {
         systemLogRefreshTimer = setTimeout(() => {
             fetchClientIssues();
             systemLogRefreshTimer = null;
         }, 500);
      }
    } else {
      let tabBtn = document.querySelector('button[onclick="switchTab(event, \\\'tab-issues\\\')"]');
      if(tabBtn && !tabBtn.innerHTML.includes('NEW')) {
          tabBtn.innerHTML = 'PC CLIENT ISSUES <span style="color:var(--bg-void);background:var(--red);padding:2px 6px;border-radius:10px;font-size:10px;margin-left:5px;font-weight:bold;">NEW</span>';
      }
    }
  });
  socket.on('incident_handling_update', function(data) {
    addFeedItem('warn', "Update Approval: " + (data.status || 'PENDING'), 'APPROVAL');
    // Auto-refresh table if tab is active
    if (document.getElementById('tab-issues').classList.contains('active')) {
      fetchClientIssues();
    } else {
      let tabBtn = document.querySelector('button[onclick="switchTab(event, \\\'tab-issues\\\')"]');
      if(tabBtn && !tabBtn.innerHTML.includes('NEW')) {
          tabBtn.innerHTML = 'PC CLIENT ISSUES <span style="color:var(--bg-void);background:var(--red);padding:2px 6px;border-radius:10px;font-size:10px;margin-left:5px;font-weight:bold;">NEW</span>';
      }
    }
  });

  function addFeedItem(cls, msgText, srcText) {
    const feed = document.getElementById('feed');
    const now = new Date();
    const timeStr = now.toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
    const el = document.createElement('div');
    el.className = `feed-item ${cls}`;
    el.innerHTML = `<span class="feed-time">${timeStr}</span><span class="feed-msg">${msgText}</span><span class="feed-src">${srcText}</span>`;
    feed.insertBefore(el, feed.firstChild);
    if (feed.children.length > 20) feed.removeChild(feed.lastChild);
    document.getElementById('feed-count').textContent = feed.children.length + ' EVENTS';
  }

  async function triggerEventReplay() {
    const traceIdInput = document.getElementById('replayTraceId');
    const statusDiv = document.getElementById('replayStatus');
    if (!traceIdInput || !traceIdInput.value.trim()) {
      alert('Masukkan Trace ID / Incident ID telemetri terlebih dahulu!');
      return;
    }
    const traceId = traceIdInput.value.trim();
    statusDiv.style.display = 'block';
    statusDiv.style.color = 'var(--text-secondary)';
    statusDiv.innerHTML = '🔄 Mengirim permintaan replay...';

    try {
      const response = await fetch('/api/replay_event', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ trace_id: traceId })
      });
      const data = await response.json();
      if (data.success) {
        statusDiv.style.color = 'var(--green)';
        statusDiv.innerHTML = `✅ Replay Berhasil: ${data.message}`;
        addFeedItem('ok', `Replay diaktifkan untuk Trace ID: ${traceId}`, 'REPLAY_ENGINE');
      } else {
        statusDiv.style.color = 'var(--red)';
        statusDiv.innerHTML = `❌ Gagal: ${data.error}`;
        addFeedItem('err', `Replay Gagal untuk Trace ID: ${traceId} - ${data.error}`, 'REPLAY_ENGINE');
      }
    } catch (err) {
      statusDiv.style.color = 'var(--red)';
      statusDiv.innerHTML = `❌ Error: ${err.message}`;
      addFeedItem('err', `Replay Error: ${err.message}`, 'REPLAY_ENGINE');
    }
  }

  // Animate kpi values slightly
  const kpiVals = document.querySelectorAll('.kpi-value');
  setInterval(() => {
    // Randomly flicker one value
    const idx = Math.floor(Math.random() * kpiVals.length);
    kpiVals[idx].style.opacity = '0.6';
    setTimeout(() => kpiVals[idx].style.opacity = '1', 200);
  }, 3000);
  function refreshCurrentTab() {
    const icon = document.getElementById('refresh-icon');
    if(icon) {
        icon.classList.add('fa-spin');
        setTimeout(() => icon.classList.remove('fa-spin'), 1000);
    }
    const activeTab = document.querySelector('.tab-pane.active');
    if (!activeTab) return;
    const tabId = activeTab.id;
    
    if(tabId === 'tab-rca') fetchRCA();
    if(tabId === 'tab-triage') fetchTriage();
    if(tabId === 'tab-groundtruth') fetchFeedback();
    if(tabId === 'tab-issues') fetchClientIssues();
    if(tabId === 'tab-aimodels') { fetchAIModels(); fetchConsensus(); fetchDriftMetrics(); fetchAIObservability(); }
    if(tabId === 'tab-advrca') fetchAdvancedRCA();
    if(tabId === 'tab-audit') fetchSystemAudit();
    if(tabId === 'tab-fleet') {
        refreshFleetSites();
        setTimeout(refreshFleetPrinters, 300);
        setTimeout(refreshFleetDevices, 600);
    }
    // Overview is real-time via Socket.IO, Governance via server-side Jinja / separate buttons
  }

  // Tabs
  function switchTab(evt, tabId) {
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    if(evt && evt.currentTarget) evt.currentTarget.classList.add('active');
    document.getElementById(tabId).classList.add('active');
    
    // Clear NEW badge
    if (tabId === 'tab-issues') {
       let tabBtn = document.querySelector('button[onclick="switchTab(event, \\\'tab-issues\\\')"]');
       if(tabBtn) tabBtn.innerHTML = 'PC CLIENT ISSUES';
     }
    
    if (tabId === 'tab-aimodels') {
      fetchAIModels();
    }
    
    if(tabId === 'tab-rca') fetchRCA();
    if(tabId === 'tab-triage') fetchTriage();
    if(tabId === 'tab-groundtruth') fetchFeedback();
    if(tabId === 'tab-issues') fetchClientIssues();
    if(tabId === 'tab-aimodels') { fetchConsensus(); fetchDriftMetrics(); fetchAIObservability(); }
    if(tabId === 'tab-advrca') fetchAdvancedRCA();
    if(tabId === 'tab-audit') fetchSystemAudit();
    if(tabId === 'tab-causal-dag') loadCausalDAG('latest');
    if(tabId === 'tab-sop-lifecycle') loadSOPLifecycle();
  }

  let causalDagNetwork = null;
  async function loadCausalDAG(incidentId, agentName) {
    const container = document.getElementById('causal-dag-network');
    const detailsContainer = document.getElementById('dag-incident-details');
    const badgeEl = document.getElementById('dag-incident-badge');
    
    if (!container) return;
    
    container.innerHTML = `
      <div style="display:flex; flex-direction:column; justify-content:center; align-items:center; height:100%; color:var(--cyan); font-family:'Share Tech Mono', monospace;">
        <i class="fas fa-sync-alt fa-spin" style="font-size:32px; margin-bottom:10px;"></i>
        <div>RETRIEVING CAUSAL GRAPH FROM PG ARCHIVE...</div>
      </div>
    `;
    
    try {
      const res = await fetch(`/api/causal_dag/${incidentId}`);
      const data = await res.json();
      
      if (data.status !== 'success' || !data.nodes || data.nodes.length === 0) {
        container.innerHTML = `
          <div style="display:flex; justify-content:center; align-items:center; height:100%; color:var(--red); font-family:'Share Tech Mono', monospace;">
            <div>ERROR: FAILED TO PARSE CAUSAL GRAPH DATA</div>
          </div>
        `;
        badgeEl.textContent = 'ERROR';
        badgeEl.className = 'panel-badge error';
        return;
      }
      
      const info = data.incident_info || {};
      badgeEl.textContent = info.device_name ? `INCIDENT: ${info.device_name} - ${info.flag}` : 'NOMINAL';
      badgeEl.className = 'panel-badge';
      if (info.flag && info.flag !== 'NOMINAL') {
        badgeEl.style.background = 'var(--red-dim)';
        badgeEl.style.color = 'var(--red)';
        badgeEl.style.borderColor = 'var(--red)';
      } else {
        badgeEl.style.background = 'rgba(0, 255, 157, 0.1)';
        badgeEl.style.color = 'var(--green)';
        badgeEl.style.borderColor = 'var(--green)';
      }
      
      detailsContainer.innerHTML = `
        <div style="margin-bottom: 8px;"><strong>Device:</strong> ${info.device_name || 'N/A'}</div>
        <div style="margin-bottom: 8px;"><strong>Incident ID:</strong> ${info.incident_id ? 'INC-' + info.incident_id : 'N/A'}</div>
        <div style="margin-bottom: 8px;"><strong>Timestamp:</strong> ${info.timestamp || 'N/A'}</div>
        <div style="margin-bottom: 8px;"><strong>Trigger:</strong> <span style="color:var(--red);">${info.flag || 'NOMINAL'}</span></div>
        <div style="margin-bottom: 8px;"><strong>Confidence:</strong> <span style="color:var(--purple); font-weight:bold;">${info.confidence ? Math.round(info.confidence * 100) + '%' : '100%'}</span></div>
        <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:8px; margin-top:8px;">
          <strong>AI Analysis:</strong><br>
          <span style="color:var(--text-primary); font-size:11px;">${info.analysis || 'System is running normally.'}</span>
        </div>
      `;
      
      const visNodes = data.nodes.map(node => {
        let color = {
          background: 'rgba(7, 21, 37, 0.95)',
          border: 'var(--border)',
          highlight: {
            background: 'rgba(0, 229, 255, 0.2)',
            border: 'var(--cyan)'
          }
        };
        let font = { color: 'var(--text-primary)', face: 'Rajdhani', size: 14 };
        
        if (node.type === 'root_cause') {
          color = {
            background: 'var(--red-dim)',
            border: 'var(--red)',
            highlight: {
              background: 'rgba(255, 61, 90, 0.3)',
              border: 'var(--red)'
            }
          };
          font.color = '#fff';
          font.bold = true;
        } else if (node.type === 'blast_radius') {
          color = {
            background: 'var(--amber-dim)',
            border: 'var(--amber)',
            highlight: {
              background: 'rgba(255, 179, 0, 0.3)',
              border: 'var(--amber)'
            }
          };
          font.color = '#fff';
        } else if (node.type === 'healthy') {
          color = {
            background: 'rgba(0, 255, 157, 0.08)',
            border: 'var(--green)',
            highlight: {
              background: 'rgba(0, 255, 157, 0.2)',
              border: 'var(--green)'
            }
          };
        }
        
        return {
          id: node.id,
          label: node.label,
          shape: 'box',
          color: color,
          font: font,
          borderWidth: 2,
          shadow: true,
          margin: 12,
          shapeProperties: {
            borderRadius: 6
          },
          title: node.details || ''
        };
      });
      
      const visEdges = data.edges.map(edge => {
        return {
          from: edge.from,
          to: edge.to,
          label: edge.label || '',
          font: { color: 'var(--text-secondary)', size: 11, background: 'none', face: 'Share Tech Mono' },
          arrows: {
            to: { enabled: true, scaleFactor: 0.8 }
          },
          color: {
            color: 'var(--border)',
            highlight: 'var(--cyan)',
            hover: 'var(--cyan)'
          },
          width: 2,
          length: 150
        };
      });
      
      const visData = {
        nodes: new vis.DataSet(visNodes),
        edges: new vis.DataSet(visEdges)
      };
      
      const visOptions = {
        interaction: {
          hover: true,
          tooltipDelay: 100
        },
        physics: {
          enabled: true,
          barnesHut: {
            gravitationalConstant: -2000,
            centralGravity: 0.3,
            springLength: 120,
            springConstant: 0.04
          }
        }
      };
      
      container.innerHTML = '';
      causalDagNetwork = new vis.Network(container, visData, visOptions);
      
      causalDagNetwork.on('click', function(params) {
        if (params.nodes.length > 0) {
          const clickedId = params.nodes[0];
          const clickedNode = data.nodes.find(n => n.id === clickedId);
          if (clickedNode) {
            detailsContainer.innerHTML = `
              <div style="font-weight:bold; color:var(--cyan); margin-bottom:10px; font-size:13px; text-transform:uppercase;">🔍 Component Detail</div>
              <div style="margin-bottom:8px;"><strong>Name:</strong> ${clickedNode.label.split('\n')[0]}</div>
              <div style="margin-bottom:8px;"><strong>Status Role:</strong> <span style="text-transform:uppercase; font-weight:bold; color:${clickedNode.type === 'root_cause' ? 'var(--red)' : clickedNode.type === 'blast_radius' ? 'var(--amber)' : 'var(--green)'}">${clickedNode.type}</span></div>
              <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:8px; margin-top:8px; font-family:'Share Tech Mono', monospace; font-size:11px;">
                <strong>Diagnostics:</strong><br>
                ${clickedNode.details}
              </div>
              <button onclick="loadCausalDAG('${incidentId}', '${agentName}')" style="margin-top:15px; width:100%; background:rgba(0,255,255,0.1); border:1px solid var(--cyan); color:var(--cyan); padding:6px 12px; border-radius:4px; cursor:pointer; font-weight:bold; font-family:'Rajdhani', sans-serif;">RESET GRAPH VIEW</button>
            `;
          }
        }
      });
      
    } catch (err) {
      console.error(err);
      container.innerHTML = `
        <div style="display:flex; justify-content:center; align-items:center; height:100%; color:var(--red); font-family:'Share Tech Mono', monospace;">
          <div>CONNECTION TIMEOUT OR API ERROR</div>
        </div>
      `;
    }
  }

  window.viewCausalDAG = function(incidentId, agentName) {
    switchTab(null, 'tab-causal-dag');
    const tabBtn = document.querySelector('button[onclick*="tab-causal-dag"]');
    if (tabBtn) {
        document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
        tabBtn.classList.add('active');
    }
    loadCausalDAG(incidentId, agentName);
  };


  async function fetchSystemAudit() {
    try {
      const res = await fetch('/api/system_audit/latest');
      const data = await res.json();
      if(data.success && data.data) {
        const audit = data.data;
        document.getElementById('audit-score-pct').textContent = audit.health_score + '%';
        const ringOffset = 339.3 - ((audit.health_score / 100) * 339.3);
        document.getElementById('audit-score-ring').style.strokeDashoffset = ringOffset;
        document.getElementById('audit-score-ring').style.stroke = (audit.health_score >= 80) ? 'var(--green)' : ((audit.health_score >= 50) ? 'var(--amber)' : 'var(--red)');
        document.getElementById('audit-score-pct').style.color = (audit.health_score >= 80) ? 'var(--green)' : ((audit.health_score >= 50) ? 'var(--amber)' : 'var(--red)');
        
        document.getElementById('audit-verdict').textContent = audit.status || 'UNKNOWN';
        document.getElementById('audit-verdict').style.color = 
          (audit.health_score >= 80) ? 'var(--green)' : ((audit.health_score >= 50) ? 'var(--amber)' : 'var(--red)');
        document.getElementById('audit-verdict').style.borderColor = 
          (audit.health_score >= 80) ? 'rgba(0,255,157,0.4)' : ((audit.health_score >= 50) ? 'rgba(255,179,0,0.4)' : 'rgba(255,59,59,0.4)');
        document.getElementById('audit-verdict').style.background = 
          (audit.health_score >= 80) ? 'rgba(0,255,157,0.1)' : ((audit.health_score >= 50) ? 'rgba(255,179,0,0.1)' : 'rgba(255,59,59,0.1)');
        
        const auditTime = new Date(audit.timestamp);
        document.getElementById('audit-timestamp').textContent = auditTime.toLocaleString();
        document.getElementById('audit-criticals').textContent = audit.failed_components || 'None';
        document.getElementById('audit-ai-analysis').textContent = audit.root_cause || 'No analysis available.';
        document.getElementById('audit-duration').textContent = audit.audit_duration_ms || '--';
        document.getElementById('audit-version').textContent = audit.auditor_version || '--';
        
        // Watchdog Logic
        const now = new Date();
        const diffSecs = (now - auditTime) / 1000;
        const watchdog = document.getElementById('audit-watchdog-alert');
        if (diffSecs > 90) {
            watchdog.style.display = 'block';
            watchdog.style.background = 'var(--red)';
            watchdog.textContent = `CRITICAL: System Auditor hasn't reported in ${Math.floor(diffSecs)} seconds!`;
        } else if (diffSecs > 60) {
            watchdog.style.display = 'block';
            watchdog.style.background = 'var(--amber)';
            watchdog.textContent = `WARNING: System Auditor is delayed (${Math.floor(diffSecs)} seconds).`;
        } else {
            watchdog.style.display = 'none';
        }
        
        const grid = document.getElementById('audit-components-grid');
        grid.innerHTML = '';
        if(audit.components) {
          for(const [comp, info] of Object.entries(audit.components)) {
            const isOk = (info.status === 'OK');
            const isWarn = (info.status === 'WARNING');
            const color = isOk ? 'var(--green)' : (isWarn ? 'var(--amber)' : 'var(--red)');
            const icon = isOk ? '✅' : (isWarn ? '⚠️' : '❌');
            grid.innerHTML += `
              <div class="monitor-card" style="border-left: 3px solid ${color};">
                <div class="monitor-title" style="color:${color}">${icon} ${comp}</div>
                <div class="monitor-subtitle">${info.detail}</div>
              </div>
            `;
          }
        }
        
        fetchSystemAuditHistory();
      }
    } catch(e) {
      console.error("Error fetching system audit:", e);
    }
  }

  async function fetchSystemAuditHistory() {
      try {
          const res = await fetch('/api/system_audit/history');
          const data = await res.json();
          if(data.success && data.data) {
              const list = document.getElementById('audit-history-list');
              list.innerHTML = '';
              data.data.forEach(h => {
                  const tr = document.createElement('tr');
                  const t_start = new Date(h.timestamp);
                  const t_end = new Date(h.end_timestamp);
                  let diff = Math.floor((t_start - t_end) / 1000);
                  if (diff < 0) diff = 0;
                  
                  let statusColor = 'var(--green)';
                  if(h.status === 'CRITICAL' || h.status === 'FAILSAFE') statusColor = 'var(--red)';
                  if(h.status === 'DEGRADED') statusColor = 'var(--amber)';
                  
                  tr.innerHTML = `
                      <td>${t_end.toLocaleTimeString()} - ${t_start.toLocaleTimeString()}</td>
                      <td>${diff > 0 ? diff : '<1'}</td>
                      <td style="color:${statusColor}; font-weight:bold;">${h.status}</td>
                      <td>${h.failed_components || 'None'}</td>
                  `;
                  list.appendChild(tr);
              });
          }
      } catch(e) {
          console.error("History fetch error", e);
      }
  }

  async function fetchAdvancedRCA() {
    try {
      const res = await fetch('/api/advanced_rca');
      const data = await res.json();
      // Update badge
      document.getElementById('adv-agent-count').innerText = (data.agents ? data.agents.length : 0) + ' AGENTS';
      // Populate per-agent table
      let tbody = document.getElementById('adv-agent-tbody');
      if (data.agents && data.agents.length > 0) {
        let h = '';
        data.agents.forEach(a => {
          const wa = a.web_availability || {};
          const ep = a.endpoint_stability || {};
          const statusColor = (ep.kernel_power_41 || ep.display_driver_4101 || ep.disk_error_153) ? 'var(--red)' : 'var(--green)';
          const statusText = (ep.kernel_power_41 || ep.display_driver_4101 || ep.disk_error_153) ? '⚠️ ISSUE' : '✅ HEALTHY';
          h += `<tr>
            <td style="color:var(--cyan);font-weight:600;">${a.agent_name || 'Unknown'}</td>
            <td>${ep.gpu_status || '--'}</td>
            <td>${ep.smart_disk || '--'}</td>
            <td>${ep.temperature || '--'}</td>
            <td>${(wa.dns_resolve || '--').substring(0,15)}</td>
            <td>${wa.http_status || '--'}</td>
            <td>${wa.response_time >= 0 ? wa.response_time : '--'}</td>
            <td style="color:${ep.kernel_power_41 ? 'var(--red)' : 'var(--green)'}">${ep.kernel_power_41 ? '⚠️ YES' : '✅ No'}</td>
            <td style="color:${ep.display_driver_4101 ? 'var(--red)' : 'var(--green)'}">${ep.display_driver_4101 ? '⚠️ YES' : '✅ No'}</td>
            <td style="color:${ep.disk_error_153 ? 'var(--red)' : 'var(--green)'}">${ep.disk_error_153 ? '⚠️ YES' : '✅ No'}</td>
            <td style="color:${ep.app_hang_1002 ? 'var(--amber)' : 'var(--green)'}">${ep.app_hang_1002 ? '⚠️ YES' : '✅ No'}</td>
            <td style="color:${statusColor};font-weight:600;">${statusText}</td>
          </tr>`;
        });
        tbody.innerHTML = h;
      }
      // Update summary panels with first agent data (or latest)
      if (data.agents && data.agents.length > 0) {
        const latest = data.agents[0];
        const wa = latest.web_availability || {};
        const ep = latest.endpoint_stability || {};
        // Web Availability Pipeline
        const setNodeColor = (id, ok) => { const el = document.getElementById(id); if(el) el.style.borderColor = ok ? 'rgba(0,255,157,0.4)' : 'rgba(255,59,59,0.4)'; };
        document.getElementById('wa-dns-val').innerText = wa.dns_resolve || '--';
        setNodeColor('wa-dns', (wa.dns_resolve || '').includes('OK'));
        document.getElementById('wa-ping-val').innerText = wa.ping_status || '--';
        setNodeColor('wa-ping', wa.ping_status === 'OK');
        document.getElementById('wa-tcp-val').innerText = wa.tcp_443 || '--';
        setNodeColor('wa-tcp', wa.tcp_443 === 'OPEN');
        document.getElementById('wa-http-val').innerText = wa.http_status || '--';
        setNodeColor('wa-http', (wa.http_status || '').startsWith('2'));
        document.getElementById('wa-resp-val').innerText = (wa.response_time >= 0 ? wa.response_time + ' ms' : '-- ms');
        setNodeColor('wa-resp', wa.response_time >= 0 && wa.response_time < 2000);
        document.getElementById('wa-browser-error').innerText = wa.browser_error || 'No browser errors detected';
        document.getElementById('wa-browser-error').style.color = (wa.browser_error && wa.browser_error !== 'None') ? 'var(--red)' : 'var(--green)';
        document.getElementById('web-avail-badge').innerText = (wa.http_status || '').startsWith('2') ? 'ONLINE' : 'DEGRADED';
        document.getElementById('web-avail-badge').style.color = (wa.http_status || '').startsWith('2') ? 'var(--green)' : 'var(--red)';
        // Endpoint Stability
        document.getElementById('ep-gpu').innerText = ep.gpu_status || '--';
        document.getElementById('ep-gpu').style.color = (ep.gpu_status === 'OK') ? 'var(--green)' : 'var(--amber)';
        document.getElementById('ep-temp').innerText = ep.temperature || '--';
        document.getElementById('ep-smart').innerText = ep.smart_disk || '--';
        document.getElementById('ep-smart').style.color = (ep.smart_disk === 'Healthy') ? 'var(--green)' : 'var(--red)';
        document.getElementById('ep-heartbeat').innerText = latest.last_seen || '--';
        // Event Viewer
        const setEv = (id, val) => { document.getElementById(id).innerText = val ? '⚠️ DETECTED' : '✅ Not Detected'; document.getElementById(id).style.color = val ? 'var(--red)' : 'var(--green)'; document.getElementById(id).parentElement.parentElement.style.borderColor = val ? 'rgba(255,59,59,0.3)' : 'rgba(255,255,255,0.05)'; };
        setEv('ev-kernel41-val', ep.kernel_power_41);
        setEv('ev-display4101-val', ep.display_driver_4101);
        setEv('ev-disk153-val', ep.disk_error_153);
        setEv('ev-apphang-val', ep.app_hang_1002);
        document.getElementById('ep-stab-badge').innerText = (ep.kernel_power_41 || ep.display_driver_4101 || ep.disk_error_153) ? 'ISSUE DETECTED' : 'STABLE';
        document.getElementById('ep-stab-badge').style.color = (ep.kernel_power_41 || ep.display_driver_4101 || ep.disk_error_153) ? 'var(--red)' : 'var(--green)';
        // Build RCA tables
        let webRca = '';
        if (!(wa.dns_resolve || '').includes('OK')) webRca += `<tr><td>URL Error</td><td>DNS: ${wa.dns_resolve}</td><td style="color:var(--red);">DNS Server Bermasalah</td><td>92%</td></tr>`;
        if (wa.ping_status !== 'OK') webRca += `<tr><td>URL Error</td><td>Ping: ${wa.ping_status}</td><td style="color:var(--red);">Jaringan Putus</td><td>95%</td></tr>`;
        if (wa.tcp_443 !== 'OPEN') webRca += `<tr><td>URL Error</td><td>TCP 443: ${wa.tcp_443}</td><td style="color:var(--red);">Firewall / Server Mati</td><td>90%</td></tr>`;
        if ((wa.http_status || '').startsWith('5')) webRca += `<tr><td>Server Error</td><td>HTTP: ${wa.http_status}</td><td style="color:var(--red);">Backend / API Down</td><td>88%</td></tr>`;
        if (wa.browser_error && wa.browser_error !== 'None') webRca += `<tr><td>Browser Crash</td><td>${wa.browser_error}</td><td style="color:var(--amber);">Cache/Extension/Policy</td><td>75%</td></tr>`;
        if (!webRca) webRca = `<tr><td colspan="4" style="text-align:center;color:var(--green);">✅ Semua layer web berfungsi normal</td></tr>`;
        document.getElementById('web-rca-tbody').innerHTML = webRca;
        let epRca = '';
        if (ep.kernel_power_41) epRca += `<tr><td>PC Blank/Restart</td><td>Kernel-Power Event 41</td><td style="color:var(--red);">Listrik Mati / PSU Bermasalah</td><td>91%</td></tr>`;
        if (ep.display_driver_4101) epRca += `<tr><td>Layar Hitam</td><td>Display Driver Event 4101</td><td style="color:var(--red);">Driver VGA Crash</td><td>94%</td></tr>`;
        if (ep.disk_error_153) epRca += `<tr><td>PC Lambat/Hang</td><td>Disk Error Event 153</td><td style="color:var(--red);">SSD/HDD Mulai Gagal</td><td>91%</td></tr>`;
        if (ep.app_hang_1002) epRca += `<tr><td>Aplikasi Hang</td><td>Application Hang Event 1002</td><td style="color:var(--amber);">Aplikasi Tidak Merespons</td><td>85%</td></tr>`;
        if (!epRca) epRca = `<tr><td colspan="4" style="text-align:center;color:var(--green);">✅ Semua komponen hardware stabil</td></tr>`;
        document.getElementById('ep-rca-tbody').innerHTML = epRca;
      }
    } catch(e) {
      console.error('Failed to fetch advanced RCA:', e);
    }
  }

  function fetchConsensus() {
    fetch('/api/consensus').then(r=>r.json()).then(res => {
       let h = '';
       res.forEach(d => {
         h += `<tr><td>${d.timestamp}</td><td style="color:var(--cyan);">${d.deepseek}</td><td style="color:var(--purple);">${d.gemini}</td><td style="color:var(--green);">${d.status}</td></tr>`;
       });
       document.getElementById('consensus-tbody').innerHTML = h || '<tr><td colspan="4">No data</td></tr>';
    }).catch(e => console.log(e));
  }

  function fetchDriftMetrics() {
    fetch('/api/system_audit/drift')
      .then(r => r.json())
      .then(res => {
        if (!res.success || !res.data) {
          document.getElementById('drift-metrics-container').innerHTML = '<div style="color:var(--red);text-align:center;width:100%;padding:20px;">Gagal memuat data drift</div>';
          return;
        }
        let h = '';
        if (res.data.length === 0) {
          h = '<div style="color:var(--text-muted);text-align:center;grid-column:1/-1;padding:20px;">Belum ada penalti calibration (AI dalam performa optimal 100%)</div>';
        } else {
          res.data.forEach(d => {
            let pct = Math.min(100, Math.max(0, d.penalty || 0));
            let color = 'var(--green)';
            let statusText = 'HEALTHY';
            if (pct >= 70) {
              color = 'var(--red)';
              statusText = 'DRIFT CRITICAL';
            } else if (pct >= 30) {
              color = 'var(--amber)';
              statusText = 'DRIFT WARNING';
            }
            
            h += `
              <div style="background:rgba(255,255,255,0.02); border:1px solid var(--border); padding:12px; border-radius:6px; position:relative;">
                <div style="display:flex; justify-content:space-between; margin-bottom:6px; align-items:center;">
                  <span style="font-weight:bold; color:var(--text-primary); font-size:13px;">🔍 ${d.category}</span>
                  <span style="font-size:9px; font-weight:bold; color:${color}; border:1px solid ${color}; padding:1px 4px; border-radius:3px; background:${color}11;">${statusText}</span>
                </div>
                <div style="height:6px; background:var(--border); border-radius:3px; overflow:hidden; margin-bottom:8px;">
                  <div style="width:${pct}%; height:100%; background:${color}; border-radius:3px;"></div>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:10px; color:var(--text-muted);">
                  <span>Penalti: <strong>${pct}%</strong></span>
                  <span>Gagal Beruntun: <strong>${d.consecutive_failures || 0}</strong></span>
                </div>
                <div style="font-size:9px; color:var(--text-muted); margin-top:6px; font-family:monospace; text-align:right;">
                  Updated: ${d.last_updated || '—'}
                </div>
              </div>
            `;
          });
        }
        document.getElementById('drift-metrics-container').innerHTML = h;
      })
      .catch(e => {
        console.error(e);
        document.getElementById('drift-metrics-container').innerHTML = '<div style="color:var(--red);text-align:center;width:100%;padding:20px;">Error koneksi ke API drift</div>';
      });
  }

  function fetchAIObservability() {
    fetch('/api/system_audit/ai_observability')
      .then(r => r.json())
      .then(res => {
        if (!res.success) {
          console.error("Gagal memuat AI Observability:", res.error);
          return;
        }
        const s = res.summary;
        
        // Populate summary cards
        document.getElementById('obs-blocked-commands').textContent = s.blocked_commands;
        document.getElementById('obs-hallucination-rate').textContent = (s.hallucination_rate * 100).toFixed(1) + '%';
        document.getElementById('obs-hallucination-count').textContent = s.hallucinations_detected;
        document.getElementById('obs-drift-alerts').textContent = s.drift_alerts;
        document.getElementById('obs-prompt-failures').textContent = s.total_prompt_failures;
        
        // Build model failures split text
        let failureSplit = [];
        if (s.failures_by_model) {
          for (const [model, count] of Object.entries(s.failures_by_model)) {
            failureSplit.push(`${model}: ${count}`);
          }
        }
        document.getElementById('obs-failures-split').textContent = failureSplit.length > 0 ? failureSplit.join(' | ') : 'Semua model stabil';
        
        // Populate supervision history table
        let supervisionHtml = '';
        if (res.audit_history && res.audit_history.length > 0) {
          res.audit_history.forEach(row => {
            const driftColor = row.drift_detected ? 'var(--red)' : 'var(--green)';
            const driftText = row.drift_detected ? '⚠️ DRIFT' : '✅ STABLE';
            const reasoningColor = row.reasoning_valid ? 'var(--green)' : 'var(--red)';
            const reasoningText = row.reasoning_valid ? '✅ VALID' : '⚠️ HALUSINASI';
            const statusColor = row.is_approved ? 'var(--green)' : 'var(--red)';
            
            supervisionHtml += `
              <tr>
                <td>${row.timestamp}</td>
                <td><span style="color:var(--cyan);">${row.agent}</span></td>
                <td><span style="color:${driftColor}; font-weight:bold;">${driftText}</span></td>
                <td><span style="color:${reasoningColor}; font-weight:bold;">${reasoningText}</span></td>
                <td><span style="color:${statusColor}; font-weight:bold;">${row.status}</span></td>
              </tr>
            `;
          });
        } else {
          supervisionHtml = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:15px;">Belum ada riwayat supervisi...</td></tr>';
        }
        document.getElementById('obs-supervision-tbody').innerHTML = supervisionHtml;
        
        // Populate failures history table
        let failuresHtml = '';
        if (res.failure_history && res.failure_history.length > 0) {
          res.failure_history.forEach(row => {
            failuresHtml += `
              <tr>
                <td>${row.timestamp}</td>
                <td><span style="color:var(--purple); font-weight:bold;">${row.ai_name}</span></td>
                <td title="${row.question}">${row.question.substring(0, 30)}${row.question.length > 30 ? '...' : ''}</td>
                <td style="color:var(--red);" title="${row.error_message}">${row.error_message.substring(0, 40)}${row.error_message.length > 40 ? '...' : ''}</td>
              </tr>
            `;
          });
        } else {
          failuresHtml = '<tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:15px;">Tidak ada error prompt tercatat.</td></tr>';
        }
        document.getElementById('obs-failures-tbody').innerHTML = failuresHtml;
      })
      .catch(e => console.error("Error fetching AI Observability:", e));
  }

  window.retrainClassifierModel = function() {
    const btn = document.getElementById('btn-retrain-model');
    if (!btn) return;
    const oldText = btn.innerHTML;
    btn.innerHTML = '🔄 TRAINING MODEL...';
    btn.disabled = true;
    btn.style.opacity = '0.5';
    
    fetch('/api/system_audit/retrain_classifier', { method: 'POST' })
      .then(r => r.json())
      .then(res => {
        if (res.success) {
          alert('SUKSES: ' + res.message);
          fetchDriftMetrics();
        } else {
          alert('GALAT: ' + (res.error || 'Gagal melatih ulang model'));
        }
      })
      .catch(e => {
        console.error(e);
        alert('GALAT: Terjadi masalah koneksi saat melatih ulang model.');
      })
      .finally(() => {
        btn.innerHTML = oldText;
        btn.disabled = false;
        btn.style.opacity = '1';
      });
  };

  function fetchTriage() {
    fetch('/api/correlation_tree').then(r=>r.json()).then(res => {
       let h = '';
       if (res.length > 0) {
           res.forEach(d => {
             h += `<tr><td>${d.timestamp}</td><td style="color:var(--cyan);font-family:monospace;">${d.cid}</td><td>${d.evt_count}</td><td style="color:var(--amber);font-weight:bold;">${d.inc}</td></tr>`;
           });
       } else {
           h = '<tr><td colspan="4" style="text-align:center;">Sistem Aman - Tidak ada insiden aktif</td></tr>';
       }
       document.getElementById('triage-tbody').innerHTML = h;
    }).catch(e => console.log(e));
  }

  function fetchRCA() {
    fetch('/api/incidents').then(r=>r.json()).then(res => {
      if (!res || res.length === 0) return;
      const inc = res[0]; // get the latest active/recent incident
      
      const agentName = inc.agent && inc.agent !== "null" ? inc.agent : "Unknown Agent";
      const flagName = inc.flag && inc.flag !== "null" ? inc.flag : "UNKNOWN_ALERT";
      const locationName = inc.location && inc.location !== "null" ? inc.location : "Jakarta_Head_Office";
      const timestampVal = inc.timestamp && inc.timestamp !== "null" ? inc.timestamp : new Date().toLocaleString();
      const stepsArr = inc.steps || [];

      // 1. Dynamic Architecture Layers
      const layersDiv = document.getElementById('rca-layers');
      if (layersDiv) {
        const activeLayerNum = parseInt(inc.layer) || 1;
        const layerData = [
          { num: 7, name: 'MONITORING', desc: 'Netdata · Digital Twin · KPI', color: 'var(--cyan)' },
          { num: 6, name: 'AUDIT & LEARNING', desc: 'PostgreSQL · Cold Storage · AI Dataset', color: 'var(--purple)' },
          { num: 5, name: 'HUMAN APPROVAL', desc: 'IT Operator · Web Dashboard', color: 'var(--amber)' },
          { num: 4, name: 'AI INTELLIGENCE', desc: 'DeepSeek Core · RAG · Orchestrator', color: 'var(--blue)' },
          { num: 3, name: 'EVENT GOVERNANCE', desc: 'Priority Queue · SLA · Suppressor', color: 'var(--green)' },
          { num: 2, name: 'STREAM PROCESSING', desc: 'Redis Pub/Sub · Normalizer · Cache', color: 'var(--red)' },
          { num: 1, name: 'ENDPOINT & EDGE', desc: 'PC Agent · FTP Buffer · OTA Updater', color: 'var(--text-secondary)' }
        ];
        
        let layersHtml = '';
        layerData.forEach(ld => {
          const isAlert = ld.num === activeLayerNum;
          const statusText = isAlert ? 'ALERT' : (ld.num === 5 ? 'SYNC' : (ld.num === 4 ? 'ACTIVE' : 'LIVE'));
          const statusClass = isAlert ? 'layer-status warn' : 'layer-status';
          const styleLC = isAlert ? 'var(--red)' : ld.color;
          layersHtml += `
            <div class="layer ${isAlert ? 'active' : ''}" style="--lc:${styleLC}; border-color: ${isAlert ? 'var(--red)' : ''}">
              <div class="layer-num">${ld.num}</div>
              <div class="layer-info">
                <div class="layer-name">${ld.name}</div>
                <div class="layer-desc">${ld.desc}</div>
              </div>
              <div class="${statusClass}">${statusText}</div>
            </div>`;
        });
        layersDiv.innerHTML = layersHtml;
      }

      // 2. Dynamic 9-Stage RCA steps
      const stepsList = document.getElementById('rca-steps-list');
      if (stepsList) {
        let step3Title = 'Hypothesis Engine';
        let step3Subtitle = 'Kabel Putus 40% · Spooler Mati 60%';
        let step3Percent = 60;
        let step3Color = 'var(--amber)';
        
        let step6Title = 'Auto Validation Engine';
        let step6Subtitle = 'Ping Otomatis · SNMP Check';
        let step6Percent = 93;
        let step6Color = 'var(--green)';

        let step1Subtitle = 'Windows Log · Ping · Spooler · Netdata · API';

        if (flagName === 'USB_CONN') {
          step1Subtitle = 'Windows Event ID 7045 · USB Registry Keys · PnpEvent';
          step3Subtitle = 'USB Mass Storage 95% · Controller Crash 5%';
          step3Percent = 95;
          step3Color = 'var(--green)';
          step6Subtitle = 'Device Registry Query Success · Audit Lock';
          step6Percent = 98;
          step6Color = 'var(--green)';
        } else if (flagName === 'NETWORK_OFFLINE' || flagName.includes('OFFLINE')) {
          step1Subtitle = 'Ping Loss · Router Gateway Metrik · Interface Status';
          step3Subtitle = 'Kabel LAN Putus 70% · Switch Overheat 30%';
          step3Percent = 70;
          step3Color = 'var(--amber)';
          step6Subtitle = 'Gateway Ping Failed · Packet Loss 100%';
          step6Percent = 100;
          step6Color = 'var(--red)';
        } else if (flagName === 'DISK_CRITICAL') {
          step1Subtitle = 'S.M.A.R.T. Monitor · Disk Space Check · IOPS stats';
          step3Subtitle = 'SSD Read-Only Mode 80% · Temporary Log Overload 20%';
          step3Percent = 80;
          step3Color = 'var(--cyan)';
          step6Subtitle = 'Write Verification Failed · SMART Status alert';
          step6Percent = 95;
          step6Color = 'var(--green)';
        }

        const pct = Math.round((inc.confidence || 0.8) * 100);

        const stages = [
          { icon: '🔎', title: '1. Evidence Collector', subtitle: step1Subtitle, pct: 100, val: '✓', color: 'var(--green)', class: 'done', desc: 'Mengumpulkan data mentah secara real-time dari berbagai sumber sebagai bukti insiden.' },
          { icon: '⏱️', title: '2. Temporal Analysis', subtitle: `Kronologi Incident terdeteksi pada ${timestampVal}`, pct: 100, val: '✓', color: 'var(--green)', class: 'done', desc: 'Menganalisis kronologi kejadian dan membandingkan kondisi sistem saat normal dengan saat terjadi error.' },
          { icon: '🧠', title: `3. ${step3Title}`, subtitle: step3Subtitle, pct: step3Percent, val: `${step3Percent}%`, color: step3Color, class: 'done', desc: 'Merumuskan hipotesis kemungkinan penyebab berdasarkan bukti yang terkumpul.' },
          { icon: '🕸️', title: '4. Cross-System Correlation', subtitle: `${agentName} → L${inc.layer || 1} Hub → Network Topology Core`, pct: 85, val: '85%', color: 'var(--cyan)', class: 'done', desc: 'Mencari hubungan sebab-akibat antar sistem di jaringan.' },
          { icon: '🔗', title: '5. Causal Graph Engine', subtitle: 'Sebab-Akibat Pasti Terverifikasi', pct: 90, val: '90%', color: 'var(--cyan)', class: 'done', desc: 'Membangun grafik sebab-akibat terarah untuk mengonfirmasi Root Cause utama.' },
          { icon: '🧪', title: `6. ${step6Title}`, subtitle: step6Subtitle, pct: step6Percent, val: `${step6Percent}%`, color: step6Color, class: 'done', desc: 'Melakukan pemeriksaan otomatis secara langsung untuk memastikan hipotesis terkuat.' },
          { icon: '🎯', title: '7. Root Cause Verification', subtitle: `Evidence Score + Temporal + Validation (${pct}%)`, pct: pct, val: `${pct}%`, color: 'var(--purple)', class: 'active', desc: 'Mensintesis skor bukti, probabilitas kausal, dan hasil validasi menjadi kesimpulan Root Cause.' },
          { icon: '📊', title: '8. Confidence Score', subtitle: `Root Cause ${pct}% Valid — Score > 75% ✓`, pct: pct, val: `${pct}%`, color: 'var(--green)', class: 'active', desc: 'Menilai tingkat keyakinan (Confidence Score). Jika skor > 75%, maka kesimpulan AI dinyatakan valid.' },
          { icon: '📝', title: '9. Recommendation', subtitle: `Tindakan: ${stepsArr.join(' → ') || 'Lakukan verifikasi manual'}`, pct: 100, val: '✓', color: 'var(--green)', class: 'done', desc: 'Menyusun draf perbaikan, rekomendasi tindakan teknis, atau perintah self-healing otomatis.' }
        ];

        let stepsHtml = '';
        stages.forEach(st => {
          stepsHtml += `
            <div class="rca-step ${st.class}" onclick="this.classList.toggle('expanded')">
              <div class="rca-icon">${st.icon}</div>
              <div class="rca-info">
                <div class="rca-title">${st.title}</div>
                <div class="rca-subtitle">${st.subtitle}</div>
                <div class="rca-desc"><strong>Fungsi:</strong> ${st.desc}</div>
              </div>
              <div class="score-bar">
                <div class="bar-track"><div class="bar-fill" style="width:${st.pct}%;background:${st.color}"></div></div>
                <div class="bar-val" style="${st.val === '✓' ? 'color:' + st.color : ''}">${st.val}</div>
              </div>
            </div>`;
        });
        stepsList.innerHTML = stepsHtml;
      }

      // 3. Confidence Meter
      const pctVal = Math.round(inc.confidence * 100);
      const ringFill = document.getElementById('rca-ring-fill');
      const meterPct = document.getElementById('rca-meter-pct');
      const meterLabel = document.getElementById('rca-meter-label');
      const verdictBadge = document.getElementById('rca-verdict-badge');
      const thresholdDesc = document.getElementById('rca-threshold-desc');
      
      if (meterPct) meterPct.textContent = pctVal + '%';
      if (meterLabel) meterLabel.textContent = pctVal >= 75 ? 'VALID' : 'LOW';
      if (verdictBadge) {
        if (pctVal >= 75) {
          verdictBadge.className = 'verdict-badge';
          verdictBadge.textContent = '✅ READY FOR APPROVAL';
          verdictBadge.style.background = 'rgba(0, 255, 157, 0.1)';
          verdictBadge.style.color = 'var(--green)';
        } else {
          verdictBadge.className = 'verdict-badge';
          verdictBadge.textContent = '⚠️ UNVERIFIED SCORE';
          verdictBadge.style.background = 'rgba(255, 179, 0, 0.1)';
          verdictBadge.style.color = 'var(--amber)';
        }
      }
      if (thresholdDesc) {
        thresholdDesc.innerHTML = pctVal >= 75 ? 
          `Score > 75% threshold terpenuhi<br>Kirim draft ke IT Operator` : 
          `Score < 75% di bawah batas aman<br>Membutuhkan analisis manual mendalam`;
      }
      if (ringFill) {
        const circumference = 339.3;
        const offset = circumference - ((pctVal / 100) * circumference);
        ringFill.style.strokeDashoffset = offset;
      }

      // 4. Human Approval Flow
      const approvalFlow = document.getElementById('rca-approval-flow');
      if (approvalFlow) {
        approvalFlow.innerHTML = `
          <div class="flow-step done-step">
            <div class="flow-icon">🧠</div>
            <div class="flow-info">
              <div class="flow-name" style="color:var(--cyan)">AI Kirim Draft</div>
              <div class="flow-detail">Beserta Confidence Score ${pctVal}%</div>
            </div>
            <div class="flow-action approve">SENT</div>
          </div>
          <div class="connector active-conn"></div>
          <div class="flow-step active-step">
            <div class="flow-icon">👨‍💻</div>
            <div class="flow-info">
              <div class="flow-name" style="color:var(--amber)">IT Operator</div>
              <div class="flow-detail">Melihat Confidence ${pctVal}% di Chat/UI</div>
            </div>
            <div class="flow-action wait">REVIEWING</div>
          </div>
          <div class="connector active-conn"></div>
          <div class="flow-step">
            <div class="flow-icon">⚖️</div>
            <div class="flow-info">
              <div class="flow-name">Approve / Reject</div>
              <div class="flow-detail">Keputusan Akhir — Web Dashboard</div>
            </div>
            <div style="display:flex;gap:4px;">
              <div class="flow-action approve" style="cursor:pointer;" onclick="alert('Incident Approved!')">✅</div>
              <div class="flow-action reject" style="cursor:pointer;" onclick="alert('Incident Rejected!')">❌</div>
            </div>
          </div>
          <div class="connector"></div>
          <div class="flow-step" style="border-color:rgba(0,229,255,0.3)">
            <div class="flow-icon">🔁</div>
            <div class="flow-info">
              <div class="flow-name">Feedback Loop</div>
              <div class="flow-detail">✅ DNA Record · ❌ Post-Mortem</div>
            </div>
          </div>`;
      }
    }).catch(e => console.log("Error fetching RCA data:", e));
  }
  
  function fetchFeedback() {
    fetch('/api/incidents').then(r=>r.json()).then(res => {
       let h = '';
       res.forEach(d => {
         let agentName = d.agent && d.agent !== "null" ? d.agent : "Unknown Agent";
         let flagName = d.flag && d.flag !== "null" ? d.flag : "UNKNOWN_ALERT";
         let locationName = d.location && d.location !== "null" ? d.location : "Jakarta_Head_Office";
         let analysisText = d.analysis && d.analysis !== "No AI analysis available" && d.analysis !== "null" ? d.analysis : `Insiden terdeteksi: ${flagName} di ${locationName}`;
         let confidencePct = d.confidence ? (d.confidence*100).toFixed(0) : 0;
         h += `<tr>
            <td style="color:var(--cyan);font-weight:bold;">${agentName}</td>
            <td style="font-size:12px;line-height:1.4;"><strong style="color:var(--amber)">Alert: ${flagName}</strong><br><span style="color:var(--text-primary)">${analysisText}</span><br><em style="color:var(--text-muted);font-size:10px;">Conf: ${confidencePct}%</em></td>
            <td><input type="text" id="corr_${agentName}" placeholder="Ketik analisa koreksi (Opsional)" style="width:100%;background:rgba(0,0,0,0.5);border:1px solid var(--border);color:#fff;padding:6px;border-radius:4px;"></td>
            <td>
              <button style="background:var(--green);color:#000;border:none;padding:6px 10px;cursor:pointer;border-radius:4px;font-weight:bold;width:100%;margin-bottom:6px;" onclick="sendFeedback(${d.incident_id || 0}, '${agentName}', '${flagName}', 'ACCEPT')">✅ Validasi AI (Benar)</button>
              <button style="background:var(--red);color:#fff;border:none;padding:6px 10px;cursor:pointer;border-radius:4px;font-weight:bold;width:100%;" onclick="sendFeedback(${d.incident_id || 0}, '${agentName}', '${flagName}', 'REJECT')">📝 Koreksi (Salah)</button>
            </td>
          </tr>`;
       });
       document.getElementById('feedback-tbody').innerHTML = h || '<tr><td colspan="4">No data</td></tr>';
    }).catch(e => console.log(e));
  }
  
  function sendFeedback(incId, agent, flag, status) {
    let el = document.getElementById('corr_'+agent);
    let correction = el ? el.value : '';
    let score = status === 'ACCEPT' ? 1.0 : 0.0;
    fetch('/api/feedback', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({incident_id: incId, ai_rca: flag, human_rca: correction || (status === 'ACCEPT' ? 'Valid' : 'Invalid'), score: score, reviewer: 'NOC_OPERATOR'})
    }).then(r=>r.json()).then(() => { alert("Feedback saved!"); fetchFeedback(); });
  }


async function fetchAIModels() {
  try {
    const configRes = await fetch('/api/ai_config');
    const statusRes = await fetch('/api/ai_status');
    const config = await configRes.json();
    const status = await statusRes.json();
    
    const grid = document.getElementById('ai-models-grid');
    if(!grid) return;
    
    grid.innerHTML = '';
    
    for (const [key, model] of Object.entries(config)) {
      const modelStatus = status[key] || { status: "UNKNOWN", code: 0 };
      let statusColor = "var(--green)";
      if (modelStatus.status === "ERROR" || modelStatus.status === "OFFLINE") statusColor = "var(--red)";
      if (modelStatus.status === "DEPLETED") statusColor = "var(--amber)";
      if (modelStatus.status === "NO KEY") statusColor = "var(--text-muted)";
      
      let emoji = "🧠";
      if(key === "gemini") emoji = "🪐";
      if(key === "deepseek") emoji = "🐋";
      if(key === "groq") emoji = "⚡";
      
      const card = document.createElement('div');
      card.className = 'guru-card';
      card.style.cssText = "padding: 15px; text-align: center;";
      card.innerHTML = `
        <div class="guru-emoji" style="font-size: 32px;">${emoji}</div>
        <div class="guru-name" style="font-size: 14px; margin-top: 8px;">${model.name}</div>
        <div style="font-family:'Share Tech Mono', monospace; font-size:11px; margin-top:8px; color:${statusColor}; font-weight: bold; background: rgba(0,0,0,0.5); padding: 4px; border-radius: 4px; border: 1px solid ${statusColor}40;">
           STATUS: ${modelStatus.status} ${modelStatus.code ? '('+modelStatus.code+')' : ''}
        </div>
        <div style="margin-top: 15px; text-align: left;">
          <label style="font-size: 10px; color: var(--text-secondary); font-weight: bold;">API KEY:</label>
          <input type="password" id="key_${key}" value="${model.api_key}" 
                 style="width: 100%; padding: 8px; margin-top: 5px; background: rgba(0,0,0,0.6); border: 1px solid var(--border); color: var(--cyan); font-family: monospace; border-radius: 4px; outline: none; transition: 0.3s;"
                 onfocus="this.type='text'; this.style.borderColor='var(--cyan)';" 
                 onblur="this.type='password'; this.style.borderColor='var(--border)';">
        </div>
      `;
      grid.appendChild(card);
    }
    
    const saveBtn = document.createElement('button');
    saveBtn.innerText = "SAVE & APPLY CONFIG";
    saveBtn.style.cssText = "grid-column: 1 / -1; padding: 12px; margin-top: 15px; background: rgba(0,255,157,0.1); border: 1px solid var(--green); color: var(--green); font-family: 'Orbitron', monospace; font-size: 14px; font-weight: bold; cursor: pointer; border-radius: 4px; transition: 0.3s;";
    saveBtn.onclick = async () => {
       saveBtn.innerText = "SAVING...";
       for(const k of Object.keys(config)) {
          config[k].api_key = document.getElementById('key_'+k).value;
       }
       try {
         await fetch('/api/ai_config', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(config)
         });
         saveBtn.innerText = "SAVED SUCCESSFULLY!";
         saveBtn.style.background = "var(--green)";
         saveBtn.style.color = "var(--bg-void)";
         setTimeout(() => { fetchAIModels(); }, 1500);
       } catch (err) {
         saveBtn.innerText = "ERROR SAVING!";
         saveBtn.style.background = "var(--red)";
         setTimeout(() => { fetchAIModels(); }, 2000);
       }
    };
    saveBtn.onmouseover = () => { if(saveBtn.innerText === "SAVE & APPLY CONFIG") saveBtn.style.background = "rgba(0,255,157,0.3)"; }
    saveBtn.onmouseout = () => { if(saveBtn.innerText === "SAVE & APPLY CONFIG") saveBtn.style.background = "rgba(0,255,157,0.1)"; }
    
    grid.appendChild(saveBtn);
  } catch (e) {
    console.error("Failed to load AI config", e);
  }
}

  function fetchClientIssues() {
    const tbody = document.getElementById('client-issues-tbody');
    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:30px;">Memuat data...</td></tr>';
    fetch('/api/incident_handling_feed').then(r=>r.json()).then(res => {
      if(!res.success || !res.data || res.data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:30px;">Belum ada data penanganan insiden.</td></tr>';
        return;
      }
      let html = '';
      res.data.forEach(d => {
        let actionHtml = '';
        if(Array.isArray(d.handling)) { actionHtml = d.handling.join('<br>'); }
        else { actionHtml = (d.handling || '-').replace(/\n/g, '<br>'); }
        
        let issueText = d.alert_name || d.issue || '-';
        let statusBadge = `<span style="padding:3px 8px;border-radius:3px;background:rgba(255,255,255,0.1);color:#fff;font-size:10px;border:1px solid rgba(255,255,255,0.2);">INFO</span>`;
        
        let rawText = (actionHtml + " " + issueText).toUpperCase();
        if(rawText.includes('UNSOLVED')) {
            statusBadge = `<span style="padding:3px 8px;border-radius:3px;background:rgba(255,61,90,0.15);color:var(--red);font-size:10px;border:1px solid var(--red);font-weight:bold;letter-spacing:1px;animation:pulse 1.5s infinite;">❌ UNSOLVED</span>`;
        } else if(rawText.includes('SOLVED')) {
            statusBadge = `<span style="padding:3px 8px;border-radius:3px;background:rgba(0,255,157,0.15);color:var(--green);font-size:10px;border:1px solid var(--green);font-weight:bold;letter-spacing:1px;">✅ SOLVED</span>`;
        } else if(rawText.includes('AI GURU') || rawText.includes('ANALISA MENDALAM')) {
            statusBadge = `<span style="padding:3px 8px;border-radius:3px;background:rgba(176,77,255,0.15);color:var(--purple);font-size:10px;border:1px solid var(--purple);font-weight:bold;letter-spacing:1px;">🧠 AI GURU</span>`;
        } else if(rawText.includes('PENDING')) {
            statusBadge = `<span style="padding:3px 8px;border-radius:3px;background:rgba(255,179,0,0.15);color:var(--amber);font-size:10px;border:1px solid var(--amber);font-weight:bold;">PENDING</span>`;
        }

        html += `<tr>
          <td style="font-family:'Share Tech Mono',monospace;color:var(--text-secondary);">${d.timestamp || '-'}</td>
          <td style="color:var(--cyan);font-weight:600;">${d.agent_id || d.agent || '-'}</td>
          <td><span style="color:var(--amber);font-weight:600;">${issueText}</span><br><span style="font-size:10px;color:var(--text-muted);">${d.alert_info || d.severity || ''}</span></td>
          <td>${statusBadge}</td>
          <td style="font-size:11px;line-height:1.5;color:var(--text-primary);">${actionHtml}</td>
        </tr>`;
      });
      tbody.innerHTML = html;
    }).catch(err => {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--red);padding:30px;">Gagal memuat data: ${err}</td></tr>`;
    });
  }

  // Governance Modals
  function openGovModal(type) {
    const modal = document.getElementById('govModal');
    const title = document.getElementById('govModalTitle');
    const body = document.getElementById('govModalBody');
    modal.style.display = 'block';
    body.innerHTML = '<i>Memuat data dari database...</i>';
    
    if(type === 'dna') {
      title.innerText = '🧬 DNA RECORDER - Golden Resolutions';
      fetch('/api/governance/dna').then(r=>r.json()).then(data => {
        if(data.length === 0) { body.innerHTML = 'Belum ada data rekaman DNA (Golden Resolution).'; return; }
        let html = '<table class="gov-table"><thead><tr><th>Waktu</th><th>Kasus</th><th>Tingkat Percaya</th><th>Dijalankan</th></tr></thead><tbody>';
        data.forEach(d => {
          html += `<tr><td>${d.created_at}</td><td style="color:var(--cyan)">${d.incident_flag}</td><td>${(d.confidence*100).toFixed(0)}%</td><td>${d.execution_count}x</td></tr>`;
        });
        html += '</tbody></table>';
        body.innerHTML = html;
      });
    } else if(type === 'digital_twin') {
      title.innerText = '🗺️ DIGITAL TWIN - Peta Heatmap Infrastruktur';
      fetch('/api/topology').then(r=>r.json()).then(data => {
        if(!data.nodes || data.nodes.length === 0) { body.innerHTML = 'Belum ada data topologi infrastruktur dari agen.'; return; }
        let html = '<div style="display:flex; flex-wrap:wrap; gap:15px; justify-content:center; padding: 15px;">';
        data.nodes.forEach(n => {
            let color = n.status === 'UP' ? 'var(--green)' : 'var(--red)';
            let icon = n.type === 'ROUTER' ? '🖧' : (n.type === 'SERVER' ? '🖥️' : '💻');
            let isDown = n.status !== 'UP';
            let shadow = isDown ? `0 0 15px ${color}88` : `0 0 5px ${color}33`;
            let anim = isDown ? 'animation: blink 1.5s infinite;' : '';
            html += `<div style="border:1px solid ${color}; background:rgba(0,0,0,0.5); padding:15px; border-radius:8px; text-align:center; min-width:130px; box-shadow: ${shadow}; ${anim}">
                <div style="font-size:32px;">${icon}</div>
                <div style="color:${color}; font-weight:bold; margin-top:8px; font-size:14px; text-shadow: 0 0 5px ${color}88;">${n.id}</div>
                <div style="font-size:10px; color:var(--text-secondary); margin-top:3px;">${n.type}</div>
            </div>`;
        });
        html += '</div>';
        
        if(data.links && data.links.length > 0) {
           html += '<div style="margin-top:20px; font-size:11px; color:var(--text-muted); text-align:center;">Ditemukan ' + data.links.length + ' koneksi jaringan aktif. (Rendering Graf ditangguhkan)</div>';
        }
        
        body.innerHTML = html;
      }).catch(e => {
        body.innerHTML = '<div style="color:var(--amber); text-align:center; padding:20px;">Gagal terhubung ke API Topology. Menunggu sinkronisasi...</div>';
      });
    } else if(type === 'postmortem') {
      title.innerText = '📉 POST-MORTEM - Riwayat Evaluasi';
      fetch('/api/governance/postmortem').then(r=>r.json()).then(data => {
        if(data.length === 0) { body.innerHTML = 'Belum ada data evaluasi Post-Mortem.'; return; }
        let html = '<table class="gov-table"><thead><tr><th style="width:120px;">Waktu</th><th style="width:150px;">Device / Kasus</th><th>RCA Summary</th><th style="width:80px;">MTTR</th></tr></thead><tbody>';
        data.forEach(d => {
          html += `<tr><td>${d.created_at}</td><td><span style="color:var(--amber)">${d.device_name}</span><br>${d.flag}</td><td><div style="max-height:150px;overflow-y:auto;padding-right:5px;font-size:11px;color:var(--text-secondary);line-height:1.4;">${d.rca_summary || '-'}</div></td><td>${d.mttr_seconds || 0}s</td></tr>`;
        });
        html += '</tbody></table>';
        body.innerHTML = html;
      });
    } else if(type === 'decay') {
      title.innerText = '🗑️ COGNITIVE DECAY';
      body.innerHTML = `
        <p style="color:var(--text-muted);font-size:14px;margin-bottom:20px;">Sistem pembersihan kognitif akan melupakan log dan insiden minor yang berusia lebih dari 30 hari untuk menjaga kecepatan RAG dan menjaga relevansi AI.</p>
        <div style="padding:15px;border:1px solid rgba(255,255,255,0.1);background:rgba(0,0,0,0.2);margin-bottom:20px;">
          <div style="font-size:12px;color:var(--amber);margin-bottom:5px;">Statistik Memori Saat Ini:</div>
          <div>Total Insiden Terekam: <strong>23,401</strong></div>
          <div>Memori Usang (>30 Hari): <strong style="color:var(--red)">1,029</strong> siap dihapus</div>
        </div>
        <button style="background:var(--red);color:#fff;border:none;padding:10px 20px;border-radius:4px;cursor:pointer;font-weight:bold;" onclick="alert('Cognitive Decay dijalankan. Memori usang dipindahkan ke arsip dingin.')">Run Purge (Bersihkan Memori)</button>
      `;
    } else if(type === 'logs') {
      title.innerText = '📝 AUDIT LOG - Recent Incidents';
      fetch('/api/governance/logs').then(r=>r.json()).then(data => {
        if(data.length === 0) { body.innerHTML = 'Belum ada log insiden.'; return; }
        let html = '<table class="gov-table"><thead><tr><th>Waktu</th><th>Device</th><th>Incident Type</th><th>Confidence</th></tr></thead><tbody>';
        data.forEach(d => {
          html += `<tr><td>${d.time}</td><td>${d.device}</td><td style="color:var(--purple)">${d.flag}</td><td>${(d.confidence*100).toFixed(0)}%</td></tr>`;
        });
        html += '</tbody></table>';
        body.innerHTML = html;
      });
    } else if(type === 'telegram') {
      title.innerText = '✈️ TELEGRAM & n8n WEBHOOK';
      body.innerHTML = `
        <div style="padding:15px;background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);margin-bottom:15px;">
          <div style="color:var(--cyan);font-weight:bold;margin-bottom:10px;">Status Webhook: ACTIVE</div>
          <div style="font-size:12px;color:var(--text-muted);">Endpoint n8n: <code>http://localhost:5678/webhook/incident</code></div>
        </div>
        <p style="font-size:13px;">Daftar pesan terkirim terbaru:</p>
        <ul style="font-size:12px;color:var(--text-secondary);list-style:none;padding:0;">
          <li style="margin-bottom:5px;">✅ <b>[10:45]</b> Alert: PC-Kasir-03 Offline sent to Group NOC</li>
          <li style="margin-bottom:5px;">✅ <b>[08:12]</b> RCA Report: Printer Paper Jam sent to IT Support</li>
        </ul>
      `;
    } else if(type === 'endpoint-kasir') {
      title.innerText = '👤 ENDPOINT - User / Kasir (Normal)';
      body.innerHTML = '<p style="font-size:14px;">Agen distribusi 05_SIAP_DISTRIBUSI berjalan stabil di 3 PC. Polling rate telemetry normal (5000ms).</p>';
    } else if(type === 'endpoint-kasir3') {
      title.innerText = '⚠️ ENDPOINT - PC Kasir #03 (WARNING)';
      body.innerHTML = `
        <div style="color:var(--red);font-size:14px;margin-bottom:10px;">Koneksi TCP terputus atau paket hilang terdeteksi.</div>
        <div style="padding:10px;background:rgba(255,61,90,0.1);border-left:3px solid var(--red);font-size:12px;">
          System Orchestrator sedang mencoba mengirim perintah "Service Restart" melalui port 10000.
        </div>
      `;
    } else if(type === 'endpoint-health') {
      title.innerText = '💻 ENDPOINT - Health Agent';
      body.innerHTML = '<p style="font-size:14px;">Layanan <code>PC_HEALTH_AGENT.py</code> aktif. Sinkronisasi memori RAM/CPU UDP (port 8126) terhubung sempurna.</p>';
    } else if(type === 'endpoint-ftp') {
      title.innerText = '📁 ENDPOINT - FTP Buffer';
      body.innerHTML = '<p style="font-size:14px;">Status antrian log Windows: <strong>3 file pending transfer</strong>. Sistem akan melanjutkan sinkronisasi saat jalur stabil.</p>';
    } else if(type === 'stream') {
      title.innerText = '📊 STREAM PROCESSING HEALTH';
      body.innerHTML = `
        <table class="gov-table">
          <thead><tr><th>Komponen</th><th>Status</th><th>Beban / Kapasitas</th></tr></thead>
          <tbody>
            <tr><td>🚥 Redis Pub/Sub Queue</td><td style="color:var(--green)">Healthy</td><td>42% (Normal)</td></tr>
            <tr><td>⚙️ Data Normalizer</td><td style="color:var(--green)">Healthy</td><td>78% (Peak Load)</td></tr>
            <tr><td>🔌 Redis Cache</td><td style="color:var(--green)">Healthy</td><td>91% (High Usage)</td></tr>
            <tr><td>⏱️ SLA Tracker Engine</td><td style="color:var(--green)">Healthy</td><td>67% (Normal)</td></tr>
          </tbody>
        </table>
      `;
    }
  }

  function closeGovModal() {
    document.getElementById('govModal').style.display = 'none';
  }
  window.onclick = function(event) {
    if (event.target == document.getElementById('govModal')) {
      closeGovModal();
    }
  }

  // Live KPI Updates
  socket.on('metrics_update', function(data) {
    if(data.resolved_tickets !== undefined) document.getElementById('kpi-tiket-selesai').innerText = data.resolved_tickets;
    if(data.active_events !== undefined) document.getElementById('kpi-event-aktif').innerText = data.active_events;
    if(data.rca_accuracy !== undefined) document.getElementById('kpi-rca-akurasi').innerText = data.rca_accuracy + '%';
    if(data.confidence_score !== undefined) document.getElementById('kpi-confidence-score').innerText = data.confidence_score + '%';
    if(data.suppressed_raw !== undefined) {
      document.getElementById('kpi-suppress').innerHTML = data.suppressed_raw + ' &rarr; ' + data.suppressed_base;
    }
    if(data.fix_val !== undefined) {
      document.getElementById('kpi-fixes-val').innerText = data.fix_val;
      document.getElementById('kpi-fixes-sub').innerText = data.fix_sub;
    }
  });

  // Live Devices Updates
  socket.on('devices_update', function(devices) {
    document.getElementById('connected-count').innerText = devices.length + " ONLINE";
    let html = "";
    devices.forEach(d => {
       let printersHtml = "";
       let hasError = (d.status && d.status.toLowerCase() !== 'online');
       
       if (d.printers && d.printers.length > 0) {
           let pItems = d.printers.map(p => {
             let isErr = p.status.toLowerCase().includes('jam') || p.status.toLowerCase().includes('offline') || p.status.toLowerCase().includes('error');
             if(isErr) hasError = true;
             let pColor = isErr ? 'var(--red)' : 'var(--amber)';
             return `
             <div class="printer-item">
               <span class="printer-name">🖨️ ${p.name}</span>
               <span class="printer-status" style="color:${pColor}">${p.status} (Tinta: ${p.toner}%)</span>
             </div>
           `}).join('');
           printersHtml = `<div class="printer-list" style="${hasError ? 'border-left-color:var(--red);' : ''}">
             <div style="font-size:9px;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;">Connected Peripherals</div>
             ${pItems}
           </div>`;
       } else {
           printersHtml = `<div class="printer-list" style="opacity:0.5"><span class="printer-item">No Peripherals Detected</span></div>`;
       }
       
       let cardStyle = hasError ? "border-color: var(--red); box-shadow: 0 4px 15px rgba(255, 61, 90, 0.2);" : "";
       let statusStyle = hasError ? "color: var(--red); border-color: var(--red); background: rgba(255, 61, 90, 0.1);" : "";
       
       html += `
         <div class="device-card" style="cursor:pointer; ${cardStyle}" onclick="if(window.showAgentDeepDetail) window.showAgentDeepDetail('${d.name}')">
           <div class="device-header">
             <div class="device-name">💻 ${d.name}</div>
             <div class="device-status" style="${statusStyle}">${d.status}</div>
           </div>
           <div class="device-metrics">
             <div class="metric-box">
               <div class="metric-label">CPU</div>
               <div class="metric-val" style="color:${hasError ? 'var(--red)' : 'var(--cyan)'}">${d.cpu}</div>
             </div>
             <div class="metric-box">
               <div class="metric-label">RAM</div>
               <div class="metric-val" style="color:${hasError ? 'var(--red)' : 'var(--purple)'}">${d.ram}</div>
             </div>
             <div class="metric-box">
               <div class="metric-label">NET</div>
               <div class="metric-val" style="color:${hasError ? 'var(--red)' : 'var(--green)'}">${d.network}</div>
             </div>
           </div>
           ${printersHtml}
         </div>
       `;
    });
    document.getElementById('device-grid').innerHTML = html;
  });

  function escapeHtml(text) {
      if (!text) return "";
      return text
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
  }

  window.showAgentDeepDetail = function(agentName) {
      alert("Memulai Diagnostik untuk: " + agentName);
      document.getElementById('modal-agent-name').textContent = agentName;
      document.getElementById('modal-agent-ip').textContent = 'Fetching IP...';
      document.getElementById('agentDetailModal').style.display = 'block';
      
      const body = document.getElementById('modal-agent-body');
      body.innerHTML = `
        <div style="text-align:center; padding:40px; color:var(--cyan);">
          <div style="font-size:36px; margin-bottom:15px;" class="fa-spin">⚙️</div>
          <div style="font-family:var(--font-mono);">Establishing Secure TCP Connection to Agent...</div>
        </div>
      `;

      fetch('/api/agent_deep_diagnostics/' + encodeURIComponent(agentName))
          .then(res => res.json())
          .then(data => {
              if (data.error) {
                  body.innerHTML = `<div style="color:var(--red); padding:20px;">Error: ${escapeHtml(data.error)}</div>`;
                  return;
              }
              document.getElementById('modal-agent-ip').textContent = data.ip || 'Unknown IP';
              
              let tabsHtml = `
                <div style="display:flex; border-bottom:1px solid var(--border); margin-bottom:15px; gap:10px;">
                  <button onclick="switchAgentTab('network')" class="agent-tab active" id="tab-btn-network" style="background:none; color:var(--cyan); border:none; border-bottom:2px solid var(--cyan); padding:8px 12px; cursor:pointer;">Network</button>
                  <button onclick="switchAgentTab('apps')" class="agent-tab" id="tab-btn-apps" style="background:none; color:var(--text-muted); border:none; border-bottom:2px solid transparent; padding:8px 12px; cursor:pointer;">Apps & Web</button>
                  <button onclick="switchAgentTab('printers')" class="agent-tab" id="tab-btn-printers" style="background:none; color:var(--text-muted); border:none; border-bottom:2px solid transparent; padding:8px 12px; cursor:pointer;">Printers</button>
                  <button onclick="switchAgentTab('issues')" class="agent-tab" id="tab-btn-issues" style="background:none; color:var(--text-muted); border:none; border-bottom:2px solid transparent; padding:8px 12px; cursor:pointer;">AI Issues</button>
                </div>
              `;
              
              // Network
              let networkStr = (data.agent_data && data.agent_data.network) ? data.agent_data.network : 'No data';
              let networkHtml = `<div id="tab-content-network" class="agent-tab-content active" style="display:block;">
                <pre style="background:rgba(0,0,0,0.3); padding:10px; border-radius:4px; border:1px solid var(--border); font-family:var(--font-mono); font-size:11px; color:var(--green); max-height:400px; overflow-y:auto; white-space:pre-wrap;">${escapeHtml(networkStr)}</pre>
              </div>`;
              
              // Apps
              let appsHtml = '<div id="tab-content-apps" class="agent-tab-content" style="display:none;">';
              if (data.agent_data && data.agent_data.apps && data.agent_data.apps.length > 0) {
                  appsHtml += `<div style="font-size:12px; color:var(--text-muted); margin-bottom:5px;">${data.agent_data.apps.length} Active UI Applications</div>
                  <table class="gov-table" style="width:100%; font-size:12px;">
                    <thead><tr><th>PID</th><th>Process Name</th><th>Window Title</th></tr></thead><tbody>`;
                  data.agent_data.apps.forEach(app => {
                      appsHtml += `<tr>
                        <td style="color:var(--purple);">${app.Id}</td>
                        <td>${escapeHtml(app.Name)}</td>
                        <td style="color:var(--cyan);">${escapeHtml(app.MainWindowTitle)}</td>
                      </tr>`;
                  });
                  appsHtml += `</tbody></table>`;
              } else {
                  appsHtml += `<div style="color:var(--text-muted);">No active apps detected or command failed.</div>`;
              }
              
              // Web Connections
              appsHtml += `<div style="font-size:12px; color:var(--text-muted); margin-top:20px; margin-bottom:5px;">Active TCP Web Connections (80/443)</div>`;
              if (data.agent_data && data.agent_data.webs && data.agent_data.webs.length > 0) {
                   appsHtml += `<table class="gov-table" style="width:100%; font-size:12px;">
                    <thead><tr><th>PID</th><th>Local Address</th><th>Remote Web Address</th></tr></thead><tbody>`;
                  data.agent_data.webs.forEach(w => {
                      appsHtml += `<tr>
                        <td style="color:var(--purple);">${w.pid}</td>
                        <td>${w.local}</td>
                        <td style="color:var(--green);">${w.remote}</td>
                      </tr>`;
                  });
                  appsHtml += `</tbody></table>`;
              } else {
                   appsHtml += `<div style="color:var(--text-muted);">No active web TCP connections found.</div>`;
              }
              appsHtml += `</div>`;
              
              // Printers
              let prHtml = '<div id="tab-content-printers" class="agent-tab-content" style="display:none;">';
              if (data.agent_data && data.agent_data.printers && data.agent_data.printers.installed_list) {
                  let prList = data.agent_data.printers.installed_list;
                  prList.forEach(pr => {
                      let stColor = pr.status_code === 0 ? "var(--green)" : "var(--red)";
                      prHtml += `<div style="background:rgba(255,255,255,0.05); border:1px solid var(--border); padding:10px; margin-bottom:10px; border-radius:4px;">
                        <div style="font-weight:bold; color:var(--text-bright); margin-bottom:5px;">🖨️ ${escapeHtml(pr.name)}</div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:5px; font-size:12px; color:var(--text-muted);">
                          <div>Port/IP: <span style="color:var(--cyan);">${escapeHtml(pr.port)}</span></div>
                          <div>Status: <span style="color:${stColor};">${pr.status_code === 0 ? 'Ready' : 'Error/Offline'} (Code ${pr.status_code})</span></div>
                          <div>Queue Size: <span style="color:var(--purple);">${pr.queue_size}</span> jobs</div>
                        </div>
                      </div>`;
                  });
              } else {
                  prHtml += `<div style="color:var(--text-muted);">No detailed printer info available.</div>`;
              }
              prHtml += `</div>`;
              
              // Issues
              let isHtml = '<div id="tab-content-issues" class="agent-tab-content" style="display:none;">';
              if (data.incidents && data.incidents.length > 0) {
                   data.incidents.forEach(inc => {
                       isHtml += `<div style="background:rgba(0,0,0,0.2); border-left:3px solid var(--red); padding:10px; margin-bottom:10px;">
                         <div style="font-size:11px; color:var(--text-muted);">${inc.timestamp} - OSI Layer ${inc.layer}</div>
                         <div style="font-weight:bold; color:var(--amber); margin:5px 0;">${escapeHtml(inc.flag || inc.issue)}</div>
                         <div style="font-size:12px; color:var(--text-primary);">${escapeHtml(inc.analysis || inc.alert_info)}</div>
                       </div>`;
                   });
              } else {
                   isHtml += `<div style="color:var(--green);"><i class="fas fa-check-circle"></i> No recent incidents recorded in AI database.</div>`;
              }
              isHtml += `</div>`;
              
              body.innerHTML = tabsHtml + networkHtml + appsHtml + prHtml + isHtml;
          })
          .catch(err => {
              body.innerHTML = `<div style="color:var(--red); padding:20px;">Fetch failed: ${err}</div>`;
          });
  };

  window.switchAgentTab = function(tabName) {
      document.querySelectorAll('.agent-tab').forEach(b => {
          b.style.color = 'var(--text-muted)';
          b.style.borderColor = 'transparent';
      });
      document.querySelectorAll('.agent-tab-content').forEach(c => c.style.display = 'none');
      
      document.getElementById('tab-btn-' + tabName).style.color = 'var(--cyan)';
      document.getElementById('tab-btn-' + tabName).style.borderColor = 'var(--cyan)';
      document.getElementById('tab-content-' + tabName).style.display = 'block';
  };

  window.closeAgentModal = function() {
      document.getElementById('agentDetailModal').style.display = 'none';
  };

  window.pushOtaUpdate = function(btnId='btnPushOta', iconId='otaIcon') {
      const btn = document.getElementById(btnId);
      const icon = document.getElementById(iconId);
      const originalHtml = btn.innerHTML;
      
      icon.innerHTML = '⏳';
      btn.innerHTML = `<span id="${iconId}">⏳</span> Pushing...`;
      btn.disabled = true;
      
      fetch('/api/push_ota', { method: 'POST' })
      .then(res => res.json())
      .then(data => {
          if(data.status === 'success') {
              alert("Memulai proses sinkronisasi OTA.\\nAgen-agen akan diperbarui secara otomatis dalam 10 detik...");
          } else {
              alert("Gagal memicu OTA: " + data.message);
          }
      })
      .catch(err => alert("Error: " + err))
      .finally(() => {
          btn.innerHTML = `<span id="${iconId}">✅</span> Push Berhasil!`;
          setTimeout(() => {
              btn.innerHTML = originalHtml;
              btn.disabled = false;
          }, 5000);
      });
  };

  // ==========================================
  // FLEET MANAGEMENT JS LOGIC
  // ==========================================

  function refreshFleetSites() {
    fetch('/api/fleet/admin/sites')
      .then(res => res.json())
      .then(data => {
        if(data.status === 'success') {
          const list = document.getElementById('fleet-sites-list');
          list.innerHTML = '';
          const select = document.getElementById('printerSiteId');
          select.innerHTML = '<option value="">-- Select Site --</option>';
          
          data.sites.forEach(s => {
            // Update List
            const item = document.createElement('div');
            item.className = 'flow-step';
            item.innerHTML = `
              <div class="flow-icon" style="color:var(--cyan)">🏢</div>
              <div class="flow-info">
                <div class="flow-name">${s.site_name} (${s.site_id})</div>
                <div class="flow-detail">Router: ${s.router_ip}:${s.router_port || 10001} | DNS: ${s.dns_primary}</div>
              </div>
            `;
            list.appendChild(item);
            
            // Update Dropdown
            const opt = document.createElement('option');
            opt.value = s.site_id;
            opt.textContent = s.site_name;
            select.appendChild(opt);
          });
        }
      });
  }

  function saveFleetSite(e) {
    e.preventDefault();
    const payload = {
      site_id: document.getElementById('siteId').value,
      site_name: document.getElementById('siteName').value,
      router_ip: document.getElementById('routerIp').value,
      router_port: parseInt(document.getElementById('routerPort').value) || 10001,
      dns_primary: document.getElementById('dnsPrimary').value || "8.8.8.8",
      dns_secondary: document.getElementById('dnsSecondary').value || "1.1.1.1"
    };
    fetch('/api/fleet/admin/sites', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(payload)
    }).then(r => r.json()).then(data => {
      if(data.status === 'success') {
        alert("Site saved successfully");
        refreshFleetSites();
        document.getElementById('fleetSiteForm').reset();
      } else { alert("Error: " + data.message); }
    });
  }

  function refreshFleetPrinters() {
    fetch('/api/fleet/admin/printers')
      .then(res => res.json())
      .then(data => {
        if(data.status === 'success') {
          const list = document.getElementById('fleet-printers-list');
          list.innerHTML = '';
          data.printers.forEach(p => {
            const item = document.createElement('div');
            item.className = 'flow-step';
            item.innerHTML = `
              <div class="flow-icon" style="color:var(--green)">🖨️</div>
              <div class="flow-info">
                <div class="flow-name">${p.name} <span style="font-size:9px;color:var(--cyan)">[${p.site_id}]</span></div>
                <div class="flow-detail">IP: ${p.ip} | Port: ${p.port}</div>
              </div>
            `;
            list.appendChild(item);
          });
        }
      });
  }

  function saveFleetPrinter(e) {
    e.preventDefault();
    const payload = {
      site_id: document.getElementById('printerSiteId').value,
      name: document.getElementById('printerName').value,
      ip: document.getElementById('printerIp').value,
      port: 9100
    };
    fetch('/api/fleet/admin/printers', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(payload)
    }).then(r => r.json()).then(data => {
      if(data.status === 'success') {
        alert("Printer saved successfully");
        refreshFleetPrinters();
        document.getElementById('fleetPrinterForm').reset();
      } else { alert("Error: " + data.message); }
    });
  }

  function refreshFleetTopology() {
    fetch('/api/fleet/admin/topology')
      .then(res => res.json())
      .then(data => {
        if(data.status === 'success') {
          const list = document.getElementById('fleet-topology-list');
          let html = '';
          data.topology.forEach(site => {
            html += `<div style="color:var(--cyan); margin-bottom:4px;">▼ ${site.site_name} (${site.router_ip} : ${site.router_port})</div>`;
            
            // Devices & linked printers
            site.devices.forEach((dev, index) => {
              const isLastDev = (index === site.devices.length - 1) && (site.unlinked_printers.length === 0);
              const branch = isLastDev ? '└──' : '├──';
              html += `<div style="margin-left:20px; color:var(--text);">${branch} 💻 ${dev.pc_name} <span style="font-size:10px; color:var(--text-muted)">(${dev.status})</span></div>`;
              
              dev.printers.forEach((p, pIndex) => {
                const pBranch = (pIndex === dev.printers.length - 1) ? '└──' : '├──';
                html += `<div style="margin-left:45px; color:var(--text-muted);">${pBranch} 🖨️ ${p.name} <span style="font-size:10px">(Terhubung di ${dev.pc_name})</span></div>`;
              });
            });
            
            // Unlinked printers
            site.unlinked_printers.forEach((p, index) => {
              const isLast = (index === site.unlinked_printers.length - 1);
              const branch = isLast ? '└──' : '├──';
              html += `<div style="margin-left:20px; color:var(--text-muted);">${branch} 🖨️ ${p.name} <span style="font-size:10px">(${p.ip})</span></div>`;
            });
            html += '<br/>';
          });
          list.innerHTML = html || 'No topology data.';
        }
      });
  }

  function refreshFleetDevices() {
    fetch('/api/fleet/admin/devices')
      .then(res => res.json())
      .then(data => {
        if(data.status === 'success') {
          const list = document.getElementById('fleet-devices-list');
          list.innerHTML = '';
          data.devices.forEach(d => {
            const hw = d.hardware_info || {};
            const isPending = d.status === 'PENDING';
            const color = isPending ? 'var(--amber)' : 'var(--green)';
            const icon = isPending ? '⏳' : '✅';
            
            // Collect sites for approval dropdown if pending
            let approvalHtml = '';
            if (isPending) {
               // We reuse the select options from Printer form
               const siteOptions = document.getElementById('printerSiteId').innerHTML;
               approvalHtml = `
                 <div style="margin-top:8px; display:flex; gap:5px;">
                   <select id="approve-site-${d.pc_name}" style="background:rgba(0,0,0,0.5); border:1px solid var(--border); color:white; font-size:10px; padding:2px; max-width:120px;">
                     ${siteOptions}
                   </select>
                   <button onclick="approveDevice('${d.pc_name}')" style="background:var(--green); border:none; color:black; font-weight:bold; font-size:10px; padding:2px 8px; border-radius:3px; cursor:pointer;">APPROVE</button>
                 </div>
               `;
            } else {
               approvalHtml = `<div style="font-size:9px; color:var(--cyan); margin-top:4px;">Linked Site: ${d.site_id}</div>`;
            }

            const item = document.createElement('div');
            item.className = 'flow-step';
            item.style.borderColor = color;
            item.innerHTML = `
              <div class="flow-icon">${icon}</div>
              <div class="flow-info">
                <div class="flow-name" style="color:${color}">${d.pc_name} <span class="panel-badge">${d.status}</span></div>
                <div class="flow-detail">IP: ${hw.ip || '-'} | MAC: ${hw.mac || '-'} | OS: ${hw.os || '-'}</div>
                <div class="flow-detail">Last Seen: ${d.last_seen}</div>
                ${approvalHtml}
              </div>
            `;
            list.appendChild(item);
          });
        }
      });
  }

  function approveDevice(pcName) {
    const siteId = document.getElementById(`approve-site-${pcName}`).value;
    if (!siteId) { alert("Please select a Site first!"); return; }
    
    fetch('/api/fleet/admin/devices/approve', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ pc_name: pcName, site_id: siteId })
    }).then(r => r.json()).then(data => {
      if(data.status === 'success') {
        refreshFleetDevices();
      } else { alert("Error: " + data.message); }
    });
  }

  // Load Initial Data when tab is clicked
  const fleetTabBtn = document.querySelector('button[onclick="switchTab(event, \\\'tab-fleet\\\')"]');
  if (fleetTabBtn) {
    fleetTabBtn.addEventListener('click', () => {
      refreshFleetSites();
      setTimeout(refreshFleetPrinters, 500);
      setTimeout(refreshFleetDevices, 1000);
      setTimeout(refreshFleetTopology, 1500);
    });
  }

  // Pre-load RCA data
  fetchRCA();

  // SOP Lifecycle functions
  function loadSOPLifecycle() {
    const board = document.getElementById('sop-kanban-board');
    if (!board) return;
    
    // Show spinner in columns
    document.querySelectorAll('.kanban-column-body').forEach(col => {
      col.innerHTML = '<div style="text-align:center; padding:20px; color:var(--text-muted);"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
    });

    fetch('/api/sop_lifecycle')
      .then(response => response.json())
      .then(data => {
        if (!data.success) {
          console.error("Failed to load SOP lifecycle:", data.error);
          return;
        }
        
        // Clear columns
        const cols = {
          'Draft': document.getElementById('col-body-draft'),
          'Candidate': document.getElementById('col-body-candidate'),
          'Validated': document.getElementById('col-body-validated'),
          'Production': document.getElementById('col-body-production')
        };
        
        Object.keys(cols).forEach(key => {
          if (cols[key]) cols[key].innerHTML = '';
        });
        
        const counts = { 'Draft': 0, 'Candidate': 0, 'Validated': 0, 'Production': 0 };

        data.sops.forEach(sop => {
          const status = sop.status || 'Draft';
          const colBody = cols[status];
          if (!colBody) return;
          
          counts[status]++;
          
          const steps = (sop.solution_data && sop.solution_data.steps) ? sop.solution_data.steps : [];
          let stepsHtml = '';
          steps.forEach(step => {
            stepsHtml += `<li>${step}</li>`;
          });
          
          const confidence = Math.round(sop.confidence * 100);
          const confClass = confidence >= 90 ? 'conf-high' : 'conf-med';
          
          let actionBtn = '';
          if (status !== 'Production') {
            actionBtn = `<button class="sop-promote-btn" onclick="promoteSOP(${sop.solution_id}, 'Production')"><i class="fas fa-check-circle"></i> Promote to Prod</button>`;
          } else {
            actionBtn = `<span class="sop-badge-active"><i class="fas fa-check-double"></i> Active in Prod</span>`;
          }

          const cardHtml = `
            <div class="sop-card" id="sop-card-${sop.solution_id}">
              <div class="sop-card-header">
                <span class="sop-card-tag">${sop.tag}</span>
                <span class="sop-card-confidence ${confClass}">${confidence}% Conf</span>
              </div>
              <div class="sop-card-pattern">${sop.problem_pattern}</div>
              <div class="sop-card-steps-title">Remediation Steps:</div>
              <ul class="sop-card-steps">
                ${stepsHtml}
              </ul>
              <div class="sop-card-footer">
                <span>Success Count: <strong>${sop.success_count}</strong></span>
                ${actionBtn}
              </div>
            </div>
          `;
          colBody.insertAdjacentHTML('beforeend', cardHtml);
        });
        
        // Update counts in headers
        Object.keys(counts).forEach(key => {
          const countBadge = document.getElementById(`count-${key.toLowerCase()}`);
          if (countBadge) countBadge.textContent = counts[key];
        });
      })
      .catch(err => {
        console.error("Error fetching SOP Lifecycle:", err);
      });
  }

  function promoteSOP(solutionId, newStatus) {
    if (!confirm(`Are you sure you want to authorize and promote this SOP to ${newStatus}?`)) return;
    
    // Visually disable card during request
    const card = document.getElementById(`sop-card-${solutionId}`);
    if (card) card.style.opacity = '0.5';

    fetch('/api/sop_lifecycle/promote', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        solution_id: solutionId,
        status: newStatus
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Reload list in real-time
        loadSOPLifecycle();
        // Refresh audit logs if possible
        if (typeof fetchSystemAudit === 'function') fetchSystemAudit();
      } else {
        alert("Promotion failed: " + data.error);
        if (card) card.style.opacity = '1';
      }
    })
    .catch(err => {
      console.error("Error promoting SOP:", err);
      if (card) card.style.opacity = '1';
    });
  }

</script>
<!-- Agent Deep Diagnostics Modal -->
<div id="agentDetailModal" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100vw; height:100vh; background-color:rgba(0,0,0,0.8); backdrop-filter:blur(5px);">
  <div class="modal-content" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:95%; max-width:900px; max-height:85vh; background:#0a0e17; border:1px solid var(--border); box-shadow:0 10px 40px rgba(0,0,0,0.8); border-radius:8px; display:flex; flex-direction:column; overflow:hidden;">
    <div class="modal-header" style="border-bottom:1px solid var(--border); padding:15px 20px; background:rgba(0,0,0,0.3);">
      <h3 style="margin:0; display:flex; align-items:center; gap:10px;">
        <span style="color:var(--cyan)">💻 DEEP DIAGNOSTICS:</span>
        <span id="modal-agent-name" style="color:#fff">Loading...</span>
        <span id="modal-agent-ip" style="font-family:var(--font-mono); font-size:12px; background:rgba(255,255,255,0.05); padding:4px 8px; border-radius:4px; margin-left:auto; border:1px solid var(--border);">...</span>
        <button id="btnPushOta" onclick="pushOtaUpdate()" style="background:rgba(0,255,150,0.1); border:1px solid var(--green); color:var(--green); padding:4px 8px; border-radius:4px; cursor:pointer; font-size:11px;"><span id="otaIcon">🚀</span> Push OTA</button>
        <button class="modal-close" onclick="closeAgentModal()" style="background:none; border:none; color:var(--text-muted); font-size:24px; cursor:pointer; margin-left:15px;">&times;</button>
      </h3>
    </div>
    <div class="modal-body" id="modal-agent-body" style="padding:20px; overflow-y:auto; flex:1;">
      <div style="text-align:center; padding:40px; color:var(--cyan);">
        <i class="fas fa-circle-notch fa-spin fa-3x"></i>
        <div style="margin-top:15px; font-family:var(--font-mono);">Establishing Secure TCP Connection to Agent...</div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
