  </div><!-- /sidebar -->

  <!-- ========== CONTENT ========== -->
  <div class="content">
    <div class="topbar">
      <button class="tb-toggle" onclick="toggleSidebar()" title="Toggle Sidebar"><i class="fa-solid fa-bars"></i></button>
      <div class="topbar-title">
        <span id="topbar-title"><i class="fa-solid fa-chart-simple" style="color:var(--blue);margin-right:8px"></i> Overview</span>
        <span class="sub" id="topbar-sub">— NOC IT AI Command Center</span>
      </div>
      <div class="topbar-right">
        <div class="ws-indicator ws-connecting" id="ws-pill" onclick="DataService.reconnect()">
          <div class="dot dot-orange" id="ws-dot"></div>
          <span id="ws-txt">Connecting...</span>
        </div>
        <div class="live-pill">
          <div class="dot dot-green"></div>
          <span id="clock-txt">--:--:--</span>
        </div>
        <button class="tb-btn always-show" onclick="Notify.critical('🚨 TEST ALERT','Ini adalah test critical alert dari NOC Dashboard.')" title="Test Alert"><i class="fa-solid fa-bell"></i><span id="alert-count" class="badge bd-rd ms-1">—</span></button>
        <button class="tb-btn primary always-show" onclick="DataService.refreshAll()"><i class="fa-solid fa-rotate" style="margin-right:6px"></i> Refresh</button>
        <button class="tb-btn" onclick="Nav.go('logs',document.querySelector('[data-panel=logs]'))"><i class="fa-solid fa-terminal" style="margin-right:6px"></i> Logs</button>
        <button class="tb-btn" onclick="Nav.go('models',document.querySelector('[data-panel=models]'))" title="Model Config & Settings"><i class="fa-solid fa-gears" style="margin-right:6px"></i> Config</button>
      </div>
    </div>

    <!-- ========== MAIN PANELS ========== -->
    <div class="main" id="main-content">

<!-- ============================================================
     PANEL: OVERVIEW
============================================================ -->
<div id="p-overview" class="panel active">
  <div class="kpi-row kpi-row-4">
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></i><div class="kpi-label">Device Online</div><div class="kpi-val" id="kpi-online">—</div><div class="kpi-sub"><span class="kpi-trend-up">↑</span> <span id="kpi-online-s">dari total fleet</span></div></div>
    <div class="kpi-card kpi-rd"><i class="kpi-icon"><i class="fa-solid fa-triangle-exclamation" style="color:var(--red)"></i></i><div class="kpi-label">Insiden Aktif</div><div class="kpi-val" id="kpi-incidents" style="color:var(--red2)">—</div><div class="kpi-sub kpi-trend-dn" id="kpi-incidents-s">memuat...</div></div>
    <div class="kpi-card kpi-or"><i class="kpi-icon"><i class="fa-solid fa-hourglass-half" style="color:var(--orange)"></i></i><div class="kpi-label">Health Score</div><div class="kpi-val" id="kpi-health">—</div><div class="kpi-sub" id="kpi-health-s">SystemAuditor v2.2</div></div>
    <div class="kpi-card kpi-pu"><i class="kpi-icon"><i class="fa-solid fa-tower-broadcast" style="color:var(--purple)"></i></i><div class="kpi-label">Device Terdaftar</div><div class="kpi-val" id="kpi-total">—</div><div class="kpi-sub kpi-trend-up" id="kpi-total-s">total fleet</div></div>
  </div>
  <div class="kpi-row kpi-row-4">
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-clock-history" style="color:var(--cyan)"></i></i><div class="kpi-label">MTTR</div><div class="kpi-val" id="kpi-mttr">—</div><div class="kpi-sub">Mean Time To Resolve</div></div>
    <div class="kpi-card kpi-bl"><i class="kpi-icon"><i class="fa-solid fa-signal" style="color:var(--blue)"></i></i><div class="kpi-label">Availability</div><div class="kpi-val" id="kpi-avail">—</div><div class="kpi-sub kpi-trend-up">Uptime periode ini</div></div>
    <div class="kpi-card kpi-pk"><i class="kpi-icon"><i class="fa-solid fa-robot" style="color:var(--pink)"></i></i><div class="kpi-label">AI Confidence</div><div class="kpi-val" id="kpi-aiconf">—</div><div class="kpi-sub">Avg model accuracy</div></div>
    <div class="kpi-card kpi-or"><i class="kpi-icon"><i class="fa-solid fa-ticket" style="color:var(--orange)"></i></i><div class="kpi-label">Ticket Hari Ini</div><div class="kpi-val" id="kpi-ticket">—</div><div class="kpi-sub">Open incidents</div></div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-triangle-exclamation" style="color:var(--red);margin-right:8px"></i>Insiden Aktif (Live)</h3><span class="tag tag-red" id="ov-inc-tag">0 aktif</span></div>
      <div class="card-body" id="ov-incidents-list" style="max-height:220px;overflow-y:auto"><div class="skeleton" style="height:14px;margin:4px 0"></div><div class="skeleton" style="height:14px;margin:4px 0;width:80%"></div><div class="skeleton" style="height:14px;margin:4px 0;width:90%"></div></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-bolt" style="color:var(--orange);margin-right:8px"></i>Status Komponen Pipeline</h3><span class="tag tag-gray" id="ov-pipeline-tag">—</span></div>
      <div class="card-body" id="ov-pipeline-list"><div class="skeleton"></div><div class="skeleton" style="width:70%"></div><div class="skeleton" style="width:85%"></div></div>
    </div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-line" style="color:var(--blue);margin-right:8px"></i>Trend Insiden (24 Jam)</h3><span class="tag tag-blue">Auto-update</span></div>
      <div class="card-body"><div class="chart-box"><canvas id="chart-incident-trend"></canvas></div></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-globe" style="color:var(--cyan);margin-right:8px"></i>Distribusi Device per Layer OSI</h3></div>
      <div class="card-body"><div class="chart-box"><canvas id="chart-layer-dist"></canvas></div></div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: MONITORING LIVE
============================================================ -->
<div id="p-monitoring" class="panel">
  <div class="kpi-row kpi-row-4">
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-tower-broadcast" style="color:var(--green)"></i></i><div class="kpi-label">Latency Avg</div><div class="kpi-val" id="mon-latency">—</div><div class="kpi-sub">ms network round-trip</div></div>
    <div class="kpi-card kpi-or"><i class="kpi-icon"><i class="fa-solid fa-chart-line" style="color:var(--orange)"></i></i><div class="kpi-label">Packet Loss</div><div class="kpi-val" id="mon-pktloss">—</div><div class="kpi-sub">% avg seluruh site</div></div>
    <div class="kpi-card kpi-bl"><i class="kpi-icon"><i class="fa-solid fa-bolt" style="color:var(--blue)"></i></i><div class="kpi-label">Response Time</div><div class="kpi-val" id="mon-resptime">—</div><div class="kpi-sub">ms DB round-trip</div></div>
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-temperature-half" style="color:var(--cyan)"></i></i><div class="kpi-label">Avg CPU Server</div><div class="kpi-val" id="mon-cpu">—</div><div class="kpi-sub">Host server</div></div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-line" style="color:var(--blue);margin-right:8px"></i>Network Latency — Real-time</h3><button class="btn btn-ghost btn-sm" onclick="Charts.resetZoom('chart-latency')">Reset Zoom</button></div>
      <div class="card-body"><div class="chart-box"><canvas id="chart-latency" style="max-height:160px"></canvas></div></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-hard-drive" style="color:var(--blue);margin-right:8px"></i>CPU/RAM/Disk — Server Host</h3><span class="tag tag-blue">Live</span></div>
      <div class="card-body" id="mon-sysres">
        <div class="pb-wrap"><div class="pb-label"><span>CPU</span><span id="mon-cpu-pct">—%</span></div><div class="pb"><div class="pb-fill pb-blue" id="mon-cpu-bar" style="width:0%"></div></div></div>
        <div class="pb-wrap"><div class="pb-label"><span>RAM</span><span id="mon-ram-pct">—%</span></div><div class="pb"><div class="pb-fill pb-purple" id="mon-ram-bar" style="width:0%"></div></div></div>
        <div class="pb-wrap"><div class="pb-label"><span>Disk</span><span id="mon-disk-pct">—%</span></div><div class="pb"><div class="pb-fill pb-orange" id="mon-disk-bar" style="width:0%"></div></div></div>
        <div class="pb-wrap"><div class="pb-label"><span>Packet Loss</span><span id="mon-pl-pct">—%</span></div><div class="pb"><div class="pb-fill pb-red" id="mon-pl-bar" style="width:0%"></div></div></div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3><i class="fa-solid fa-globe" style="color:var(--cyan);margin-right:8px"></i>Status Koneksi per Site</h3><button class="btn btn-primary btn-sm" onclick="DataService.pingAllSites()"><i class="fa-solid fa-rotate" style="margin-right:6px"></i> Ping All</button></div>
    <div class="card-body" id="site-status-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px"><div class="empty-state"><div class="es-icon"><i class="fa-solid fa-globe"></i></div><div class="es-text">Klik Ping All untuk memeriksa semua site</div></div></div>
  </div>
</div>

<!-- ============================================================
     PANEL: USER ACTIVITY & ISSUES (NOC DASHBOARD)
============================================================ -->
<div id="p-activity" class="panel">
  <!-- KPI Row -->
  <div class="kpi-row kpi-row-4" style="margin-bottom:12px">
    <div class="kpi-card kpi-bl"><i class="kpi-icon"><i class="fa-solid fa-users"></i></i><div class="kpi-label">Active Users</div><div class="kpi-val" id="act-kpi-users">0</div></div>
    <div class="kpi-card kpi-pu"><i class="kpi-icon"><i class="fa-solid fa-cubes"></i></i><div class="kpi-label">Active Apps</div><div class="kpi-val" id="act-kpi-apps">0</div></div>
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-earth-americas"></i></i><div class="kpi-label">Active Tabs (Chrome)</div><div class="kpi-val" id="act-kpi-tabs">0</div></div>
    <div class="kpi-card kpi-rd"><i class="kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></i><div class="kpi-label">Active Issues</div><div class="kpi-val" id="act-kpi-issues" style="color:var(--red2)">0</div></div>
  </div>

  <div class="grid-2">
    <!-- Card 1: Live View -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fa-solid fa-tv" style="color:var(--blue);margin-right:8px"></i>Live Active App per Device</h3>
        <span class="tag tag-green">Live updates</span>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th>Device / User</th>
              <th>Active App</th>
              <th>Window Title / Chrome Tab</th>
              <th>State</th>
              <th>Last Update</th>
            </tr>
          </thead>
          <tbody id="act-live-tbody">
            <tr><td colspan="5" style="text-align:center;color:var(--txt3)">Waiting for agent data...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Card 2: AI Anomaly Insights -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fa-solid fa-brain" style="color:var(--purple);margin-right:8px"></i>AI Insights & Anomalies</h3>
        <span class="tag tag-purple">AI Ready</span>
      </div>
      <div class="card-body" id="act-ai-insights" style="max-height: 280px; overflow-y: auto;">
        <div class="insight-box" style="margin-bottom:8px"><b>System status:</b> Analisis AI diaktifkan. Data sedang dikumpulkan dari Go Agent dan Chrome Extension.</div>
      </div>
    </div>
  </div>

  <div class="grid-2" style="margin-top:12px">
    <!-- Card 3: Issue Realtime Feed -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fa-solid fa-list-check" style="color:var(--red);margin-right:8px"></i>Issue Panel — Realtime Feed</h3>
        <span class="tag tag-red" id="act-issues-count">0 issues</span>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Device</th>
              <th>Source / Browser</th>
              <th>Issue Type</th>
              <th>Severity</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody id="act-issues-tbody">
            <tr><td colspan="6" style="text-align:center;color:var(--txt3)">No issues detected.</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Card 4: Historical Logs -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fa-solid fa-clock-rotate-left" style="color:var(--cyan);margin-right:8px"></i>Browser Crash & Freeze Logs</h3>
        <span class="tag tag-blue">Auto-refresh</span>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th>Time</th>
              <th>Device</th>
              <th>Browser</th>
              <th>Event / Issue</th>
              <th>Page URL</th>
            </tr>
          </thead>
          <tbody id="act-history-tbody">
            <tr><td colspan="5" style="text-align:center;color:var(--txt3)">Waiting for events...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: SERVER HEALTH
============================================================ -->
<div id="p-server" class="panel">
  <div style="background:var(--glass);border:1px solid var(--bd);border-radius:var(--radius);padding:16px 20px;margin-bottom:12px;display:flex;align-items:center;gap:20px;position:relative;overflow:hidden">
    <div style="position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(180deg,var(--green),var(--cyan))"></div>
    <div style="padding-left:8px">
      <div style="font-size:40px;font-weight:900;line-height:1;color:var(--green)" id="srv-score">—<span style="font-size:18px">%</span></div>
      <div style="font-size:10.5px;color:var(--txt2);margin-top:4px">Weighted Health Score · SystemAuditor v2.2</div>
      <div style="font-size:9.5px;color:var(--txt3);margin-top:2px" id="srv-last-update">Belum ada data</div>
    </div>
    <div style="flex:1">
      <div class="chart-box"><canvas id="chart-health-score" style="max-height:80px"></canvas></div>
    </div>
    <div style="display:flex;flex-flow:row wrap;gap:6px;max-width:320px;justify-content:flex-end" id="srv-status-pills"></div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-magnifying-glass" style="color:var(--blue);margin-right:8px"></i>Detail Komponen Audit</h3><button class="btn btn-primary btn-sm" onclick="Panels.server.runAudit()"><i class="fa-solid fa-rotate" style="margin-right:6px"></i>Run Audit</button></div>
      <div class="card-body" id="srv-comp-detail"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-column" style="color:var(--blue);margin-right:8px"></i>Riwayat Audit (10 Terakhir)</h3></div>
      <div class="card-body tbl-wrap">
        <table><thead><tr><th>Waktu</th><th>Score</th><th>Status</th><th>Gagal</th></tr></thead>
        <tbody id="srv-audit-history"></tbody></table>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3><i class="fa-solid fa-circle" style="color:var(--red);margin-right:8px"></i>Perangkat Offline (Auditor State)</h3><span class="tag tag-red" id="srv-offline-tag">0</span></div>
    <div class="card-body" id="srv-offline-list"></div>
  </div>
</div>

<!-- ============================================================
     PANEL: INCIDENT TRIAGE
============================================================ -->
<div id="p-incident" class="panel">
  <div class="kpi-row kpi-row-3" style="margin-bottom:12px">
    <div class="kpi-card kpi-rd"><i class="kpi-icon"><i class="fa-solid fa-triangle-exclamation" style="color:var(--red)"></i></i><div class="kpi-label">Aktif</div><div class="kpi-val" id="tri-active">—</div></div>
    <div class="kpi-card kpi-or"><i class="kpi-icon"><i class="fa-solid fa-circle" style="color:var(--orange)"></i></i><div class="kpi-label">Offline</div><div class="kpi-val" id="tri-offline">—</div></div>
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></i><div class="kpi-label">Online</div><div class="kpi-val" id="tri-online">—</div></div>
  </div>
  <div class="card">
    <div class="tbl-toolbar">
      <div class="tbl-search"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input id="tri-search" placeholder="Cari incident..." oninput="Tables.filter('tbl-incident',this.value)"></div>
      <select class="inp" style="width:120px;padding:4px 7px" id="tri-filter-sev" onchange="Tables.applyFilters('tbl-incident')"><option value="">Semua Severity</option><option value="CRITICAL">Critical</option><option value="HIGH">High</option><option value="MEDIUM">Medium</option><option value="LOW">Low</option></select>
      <select class="inp" style="width:120px;padding:4px 7px" id="tri-filter-site" onchange="Tables.applyFilters('tbl-incident')"><option value="">Semua Site</option><option>Jateng 3</option><option>PKL</option><option>PML</option><option>IDM</option><option>Lab_Local</option></select>
      <div style="margin-left:auto;display:flex;gap:6px">
        <button class="btn btn-ghost btn-sm" onclick="Tables.exportCSV('tbl-incident','incidents')"><i class="fa-solid fa-download" style="margin-right:6px"></i>CSV</button>
        <button class="btn btn-ghost btn-sm" onclick="Tables.exportJSON('tbl-incident','incidents')"><i class="fa-solid fa-download" style="margin-right:6px"></i>JSON</button>
        <button class="btn btn-ghost btn-sm" onclick="Tables.exportExcel('tbl-incident','incidents')"><i class="fa-solid fa-download" style="margin-right:6px"></i>Excel</button>
        <button class="btn btn-primary btn-sm" onclick="DataService.loadIncidents()"><i class="fa-solid fa-rotate"></i></button>
      </div>
    </div>
    <div class="tbl-wrap">
      <table id="tbl-incident">
        <thead><tr><th onclick="Tables.sort(this,'tbl-incident',0)">ID</th><th onclick="Tables.sort(this,'tbl-incident',1)">Device</th><th onclick="Tables.sort(this,'tbl-incident',2)">Site</th><th onclick="Tables.sort(this,'tbl-incident',3)">Layer</th><th onclick="Tables.sort(this,'tbl-incident',4)">Flag</th><th onclick="Tables.sort(this,'tbl-incident',5)">Severity</th><th onclick="Tables.sort(this,'tbl-incident',6)">Confidence</th><th onclick="Tables.sort(this,'tbl-incident',7)">Waktu</th><th>Action</th></tr></thead>
        <tbody id="tbody-incident"><tr><td colspan="9" style="text-align:center;padding:16px"><div class="skeleton" style="max-width:300px;margin:auto"></div></td></tr></tbody>
      </table>
    </div>
    <div class="tbl-footer"><span id="tri-count-txt">Memuat...</span><div class="tbl-pages" id="tri-pages"></div></div>
  </div>
</div>

<!-- ============================================================
     PANEL: GROUND TRUTH & RCA
============================================================ -->
<div id="p-rca" class="panel">
  <div class="grid-2" style="margin-bottom:12px">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-bullseye" style="color:var(--purple);margin-right:8px"></i>Pilih Insiden untuk Analisis RCA</h3></div>
      <div class="card-body" style="display:flex;gap:8px">
        <select class="inp" id="rca-select" style="flex:1" onchange="Panels.rca.analyze()"><option value="">Pilih insiden...</option></select>
        <button class="btn btn-primary" onclick="Panels.rca.analyze()"><i class="fa-solid fa-microscope" style="margin-right:6px"></i>Analyze</button>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-column" style="color:var(--blue);margin-right:8px"></i>RCA Stats</h3></div>
      <div class="card-body">
        <div class="chart-box"><canvas id="chart-rca-confidence" style="max-height:100px"></canvas></div>
      </div>
    </div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-magnifying-glass" style="color:var(--blue);margin-right:8px"></i>5 Why Analysis</h3><span class="tag tag-purple" id="rca-conf-tag">—</span></div>
      <div class="card-body" id="rca-5why"><div class="empty-state"><div class="es-icon"><i class="fa-solid fa-microscope"></i></div><div class="es-text">Pilih insiden untuk memulai RCA</div></div></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-terminal" style="color:var(--blue);margin-right:8px"></i>Evidence Chain & Ground Truth</h3></div>
      <div class="card-body">
        <div id="rca-evidence"><div class="empty-state"><div class="es-icon"><i class="fa-solid fa-terminal"></i></div><div class="es-text">Evidence akan muncul setelah analisis</div></div></div>
        <div id="rca-feedback-box" style="display: none; margin-top: 15px; border-top: 1px solid var(--bd); padding-top: 12px;">
          <h4 style="font-size: 11px; margin-bottom: 8px; color: var(--txt); display: flex; align-items: center; gap: 4px;"><i class="fa-solid fa-pen-to-square" style="color:var(--blue);margin-right:6px"></i>Submit Ground Truth Feedback</h4>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <div>
              <label class="inp-label" style="font-size: 10px; margin-bottom: 2px;">AI Root Cause Prediction</label>
              <input type="text" class="inp" id="rca-ai-pred" readonly style="background: rgba(255,255,255,0.03); cursor: not-allowed; font-size: 11px;">
            </div>
            <div>
              <label class="inp-label" style="font-size: 10px; margin-bottom: 2px;">Human Root Cause (Ground Truth)</label>
              <select class="inp" id="rca-human-gt" style="font-size: 11px;" onchange="document.getElementById('rca-manual-gt-container').style.display = this.value === 'Other / Manual Cause' ? 'block' : 'none'">
                <option value="">-- Pilih Ground Truth --</option>
                <option value="Hardware Failure (Power Supply / Switch Off)">Hardware Failure (Power Supply / Switch Off)</option>
                <option value="Network Disconnection / LAN Cable Loose">Network Disconnection / LAN Cable Loose</option>
                <option value="Router Congestion / High Bandwidth Load">Router Congestion / High Bandwidth Load</option>
                <option value="USB Security Violation (Unauthorized Insertion)">USB Security Violation (Unauthorized Insertion)</option>
                <option value="Printer Service Crash / Loop Spooler">Printer Service Crash / Loop Spooler</option>
                <option value="Software/App Exception (Event ID 1000/1002)">Software/App Exception (Event ID 1000/1002)</option>
                <option value="ISP / Uplink Outage">ISP / Uplink Outage</option>
                <option value="Other / Manual Cause">Other / Manual Cause</option>
              </select>
            </div>
            <div id="rca-manual-gt-container" style="display: none;">
              <label class="inp-label" style="font-size: 10px; margin-bottom: 2px;">Manual Cause Detail</label>
              <input type="text" class="inp" id="rca-manual-gt" placeholder="Tulis penyebab manual..." style="font-size: 11px;">
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <span class="inp-label" style="font-size: 10px; white-space: nowrap;">Akurasi AI:</span>
                <select class="inp" id="rca-feedback-score" style="width: 75px; padding: 2px 4px; font-size: 11px;">
                  <option value="1.0">5 ⭐ (Sangat Akurat)</option>
                  <option value="0.8">4 ⭐ (Akurat)</option>
                  <option value="0.6">3 ⭐ (Cukup)</option>
                  <option value="0.4">2 ⭐ (Kurang)</option>
                  <option value="0.2">1 ⭐ (Salah)</option>
                </select>
              </div>
              <button class="btn btn-purple btn-sm" onclick="Panels.rca.submitFeedback()" style="padding: 4px 10px; font-size: 11px;">Submit Feedback</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-body" id="rca-timeline"><div class="empty-state"><div class="es-icon">🕐</div><div class="es-text">Timeline akan ditampilkan setelah analisis</div></div></div>
  </div>
  <div class="card" style="margin-top:12px">
    <div class="card-header"><h3>🛠 Remote Action via Orchestrator</h3><div><span class="tag tag-gray" id="remote-target-ip" style="margin-right: 6px;">—</span><span class="tag tag-blue">Port 18800</span></div></div>
    <div class="card-body">
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
        <select class="inp" style="width:200px" id="rca-target" onchange="const d = DataService._devices.find(x=>x.name===this.value); setEl('remote-target-ip', d ? d.ip : '—')"><option value="">Pilih device target...</option></select>
        <button class="btn btn-warning" onclick="Panels.rca.sendCmd('RECHECK_STATUS')">🔍 Recheck Status</button>
        <button class="btn btn-success" onclick="Panels.rca.sendCmd('RESOLVE_ISSUE')">✅ Mark Resolved</button>
        <button class="btn btn-danger" onclick="Panels.rca.sendCmd('CLEAR_QUEUE')">🗑️ Clear Queue</button>
        <button class="btn btn-purple" onclick="Panels.rca.sendCmd('RESTART_SERVICE')">🔄 Restart Service</button>
      </div>
      <div id="rca-cmd-result" style="font-size:10.5px;color:var(--txt2)"></div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: CAUSAL DAG
============================================================ -->
<div id="p-dag" class="panel">
  <div class="card mb-12">
    <div class="dag-toolbar">
      <select class="inp" style="width:220px" id="dag-select" onchange="DAGEngine.loadIncident(this.value)"><option value="">Pilih Insiden...</option></select>
      <button class="btn btn-ghost btn-sm" onclick="DAGEngine.zoomIn()">🔍+</button>
      <button class="btn btn-ghost btn-sm" onclick="DAGEngine.zoomOut()">🔍-</button>
      <button class="btn btn-ghost btn-sm" onclick="DAGEngine.resetView()"><i class="fa-solid fa-arrow-rotate-left" style="margin-right:6px"></i>Reset</button>
      <button class="btn btn-ghost btn-sm" onclick="DAGEngine.expandAll()"><i class="fa-solid fa-expand" style="margin-right:6px"></i>Expand</button>
      <button class="btn btn-ghost btn-sm" onclick="DAGEngine.collapseAll()"><i class="fa-solid fa-compress" style="margin-right:6px"></i>Collapse</button>
      <div class="tbl-search" style="width:160px"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input placeholder="Cari node..." oninput="DAGEngine.searchNode(this.value)"></div>
      <button class="btn btn-primary btn-sm" onclick="DAGEngine.exportSVG()"><i class="fa-solid fa-download" style="margin-right:6px"></i>SVG</button>
    </div>
    <div class="dag-svg-wrap" id="dag-svg-wrap">
      <svg id="dag-svg" class="dag-svg" viewBox="0 0 800 320">
        <defs>
          <marker id="arrowhead" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M2 1L8 5L2 9" fill="none" stroke="#3b82f6" stroke-width="1.5"/></marker>
          <marker id="arrowhead-red" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M2 1L8 5L2 9" fill="none" stroke="#ef4444" stroke-width="1.5"/></marker>
          <marker id="arrowhead-green" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M2 1L8 5L2 9" fill="none" stroke="#10b981" stroke-width="1.5"/></marker>
          <marker id="arrowhead-cyan" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M2 1L8 5L2 9" fill="none" stroke="#0d9488" stroke-width="1.5"/></marker>
          <filter id="glow"><feGaussianBlur stdDeviation="3" result="coloredBlur"/><feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <g id="dag-viewport">
          <g id="dag-edges"></g>
          <g id="dag-nodes"></g>
        </g>
      </svg>
    </div>
  </div>
  <div class="insight-box" id="dag-insight" style="display:none"><b>🧠 AI Insight:</b> <span id="dag-insight-txt"></span></div>
</div>



<!-- ============================================================
     PANEL: PC HEALTH
============================================================ -->
<div id="p-pchealth" class="panel">
  <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">
    <div class="tbl-search" style="width:200px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input id="pc-search" placeholder="Cari device/IP..." oninput="Panels.pchealth.applyFilters()"></div>
    <select class="inp" style="width:130px;padding:4px 7px" id="pc-filter-status" onchange="Panels.pchealth.applyFilters()"><option value="">Semua Status</option><option>ONLINE</option><option>OFFLINE</option><option>FAULTY</option></select>
    <select class="inp" style="width:130px;padding:4px 7px" id="pc-filter-site" onchange="Panels.pchealth.applyFilters()"><option value="">Semua Site</option></select>
    <div style="margin-left:auto;display:flex;gap:6px">
      <button class="btn btn-ghost btn-sm" onclick="Panels.pchealth.exportCSV()"><i class="fa-solid fa-download" style="margin-right:6px"></i>CSV</button>
      <button class="btn btn-primary btn-sm" onclick="DataService.loadDevices()"><i class="fa-solid fa-rotate" style="margin-right:6px"></i>Refresh</button>
    </div>
  </div>
  <div id="pc-grid" class="device-grid"></div>
  <!-- PC Detail Modal trigger -->
  <div class="card" id="pc-detail-card" style="margin-top:12px; display:none">
    <div class="card-header"><h3 id="pc-detail-title"><i class="fa-solid fa-desktop" style="color:var(--blue);margin-right:8px"></i>Detail PC</h3><button class="btn btn-ghost btn-sm" onclick="document.getElementById('pc-detail-card').style.display='none'"><i class="fa-solid fa-xmark" style="margin-right:6px"></i>Tutup</button></div>
    <div class="card-body" id="pc-detail-body"></div>
  </div>
</div>

<!-- ============================================================
     PANEL: PRINTER STATUS
============================================================ -->
<div id="p-printer" class="panel">
  <!-- KPI Row -->
  <div class="kpi-row kpi-row-4" style="margin-bottom:12px">
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-print" style="color:var(--green)"></i></i><div class="kpi-label">Printer Online</div><div class="kpi-val" id="pr-online">—</div></div>
    <div class="kpi-card kpi-rd"><i class="kpi-icon"><i class="fa-solid fa-triangle-exclamation" style="color:var(--red)"></i></i><div class="kpi-label">Error/Offline</div><div class="kpi-val" id="pr-error">—</div></div>
    <div class="kpi-card kpi-or"><i class="kpi-icon"><i class="fa-solid fa-file-invoice" style="color:var(--orange)"></i></i><div class="kpi-label">Total Queue</div><div class="kpi-val" id="pr-queue">—</div></div>
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-droplet" style="color:var(--cyan)"></i></i><div class="kpi-label">Avg Toner</div><div class="kpi-val" id="pr-toner">—</div></div>
  </div>
  <!-- Action Bar -->
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap">
    <button class="btn btn-primary btn-sm" id="btn-add-printer" onclick="PrinterMgr.openAddModal()"><i class="fa-solid fa-plus" style="margin-right:6px"></i>Add Printer</button>
    <button class="btn btn-ghost btn-sm" onclick="PrinterMgr.pingAll()"><i class="fa-solid fa-satellite-dish" style="margin-right:6px"></i>Ping All</button>
    <button class="btn btn-ghost btn-sm" onclick="PrinterMgr.load()"><i class="fa-solid fa-rotate" style="margin-right:6px"></i>Refresh</button>
    <div style="flex:1"></div>
    <span style="font-size:10px;color:var(--txt3)" id="pr-last-refresh">—</span>
  </div>
  <!-- Printer Grid -->
  <div id="printer-grid" class="printer-grid">
    <div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--txt3)">
      <i class="fa-solid fa-print" style="font-size:32px;margin-bottom:10px;display:block;opacity:.3"></i>
      <div>Belum ada printer terdaftar. Klik <b>Add Printer</b> untuk menambah.</div>
    </div>
  </div>
</div>

<!-- Add/Edit Printer Modal -->
<div id="printer-add-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);align-items:center;justify-content:center">
  <div style="background:var(--panel);border:1px solid var(--bd2);border-radius:12px;padding:24px;width:420px;max-width:95vw;box-shadow:0 20px 60px rgba(0,0,0,.5)">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <h3 style="margin:0;font-size:14px"><i class="fa-solid fa-print" style="color:var(--blue);margin-right:8px"></i><span id="printer-modal-title">Add Printer</span></h3>
      <button style="background:none;border:none;color:var(--txt2);cursor:pointer;font-size:18px" onclick="PrinterMgr.closeAddModal()">✕</button>
    </div>
    <input type="hidden" id="pr-edit-id" value="">
    <div style="display:flex;flex-direction:column;gap:10px">
      <div>
        <label class="inp-label">Nama Printer *</label>
        <input class="inp" id="pr-name" placeholder="Contoh: Printer-Kasir-01" style="width:100%">
      </div>
      <div>
        <label class="inp-label">Model / Brand</label>
        <input class="inp" id="pr-model" placeholder="Contoh: Epson TM-T82X, HP LaserJet" style="width:100%">
      </div>
      <div style="display:grid;grid-template-columns:1fr 80px;gap:8px">
        <div>
          <label class="inp-label">IP Address *</label>
          <input class="inp" id="pr-ip" placeholder="192.168.x.x" style="width:100%">
        </div>
        <div>
          <label class="inp-label">Port</label>
          <input class="inp" id="pr-port" placeholder="9100" type="number" style="width:100%">
        </div>
      </div>
      <div>
        <label class="inp-label">Site ID</label>
        <input class="inp" id="pr-site-id" placeholder="Contoh: SITE-MKT-01" style="width:100%">
      </div>
      <div>
        <label class="inp-label">PC / Host Agent</label>
        <input class="inp" id="pr-pc-name" placeholder="Nama PC yang mengontrol printer ini" style="width:100%">
      </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:16px;justify-content:flex-end">
      <button class="btn btn-ghost btn-sm" onclick="PrinterMgr.closeAddModal()">Batal</button>
      <button class="btn btn-primary btn-sm" onclick="PrinterMgr.savePrinter()"><i class="fa-solid fa-floppy-disk" style="margin-right:6px"></i>Simpan</button>
    </div>
  </div>
</div>


<!-- ============================================================
     PANEL: FLEET MANAGEMENT
============================================================ -->
<div id="p-fleet" class="panel">
  <div class="kpi-row kpi-row-3">
    <div class="kpi-card kpi-gr"><i class="kpi-icon">🏢</i><div class="kpi-label">Sites Aktif</div><div class="kpi-val" id="fl-sites">—</div></div>
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-desktop" style="color:var(--cyan)"></i></i><div class="kpi-label">Total Devices</div><div class="kpi-val" id="fl-total">—</div></div>
    <div class="kpi-card kpi-rd"><i class="kpi-icon"><i class="fa-solid fa-circle" style="color:var(--red)"></i></i><div class="kpi-label">Offline</div><div class="kpi-val" id="fl-offline">—</div></div>
  </div>
  <div class="grid-2-eq">
    <div class="card">
      <div class="card-header"><h3>🏢 Sites — GATEWAY_TO_SITE_MAP</h3></div>
      <div class="card-body" id="fl-sites-list"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-column" style="color:var(--blue);margin-right:8px"></i>Distribusi per Site</h3></div>
      <div class="card-body"><div class="chart-box"><canvas id="chart-fleet-site"></canvas></div></div>
    </div>
  </div>
  <div class="card">
    <div class="tbl-toolbar">
      <div class="tbl-search"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input id="fl-search" placeholder="Cari device..." oninput="Tables.filter('tbl-fleet',this.value)"></div>
      <button class="btn btn-ghost btn-sm" onclick="Tables.exportCSV('tbl-fleet','fleet')"><i class="fa-solid fa-download" style="margin-right:6px"></i>CSV</button>
      <button class="btn btn-ghost btn-sm" onclick="Tables.exportExcel('tbl-fleet','fleet')"><i class="fa-solid fa-download" style="margin-right:6px"></i>Excel</button>
    </div>
    <div class="tbl-wrap">
      <table id="tbl-fleet">
        <thead><tr><th onclick="Tables.sort(this,'tbl-fleet',0)">Nama</th><th onclick="Tables.sort(this,'tbl-fleet',1)">IP</th><th onclick="Tables.sort(this,'tbl-fleet',2)">Layer</th><th onclick="Tables.sort(this,'tbl-fleet',3)">Site</th><th onclick="Tables.sort(this,'tbl-fleet',4)">Status</th><th onclick="Tables.sort(this,'tbl-fleet',5)">Last Seen</th><th>Action</th></tr></thead>
        <tbody id="tbody-fleet"></tbody>
      </table>
    </div>
    <div class="tbl-footer"><span id="fl-count-txt">—</span><div class="tbl-pages" id="fl-pages"></div></div>
  </div>
</div>

<!-- ============================================================
     PANEL: STORAGE
============================================================ -->
<div id="p-storage" class="panel">
  <div class="grid-3">
    <div class="kpi-card kpi-bl"><i class="kpi-icon"><i class="fa-solid fa-database" style="color:var(--blue)"></i></i><div class="kpi-label">DB PostgreSQL</div><div class="kpi-val" id="st-db">—</div><div class="kpi-sub">osi_system tables</div></div>
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-bolt" style="color:var(--cyan)"></i></i><div class="kpi-label">Redis Memory</div><div class="kpi-val" id="st-redis">—</div><div class="kpi-sub">Used/Max</div></div>
    <div class="kpi-card kpi-pu"><i class="kpi-icon"><i class="fa-solid fa-brain" style="color:var(--purple)"></i></i><div class="kpi-label">RAG Vectors</div><div class="kpi-val" id="st-rag">108 KB</div><div class="kpi-sub">rag_vectors.db</div></div>
  </div>
  <div class="grid-2-eq">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-hard-drive" style="color:var(--blue);margin-right:8px"></i>Disk Usage</h3><button class="btn btn-ghost btn-sm" onclick="Panels.storage.refresh()"><i class="fa-solid fa-rotate"></i></button></div>
      <div class="card-body" id="st-disk-detail"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3>⚡ Redis Queue Metrics</h3><span class="tag tag-blue">Ingestor Monitor</span></div>
      <div class="card-body" id="st-queue-metrics">
        <div class="pb-wrap"><div class="pb-label"><span>Metrics Queue</span><span id="st-mq">0</span></div><div class="pb"><div class="pb-fill pb-blue" id="st-mq-bar" style="width:0%"></div></div></div>
        <div class="pb-wrap"><div class="pb-label"><span>Logs Queue</span><span id="st-lq">0</span></div><div class="pb"><div class="pb-fill pb-purple" id="st-lq-bar" style="width:0%"></div></div></div>
        <div class="pb-wrap"><div class="pb-label"><span>Events Queue</span><span id="st-eq">0</span></div><div class="pb"><div class="pb-fill pb-cyan" id="st-eq-bar" style="width:0%"></div></div></div>
        <div class="li-row" style="margin-top:10px"><span class="li-name">Load Shedding Level</span><span id="st-load-lv" class="tag tag-green">L0 Normal</span></div>
        <div class="li-row"><span class="li-name">Processed (5s)</span><span id="st-throughput" class="tag tag-blue">0</span></div>
        <div class="li-row"><span class="li-name">Avg Latency</span><span id="st-latency" class="tag tag-gray">0ms</span></div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3><i class="fa-solid fa-folder-open" style="color:var(--blue);margin-right:8px"></i>File Sistem AI</h3></div>
    <div class="card-body">
      <div id="st-ai-files" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px">
        <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px"><div class="li-name"><i class="fa-solid fa-robot" style="margin-right:6px"></i>local_classifier.joblib</div><div style="font-size:10px;color:var(--txt3)">380 KB · RandomForest v3</div></div>
        <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px"><div class="li-name"><i class="fa-solid fa-book-open-reader" style="margin-right:6px"></i>rag_continuous_learning.json</div><div style="font-size:10px;color:var(--txt3)">227 KB · Dynamic KB</div></div>
        <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px"><div class="li-name"><i class="fa-solid fa-chart-column" style="margin-right:6px"></i>local_knowledge_base.json</div><div style="font-size:10px;color:var(--txt3)">175 KB · Static KB</div></div>
        <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px"><div class="li-name"><i class="fa-solid fa-database" style="margin-right:6px"></i>rag_vectors.db</div><div style="font-size:10px;color:var(--txt3)">108 KB · SQLite Vector Store</div></div>
        <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px"><div class="li-name"><i class="fa-solid fa-gears" style="margin-right:6px"></i>orchestrator.py</div><div style="font-size:10px;color:var(--txt3)">99 KB · Enterprise RCA Engine</div></div>
        <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px"><div class="li-name"><i class="fa-solid fa-chart-column" style="margin-right:6px"></i>local_classifier_pure.json</div><div style="font-size:10px;color:var(--txt3)">322 KB · Pure JSON classifier</div></div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: AI PANEL
============================================================ -->
<div id="p-ai" class="panel">
  <div class="kpi-row kpi-row-4">
    <div class="kpi-card kpi-pu"><i class="kpi-icon"><i class="fa-solid fa-robot" style="color:var(--purple)"></i></i><div class="kpi-label">AI Aktif</div><div class="kpi-val" id="ai-active-count">—</div><div class="kpi-sub" id="ai-active-names">DeepSeek, Gemini, Groq</div></div>
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-crosshairs" style="color:var(--green)"></i></i><div class="kpi-label">Avg Confidence</div><div class="kpi-val" id="ai-avg-conf">—</div><div class="kpi-sub kpi-trend-up">Model consensus</div></div>
    <div class="kpi-card kpi-bl"><i class="kpi-icon"><i class="fa-solid fa-book-open-reader" style="color:var(--blue)"></i></i><div class="kpi-label">RAG Entries</div><div class="kpi-val" id="ai-rag-count">—</div><div class="kpi-sub">Continuous learning</div></div>
    <div class="kpi-card kpi-cy"><i class="kpi-icon"><i class="fa-solid fa-brain" style="color:var(--cyan)"></i></i><div class="kpi-label">Classif. Accuracy</div><div class="kpi-val" id="ai-class-acc">—</div><div class="kpi-sub">Local RF model</div></div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-brain" style="color:var(--purple);margin-right:8px"></i>AI Reasoning Engine (Live)</h3><button class="btn btn-purple btn-sm" onclick="Panels.ai.runInference()"><i class="fa-solid fa-play" style="margin-right:6px"></i>Run Inference</button></div>
      <div class="card-body" id="ai-reasoning-panel">
        <div style="margin-bottom:10px">
          <label class="inp-label">Input Query untuk AI</label>
          <textarea class="inp" id="ai-query-input" rows="2" placeholder="Masukkan deskripsi masalah atau pilih insiden aktif..."></textarea>
        </div>
        <div id="ai-reasoning-output"><div class="empty-state"><div class="es-icon"><i class="fa-solid fa-brain"></i></div><div class="es-text">Klik Run Inference untuk memulai analisis AI</div></div></div>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-column" style="color:var(--blue);margin-right:8px"></i>Model Performance</h3></div>
      <div class="card-body">
        <div class="chart-box"><canvas id="chart-ai-perf" style="max-height:150px"></canvas></div>
        <div id="ai-model-status-list" style="margin-top:10px"></div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3><i class="fa-solid fa-crosshairs" style="color:var(--purple);margin-right:8px"></i>Prediction & Classification History</h3><button class="btn btn-ghost btn-sm" onclick="Tables.exportCSV('tbl-ai-hist','ai-history')"><i class="fa-solid fa-download" style="margin-right:6px"></i>CSV</button></div>
    <div class="tbl-wrap">
      <table id="tbl-ai-hist">
        <thead><tr><th>Waktu</th><th>Device</th><th>Prediksi</th><th>Ground Truth</th><th>Confidence</th><th>Model</th><th>Status</th></tr></thead>
        <tbody id="tbody-ai-hist"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: TRAINING FEEDBACK
============================================================ -->
<div id="p-training" class="panel">
  <div class="kpi-row kpi-row-3">
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></i><div class="kpi-label">Feedback Benar</div><div class="kpi-val" id="tr-correct">—</div></div>
    <div class="kpi-card kpi-rd"><i class="kpi-icon"><i class="fa-solid fa-circle-xmark" style="color:var(--red)"></i></i><div class="kpi-label">Feedback Salah</div><div class="kpi-val" id="tr-incorrect">—</div></div>
    <div class="kpi-card kpi-bl"><i class="kpi-icon"><i class="fa-solid fa-book-open-reader" style="color:var(--blue)"></i></i><div class="kpi-label">RAG Entries</div><div class="kpi-val" id="tr-rag">—</div></div>
  </div>
  <div class="grid-2-eq">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-comments" style="color:var(--blue);margin-right:8px"></i>Feedback Queue — Insiden Aktif</h3><span class="badge bd-bl" id="tr-queue-count">0</span></div>
      <div class="card-body" id="tr-feedback-list" style="max-height:380px;overflow-y:auto"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-chart-line" style="color:var(--blue);margin-right:8px"></i>Akurasi Training Over Time</h3></div>
      <div class="card-body"><div class="chart-box"><canvas id="chart-training-acc" style="max-height:200px"></canvas></div>
        <div class="insight-box" style="margin-top:10px"><b>Status RAG:</b> rag_continuous_learning.json (227 KB) · rag_vectors.db (108 KB) · Mode: Continuous Learning</div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: LIVE LOGS
============================================================ -->
<div id="p-logs" class="panel">
  <div class="card">
    <div class="log-toolbar">
      <div class="tbl-search" style="flex:1;min-width:140px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input id="log-search" placeholder="Cari log..." oninput="LogStreamer.search(this.value)"></div>
      <select class="inp" style="width:110px;padding:4px 7px" id="log-filter" onchange="LogStreamer.setFilter(this.value)">
        <option value="">Semua Level</option>
        <option value="OK">OK</option>
        <option value="INFO">INFO</option>
        <option value="WARN">WARN</option>
        <option value="ERR">ERROR</option>
        <option value="DEBUG">DEBUG</option>
      </select>
      <select class="inp" style="width:110px;padding:4px 7px" id="log-source-filter" onchange="LogStreamer.setSourceFilter(this.value)">
        <option value="">Semua Source</option>
        <option value="ORCH">Orchestrator</option>
        <option value="AUDIT">Auditor</option>
        <option value="INGEST">Ingestor</option>
        <option value="AI">AI Engine</option>
        <option value="DB">Database</option>
      </select>
      <button class="btn btn-warning btn-sm" id="log-pause-btn" onclick="LogStreamer.togglePause()">⏸ Pause</button>
      <button class="btn btn-danger btn-sm" onclick="LogStreamer.clear()"><i class="fa-solid fa-trash-can" style="margin-right:6px"></i>Clear</button>
      <button class="btn btn-ghost btn-sm" onclick="LogStreamer.download()"><i class="fa-solid fa-download" style="margin-right:6px"></i>Download</button>
      <button class="btn btn-ghost btn-sm" onclick="LogStreamer.copy()"><i class="fa-solid fa-copy" style="margin-right:6px"></i>Copy</button>
      <span class="tag tag-gray" id="log-count-tag">0 baris</span>
    </div>
    <div class="log-box" id="log-box">
      <div class="log-line"><span class="log-time">--:--:--</span><span class="log-src">[BOOT]</span><span class="log-msg info">[INFO] NOC IT AI Command Center v3.0 · Initializing...</span></div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: LIVE CHAT SUPPORT
============================================================ -->
<div id="p-chat" class="panel">
  <style>
    .chat-layout {
      display: flex;
      height: calc(100vh - 120px);
      gap: 16px;
      color: #e2e8f0;
    }
    .chat-sidebar {
      width: 280px;
      display: flex;
      flex-direction: column;
      background: rgba(15, 23, 42, 0.4);
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }
    .chat-sidebar-header {
      padding: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(15, 23, 42, 0.6);
    }
    .chat-sidebar-tabs {
      display: flex;
      gap: 4px;
      padding: 8px;
      background: rgba(15, 23, 42, 0.3);
      overflow-x: auto;
    }
    .chat-sidebar-tab {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      cursor: pointer;
      white-space: nowrap;
      background: transparent;
      border: none;
      color: #94a3b8;
    }
    .chat-sidebar-tab.active {
      background: var(--blue);
      color: #fff;
    }
    .chat-sessions-list {
      flex: 1;
      overflow-y: auto;
      padding: 8px;
    }
    .chat-session-item {
      padding: 10px;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 6px;
      transition: background 0.2s;
      border: 1px solid transparent;
    }
    .chat-session-item:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    .chat-session-item.active {
      background: rgba(59, 130, 246, 0.15);
      border-color: rgba(59, 130, 246, 0.3);
    }
    .chat-session-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chat-session-item-title {
      font-weight: 600;
      font-size: 13px;
    }
    .chat-session-item-status {
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 9999px;
      font-weight: 500;
    }
    .chat-status-open { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
    .chat-status-waiting { background: rgba(245, 158, 11, 0.2); color: #fbbf24; animation: pulse 2s infinite; }
    .chat-status-active { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .chat-status-closed { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }
    
    .chat-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: rgba(15, 23, 42, 0.4);
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }
    .chat-main-header {
      padding: 12px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(15, 23, 42, 0.6);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chat-main-header-info {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .chat-bubbles-container {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .chat-bubble-wrapper {
      display: flex;
      flex-direction: column;
      max-width: 70%;
    }
    .chat-bubble-wrapper.client {
      align-self: flex-start;
    }
    .chat-bubble-wrapper.operator {
      align-self: flex-end;
    }
    .chat-bubble-wrapper.system {
      align-self: center;
      max-width: 90%;
    }
    .chat-bubble-wrapper.ai {
      align-self: center;
      max-width: 90%;
    }
    .chat-bubble {
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.4;
      word-break: break-word;
    }
    .chat-bubble-wrapper.client .chat-bubble {
      background: rgba(255, 255, 255, 0.08);
      color: #f1f5f9;
      border-bottom-left-radius: 0;
    }
    .chat-bubble-wrapper.operator .chat-bubble {
      background: var(--blue);
      color: #fff;
      border-bottom-right-radius: 0;
    }
    .chat-bubble-wrapper.system .chat-bubble {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      border: 1px dashed rgba(245, 158, 11, 0.3);
      font-size: 12px;
      text-align: center;
    }
    .chat-bubble-wrapper.ai .chat-bubble {
      background: rgba(139, 92, 246, 0.15);
      color: #a78bfa;
      border: 1px solid rgba(139, 92, 246, 0.3);
      font-size: 12px;
    }
    .chat-bubble-meta {
      font-size: 10px;
      color: #64748b;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .chat-bubble-wrapper.operator .chat-bubble-meta {
      justify-content: flex-end;
    }
    
    .chat-suggest-panel {
      padding: 8px 12px;
      background: rgba(15, 23, 42, 0.6);
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .chat-suggest-title {
      font-size: 11px;
      color: #8b5cf6;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .chat-suggest-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .chat-suggest-chip {
      background: rgba(139, 92, 246, 0.15);
      border: 1px solid rgba(139, 92, 246, 0.25);
      color: #c084fc;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 11px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .chat-suggest-chip:hover {
      background: rgba(139, 92, 246, 0.3);
      border-color: rgba(139, 92, 246, 0.5);
    }
    
    .chat-input-area {
      padding: 12px;
      background: rgba(15, 23, 42, 0.6);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .chat-input-bar {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    
    .chat-preview-container {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      padding: 4px 0;
    }
    .chat-preview-item {
      position: relative;
      width: 60px;
      height: 60px;
      border-radius: 4px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #0f172a;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .chat-preview-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .chat-preview-item .file-icon {
      font-size: 20px;
      color: #94a3b8;
    }
    .chat-preview-item-remove {
      position: absolute;
      top: 1px;
      right: 1px;
      width: 16px;
      height: 16px;
      background: rgba(239, 68, 68, 0.8);
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      cursor: pointer;
      border: none;
    }
    
    .chat-context-sidebar {
      width: 260px;
      background: rgba(15, 23, 42, 0.4);
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .chat-context-header {
      padding: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(15, 23, 42, 0.6);
      font-weight: 600;
      font-size: 13px;
    }
    .chat-context-content {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .chat-context-section-title {
      font-size: 11px;
      font-weight: 600;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 2px;
    }
    .chat-context-item {
      font-size: 11px;
      padding: 6px;
      background: rgba(255, 255, 255, 0.02);
      border-radius: 4px;
      margin-bottom: 4px;
    }
    
    .chat-context-img-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
    }
    .chat-context-img-thumb {
      aspect-ratio: 1;
      background: #0f172a;
      border-radius: 4px;
      overflow: hidden;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .chat-context-img-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .typing-indicator-label {
      font-size: 11px;
      color: #64748b;
      font-style: italic;
      height: 15px;
      margin-bottom: 4px;
      padding-left: 16px;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
  </style>

  <div class="chat-layout">
    <div class="chat-sidebar">
      <div class="chat-sidebar-header">
        <input class="inp" style="width:100%" placeholder="Cari Sesi PC..." oninput="NocChat.searchSessions(this.value)" />
      </div>
      <div class="chat-sidebar-tabs">
        <button class="chat-sidebar-tab active" onclick="NocChat.setTab('ALL', this)">Semua</button>
        <button class="chat-sidebar-tab" onclick="NocChat.setTab('WAITING_OPERATOR', this)">Menunggu</button>
        <button class="chat-sidebar-tab" onclick="NocChat.setTab('ACTIVE', this)">Aktif</button>
        <button class="chat-sidebar-tab" onclick="NocChat.setTab('CLOSED', this)">Selesai</button>
      </div>
      <div class="chat-sessions-list" id="chat-sessions-list">
        <div style="padding:16px;text-align:center;color:#64748b;font-size:12px">Tidak ada sesi chat.</div>
      </div>
    </div>

    <div class="chat-main" id="chat-main-window" style="display:none">
      <div class="chat-main-header">
        <div class="chat-main-header-info">
          <span style="font-size:16px;color:#fff"><i class="fa-solid fa-desktop"></i></span>
          <div>
            <h4 id="chat-header-pcname" style="margin:0;font-size:14px">CLIENT-PC</h4>
            <span id="chat-header-clientid" style="font-size:10px;color:#64748b">client-id</span>
          </div>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn btn-ghost btn-sm" onclick="NocChat.toggleSessionStatus()">
            <i class="fa-solid fa-circle-check"></i> <span id="btn-session-status-text">Close Session</span>
          </button>
        </div>
      </div>

      <div class="chat-bubbles-container" id="chat-bubbles-container"></div>
      
      <div class="typing-indicator-label" id="typing-indicator-label"></div>

      <div class="chat-suggest-panel" id="chat-suggest-panel">
        <div class="chat-suggest-title"><i class="fa-solid fa-wand-magic-sparkles"></i> Saran Jawaban AI</div>
        <div class="chat-suggest-chips" id="chat-suggest-chips"></div>
      </div>

      <div class="chat-input-area">
        <div class="chat-preview-container" id="chat-preview-container" style="display:none"></div>
        <div class="chat-input-bar">
          <button class="btn btn-ghost btn-sm" onclick="document.getElementById('chat-file-input').click()" style="padding:8px">
            <i class="fa-solid fa-paperclip" style="font-size:14px"></i>
          </button>
          <input type="file" id="chat-file-input" style="display:none" onchange="NocChat.handleFileSelect(event)" multiple />
          <input type="text" class="inp" id="chat-text-input" style="flex:1" placeholder="Ketik pesan balasan..." onkeydown="NocChat.handleKeyDown(event)" oninput="NocChat.handleInput()" />
          <button class="btn btn-blue btn-sm" onclick="NocChat.sendMessage()" style="padding:8px 16px">Kirim</button>
        </div>
      </div>
    </div>
    
    <div class="chat-main" id="chat-main-empty" style="flex:1;align-items:center;justify-content:center">
      <div style="text-align:center;color:#64748b">
        <span style="font-size:48px;margin-bottom:12px;display:block"><i class="fa-solid fa-comments"></i></span>
        <h4 style="margin:0 0 4px 0">Live Chat Support</h4>
        <p style="margin:0;font-size:12px">Pilih salah satu sesi klien di sebelah kiri untuk memulai chat.</p>
      </div>
    </div>

    <div class="chat-context-sidebar" id="chat-context-sidebar" style="display:none">
      <div class="chat-context-header">📋 Konteks Perangkat</div>
      <div class="chat-context-content">
        <div>
          <div class="chat-context-section-title">Incidents Terbaru (5)</div>
          <div id="ctx-incidents-list">
            <div style="color:#64748b;font-size:11px">Tidak ada data.</div>
          </div>
        </div>
        <div>
          <div class="chat-context-section-title">Remote Access (3)</div>
          <div id="ctx-remote-list">
            <div style="color:#64748b;font-size:11px">Tidak ada data.</div>
          </div>
        </div>
        <div>
          <div class="chat-context-section-title">Galeri Screenshot (10)</div>
          <div class="chat-context-img-grid" id="ctx-screenshots-grid"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    var NocChat = {
      socket: null,
      sessions: [],
      activeSession: null,
      messages: [],
      selectedTab: 'ALL',
      searchQuery: '',
      attachments: [],
      typingTimer: null,
      
      init() {
        const protocol = window.location.protocol === 'https:' ? 'wss://' : 'ws://';
        const wsUrl = protocol + window.location.host + '/ws/chat';
        
        this.socket = new WebSocket(wsUrl);
        this.socket.onopen = () => {
          console.log(" [CHAT] Connected to Chat WebSocket");
        };
        
        this.socket.onmessage = (event) => {
          const ev = JSON.parse(event.data);
          this.handleSocketEvent(ev);
        };
        
        this.socket.onclose = () => {
          console.warn(" [CHAT] Chat WebSocket disconnected, reconnecting in 5s...");
          setTimeout(() => this.init(), 5000);
        };
        
        this.loadSessions();
      },

      async loadSessions() {
        try {
          const resp = await fetch('/api/chat/sessions');
          if (resp.ok) {
            this.sessions = await resp.json();
            this.renderSessions();
          }
        } catch (err) {
          console.error("Failed to load chat sessions:", err);
        }
      },

      setTab(tab, el) {
        this.selectedTab = tab;
        document.querySelectorAll('.chat-sidebar-tab').forEach(btn => btn.classList.remove('active'));
        if (el) el.classList.add('active');
        this.renderSessions();
      },

      searchSessions(q) {
        this.searchQuery = q.toLowerCase();
        this.renderSessions();
      },

      renderSessions() {
        const container = document.getElementById('chat-sessions-list');
        container.innerHTML = '';
        
        const filtered = this.sessions.filter(s => {
          if (this.selectedTab !== 'ALL' && s.status !== this.selectedTab) {
            return false;
          }
          if (this.searchQuery && !s.pc_name.toLowerCase().includes(this.searchQuery) && !s.client_id.toLowerCase().includes(this.searchQuery)) {
            return false;
          }
          return true;
        });

        if (filtered.length === 0) {
          container.innerHTML = `<div style="padding:16px;text-align:center;color:#64748b;font-size:12px">Tidak ada sesi chat.</div>`;
          return;
        }

        filtered.forEach(s => {
          const activeClass = this.activeSession && this.activeSession.client_id === s.client_id ? 'active' : '';
          const item = document.createElement('div');
          item.className = `chat-session-item ${activeClass}`;
          item.onclick = () => this.selectSession(s);
          
          let statusText = s.status;
          let statusClass = 'chat-status-open';
          if (s.status === 'WAITING_OPERATOR') {
            statusText = 'Menunggu';
            statusClass = 'chat-status-waiting';
          } else if (s.status === 'ACTIVE') {
            statusText = 'Aktif';
            statusClass = 'chat-status-active';
          } else if (s.status === 'CLOSED') {
            statusText = 'Selesai';
            statusClass = 'chat-status-closed';
          }

          const dateStr = new Date(s.updated_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

          item.innerHTML = `
            <div class="chat-session-item-header">
              <span class="chat-session-item-title">${s.pc_name || 'CLIENT'}</span>
              <span class="chat-session-item-status ${statusClass}">${statusText}</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:11px;color:#94a3b8">
              <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px">${s.client_id.substring(0,8)}...</span>
              <span>${dateStr}</span>
            </div>
          `;
          container.appendChild(item);
        });
      },

      async selectSession(s) {
        this.activeSession = s;
        this.renderSessions();
        
        document.getElementById('chat-main-empty').style.display = 'none';
        document.getElementById('chat-main-window').style.display = 'flex';
        document.getElementById('chat-context-sidebar').style.display = 'flex';
        
        document.getElementById('chat-header-pcname').textContent = s.pc_name;
        document.getElementById('chat-header-clientid').textContent = s.client_id;
        
        document.getElementById('btn-session-status-text').textContent = s.status === 'CLOSED' ? 'Reopen Session' : 'Close Session';

        document.getElementById('typing-indicator-label').textContent = '';

        await this.loadHistory(s.client_id);
        await this.loadSuggestions(s.client_id);
        await this.loadDeviceContext(s.client_id);
      },

      async loadHistory(client_id) {
        try {
          const resp = await fetch(`/api/chat/history/${client_id}`);
          if (resp.ok) {
            this.messages = await resp.json();
            this.renderMessages();
          }
        } catch (err) {
          console.error("Failed to load history:", err);
        }
      },

      renderMessages() {
        const container = document.getElementById('chat-bubbles-container');
        container.innerHTML = '';

        this.messages.forEach(m => {
          const wrapper = document.createElement('div');
          let roleClass = 'system';
          if (m.sender === 'CLIENT') roleClass = 'client';
          else if (m.sender === 'OPERATOR') roleClass = 'operator';
          else if (m.sender === 'AI_HYPOTHESIS') roleClass = 'ai';
          
          wrapper.className = `chat-bubble-wrapper ${roleClass}`;
          
          const timestamp = new Date(m.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          let readBadge = '';
          if (m.sender === 'OPERATOR') {
            if (m.read_status === 'READ') readBadge = '✓✓ Read';
            else if (m.read_status === 'DELIVERED') readBadge = '✓✓';
            else readBadge = '✓';
          }

          const escapeHTML = (str) => {
            if (!str) return '';
            return str
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;")
              .replace(/'/g, "&#039;");
          };
          let content = escapeHTML(m.message);
          if (m.attachment_path) {
            const files = m.attachment_path.split(',');
            let attachHTML = '<div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">';
            files.forEach(f => {
              const ext = f.split('.').pop().toLowerCase();
              const relF = '/' + f;
              if (['png','jpg','jpeg','gif'].includes(ext)) {
                attachHTML += `<a href="${relF}" target="_blank"><img src="${relF}" style="max-width:150px;max-height:150px;border-radius:4px;border:1px solid rgba(255,255,255,0.1)"/></a>`;
              } else {
                attachHTML += `<a href="${relF}" target="_blank" class="chat-session-item-status chat-status-open" style="display:flex;align-items:center;gap:4px;text-decoration:none"><i class="fa-solid fa-file-arrow-down"></i> ${f.split('/').pop()}</a>`;
              }
            });
            attachHTML += '</div>';
            content += attachHTML;
          }

          wrapper.innerHTML = `
            <div class="chat-bubble">
              ${content}
            </div>
            <div class="chat-bubble-meta">
              <span>${timestamp}</span>
              ${readBadge ? `<span style="color:var(--blue)">${readBadge}</span>` : ''}
            </div>
          `;
          container.appendChild(wrapper);
        });
        
        container.scrollTop = container.scrollHeight;
      },

      async loadSuggestions(client_id) {
        try {
          const resp = await fetch(`/api/chat/suggest?client_id=${client_id}`);
          if (resp.ok) {
            const data = await resp.json();
            const chips = document.getElementById('chat-suggest-chips');
            chips.innerHTML = '';
            data.suggestions.forEach(s => {
              const chip = document.createElement('div');
              chip.className = 'chat-suggest-chip';
              chip.textContent = s;
              chip.onclick = () => {
                document.getElementById('chat-text-input').value = s;
                this.sendMessage();
              };
              chips.appendChild(chip);
            });
          }
        } catch (err) {
          console.error("Failed to load suggested replies:", err);
        }
      },

      async loadDeviceContext(client_id) {
        try {
          const resp = await fetch(`/api/chat/device_context/${client_id}`);
          if (resp.ok) {
            const data = await resp.json();
            
            const incList = document.getElementById('ctx-incidents-list');
            incList.innerHTML = '';
            if (data.incidents && data.incidents.length > 0) {
              data.incidents.forEach(inc => {
                const item = document.createElement('div');
                item.className = 'chat-context-item';
                item.innerHTML = `
                  <div style="font-weight:600;color:var(--red)">${inc.severity} - ${inc.status}</div>
                  <div>${inc.description}</div>
                  <div style="font-size:9px;color:#64748b">${new Date(inc.created_at).toLocaleString()}</div>
                `;
                incList.appendChild(item);
              });
            } else {
              incList.innerHTML = `<div style="color:#64748b;font-size:11px">Tidak ada insiden aktif.</div>`;
            }

            const remoteList = document.getElementById('ctx-remote-list');
            remoteList.innerHTML = '';
            if (data.remote_sessions && data.remote_sessions.length > 0) {
              data.remote_sessions.forEach(sess => {
                const item = document.createElement('div');
                item.className = 'chat-context-item';
                item.innerHTML = `
                  <div style="font-weight:600;color:var(--blue)">${sess.operator} (${sess.status})</div>
                  <div>Alasan: ${sess.reason || 'Remote Access'}</div>
                  <div style="font-size:9px;color:#64748b">${new Date(sess.start_time).toLocaleString()}</div>
                `;
                remoteList.appendChild(item);
              });
            } else {
              remoteList.innerHTML = `<div style="color:#64748b;font-size:11px">Tidak ada log remote.</div>`;
            }

            const grid = document.getElementById('ctx-screenshots-grid');
            grid.innerHTML = '';
            if (data.screenshots && data.screenshots.length > 0) {
              data.screenshots.forEach(sc => {
                const files = sc.attachment_path.split(',');
                files.forEach(f => {
                  const thumb = document.createElement('div');
                  thumb.className = 'chat-context-img-thumb';
                  thumb.innerHTML = `<a href="/${f}" target="_blank"><img src="/${f}" /></a>`;
                  grid.appendChild(thumb);
                });
              });
            } else {
              grid.innerHTML = `<div style="color:#64748b;font-size:11px;grid-column: span 3">Tidak ada screenshot.</div>`;
            }
          }
        } catch (err) {
          console.error("Failed to load device context:", err);
        }
      },

      handleKeyDown(event) {
        if (event.key === 'Enter') {
          this.sendMessage();
        }
      },

      handleInput() {
        if (this.socket && this.activeSession) {
          this.socket.send(JSON.stringify({
            type: "typing",
            client_id: this.activeSession.client_id,
            sender: "OPERATOR"
          }));
        }
      },

      async handleFileSelect(event) {
        const files = event.target.files;
        if (files.length === 0) return;
        
        const container = document.getElementById('chat-preview-container');
        container.innerHTML = '';
        container.style.display = 'flex';
        
        this.attachments = [];
        
        for (let i = 0; i < Math.min(files.length, 5); i++) {
          const file = files[i];
          this.attachments.push(file);
          
          const item = document.createElement('div');
          item.className = 'chat-preview-item';
          
          if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (e) => {
              item.innerHTML = `
                <img src="${e.target.result}" />
                <button class="chat-preview-item-remove" onclick="NocChat.removeAttachment(${i})">×</button>
              `;
            };
            reader.readAsDataURL(file);
          } else {
            item.innerHTML = `
              <div class="file-icon"><i class="fa-solid fa-file"></i></div>
              <div style="font-size:8px;position:absolute;bottom:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:90%;text-align:center">${file.name}</div>
              <button class="chat-preview-item-remove" onclick="NocChat.removeAttachment(${i})">×</button>
            `;
          }
          container.appendChild(item);
        }
      },

      removeAttachment(idx) {
        this.attachments.splice(idx, 1);
        const container = document.getElementById('chat-preview-container');
        container.children[idx].remove();
        if (this.attachments.length === 0) {
          container.style.display = 'none';
        }
      },

      async sendMessage() {
        const input = document.getElementById('chat-text-input');
        const text = input.value.trim();
        
        if (text === '' && this.attachments.length === 0) return;
        if (!this.activeSession) return;
        
        let attachmentPaths = [];
        
        if (this.attachments.length > 0) {
          for (let file of this.attachments) {
            const formData = new FormData();
            formData.append('file', file);
            try {
              const resp = await fetch('/api/chat/upload', {
                method: 'POST',
                body: formData
              });
              if (resp.ok) {
                const resData = await resp.json();
                attachmentPaths.push(resData.attachment_path);
              }
            } catch (err) {
              console.error("Failed to upload file:", err);
            }
          }
        }
        
        const payload = {
          type: "message",
          client_id: this.activeSession.client_id,
          sender: "OPERATOR",
          data: {
            client_id: this.activeSession.client_id,
            message: text,
            attachment_path: attachmentPaths.join(',')
          }
        };

        if (this.socket && this.socket.readyState === WebSocket.OPEN) {
          this.socket.send(JSON.stringify(payload));
        } else {
          try {
            await fetch('/api/chat/send', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                client_id: this.activeSession.client_id,
                sender: "OPERATOR",
                message: text,
                attachment_path: attachmentPaths.join(',')
              })
            });
          } catch (err) {
            console.error("Failed fallback send:", err);
          }
        }
        
        input.value = '';
        this.attachments = [];
        document.getElementById('chat-preview-container').innerHTML = '';
        document.getElementById('chat-preview-container').style.display = 'none';
      },

      async toggleSessionStatus() {
        if (!this.activeSession) return;
        const nextStatus = this.activeSession.status === 'CLOSED' ? 'ACTIVE' : 'CLOSED';
        try {
          const resp = await fetch(`/api/chat/sessions/${this.activeSession.client_id}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: nextStatus })
          });
          if (resp.ok) {
            this.activeSession.status = nextStatus;
            this.loadSessions();
            document.getElementById('btn-session-status-text').textContent = nextStatus === 'CLOSED' ? 'Reopen Session' : 'Close Session';
          }
        } catch (err) {
          console.error("Failed to toggle session status:", err);
        }
      },

      handleSocketEvent(event) {
        if (event.type === 'message') {
          const msg = event.data;
          
          if (this.activeSession && msg.client_id === this.activeSession.client_id) {
            const idx = this.messages.findIndex(m => m.id === msg.id);
            if (idx !== -1) {
              this.messages[idx] = msg;
            } else {
              this.messages.push(msg);
              
              if (msg.sender === 'CLIENT') {
                this.socket.send(JSON.stringify({
                  type: "read_receipt",
                  client_id: msg.client_id,
                  data: { message_id: msg.id }
                }));
              }
            }
            this.renderMessages();
          } else {
            this.playAlertSound();
            this.updateUnreadCount(1);
          }
          this.loadSessions();
        } else if (event.type === 'typing') {
          if (this.activeSession && event.client_id === this.activeSession.client_id && event.sender === 'CLIENT') {
            const label = document.getElementById('typing-indicator-label');
            label.textContent = "Client sedang mengetik...";
            
            clearTimeout(this.typingTimer);
            this.typingTimer = setTimeout(() => {
              label.textContent = '';
            }, 3000);
          }
        } else if (event.type === 'read_receipt') {
          if (this.activeSession && event.client_id === this.activeSession.client_id) {
            const msgID = event.data.message_id;
            const idx = this.messages.findIndex(m => m.id === msgID);
            if (idx !== -1) {
              this.messages[idx].read_status = 'READ';
              this.renderMessages();
            }
          }
        } else if (event.type === 'operator_status') {
          this.loadSessions();
        }
      },

      playAlertSound() {
        try {
          const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-84.wav');
          audio.volume = 0.5;
          audio.play();
        } catch (err) {
          console.warn("Sound play failed", err);
        }
      },

      updateUnreadCount(delta) {
        const badge = document.getElementById('bdg-chat');
        let val = parseInt(badge.textContent || '0') + delta;
        if (val < 0) val = 0;
        badge.textContent = val;
        badge.style.display = val > 0 ? 'inline-block' : 'none';
      }
    };

    window.addEventListener('DOMContentLoaded', () => {
      NocChat.init();
    });
  </script>
</div>

<!-- ============================================================
     PANEL: GOVERNANCE
============================================================ -->
<div id="p-gov" class="panel">
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3>🏆 Top Resolusi Sukses</h3><span class="tag tag-green" id="gov-res-tag">—</span></div>
      <div class="tbl-wrap">
        <table id="tbl-gov-res">
          <thead><tr><th>#</th><th onclick="Tables.sort(this,'tbl-gov-res',1)">Flag / Tipe</th><th onclick="Tables.sort(this,'tbl-gov-res',2)">Jumlah</th><th onclick="Tables.sort(this,'tbl-gov-res',3)">Layer</th></tr></thead>
          <tbody id="tbody-gov-res"></tbody>
        </table>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-clipboard-list" style="color:var(--blue);margin-right:8px"></i>Audit Log (Terbaru)</h3><button class="btn btn-ghost btn-sm" onclick="Tables.exportCSV('tbl-gov-audit','audit-log')"><i class="fa-solid fa-download" style="margin-right:6px"></i>CSV</button></div>
      <div class="tbl-wrap">
        <table id="tbl-gov-audit">
          <thead><tr><th>Waktu</th><th>Score</th><th>Status</th><th>Gagal</th></tr></thead>
          <tbody id="tbody-gov-audit"></tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3><i class="fa-solid fa-shield-halved" style="color:var(--blue);margin-right:8px"></i>Security Policy & Recovery Mode</h3></div>
    <div class="card-body" id="gov-policy">
      <div class="grid-2-eq">
        <div>
          <div class="inp-label">Recovery Mode (config.py)</div>
          <select class="inp" id="gov-recovery-mode" onchange="Panels.gov.setRecoveryMode(this.value)">
            <option value="Semi-Auto" selected>Semi-Auto (Human-in-Loop)</option>
            <option value="Advisory">Advisory (Saran Saja)</option>
            <option value="Full-Auto">Full-Auto (Eksekusi Otonom)</option>
          </select>
          <div class="insight-box" style="margin-top:8px"><b>Aktif:</b> Semi-Auto · AI hanya merekomendasikan, operator wajib approve sebelum eksekusi.</div>
        </div>
        <div>
          <div class="inp-label">Enterprise Apps Terpantau</div>
          <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px">
            <span class="tag tag-blue">ERP</span><span class="tag tag-blue">HRIS</span><span class="tag tag-blue">Accounting</span><span class="tag tag-blue">Inventory</span><span class="tag tag-blue">POS</span><span class="tag tag-blue">Office</span><span class="tag tag-blue">Browser</span><span class="tag tag-blue">Email Client</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="card" style="margin-top:12px">
    <div class="card-header"><h3><i class="fa-solid fa-chart-bar" style="color:var(--blue);margin-right:8px"></i>SLA Compliance Chart</h3></div>
    <div class="card-body"><div class="chart-box"><canvas id="chart-sla" style="max-height:140px"></canvas></div></div>
  </div>
</div>

<!-- ============================================================
     PANEL: SOP LIFECYCLE
============================================================ -->
<div id="p-sop" class="panel">
  <div class="kpi-row kpi-row-3">
    <div class="kpi-card kpi-gr"><i class="kpi-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></i><div class="kpi-label">SOP Aktif</div><div class="kpi-val" id="sop-active-kpi">—</div></div>
    <div class="kpi-card kpi-or"><i class="kpi-icon"><i class="fa-solid fa-file-invoice" style="color:var(--orange)"></i></i><div class="kpi-label">SOP Draft</div><div class="kpi-val" id="sop-draft-kpi">—</div></div>
    <div class="kpi-card kpi-pu"><i class="kpi-icon"><i class="fa-solid fa-rotate" style="color:var(--purple)"></i></i><div class="kpi-label">Pending Review</div><div class="kpi-val" id="sop-review-kpi">—</div></div>
  </div>
  <div class="grid-2-eq">
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-file-invoice" style="color:var(--orange);margin-right:8px"></i>SOP DRAFT — Auto-Generated</h3><span class="badge bd-or" id="sop-draft-badge">—</span></div>
      <div class="card-body" id="sop-draft-list" style="max-height:320px;overflow-y:auto"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-circle-check" style="color:var(--green);margin-right:8px"></i>SOP AKTIF — Orchestrator</h3><span class="badge bd-gr" id="sop-active-badge">—</span></div>
      <div class="card-body" id="sop-active-list" style="max-height:320px;overflow-y:auto"></div>
    </div>
  </div>
  <div class="card" style="margin-top:12px">
    <div class="card-header"><h3><i class="fa-solid fa-plus" style="color:var(--blue);margin-right:8px"></i>Buat SOP Manual</h3></div>
    <div class="card-body">
      <div class="grid-2-eq">
        <div><label class="inp-label">Nama SOP</label><input class="inp" id="sop-new-name" placeholder="Nama SOP baru..."></div>
        <div><label class="inp-label">Trigger Event</label><input class="inp" id="sop-new-trigger" placeholder="Contoh: SYSTEM_OFFLINE, QUEUE_FULL..."></div>
      </div>
      <div style="margin-top:8px"><label class="inp-label">Deskripsi SOP</label><textarea class="inp" id="sop-new-desc" rows="2" placeholder="Langkah-langkah SOP..."></textarea></div>
      <div style="margin-top:8px;display:flex;gap:8px">
        <button class="btn btn-primary" onclick="Panels.sop.create()"><i class="fa-solid fa-circle-check" style="margin-right:6px"></i>Buat SOP Draft</button>
        <button class="btn btn-ghost" onclick="Panels.sop.clearForm()"><i class="fa-solid fa-trash-can" style="margin-right:6px"></i>Clear</button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     PANEL: MODEL CONFIG
============================================================ -->
<div id="p-models" class="panel">
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h3>⚙️ Model AI Terkonfigurasi</h3><button class="btn btn-primary btn-sm" onclick="Panels.models.save()">💾 Save Config</button></div>
      <div class="card-body" id="model-config-list"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fa-solid fa-key" style="color:var(--blue);margin-right:8px"></i>Status & Test API Keys</h3></div>
      <div class="card-body" id="model-key-status"></div>
    </div>
  </div>
  <div class="card" style="margin-top:12px">
    <div class="card-header"><h3>🏗 Konfigurasi Sistem (config.py)</h3></div>
    <div class="card-body" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px" id="sys-config-grid">
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Orchestrator Port</div><div style="font-size:15px;font-weight:700;color:var(--blue2)">:18800</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Dashboard Port</div><div style="font-size:15px;font-weight:700;color:var(--blue2)">:9999</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Ingestion / OTA Port</div><div style="font-size:15px;font-weight:700;color:var(--blue2)">:8800</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Netdata Master</div><div style="font-size:15px;font-weight:700;color:var(--cyan2)">:19999</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">NATS JetStream</div><div style="font-size:15px;font-weight:700;color:var(--purple2)">:4222</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Redis Broker</div><div style="font-size:15px;font-weight:700;color:var(--red2)">:6379</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">PostgreSQL DB</div><div style="font-size:15px;font-weight:700;color:var(--green2)">osi_system</div></div>
      <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Recovery Mode</div><div style="font-size:15px;font-weight:700;color:var(--orange2)">Semi-Auto</div></div>
    </div>
  </div>
  <div class="card" style="margin-top:12px">
    <div class="card-header">
      <h3><i class="fa-solid fa-desktop" style="color:var(--blue);margin-right:8px"></i>Remote Access Tools</h3>
      <div style="display:flex;gap:6px;align-items:center">
        <span id="launcher-status-badge" class="tag tag-gray" style="font-size:10px; cursor:pointer" onclick="RemoteSettings.retryConnection()" title="Klik untuk menghubungkan ulang">⏳ Checking...</span>
        <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.open()" title="Remote Access Settings" style="display:flex;align-items:center;gap:4px;padding:4px 10px">
          <i class="fa-solid fa-gears" style="margin-right:4px"></i> <span style="font-size:11px">Pengaturan</span>
        </button>
      </div>
    </div>
    <div class="card-body">
      <div style="margin-bottom:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <select class="inp" style="width:220px" id="remote-target-select"><option value="">Pilih device target...</option></select>
        <span style="font-size:10.5px;color:var(--txt2);align-self:center">Target IP: <b id="remote-tools-target-ip" style="color:var(--blue2)">—</b></span>
        <span style="font-size:10px;color:var(--txt3);align-self:center" id="remote-anydesk-id-display"></span>
        <span style="font-size:10px;color:var(--txt3);align-self:center" id="remote-rustdesk-id-display"></span>
      </div>
      <div class="remote-grid" id="remote-grid">
        <div class="remote-btn" id="remote-btn-rustdesk" onclick="Remote.launch('rustdesk')"><span class="ri"><i class="fa-solid fa-desktop" style="color:var(--orange2)"></i></span>RustDesk</div>
        <div class="remote-btn" id="remote-btn-anydesk" onclick="Remote.launch('anydesk')"><span class="ri"><i class="fa-solid fa-tower-broadcast" style="color:var(--red2)"></i></span>AnyDesk</div>
        <div class="remote-btn" id="remote-btn-vnc" onclick="Remote.launch('vnc')"><span class="ri"><i class="fa-solid fa-plug" style="color:var(--purple2)"></i></span>VNC Viewer</div>
        <div class="remote-btn" id="remote-btn-rdp" onclick="Remote.launch('rdp')"><span class="ri"><i class="fa-brands fa-windows" style="color:var(--blue2)"></i></span>RDP</div>
        <div class="remote-btn" id="remote-btn-explorer" onclick="Remote.launch('explorer')"><span class="ri"><i class="fa-solid fa-folder-open" style="color:var(--yellow2)"></i></span>Explorer</div>
        <div class="remote-btn" id="remote-btn-logs" onclick="Remote.launch('logs')"><span class="ri"><i class="fa-solid fa-file-lines" style="color:var(--txt2)"></i></span>Logs</div>
        <div class="remote-btn" id="remote-btn-settings" onclick="Remote.launch('settings')"><span class="ri"><i class="fa-solid fa-gears" style="color:var(--cyan2)"></i></span>Settings</div>
        <div class="remote-btn" id="remote-btn-detect" onclick="Remote.launch('detect')"><span class="ri"><i class="fa-solid fa-magnifying-glass" style="color:var(--green2)"></i></span>Detect</div>
      </div>
      <div id="remote-result" style="margin-top:10px;font-size:11px;color:var(--txt2)"></div>
    </div>
  </div>

<!-- ============================================================
     REMOTE SETTINGS MODAL
============================================================ -->
<div id="modal-remote-settings" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);overflow:auto" onclick="if(event.target===this)RemoteSettings.close()">
  <div style="background:var(--bg2);border:1px solid var(--bd2);border-radius:12px;max-width:720px;margin:40px auto;padding:0;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.6)">
    <!-- Modal Header -->
    <div style="background:linear-gradient(90deg,var(--blue2)15%,var(--purple2)100%);padding:16px 20px;display:flex;justify-content:space-between;align-items:center">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:20px"><i class="fa-solid fa-gears" style="color:#fff"></i></span>
        <div>
          <div style="font-weight:700;font-size:14px;color:#fff">Remote Access Settings</div>
          <div style="font-size:10px;color:rgba(255,255,255,.7)">Konfigurasi tool, koneksi & keamanan</div>
        </div>
      </div>
      <button onclick="RemoteSettings.close()" style="background:rgba(255,255,255,.15);border:none;color:#fff;width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center">×</button>
    </div>
    <!-- Tab Navigation -->
    <div style="display:flex;gap:0;border-bottom:1px solid var(--bd);background:var(--bg3);overflow-x:auto" id="rs-tab-nav">
      <button class="rs-tab-btn rs-tab-active" onclick="RemoteSettings.switchTab('general')" id="rs-tab-general" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt);border-bottom:2px solid var(--blue2);white-space:nowrap"><i class="fa-solid fa-gears" style="margin-right:4px"></i>General</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('anydesk')" id="rs-tab-anydesk" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap"><i class="fa-solid fa-tower-broadcast" style="margin-right:4px"></i>AnyDesk</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('rustdesk')" id="rs-tab-rustdesk" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap"><i class="fa-solid fa-desktop" style="margin-right:4px"></i>RustDesk</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('vnc')" id="rs-tab-vnc" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap"><i class="fa-solid fa-plug" style="margin-right:4px"></i>VNC</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('siterouter')" id="rs-tab-siterouter" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap">🌐 Site Router</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('devicelist')" id="rs-tab-devicelist" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap"><i class="fa-solid fa-desktop" style="margin-right:4px"></i>Device Registry</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('security')" id="rs-tab-security" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap"><i class="fa-solid fa-shield-halved" style="margin-right:4px"></i>Security</button>
      <button class="rs-tab-btn" onclick="RemoteSettings.switchTab('testconn')" id="rs-tab-testconn" style="padding:10px 14px;font-size:11px;border:none;cursor:pointer;background:transparent;color:var(--txt2);border-bottom:2px solid transparent;white-space:nowrap">🔍 Test Koneksi</button>
    </div>
    <!-- Tab Content -->
    <div style="padding:20px;max-height:500px;overflow-y:auto">

      <!-- TAB: GENERAL -->
      <div id="rs-pane-general">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px"><i class="fa-solid fa-gears" style="margin-right:6px"></i>Pengaturan Umum</div>
        <div style="margin-bottom:14px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px">Default Remote Tool</div>
          <div style="display:flex;gap:16px">
            <label style="display:flex;align-items:center;gap:6px;font-size:11.5px;cursor:pointer"><input type="radio" name="rs-default-tool" value="rustdesk" id="rs-dt-rustdesk" checked> <i class="fa-solid fa-desktop" style="margin-right:4px"></i>RustDesk</label>
            <label style="display:flex;align-items:center;gap:6px;font-size:11.5px;cursor:pointer"><input type="radio" name="rs-default-tool" value="anydesk" id="rs-dt-anydesk"> <i class="fa-solid fa-tower-broadcast" style="margin-right:4px"></i>AnyDesk</label>
            <label style="display:flex;align-items:center;gap:6px;font-size:11.5px;cursor:pointer"><input type="radio" name="rs-default-tool" value="vnc" id="rs-dt-vnc"> <i class="fa-solid fa-plug" style="margin-right:4px"></i>VNC</label>
            <label style="display:flex;align-items:center;gap:6px;font-size:11.5px;cursor:pointer"><input type="radio" name="rs-default-tool" value="rdp" id="rs-dt-rdp"> <i class="fa-brands fa-windows" style="margin-right:4px"></i>RDP</label>
          </div>
        </div>
        <div style="margin-bottom:14px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px">Behavior</div>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" id="rs-auto-launch" checked> Auto Launch Remote</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" id="rs-auto-connect" checked> Auto Connect</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer"><input type="checkbox" id="rs-remember-device" checked> Remember Last Device</label>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div><div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Connection Timeout (detik)</div><input class="inp" type="number" id="rs-timeout" value="30" min="5" max="120" style="width:100%"></div>
          <div><div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Retry Count</div><input class="inp" type="number" id="rs-retry" value="3" min="1" max="10" style="width:100%"></div>
        </div>
      </div>

      <!-- TAB: ANYDESK -->
      <div id="rs-pane-anydesk" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px"><i class="fa-solid fa-tower-broadcast" style="margin-right:6px"></i>AnyDesk Configuration</div>
        <div style="margin-bottom:12px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Executable Path</div>
          <div style="display:flex;gap:6px">
            <input class="inp" id="rs-anydesk-path" value="C:\Program Files (x86)\AnyDesk\AnyDesk.exe" style="flex:1">
            <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.autoDetect('anydesk')">🔍 Auto Detect</button>
          </div>
        </div>
        <div style="margin-bottom:12px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Default Password</div>
          <div style="display:flex;gap:6px">
            <input class="inp" id="rs-anydesk-pass" type="password" placeholder="Password unattended access" style="flex:1">
            <button class="btn btn-ghost btn-sm" onclick="const i=document.getElementById('rs-anydesk-pass');i.type=i.type==='password'?'text':'password'">👁</button>
          </div>
        </div>
        <div style="margin-bottom:14px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:6px">Features</div>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" id="rs-ad-remember-pass" checked> Remember Password</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" id="rs-ad-unattended" checked> Use Unattended Access</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer"><input type="checkbox" id="rs-ad-fullscreen" checked> Launch Fullscreen</label>
        </div>
        <button class="btn btn-primary btn-sm" onclick="RemoteSettings.testTool('anydesk')">🔍 Test AnyDesk</button>
        <span id="rs-anydesk-test-result" style="font-size:11px;margin-left:10px"></span>
      </div>

      <!-- TAB: RUSTDESK -->
      <div id="rs-pane-rustdesk" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px"><i class="fa-solid fa-desktop" style="margin-right:6px"></i>RustDesk Configuration</div>
        <div style="margin-bottom:12px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Executable Path</div>
          <div style="display:flex;gap:6px">
            <input class="inp" id="rs-rustdesk-path" value="C:\Program Files\RustDesk\rustdesk.exe" style="flex:1">
            <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.autoDetect('rustdesk')">🔍 Auto Detect</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
          <div><div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Relay Server</div><input class="inp" id="rs-rd-relay" value="relay.rustdesk.com" style="width:100%"></div>
          <div><div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">API Server</div><input class="inp" id="rs-rd-api" value="api.rustdesk.com" style="width:100%"></div>
        </div>
        <div style="margin-bottom:12px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Encryption Key</div>
          <div style="display:flex;gap:6px">
            <input class="inp" id="rs-rd-key" type="password" placeholder="Paste RustDesk encryption key" style="flex:1">
            <button class="btn btn-ghost btn-sm" onclick="const i=document.getElementById('rs-rd-key');i.type=i.type==='password'?'text':'password'">👁</button>
          </div>
        </div>
        <div style="margin-bottom:14px">
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" id="rs-rd-remember" checked> Remember Password</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer"><input type="checkbox" id="rs-rd-autoconn" checked> Auto Connect</label>
        </div>
        <button class="btn btn-primary btn-sm" onclick="RemoteSettings.testTool('rustdesk')">🔍 Test RustDesk</button>
        <span id="rs-rustdesk-test-result" style="font-size:11px;margin-left:10px"></span>
      </div>

      <!-- TAB: VNC -->
      <div id="rs-pane-vnc" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px"><i class="fa-solid fa-plug" style="margin-right:6px"></i>VNC Configuration</div>
        <div style="margin-bottom:12px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Preferred Viewer</div>
          <select class="inp" id="rs-vnc-viewer" style="width:200px">
            <option value="ultravnc">UltraVNC</option>
            <option value="tigervnc">TigerVNC</option>
            <option value="realvnc">RealVNC</option>
          </select>
        </div>
        <div style="margin-bottom:12px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Executable Path</div>
          <div style="display:flex;gap:6px">
            <input class="inp" id="rs-vnc-path" value="C:\Program Files\UltraVNC\vncviewer.exe" style="flex:1">
            <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.autoDetect('vnc')">🔍 Auto Detect</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:120px 1fr;gap:10px;margin-bottom:12px">
          <div><div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Default Port</div><input class="inp" id="rs-vnc-port" type="number" value="5900" style="width:100%"></div>
          <div><div style="font-size:10.5px;color:var(--txt3);margin-bottom:4px">Default Password</div>
            <div style="display:flex;gap:6px"><input class="inp" id="rs-vnc-pass" type="password" placeholder="VNC password" style="flex:1">
            <button class="btn btn-ghost btn-sm" onclick="const i=document.getElementById('rs-vnc-pass');i.type=i.type==='password'?'text':'password'">👁</button></div>
          </div>
        </div>
        <div style="margin-bottom:14px">
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer"><input type="checkbox" id="rs-vnc-remember" checked> Remember Password</label>
        </div>
        <button class="btn btn-primary btn-sm" onclick="RemoteSettings.testTool('vnc')">🔍 Test VNC</button>
        <span id="rs-vnc-test-result" style="font-size:11px;margin-left:10px"></span>
      </div>

      <!-- TAB: SITE ROUTER -->
      <div id="rs-pane-siterouter" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px">🌐 Site Management</div>
        <div style="overflow-x:auto;margin-bottom:12px">
          <table style="width:100%;font-size:11px;border-collapse:collapse" id="rs-site-table">
            <thead><tr style="background:var(--bg3)">
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Site Name</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Gateway</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Subnet</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Tool</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Aksi</th>
            </tr></thead>
            <tbody id="rs-site-tbody">
              <tr style="font-size:10.5px">
                <td style="padding:6px 8px;border:1px solid var(--bd)">Head Office</td>
                <td style="padding:6px 8px;border:1px solid var(--bd)">10.20.0.1</td>
                <td style="padding:6px 8px;border:1px solid var(--bd)">10.20.0.0/24</td>
                <td style="padding:6px 8px;border:1px solid var(--bd)"><span class="tag tag-blue">RustDesk</span></td>
                <td style="padding:6px 8px;border:1px solid var(--bd)"><button class="btn btn-ghost btn-xs" onclick="Notify.toast('ℹ Info','Edit site belum tersedia','info')">✏ Edit</button></td>
              </tr>
              <tr style="font-size:10.5px">
                <td style="padding:6px 8px;border:1px solid var(--bd)">Kantor Cabang</td>
                <td style="padding:6px 8px;border:1px solid var(--bd)">192.168.1.1</td>
                <td style="padding:6px 8px;border:1px solid var(--bd)">192.168.1.0/24</td>
                <td style="padding:6px 8px;border:1px solid var(--bd)"><span class="tag tag-purple">AnyDesk</span></td>
                <td style="padding:6px 8px;border:1px solid var(--bd)"><button class="btn btn-ghost btn-xs" onclick="Notify.toast('ℹ Info','Edit site belum tersedia','info')">✏ Edit</button></td>
              </tr>
            </tbody>
          </table>
        </div>
        <button class="btn btn-success btn-sm" onclick="RemoteSettings.addSite()">+ Add Site</button>
        <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.syncAllRoutes()"><i class="fa-solid fa-rotate" style="margin-right:4px"></i>Sync All Routes</button>
      </div>

      <!-- TAB: DEVICE LIST (MANUAL REGISTRY) -->
      <div id="rs-pane-devicelist" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px">🖥️ Device Registry</div>
        <div style="overflow-x:auto;margin-bottom:12px;max-height:220px;overflow-y:auto">
          <table style="width:100%;font-size:11px;border-collapse:collapse;border:1px solid var(--bd)" id="rs-device-table">
            <thead><tr style="background:var(--bg3)">
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Device Name</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Site</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">IP PC</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd)">Remote IDs</th>
              <th style="padding:8px;text-align:left;border:1px solid var(--bd);width:100px">Aksi</th>
            </tr></thead>
            <tbody id="rs-device-tbody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
        <button class="btn btn-success btn-sm" onclick="RemoteSettings.addDevice()">+ Add Device</button>
      </div>

      <!-- TAB: SECURITY -->
      <div id="rs-pane-security" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px"><i class="fa-solid fa-shield-halved" style="margin-right:6px"></i>Security & Encryption</div>
        <div style="background:var(--glass);border-radius:8px;padding:14px;margin-bottom:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <span style="font-size:11.5px;font-weight:600">Master Key Status</span>
            <span class="tag tag-green">✅ Configured</span>
          </div>
          <div style="font-size:10.5px;color:var(--txt2);display:grid;grid-template-columns:1fr 1fr;gap:6px">
            <div>Encryption: <b style="color:var(--green2)">AES-256-GCM</b></div>
            <div>Last Rotated: <b style="color:var(--txt)">2026-06-01</b></div>
            <div>Salt: <b style="color:var(--txt)">Random (16 bytes)</b></div>
            <div>Integrity: <b style="color:var(--green2)">✅ Enabled</b></div>
          </div>
        </div>
        <div style="margin-bottom:14px">
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">Key Management</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="btn btn-ghost btn-sm" onclick="Notify.toast('🔄 Rotate Key','Key rotation memerlukan konfirmasi admin','warn')">🔄 Rotate Key</button>
            <button class="btn btn-ghost btn-sm" onclick="Notify.toast('💾 Backup','Backup key disimpan ke file terenkripsi','ok')">💾 Backup Key</button>
            <button class="btn btn-ghost btn-sm" onclick="Notify.toast('📥 Import','Import key dari file terenkripsi','info')">📥 Import Key</button>
          </div>
        </div>
        <div>
          <div style="font-size:10.5px;color:var(--txt3);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">Password Policies</div>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" checked disabled> Never save plaintext passwords</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer;margin-bottom:6px"><input type="checkbox" checked disabled> Encrypt passwords at rest</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;cursor:pointer"><input type="checkbox" id="rs-sec-clear-cache"> Clear cache on logout</label>
        </div>
        <div style="margin-top:14px;background:rgba(255,170,0,.08);border:1px solid rgba(255,170,0,.3);border-radius:6px;padding:10px;font-size:10.5px;color:var(--orange2)">
          ⚠️ <b>WARNING:</b> Jangan share master key kepada siapapun!
        </div>
      </div>

      <!-- TAB: TEST CONNECTION -->
      <div id="rs-pane-testconn" style="display:none">
        <div style="font-size:11.5px;font-weight:700;color:var(--blue2);margin-bottom:14px">🔍 Test Connection Status</div>
        <div id="rs-testconn-results" style="display:grid;gap:10px">
          <div class="rs-tool-status" id="rs-status-anydesk">
            <div style="display:flex;justify-content:space-between;align-items:center;background:var(--glass);border-radius:8px;padding:12px">
              <div>
                <div style="font-weight:600;font-size:12px;margin-bottom:4px"><i class="fa-solid fa-tower-broadcast" style="margin-right:6px"></i>AnyDesk</div>
                <div style="font-size:10.5px;color:var(--txt2)" id="rs-anydesk-status-detail">Belum ditest...</div>
              </div>
              <span class="tag tag-gray" id="rs-anydesk-status-tag">UNKNOWN</span>
            </div>
          </div>
          <div class="rs-tool-status" id="rs-status-rustdesk">
            <div style="display:flex;justify-content:space-between;align-items:center;background:var(--glass);border-radius:8px;padding:12px">
              <div>
                <div style="font-weight:600;font-size:12px;margin-bottom:4px"><i class="fa-solid fa-desktop" style="margin-right:6px"></i>RustDesk</div>
                <div style="font-size:10.5px;color:var(--txt2)" id="rs-rustdesk-status-detail">Belum ditest...</div>
              </div>
              <span class="tag tag-gray" id="rs-rustdesk-status-tag">UNKNOWN</span>
            </div>
          </div>
          <div class="rs-tool-status" id="rs-status-vnc">
            <div style="display:flex;justify-content:space-between;align-items:center;background:var(--glass);border-radius:8px;padding:12px">
              <div>
                <div style="font-weight:600;font-size:12px;margin-bottom:4px"><i class="fa-solid fa-plug" style="margin-right:6px"></i>VNC</div>
                <div style="font-size:10.5px;color:var(--txt2)" id="rs-vnc-status-detail">Belum ditest...</div>
              </div>
              <span class="tag tag-gray" id="rs-vnc-status-tag">UNKNOWN</span>
            </div>
          </div>
          <div class="rs-tool-status" id="rs-status-rdp">
            <div style="display:flex;justify-content:space-between;align-items:center;background:var(--glass);border-radius:8px;padding:12px">
              <div>
                <div style="font-weight:600;font-size:12px;margin-bottom:4px"><i class="fa-brands fa-windows" style="margin-right:6px"></i>RDP (MSTSC)</div>
                <div style="font-size:10.5px;color:var(--txt2)" id="rs-rdp-status-detail">Belum ditest...</div>
              </div>
              <span class="tag tag-gray" id="rs-rdp-status-tag">UNKNOWN</span>
            </div>
          </div>
        </div>
        <div style="margin-top:14px;display:flex;gap:8px">
          <button class="btn btn-primary btn-sm" onclick="RemoteSettings.testAllConnections()"><i class="fa-solid fa-rotate" style="margin-right:4px"></i>Test Semua</button>
          <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.close()"><i class="fa-solid fa-xmark" style="margin-right:4px"></i>Tutup</button>
        </div>
      </div>

    </div>
    <!-- Modal Footer -->
    <div style="background:var(--bg3);border-top:1px solid var(--bd);padding:12px 20px;display:flex;justify-content:space-between;align-items:center">
      <div style="font-size:10.5px;color:var(--txt3)"><i class="fa-solid fa-lightbulb" style="margin-right:4px"></i>Pengaturan disimpan terenkripsi di server</div>
      <div style="display:flex;gap:8px">
        <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.reset()"><i class="fa-solid fa-arrow-rotate-left" style="margin-right:4px"></i>Reset Default</button>
        <button class="btn btn-ghost btn-sm" onclick="RemoteSettings.close()"><i class="fa-solid fa-xmark" style="margin-right:4px"></i>Batal</button>
        <button class="btn btn-primary btn-sm" onclick="RemoteSettings.save()"><i class="fa-solid fa-floppy-disk" style="margin-right:4px"></i>Simpan</button>
      </div>
    </div>
  </div>
</div>
</div>

    </div><!-- /main-content -->
  </div><!-- /content -->
</div><!-- /shell -->

<!-- ============================================================
     JAVASCRIPT — PRODUCTION ENGINE
============================================================ -->
<script>
'use strict';

/* ==================================================
   CONFIG
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var CFG = {
  API: window.location.origin,
  REFRESH_MS: 30000,
  LOG_MAX: 500,
  GATEWAY_TO_SITE: {},
  SITES: [],
  AI_MODELS: [
    {key:'deepseek',name:'DeepSeek (Opus)',url:'api.deepseek.com',enabled:true,icon:'<i class="fa-solid fa-robot" style="color:var(--pink);margin-right:6px"></i>'},
    {key:'gemini',name:'Google Gemini',url:'generativelanguage.googleapis.com',enabled:false,icon:'<i class="fa-solid fa-sparkles" style="color:var(--blue2);margin-right:6px"></i>'},
    {key:'groq',name:'Groq (Llama-3.1)',url:'api.groq.com',enabled:false,icon:'<i class="fa-solid fa-bolt" style="color:var(--orange2);margin-right:6px"></i>'}
  ],
  OFFLINE_DEVICES: []
};

/* ==================================================
   EVENT BUS
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Bus = {
  _h: {},
  on(ev, fn) { (this._h[ev] = this._h[ev]||[]).push(fn); },
  off(ev, fn) { if(this._h[ev]) this._h[ev] = this._h[ev].filter(f=>f!==fn); },
  emit(ev, data) { (this._h[ev]||[]).forEach(fn=>{ try{fn(data)}catch(e){} }); }
};

/* ==================================================
   WEBSOCKET SERVICE (Native Browser Implementation)
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
const WSService = {
  socket: null,
  connect() {
    if (this.socket && (this.socket.readyState === WebSocket.OPEN || this.socket.readyState === WebSocket.CONNECTING)) return;
    this._setStatus('connecting');
    try {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      this.socket = new WebSocket(`${protocol}//${window.location.host}/ws/logs`);

      this.socket.onopen = () => {
        this._setStatus('online');
        LogStreamer.add('OK', 'WS', 'WebSocket connected (Native)');
        Bus.emit('ws:connected');
      };

      this.socket.onclose = () => {
        this._setStatus('offline');
        Bus.emit('ws:disconnected');
        // Auto-reconnect after 3 seconds
        setTimeout(() => this.connect(), 3000);
      };

      this.socket.onerror = () => {
        this._setStatus('connecting');
      };

      this.socket.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.event === 'system_log') {
            let severity = 'INFO';
            const data = msg.data;
            if (data.type === 'warning' || data.type === 'warn') severity = 'WARN';
            else if (data.type === 'critical' || data.type === 'err' || data.type === 'error') severity = 'ERR';
            else if (data.type === 'ok' || data.type === 'success') severity = 'OK';
            else if (data.type === 'debug') severity = 'DEBUG';
            
            let src = 'SYS';
            if (data.category) {
              src = data.category;
            }
            Bus.emit('log:entry', {type: severity, src: src, message: data.message});
          } else if (msg.event === 'incident_event') {
            const data = msg.data;
            let severity = 'INFO';
            if (data.type === 'critical') severity = 'ERR';
            else if (data.type === 'warning') severity = 'WARN';
            else if (data.type === 'RESOLVED') severity = 'OK';
            else if (data.type === 'ESCALATED') severity = 'WARN';

            Bus.emit('log:entry', {type: severity, src: 'NETDATA', message: data.message});

            let toastType = 'info';
            if (data.type === 'critical') toastType = 'crit';
            else if (data.type === 'warning' || data.type === 'ESCALATED') toastType = 'warn';
            else if (data.type === 'RESOLVED') toastType = 'ok';

            Notify.toast(
              data.type === 'critical' ? '🚨 Critical' : (data.type === 'RESOLVED' ? '✅ Resolved' : '⚠️ Alert'),
              data.message,
              toastType
            );
            DataService.loadIncidents();
          } else if (msg.event === 'devices_update') {
            const devices = msg.data;
            DataService._devices = devices;
            DataService._updateDeviceBadges(devices);
            Bus.emit('devices:loaded', devices);
          } else if (msg.event === 'metrics_update') {
            const data = msg.data;
            if (data.resolved_tickets !== undefined) {
              setEl('kpi-ticket', data.resolved_tickets);
            }
            if (data.active_events !== undefined) {
              setEl('kpi-incidents', data.active_events);
              setEl('kpi-incidents-s', data.active_events > 0 ? '↓ ' + data.active_events + ' active incidents' : '✓ No active incidents');
              setEl('ov-inc-tag', data.active_events + ' aktif');
            }
            if (data.confidence_score !== undefined) {
              setEl('kpi-aiconf', data.confidence_score + '%');
            }
            if (data.rca_accuracy !== undefined) {
              setEl('kpi-health', data.rca_accuracy + '%');
            }
          } else if (msg.event === 'live_telemetry') {
            if (Panels.activity && Panels.activity.handleLiveTelemetry) {
              Panels.activity.handleLiveTelemetry(msg.data);
            }
          }
        } catch (jsonErr) {
          console.warn("WS JSON Parse Error:", jsonErr);
        }
      };
    } catch(e) {
      this._setStatus('offline');
    }
  },
  _setStatus(s) {
    const pill = document.getElementById('ws-pill');
    const dot = document.getElementById('ws-dot');
    const txt = document.getElementById('ws-txt');
    const clsMap = {online:'ws-online',offline:'ws-offline',connecting:'ws-connecting'};
    const dotCls = {online:'dot-green',offline:'dot-red',connecting:'dot-orange'};
    const label = {online:'WS Live',offline:'WS Offline',connecting:'Connecting...'};
    if(pill) pill.className = 'ws-indicator '+clsMap[s];
    if(dot) dot.className = 'dot '+dotCls[s];
    if(txt) txt.textContent = label[s];
    const connDot = document.getElementById('conn-dot');
    if(connDot) connDot.className = 'dot '+(s==='online'?'dot-green':s==='offline'?'dot-red':'dot-orange');
  },
  disconnect() {
    if (this.socket) this.socket.close();
  },
  reconnect() {
    if (this.socket) {
      this.socket.connect();
    }
  }
};

/* ==================================================
   MOCK DATA SERVICE (abstraction layer)
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
// MockDataService was removed. Dashboard runs on live production database APIs only.

/* ==================================================
   DATA SERVICE (API + Fallback to Mock)
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var DataService = {
  _devices: [], _incidents: [], _health: null,
  async fetch(endpoint, opts={}) {
    try {
      const resp = await fetch(CFG.API+endpoint, {
        headers:{'Accept':'application/json','Content-Type':'application/json'},
        signal: AbortSignal.timeout(5000), ...opts
      });
      if(!resp.ok) throw new Error('HTTP '+resp.status);
      return await resp.json();
    } catch(e) { return null; }
  },
  async loadDevices() {
    let data = await this.fetch('/api/devices');
    if (data && !Array.isArray(data) && typeof data === 'object') {
      data = Object.keys(data).map(name => {
        const item = data[name];
        return {
          name: name,
          ip: item.data?.ip || '',
          location: item.data?.location || '',
          status: item.data?.status || 'OFFLINE',
          layer: item.data?.layer !== undefined ? item.data.layer : 1,
          cpu: item.data?.cpu !== undefined ? item.data.cpu : 0,
          ram: item.data?.ram !== undefined ? item.data.ram : 0,
          network: item.data?.network !== undefined ? item.data.network : 0,
          last_seen: item.timestamp || new Date().toISOString()
        };
      });
    } else if (!data || !Array.isArray(data)) {
      data = [];
    }
    this._devices = data;
    Bus.emit('devices:loaded', data);
    this._updateDeviceBadges(data);
    return data;
  },
  async loadIncidents() {
    let data = await this.fetch('/api/incidents');
    if(!data || !Array.isArray(data)) data = [];
    this._incidents = data;
    const active = data.filter(i=>i.status!=='RESOLVED'&&i.status!=='CLOSED'&&i.status!=='SOLVED VERIFIED');
    Bus.emit('incidents:loaded', data);
    document.getElementById('bdg-incident').textContent = active.length;
    document.getElementById('bdg-overview').textContent = active.length;
    document.getElementById('alert-count').textContent = active.length;
    return data;
  },
  async resolveIncident(incidentId, deviceName) {
    return this.fetch('/api/incident/resolve', {
      method: 'POST',
      body: JSON.stringify({ incident_id: incidentId, device_name: deviceName })
    });
  },
  async escalateIncident(incidentId, deviceName) {
    return this.fetch('/api/incident/escalate', {
      method: 'POST',
      body: JSON.stringify({ incident_id: incidentId, device_name: deviceName })
    });
  },
  async loadHealth() {
    let data = await this.fetch('/api/system/health');
    if(!data) data = {health_score:100,status:'HEALTHY',auditor_version:'v3.0',timestamp:new Date().toISOString(),components:{}};
    this._health = data;
    Bus.emit('health:loaded', data);
    return data;
  },
  async loadQueues() {
    let data = await this.fetch('/api/system/queues');
    if(!data) data = {metrics_queue_size:0,logs_queue_size:0,events_queue_size:0,load_shedding_level:0,processed_throughput_5s:0,avg_processing_latency_ms:0,error_rate_5s:0,dlq_rate_5s:0};
    Bus.emit('queues:loaded', data);
    return data;
  },
  async loadStorageStats() {
    let data = await this.fetch('/api/storage/stats');
    return data;
  },
  async loadPrinters() {
    let res = await this.fetch('/api/fleet/admin/printers');
    if (res && res.status === 'success' && Array.isArray(res.printers)) {
      return res.printers;
    }
    return [];
  },
  async loadAIStats() {
    return this.fetch('/api/ai/stats');
  },
  async loadAIConfig() {
    return this.fetch('/api/ai_config');
  },
  async saveAIConfig(config) {
    return this.fetch('/api/ai_config', {
      method: 'POST',
      body: JSON.stringify(config)
    });
  },
  async testAIKeyStatus() {
    return this.fetch('/api/ai_status');
  },
  async runAIDiagnose(query, evidence="") {
    return this.fetch('/api/offline/diagnose', {
      method: 'POST',
      body: JSON.stringify({ question: query, evidence: evidence })
    });
  },
  async loadFeedbackStats() {
    return this.fetch('/api/feedback/stats');
  },
  async submitFeedback(incidentId, score, aiRca="", humanRca="") {
    return this.fetch('/api/feedback', {
      method: 'POST',
      body: JSON.stringify({
        incident_id: incidentId,
        score: score,
        ai_rca: aiRca,
        human_rca: humanRca,
        reviewer: 'NOC_OPERATOR'
      })
    });
  },
  async loadAudits() {
    let data = await this.fetch('/api/system/audits');
    if(!data||!Array.isArray(data)) data = [];
    return data;
  },
  async loadServerLogs(limit = 100) {
    let data = await this.fetch(`/api/server/logs?limit=${limit}`);
    if(!data||!Array.isArray(data)) data = [];
    return data;
  },
  async loadRecoveryMode() {
    return this.fetch('/api/governance/recovery_mode');
  },
  async saveRecoveryMode(mode) {
    return this.fetch('/api/governance/recovery_mode', {
      method: 'POST',
      body: JSON.stringify({ recovery_mode: mode })
    });
  },
  async createSOP(name, trigger, desc) {
    return this.fetch('/api/governance/sops/create', {
      method: 'POST',
      body: JSON.stringify({ name, trigger, desc })
    });
  },
  async promoteSOP(name, trigger, desc) {
    return this.fetch('/api/governance/sops/promote', {
      method: 'POST',
      body: JSON.stringify({ name, trigger, desc })
    });
  },
  async deleteSOP(name) {
    return this.fetch('/api/governance/sops/delete', {
      method: 'POST',
      body: JSON.stringify({ name })
    });
  },
  async loadKPIMetrics() {
    let data = await this.fetch('/api/kpi_metrics');
    if(!data) {
      data = {
        global: {
          fcr_rate: 98.2,
          avg_confidence: 0.89,
          resolution_time_sec: 145,
          csat_rating: 4.8,
          kb_entries: 52
        }
      };
    }
    return data;
  },
  async loadHostMetrics() {
    let data = await this.fetch('/api/host_metrics');
    if(!data) {
      data = { cpu: 0, ram: 0, disk: 0, latency: 0 };
    }
    // Pastikan nilai numerik (backend bisa mengirim string "1.2")
    data.cpu     = parseFloat(data.cpu)     || 0;
    data.ram     = parseFloat(data.ram)     || 0;
    data.disk    = parseFloat(data.disk)    || 0;
    data.latency = parseFloat(data.latency) || 0;
    return data;
  },

  async loadPingSites() {
    let data = await this.fetch('/api/ping_sites');
    if(!data) {
      data = {
        '192.168.1.1': { status: 'ONLINE', latency: 28 },
        '192.168.4.1': { status: 'OFFLINE', latency: 0 },
        '192.168.10.1': { status: 'ONLINE', latency: 21 },
        '192.168.20.1': { status: 'OFFLINE', latency: 0 },
        '127.0.0.1': { status: 'ONLINE', latency: 31 }
      };
    }
    return data;
  },
  async pingAllSites() {
    // Alias for loadPingSites + update site grid UI
    const grid = document.getElementById('site-status-grid');
    if(grid) grid.innerHTML = '<div class="empty-state"><div class="es-icon">⏳</div><div class="es-text">Mengirim ping ke semua site...</div></div>';
    const pingData = await this.loadPingSites();
    if(!grid) return pingData;
    const siteMap = CFG.GATEWAY_TO_SITE;
    const entries = Object.entries(pingData);
    if(!entries.length) { grid.innerHTML = '<div class="empty-state"><div class="es-icon">❓</div><div class="es-text">Tidak ada data site</div></div>'; return pingData; }
    grid.innerHTML = entries.map(([gw, res]) => {
      const site = siteMap[gw] || gw;
      const ok = res.status === 'ONLINE';
      const clr = ok ? 'var(--green2)' : 'var(--red2)';
      const bg = ok ? 'rgba(34,197,94,.06)' : 'rgba(239,68,68,.06)';
      const brd = ok ? 'rgba(34,197,94,.2)' : 'rgba(239,68,68,.2)';
      return `<div style="background:${bg};border:1px solid ${brd};border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:4px">
        <div style="font-size:11.5px;font-weight:700;color:var(--txt)">${site}</div>
        <div style="font-size:10px;color:var(--txt3)">${gw}</div>
        <div style="display:flex;align-items:center;gap:5px;margin-top:2px">
          <span style="color:${clr};font-weight:600;font-size:10px">${ok ? '✅ ONLINE' : '❌ OFFLINE'}</span>
          ${ok ? `<span style="font-size:10px;color:var(--txt3)">${res.latency}ms</span>` : ''}
        </div>
        <button class="btn btn-ghost btn-xs" onclick="Panels.monitoring.pingSite('${gw}','${site}')" style="margin-top:4px;font-size:9.5px"><i class="fa-solid fa-signal"></i> Re-Ping</button>
      </div>`;
    }).join('');
    Notify.toast('<i class="fa-solid fa-signal"></i> Ping Sites', `Selesai — ${entries.filter(([,r])=>r.status==='ONLINE').length}/${entries.length} site online`, 'ok', 3000);
    LogStreamer.add('OK', 'PING', 'Ping all sites complete');
    return pingData;
  },
  async sendCommand(cmd, target, params={}) {
    const body = JSON.stringify({command:cmd,target,params});
    let data = await this.fetch('/api/orchestrator/command',{method:'POST',body});
    if(!data) data = {status:'ERROR',message:'Command relay service not available'};
    return data;
  },
  _updateDeviceBadges(devices) {
    const online = devices.filter(d=>d.status==='ONLINE').length;
    const offline = devices.filter(d=>d.status!=='ONLINE').length;
    const onlineEl = document.getElementById('kpi-online');
    const onlineSEl = document.getElementById('kpi-online-s');
    const totalEl = document.getElementById('kpi-total');
    if(onlineEl) onlineEl.textContent = online;
    if(onlineSEl) onlineSEl.textContent = `${online}/${devices.length} online`;
    if(totalEl) totalEl.textContent = devices.length;
    // Update alert count badge
    const alertBadge = document.getElementById('alert-count');
    if(alertBadge) alertBadge.textContent = offline > 0 ? offline : '—';
    if(alertBadge) alertBadge.style.background = offline > 0 ? 'rgba(239,68,68,.2)' : 'rgba(34,197,94,.15)';
    if(alertBadge) alertBadge.style.color = offline > 0 ? 'var(--red2)' : 'var(--green2)';
    document.getElementById('kpi-total-s').textContent = CFG.SITES.length+' sites';
    document.getElementById('tri-online').textContent = online;
    document.getElementById('tri-offline').textContent = offline;
    document.getElementById('fl-total').textContent = devices.length;
    document.getElementById('fl-offline').textContent = offline;
    // PC Health & Printers
    const printers = devices.filter(d=>d.name.toLowerCase().includes('printer')||(d.metadata&&d.metadata.type==='printer'));
    const pcs = devices.filter(d=>!d.name.toLowerCase().includes('printer')&&!(d.metadata&&d.metadata.type==='printer'));
    const offlinePcs = pcs.filter(d=>d.status!=='ONLINE').length;
    document.getElementById('bdg-printer').textContent = printers.length;
    const bdgPc = document.getElementById('bdg-pc');
    if (bdgPc) {
      bdgPc.textContent = offlinePcs > 0 ? offlinePcs + '!' : pcs.length;
      bdgPc.className = offlinePcs > 0 ? 'badge bd-rd' : 'badge bd-gr'; // red if any offline, green if all online
    }
  },
  async refreshAll() {
    Notify.toast('🔄 Refreshing...','Memuat ulang semua data','info',2000);
    LogStreamer.add('INFO','SYS','Manual refresh triggered');
    const [devices, incidents, health] = await Promise.all([
      this.loadDevices(), this.loadIncidents(), this.loadHealth()
    ]);
    const activePanel = document.querySelector('.panel.active');
    if(activePanel) {
      const pid = activePanel.id.replace('p-','');
      if(Panels[pid] && Panels[pid].load) Panels[pid].load();
    }
    updateLastRefresh();
  },
  reconnect() { WSService.reconnect(); }
};

/* ==================================================
   NOTIFICATION SERVICE
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Notify = {
  _supported: ('Notification' in window),
  _sounds: true,
  show(title, msg, type='info', duration=5000) {
    const types={crit:{css:'crit-toast',icon:'🚨',color:'var(--red)'},warn:{css:'warn-toast',icon:'⚠️',color:'var(--orange)'},ok:{css:'ok-toast',icon:'✅',color:'var(--green)'},info:{css:'info-toast',icon:'ℹ️',color:'var(--blue)'}};
    const t = types[type]||types.info;
    const id = 'toast-'+Date.now();
    const el = document.createElement('div');
    el.className = 'toast '+t.css;
    el.id = id;
    el.style.setProperty('--toast-color', t.color);
    el.innerHTML = `<span class="toast-icon">${t.icon}</span><div class="toast-content"><div class="toast-title">${title}</div><div class="toast-body">${msg}</div><div class="toast-progress"><div class="toast-progress-bar" style="width:100%;transition-duration:${duration}ms"></div></div></div><button class="toast-close" onclick="Notify.remove('${id}')">×</button>`;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => { el.querySelector('.toast-progress-bar').style.width='0%'; }, 50);
    if(duration>0) setTimeout(() => this.remove(id), duration+300);
    return id;
  },
  remove(id) { const el=document.getElementById(id); if(el){el.classList.add('removing');setTimeout(()=>el.remove(),250);} },
  toast(title, msg, type='info', duration=4000) { return this.show(title, msg, type, duration); },
  critical(title, msg) {
    this.show(title, msg, 'crit', 0);
    Modal.show(title, `<div style="text-align:center;padding:10px"><div style="font-size:40px;margin-bottom:12px">🚨</div><div style="font-size:14px;font-weight:600;color:var(--txt);margin-bottom:8px">${title}</div><div style="font-size:12px;color:var(--txt2)">${msg}</div></div>`,
      [{label:'Acknowledge',cls:'btn-danger',fn:'Modal.close()'}]);
    if(this._supported && Notification.permission==='granted') { new Notification(title,{body:msg,icon:''}).onclick=()=>{}; }
  },
  requestBrowserPermission() {
    if(this._supported && Notification.permission==='default') Notification.requestPermission();
  }
};

/* ==================================================
   MODAL
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
const Modal = {
  show(title, bodyHTML, buttons=[], icon='🔔') {
    document.getElementById('modal-title').textContent = title;
    document.getElementById('modal-icon').textContent = icon;
    document.getElementById('modal-body').innerHTML = bodyHTML;
    const footer = document.getElementById('modal-footer');
    footer.innerHTML = buttons.map(b=>`<button class="btn ${b.cls||'btn-ghost'}" onclick="${b.fn}">${b.label}</button>`).join('');
    if(!footer.innerHTML) footer.innerHTML = '<button class="btn btn-ghost" onclick="Modal.close()">Tutup</button>';
    document.getElementById('modal-overlay').classList.remove('hidden');
  },
  close() { document.getElementById('modal-overlay').classList.add('hidden'); },
  confirm(title, msg, onOk) {
    this.show(title, `<p style="font-size:12px;color:var(--txt2)">${msg}</p>`,
      [{label:'Konfirmasi',cls:'btn-danger',fn:'('+onOk.toString()+')()'},{label:'Batal',cls:'btn-ghost',fn:'Modal.close()'}]);
  }
};

/* ==================================================
   TABLE HELPER
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Tables = {
  _state: {},
  _getData(tableId) {
    const tbody = document.getElementById('tbody-'+tableId.replace('tbl-',''));
    if(!tbody) return [];
    return Array.from(tbody.querySelectorAll('tr:not(.hidden-row)'));
  },
  sort(th, tableId, colIdx) {
    const s = this._state[tableId] || {col:-1,dir:1};
    const dir = s.col===colIdx ? -s.dir : 1;
    this._state[tableId] = {col:colIdx,dir};
    const tbody = document.getElementById('tbody-'+tableId.replace('tbl-',''));
    if(!tbody) return;
    const rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort((a,b)=>{
      const av = (a.cells[colIdx]||{}).textContent||'';
      const bv = (b.cells[colIdx]||{}).textContent||'';
      const an = parseFloat(av.replace(/[^0-9.-]/g,'')), bn = parseFloat(bv.replace(/[^0-9.-]/g,''));
      if(!isNaN(an)&&!isNaN(bn)) return (an-bn)*dir;
      return av.localeCompare(bv)*dir;
    });
    rows.forEach(r=>tbody.appendChild(r));
    document.querySelectorAll('#'+tableId+' thead th').forEach((h,i)=>{h.classList.remove('sorted-asc','sorted-desc'); if(i===colIdx)h.classList.add(dir===1?'sorted-asc':'sorted-desc');});
  },
  filter(tableId, query) {
    this.applyFilters(tableId);
  },
  applyFilters(tableId) {
    const searchEl = document.getElementById(tableId.replace('tbl-','')+'-search') || document.getElementById('tri-search');
    const q = (searchEl || {value:''}).value.toLowerCase().trim();
    
    const sevSelect = document.getElementById('tri-filter-sev');
    const siteSelect = document.getElementById('tri-filter-site');
    const targetSev = sevSelect ? sevSelect.value : '';
    const targetSite = siteSelect ? siteSelect.value : '';

    const tbody = document.getElementById('tbody-'+tableId.replace('tbl-',''));
    if(!tbody) return;
    
    let visible = 0;
    const sevMap = {
      'CRITICAL': 'KRITIS',
      'HIGH': 'TINGGI',
      'MEDIUM': 'SEDANG',
      'LOW': 'RENDAH'
    };
    const mappedSev = sevMap[targetSev] || '';

    tbody.querySelectorAll('tr').forEach(tr=>{
      const site = tr.getAttribute('data-site') || '';
      const sev = tr.getAttribute('data-sev') || '';
      
      const matchQuery = !q || tr.textContent.toLowerCase().includes(q);
      const matchSev = !mappedSev || sev === mappedSev;
      const matchSite = !targetSite || site.toLowerCase().includes(targetSite.toLowerCase());
      
      const show = matchQuery && matchSev && matchSite;
      tr.classList.toggle('hidden-row', !show);
      if(show) visible++;
    });

    const cntEl = document.getElementById(tableId.replace('tbl-','').split('-')[0]+'-count-txt') || document.getElementById('tri-count-txt');
    if(cntEl) cntEl.textContent = visible + ' insiden';
  },
  exportCSV(tableId, filename) {
    const table = document.getElementById(tableId);
    if(!table) return;
    const rows = Array.from(table.querySelectorAll('tr:not(.hidden-row)'));
    const csv = rows.map(r=>Array.from(r.querySelectorAll('th,td')).map(c=>'"'+c.textContent.replace(/"/g,'""')+'"').join(',')).join('\n');
    this._download(csv, filename+'.csv', 'text/csv');
    Notify.toast('📥 Export','CSV berhasil didownload','ok',2500);
  },
  exportJSON(tableId, filename) {
    const table = document.getElementById(tableId);
    if(!table) return;
    const headers = Array.from(table.querySelectorAll('thead th')).map(h=>h.textContent.trim());
    const rows = Array.from(table.querySelectorAll('tbody tr:not(.hidden-row)')).map(r=>
      Object.fromEntries(Array.from(r.querySelectorAll('td')).map((c,i)=>[headers[i]||i,c.textContent.trim()]))
    );
    this._download(JSON.stringify(rows,null,2), filename+'.json', 'application/json');
    Notify.toast('📥 Export','JSON berhasil didownload','ok',2500);
  },
  exportExcel(tableId, filename) {
    if(typeof XLSX==='undefined'){Notify.toast('⚠️ Error','SheetJS tidak tersedia','warn');return;}
    const table = document.getElementById(tableId);
    if(!table) return;
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.table_to_sheet(table);
    XLSX.utils.book_append_sheet(wb, ws, 'Data');
    XLSX.writeFile(wb, filename+'.xlsx');
    Notify.toast('📥 Export','Excel berhasil didownload','ok',2500);
  },
  _download(content, filename, mime) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([content],{type:mime}));
    a.download = filename; a.click(); URL.revokeObjectURL(a.href);
  }
};

/* ==================================================
   CHART SERVICE
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Charts = {
  _charts: {},
  defaults() {
    Chart.defaults.color = '#8b9ab5';
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.font.size = 11;
    Chart.defaults.plugins.legend.labels.boxWidth = 10;
    Chart.defaults.plugins.legend.labels.padding = 12;
  },
  _resolveDatasets(datasets) {
    const resolveColor = (c) => {
      if (typeof c === 'string' && c.startsWith('var(')) {
        const varName = c.substring(4, c.length - 1);
        return getComputedStyle(document.documentElement).getPropertyValue(varName).trim() || c;
      }
      return c;
    };
    return datasets.map(ds => {
      const copy = { ...ds };
      if (copy.backgroundColor) {
        copy.backgroundColor = Array.isArray(copy.backgroundColor) 
          ? copy.backgroundColor.map(resolveColor) 
          : resolveColor(copy.backgroundColor);
      }
      if (copy.borderColor) {
        copy.borderColor = Array.isArray(copy.borderColor) 
          ? copy.borderColor.map(resolveColor) 
          : resolveColor(copy.borderColor);
      }
      if (!copy.hoverBackgroundColor && copy.backgroundColor) {
        copy.hoverBackgroundColor = copy.backgroundColor;
      }
      if (!copy.hoverBorderColor && copy.borderColor) {
        copy.hoverBorderColor = copy.borderColor;
      }
      return copy;
    });
  },
  create(id, type, labels, datasets, opts={}) {
    if(this._charts[id]) this._charts[id].destroy();
    const ctx = document.getElementById(id);
    if(!ctx) return null;
    const resolved = this._resolveDatasets(datasets);
    const chart = new Chart(ctx, {
      type, data:{labels,datasets:resolved},
      options:{
        responsive:true, maintainAspectRatio:true, animation:{duration:600},
        plugins:{
          legend:{display:!!opts.legend, position:'bottom'},
          tooltip:{callbacks:opts.tooltipCallbacks||{}}
        },
        scales: type==='bar'||type==='line' ? {
          x:{grid:{color:'rgba(255,255,255,.04)'},ticks:{color:'#4d5e7a'}},
          y:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#4d5e7a'},...(opts.yOpts||{})}
        } : {},
        ...opts
      }
    });
    this._charts[id] = chart;
    return chart;
  },
  update(id, labels, datasets) {
    const c = this._charts[id];
    if(!c) return;
    c.data.labels = labels;
    c.data.datasets = this._resolveDatasets(datasets);
    c.update('none');
  },
  addPoint(id, label, values) {
    const c = this._charts[id];
    if(!c) return;
    c.data.labels.push(label);
    values.forEach((v,i)=>{ if(c.data.datasets[i]) c.data.datasets[i].data.push(v); });
    if(c.data.labels.length > 30) { c.data.labels.shift(); c.data.datasets.forEach(ds=>ds.data.shift()); }
    c.update('none');
  },
  resetZoom(id) { const c = this._charts[id]; if(c) c.resetZoom&&c.resetZoom(); }
};

/* ==================================================
   LOG STREAMER
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var LogStreamer = {
  _logs: [], _paused: false, _filter: '', _srcFilter: '', _searchQ: '',
  _maxLogs: CFG.LOG_MAX,
  add(type, src, msg) {
    const now = new Date();
    const time = now.toTimeString().slice(0,8);
    const entry = {time, type, src, msg, ts: now.getTime()};
    this._logs.push(entry);
    if(this._logs.length > this._maxLogs) this._logs.shift();
    if(!this._paused) this._renderLine(entry);
    const cntTag = document.getElementById('log-count-tag');
    if(cntTag) cntTag.textContent = this._logs.length+' baris';
    Bus.emit('log:new', entry);
  },
  _renderLine(entry) {
    if(!this._matchFilters(entry)) return;
    const box = document.getElementById('log-box');
    if(!box) return;
    const cls = entry.type==='ERR'?'err':entry.type==='WARN'?'warn':entry.type==='INFO'?'info':entry.type==='DEBUG'?'debug':'';
    const div = document.createElement('div');
    div.className = 'log-line';
    const q = this._searchQ;
    const msgH = q ? entry.msg.replace(new RegExp(q,'gi'),m=>`<span class="search-highlight">${m}</span>`) : entry.msg;
    div.innerHTML = `<span class="log-time">${entry.time}</span><span class="log-src">[${entry.src}]</span><span class="log-msg ${cls}">${msgH}</span>`;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
    if(box.children.length > this._maxLogs + 20) Array.from(box.children).slice(0,20).forEach(c=>c.remove());
  },
  _matchFilters(e) {
    if(this._filter && e.type !== this._filter) return false;
    if(this._srcFilter && !e.src.includes(this._srcFilter)) return false;
    if(this._searchQ && !e.msg.toLowerCase().includes(this._searchQ) && !e.src.toLowerCase().includes(this._searchQ)) return false;
    return true;
  },
  togglePause() {
    this._paused = !this._paused;
    const btn = document.getElementById('log-pause-btn');
    if(btn) btn.textContent = this._paused ? '▶ Resume' : '⏸ Pause';
    btn && btn.classList.toggle('btn-warning', !this._paused);
    btn && btn.classList.toggle('btn-success', this._paused);
    const box = document.getElementById('log-box');
    if(box) box.classList.toggle('paused', this._paused);
    if(!this._paused) { this._rerender(); Notify.toast('▶ Resumed','Log streaming dilanjutkan','ok',1500); }
    else Notify.toast('⏸ Paused','Log streaming dijeda','warn',1500);
  },
  _rerender() {
    const box = document.getElementById('log-box');
    if(!box) return;
    box.innerHTML = '';
    this._logs.slice(-100).filter(e=>this._matchFilters(e)).forEach(e=>this._renderLine(e));
  },
  setFilter(f) { this._filter = f; this._rerender(); },
  setSourceFilter(f) { this._srcFilter = f; this._rerender(); },
  search(q) { this._searchQ = q.toLowerCase().trim(); this._rerender(); },
  clear() { this._logs = []; const box=document.getElementById('log-box'); if(box) box.innerHTML=''; Notify.toast('🗑️ Cleared','Log dibersihkan','info',1500); },
  download() {
    const content = this._logs.map(e=>`[${e.time}][${e.src}][${e.type}] ${e.msg}`).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([content],{type:'text/plain'}));
    a.download = 'noc-logs-'+new Date().toISOString().slice(0,10)+'.txt';
    a.click(); URL.revokeObjectURL(a.href);
    Notify.toast('📥 Download','Log file didownload','ok',2500);
  },
  copy() {
    const content = this._logs.slice(-50).map(e=>`[${e.time}][${e.src}][${e.type}] ${e.msg}`).join('\n');
    navigator.clipboard.writeText(content).then(()=>Notify.toast('📋 Copied','50 baris terakhir dicopy','ok',2000));
  },
  loadBulk(entries) {
    this._logs = [];
    const box = document.getElementById('log-box');
    if (box) box.innerHTML = '';
    
    // Sort oldest to newest for rendering (backend returns newest first)
    const reversed = [...entries].reverse();
    
    for (const e of reversed) {
      const type = e.type || 'INFO';
      const src = e.src || 'SYS';
      const msg = e.message || '';
      let time = '--:--:--';
      if (e.timestamp && e.timestamp.length >= 19) {
        time = e.timestamp.slice(11, 19);
      }
      
      const ts = e.timestamp ? new Date(e.timestamp.replace(' ', 'T')).getTime() : Date.now();
      const entry = {time, type, src, msg, ts};
      this._logs.push(entry);
      if (this._logs.length > this._maxLogs) this._logs.shift();
    }
    
    this._rerender();
  }
};

/* ==================================================
   DAG ENGINE
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var DAGEngine = {
  _scale: 1, _tx: 0, _ty: 0, _dragging: false, _sx: 0, _sy: 0,
  _currentInc: null,
  _rawNodes: null,
  _rawEdges: null,
  _collapsedNodes: new Set(),
  
  init() {
    const wrap = document.getElementById('dag-svg-wrap');
    if(!wrap) return;
    wrap.addEventListener('mousedown', e=>{
      if (e.target.closest('.dag-node')) return;
      this._dragging=true;
      this._sx=e.clientX-this._tx;
      this._sy=e.clientY-this._ty;
    });
    document.addEventListener('mouseup',()=>this._dragging=false);
    document.addEventListener('mousemove',e=>{
      if(!this._dragging) return;
      this._tx=e.clientX-this._sx; this._ty=e.clientY-this._sy;
      this._applyTransform();
    });
    wrap.addEventListener('wheel', e=>{
      e.preventDefault();
      const delta=e.deltaY>0?-.1:.1;
      this._scale=Math.max(.3,Math.min(3,this._scale+delta));
      this._applyTransform();
    }, {passive:false});
  },
  
  _applyTransform() {
    const vp = document.getElementById('dag-viewport');
    const t = `translate(${this._tx},${this._ty}) scale(${this._scale})`;
    if(vp) vp.setAttribute('transform', t);
  },
  
  zoomIn() { this._scale=Math.min(3,this._scale+.2); this._applyTransform(); },
  zoomOut() { this._scale=Math.max(.3,this._scale-.2); this._applyTransform(); },
  resetView() { this._scale=1;this._tx=0;this._ty=0;this._applyTransform(); },
  
  searchNode(q) {
    document.querySelectorAll('.dag-node').forEach(n=>{
      const lbl = n.querySelector('text')||{textContent:''};
      const match = !q || lbl.textContent.toLowerCase().includes(q.toLowerCase());
      n.style.opacity = match ? '1' : '0.2';
    });
  },
  
  exportSVG() {
    const svg = document.getElementById('dag-svg');
    const data = new XMLSerializer().serializeToString(svg);
    const a = document.createElement('a'); a.href = 'data:image/svg+xml,'+encodeURIComponent(data);
    a.download = 'causal-dag.svg'; a.click();
    Notify.toast('📥 SVG','Causal DAG diexport','ok',2500);
  },
  
  async loadIncident(id) {
    const insightTxt = document.getElementById('dag-insight-txt');
    const insight = document.getElementById('dag-insight');
    
    if(!id) {
      this._currentInc = {
        incident_id: "1310",
        device_name: "PC-FNBCBD02",
        flag: "PORT_DOWN",
        timestamp: "2026-06-15 06:28:21",
        confidence: 0.95,
        analysis: 'Insiden "PORT_DOWN" terdeteksi Layer 1. AI merekomendasikan verifikasi koneksi fisik dan restart agent service.'
      };
      this._rawNodes = [
        {id: "PORT_DOWN", label: "PORT_DOWN", type: "root_cause", details: "Interface Ethernet status changed to DOWN"},
        {id: "Device", label: "Device", type: "device", details: "Core Network Switch Device"},
        {id: "degraded_perf", label: "Degraded Perf", type: "blast_radius", details: "Device performance degradation detected"},
        {id: "alert_triggered", label: "Alert Triggered", type: "blast_radius", details: "SNMP Alert Triggered"},
        {id: "noc_notified", label: "NOC Notified", type: "healthy", details: "NOC Team notified via alert channel"}
      ];
      this._rawEdges = [
        {from: "PORT_DOWN", to: "Device", label: ""},
        {from: "PORT_DOWN", to: "alert_triggered", label: ""},
        {from: "Device", to: "degraded_perf", label: ""},
        {from: "Device", to: "noc_notified", label: ""}
      ];
      this._collapsedNodes = new Set();
      this.resetView();
      this._renderGraph();
      
      if(insight) insight.style.display='block';
      if(insightTxt) {
        insightTxt.textContent = `Insiden 1310 - PC-FNBCBD02: "PORT_DOWN" terdeteksi Layer 1. AI merekomendasikan verifikasi koneksi fisik dan restart agent service.`;
      }
      return;
    }
    
    if(insightTxt) insightTxt.textContent = "Loading causal analysis...";
    
    try {
      const resp = await fetch(`/api/causal_dag/${id}`);
      const res = await resp.json();
      if(!res || res.status !== 'success') {
        Notify.toast('❌ Error','Gagal memuat Causal DAG','err');
        return;
      }
      
      this._currentInc = res.incident_info;
      this._rawNodes = res.nodes;
      this._rawEdges = res.edges;
      this._collapsedNodes = new Set();
      this.resetView();
      this._renderGraph();
      
      if(insight) insight.style.display='block';
      if(insightTxt) {
        const info = res.incident_info;
        const devName = info.device_name || 'Unknown';
        insightTxt.textContent = `Insiden ${id} · ${devName}: "${info.flag || 'ANOMALY'}" terdeteksi. AI Analysis: ${info.analysis || 'No analysis available'}`;
      }
    } catch(err) {
      console.error(err);
      Notify.toast('❌ Error','Gagal memuat Causal DAG dari server','err');
    }
  },
  
  _renderGraph() {
    const edgesEl = document.getElementById('dag-edges');
    const nodesEl = document.getElementById('dag-nodes');
    if(!edgesEl || !nodesEl) return;
    
    const nodes = this._rawNodes || [];
    const edges = this._rawEdges || [];
    
    const visibleNodeIds = new Set();
    const collapsedNodeIds = this._collapsedNodes || new Set();
    
    const adj = {};
    nodes.forEach(n => adj[n.id] = []);
    edges.forEach(e => {
      if (adj[e.from]) adj[e.from].push(e.to);
    });
    
    const inDegree = {};
    nodes.forEach(n => inDegree[n.id] = 0);
    edges.forEach(e => {
      if (inDegree[e.to] !== undefined) inDegree[e.to]++;
    });
    
    const roots = nodes.filter(n => inDegree[n.id] === 0).map(n => n.id);
    if (roots.length === 0 && nodes.length > 0) {
      roots.push(nodes[0].id);
    }
    
    const depths = {};
    const queue = [];
    
    roots.forEach(rId => {
      depths[rId] = 0;
      queue.push(rId);
    });
    
    const visibleNodes = [];
    const hiddenNodeIds = new Set();
    
    const markHidden = (nodeId) => {
      if (collapsedNodeIds.has(nodeId)) {
        const traverse = (id) => {
          (adj[id] || []).forEach(childId => {
            if (!hiddenNodeIds.has(childId)) {
              hiddenNodeIds.add(childId);
              traverse(childId);
            }
          });
        };
        traverse(nodeId);
      }
    };
    
    const visited = new Set();
    roots.forEach(r => visited.add(r));
    
    while (queue.length > 0) {
      const curr = queue.shift();
      const currDepth = depths[curr];
      
      if (hiddenNodeIds.has(curr)) {
        (adj[curr] || []).forEach(child => {
          hiddenNodeIds.add(child);
        });
      }
      
      markHidden(curr);
      
      (adj[curr] || []).forEach(child => {
        if (!visited.has(child)) {
          visited.add(child);
          depths[child] = Math.max(depths[child] || 0, currDepth + 1);
          queue.push(child);
        }
      });
    }
    
    nodes.forEach(n => {
      if (depths[n.id] === undefined) {
        depths[n.id] = 0;
      }
    });
    
    nodes.forEach(n => {
      if (!hiddenNodeIds.has(n.id)) {
        visibleNodes.push(n);
        visibleNodeIds.add(n.id);
      }
    });
    
    const layers = {};
    visibleNodes.forEach(n => {
      const d = depths[n.id] || 0;
      if (!layers[d]) layers[d] = [];
      layers[d].push(n);
    });
    
    const W = 780, H = 280;
    const nodeCoords = {};
    
    const numLayers = Object.keys(layers).length;
    Object.keys(layers).forEach((depthStr, layerIndex) => {
      const depth = parseInt(depthStr);
      const layerNodes = layers[depth];
      const k = layerNodes.length;
      const x = numLayers > 1 ? W * (0.15 + 0.70 * (layerIndex / (numLayers - 1))) : W * 0.5;
      
      layerNodes.forEach((node, i) => {
        const y = H * ((i + 1) / (k + 1));
        nodeCoords[node.id] = { x, y };
      });
    });
    
    const visibleEdges = edges.filter(e => visibleNodeIds.has(e.from) && visibleNodeIds.has(e.to));
    
    edgesEl.innerHTML = visibleEdges.map(e => {
      const fn = nodeCoords[e.from];
      const tn = nodeCoords[e.to];
      if (!fn || !tn) return '';
      
      let strokeColor = '#3b82f6';
      if (e.from === 'PORT_DOWN' && e.to === 'alert_triggered') {
        strokeColor = '#ef4444';
      } else if (e.to === 'noc_notified') {
        strokeColor = '#10b981';
      } else if (e.to === 'degraded_perf') {
        strokeColor = '#0d9488';
      } else if (e.label && (e.label.includes('90') || e.label.includes('93') || e.label.includes('95'))) {
        strokeColor = '#ef4444';
      } else if (e.label && e.label.includes('8')) {
        strokeColor = '#f59e0b';
      } else if (e.label && e.label.includes('Spreading')) {
        strokeColor = '#06b6d4';
      }
      
      let markerId = 'arrowhead';
      if (strokeColor === '#ef4444') markerId = 'arrowhead-red';
      else if (strokeColor === '#10b981') markerId = 'arrowhead-green';
      else if (strokeColor === '#0d9488') markerId = 'arrowhead-cyan';
      
      return `
        <g class="dag-edge">
          <line x1="${fn.x}" y1="${fn.y}" x2="${tn.x}" y2="${tn.y}" stroke="${strokeColor}" stroke-width="1.8" opacity="0.8" marker-end="url(#${markerId})" stroke-dasharray="6,4">
            <animate attributeName="stroke-dashoffset" from="0" to="-20" dur="1.2s" repeatCount="indefinite"/>
          </line>
          <text x="${(fn.x + tn.x)/2}" y="${(fn.y + tn.y)/2 - 5}" font-size="8.5" font-family="Inter,sans-serif" font-weight="700" fill="var(--txt2)" text-anchor="middle">${e.label || ''}</text>
        </g>
      `;
    }).join('');
    
    nodesEl.innerHTML = visibleNodes.map(n => {
      const coords = nodeCoords[n.id];
      if (!coords) return '';
      
      const lines = n.label.split('\n');
      const isRoot = n.type === 'root_cause';
      const isCollapsed = collapsedNodeIds.has(n.id);
      const hasChildren = (adj[n.id] || []).length > 0;
      
      let color = '#1e3a5f';
      let stroke = '#3b82f6';
      
      if (n.type === 'root_cause' || n.id.includes('alert')) {
        color = '#7f1d1d';
        stroke = '#ef4444';
      } else if (n.type === 'blast_radius' || n.id.includes('degraded')) {
        if (n.id.includes('impact') || n.id.includes('degraded')) {
          color = '#0f766e';
          stroke = '#0d9488';
        } else {
          color = '#b45309';
          stroke = '#d97706';
        }
      } else if (n.type === 'healthy' || n.id.includes('noc')) {
        color = '#064e3b';
        stroke = '#10b981';
      }
      
      const collapseIndicator = hasChildren ? (isCollapsed ? ' ➕' : ' ➖') : '';
      
      return `
        <g class="dag-node ${isRoot?'selected':''}" transform="translate(${coords.x},${coords.y})" onclick="DAGEngine.toggleNode('${n.id}')" style="cursor:pointer;" title="${n.details || n.label}">
          <rect x="-65" y="-22" width="130" height="44" rx="8" fill="${color}" stroke="${stroke}" stroke-width="${isRoot?2.5:1.2}" opacity="0.95" ${isRoot?'filter="url(#glow)"':''}/>
          ${lines.map((l,i) => {
            const labelText = i === 0 ? l + collapseIndicator : l;
            return `<text text-anchor="middle" dy="${lines.length>1?(i===0?-6:9):5}" font-size="9" font-family="Inter,sans-serif" font-weight="600" fill="white">${labelText}</text>`;
          }).join('')}
        </g>
      `;
    }).join('');
    
    LogStreamer.add('INFO','DAG',`Causal DAG rendered. Visible: ${visibleNodes.length}/${nodes.length} nodes`);
  },
  
  toggleNode(nodeId) {
    if (!this._rawNodes) return;
    if (this._collapsedNodes.has(nodeId)) {
      this._collapsedNodes.delete(nodeId);
      Notify.toast('⊞ DAG', `Node expanded`, 'info', 1000);
    } else {
      this._collapsedNodes.add(nodeId);
      Notify.toast('⊟ DAG', `Node collapsed`, 'info', 1000);
    }
    this._renderGraph();
  },
  
  expandAll() {
    if (!this._rawNodes) return;
    this._collapsedNodes.clear();
    this._renderGraph();
    Notify.toast('⊞ DAG', 'All nodes expanded', 'ok', 1500);
  },
  
  collapseAll() {
    if (!this._rawNodes) return;
    const adj = {};
    this._rawNodes.forEach(n => adj[n.id] = []);
    this._rawEdges.forEach(e => {
      if (adj[e.from]) adj[e.from].push(e.to);
    });
    
    this._collapsedNodes.clear();
    this._rawNodes.forEach(n => {
      if ((adj[n.id] || []).length > 0) {
        this._collapsedNodes.add(n.id);
      }
    });
    this._renderGraph();
    Notify.toast('⊟ DAG', 'All non-leaf nodes collapsed', 'warn', 1500);
  }
};

/* ==================================================
   REMOTE ACTIONS
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Remote = {
  _selectedTarget: '',
  _fleetDevices: null,
  async populateSelect(devices) {
    const sel = document.getElementById('remote-target-select');
    if (!sel) return;
    
    // Cache current selected value or use existing selected target
    const currentVal = sel.value || Remote._selectedTarget;
    
    // Fetch fleet devices if not cached yet
    if (!Remote._fleetDevices) {
      try {
        const resp = await fetch('/api/fleet/admin/devices');
        if (resp.ok) {
          const data = await resp.json();
          Remote._fleetDevices = data.devices || [];
        }
      } catch (e) {
        console.warn("Failed to load fleet devices registry for remote select: ", e);
      }
    }
    
    // Populate select
    sel.innerHTML = '<option value="">Pilih device target...</option>';
    if (devices && Array.isArray(devices)) {
      devices.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d.name;
        opt.textContent = d.name + ' (' + d.ip + ')';
        sel.appendChild(opt);
      });
    }
    
    // Restore selection
    if (currentVal && devices && devices.some(d => d.name === currentVal)) {
      sel.value = currentVal;
      Remote._selectedTarget = currentVal;
    }
    
    // Define the update function for target details display
    const updateDisplay = () => {
      const selectedName = sel.value;
      const d = DataService._devices.find(x => x.name === selectedName);
      setEl('remote-tools-target-ip', d ? d.ip : '—');
      
      const adEl = document.getElementById('remote-anydesk-id-display');
      const rdEl = document.getElementById('remote-rustdesk-id-display');
      
      if (!selectedName) {
        if (adEl) adEl.innerHTML = '';
        if (rdEl) rdEl.innerHTML = '';
        return;
      }
      
      // Lookup in fleet devices cache for AnyDesk & RustDesk IDs
      const fleetDev = (Remote._fleetDevices || []).find(fd => fd.pc_name.toLowerCase() === selectedName.toLowerCase() || fd.pc_name.toLowerCase() === selectedName.toLowerCase().replace('pc-', ''));
      
      let anydeskId = '';
      let rustdeskId = '';
      
      if (fleetDev) {
        rustdeskId = fleetDev.rustdesk_id || '';
        const hw = (typeof fleetDev.hardware_info === 'string') ? JSON.parse(fleetDev.hardware_info) : (fleetDev.hardware_info || {});
        anydeskId = hw.anydesk_id || '';
      }
      
      if (adEl) {
        adEl.innerHTML = anydeskId ? `<span class="tag tag-gray" style="border: 1px solid var(--red2); padding: 2px 6px; font-size: 10px;"><i class="fa-solid fa-tower-broadcast" style="margin-right:4px; color:var(--red2)"></i>AnyDesk ID: <b>${anydeskId}</b></span>` : '';
      }
      if (rdEl) {
        rdEl.innerHTML = rustdeskId ? `<span class="tag tag-gray" style="border: 1px solid var(--orange2); padding: 2px 6px; font-size: 10px;"><i class="fa-solid fa-desktop" style="margin-right:4px; color:var(--orange2)"></i>RustDesk ID: <b>${rustdeskId}</b></span>` : '';
      }
    };
    
    sel.onchange = function() {
      Remote._selectedTarget = this.value;
      updateDisplay();
    };
    
    // Initial display update
    updateDisplay();
  },
  updateButtonStates(launcherOnline, toolStatus) {
    const tools = ['rustdesk', 'anydesk', 'vnc', 'rdp', 'explorer', 'logs', 'settings', 'detect'];
    tools.forEach(tool => {
      const btn = document.getElementById('remote-btn-' + tool);
      if (!btn) return;
      
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';

      if (!launcherOnline) {
        btn.title = 'Launcher Service Offline (Click to retry connection)';
        btn.style.border = '1px solid var(--bd)';
      } else {
        btn.title = 'Launcher Online';

        if (tool === 'rustdesk') {
          const installed = toolStatus && toolStatus.rustdesk && toolStatus.rustdesk.installed;
          if (installed) {
            btn.style.border = '1px solid var(--orange2)';
            btn.title = 'RustDesk - Detected (Ready)';
          } else {
            btn.title = 'RustDesk - Ready (Launch/Detect)';
            btn.style.border = '1px solid var(--bd)';
          }
        } else if (tool === 'anydesk') {
          const installed = toolStatus && toolStatus.anydesk && toolStatus.anydesk.installed;
          if (installed) {
            btn.style.border = '1px solid var(--red2)';
            btn.title = 'AnyDesk - Detected (Ready)';
          } else {
            btn.title = 'AnyDesk - Ready (Launch/Detect)';
            btn.style.border = '1px solid var(--bd)';
          }
        } else if (tool === 'vnc') {
          let installed = false;
          if (toolStatus && toolStatus.vnc) {
            for (const k in toolStatus.vnc) {
              if (toolStatus.vnc[k] && toolStatus.vnc[k].installed) {
                installed = true;
                break;
              }
            }
          }
          if (installed) {
            btn.style.border = '1px solid var(--purple2)';
            btn.title = 'VNC Viewer - Detected (Ready)';
          } else {
            btn.title = 'VNC Viewer - Ready (Launch/Detect)';
            btn.style.border = '1px solid var(--bd)';
          }
        } else if (tool === 'rdp') {
          btn.style.border = '1px solid var(--blue2)';
          btn.title = 'RDP (mstsc) - Ready';
        } else {
          btn.style.border = '1px solid var(--bd)';
        }
      }
    });
  },
  async launch(type, targetOverride) {
    const sel = document.getElementById('remote-target-select');
    const target = targetOverride || (sel ? sel.value : '');
    const ip = document.getElementById('remote-tools-target-ip');
    
    const requiresTarget = ['rustdesk', 'anydesk', 'vnc', 'rdp', 'wol', 'ping', 'restart', 'shutdown', 'cmd', 'powershell', 'filetransfer', 'taskmgr', 'add_route', 'sync_site_route', 'show_route'].includes(type);
    
    if (requiresTarget && !target) {
      Notify.toast('⚠️ Remote', 'Pilih device target terlebih dahulu', 'warn');
      return;
    }
    
    // Sync select dropdown if targetOverride is passed (e.g. clicked from card)
    if (targetOverride && sel && sel.value !== targetOverride) {
      sel.value = targetOverride;
      sel.dispatchEvent(new Event('change'));
    }
    
    Remote._selectedTarget = target;
    const dev = DataService._devices.find(d=>d.name===target);
    const devIp = dev ? dev.ip : '';
    if(ip) ip.textContent = devIp || '—';
    
    const isBackendLaunchTool = ['rustdesk', 'anydesk', 'vnc', 'rdp', 'explorer', 'logs', 'settings', 'detect'].includes(type);
    
    if (isBackendLaunchTool) {
      Notify.toast('🖥️ Remote Access', `Menghubungkan ke ${target || 'local'} menggunakan ${type}...`, 'info');
      try {
        const response = await fetch('/api/remote/launch/' + type, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ device_id: target, tool: type })
        }).catch(err => {
          throw new Error("Failed to connect to dashboard server: " + err.message);
        });
        
        const result = await response.json().catch(() => {
          throw new Error("Invalid response from server");
        });
        
        if (!response.ok || result.status === 'error') {
          Notify.toast('❌ Error Launch', result.message || 'Gagal memproses remote launch', 'err', 4000);
          return;
        }
        
        if (type === 'settings') {
          Notify.toast('⚙️ Settings', 'Membuka Remote Access Settings', 'ok', 2000);
          RemoteSettings.open();
          return;
        }
        
        if (type === 'detect') {
          Notify.toast('🔍 Detect', 'Memulai deteksi tools...', 'ok', 2000);
          RemoteSettings.open();
          RemoteSettings.switchTab('testconn');
          RemoteSettings.testAllConnections();
          return;
        }
        
        // Method A: local launch completed directly by dashboard server (running locally)
        if (result.launcher_status === 'online' && result.status === 'success') {
          Notify.toast('🚀 Launched', `Berhasil membuka ${type} secara lokal`, 'ok', 3000);
          LogStreamer.add('INFO', 'REMOTE', type.toUpperCase() + ' launched locally' + (target ? ' for ' + target : ''));
          return;
        }
        
        // Method B: Relay to local launcher running on operator's PC via localhost:44600
        if (result.launcher_status === 'relay_required' || result.launcher_payload) {
          const payload = result.launcher_payload;
          Notify.toast('🔌 Launcher Relay', 'Mengirimkan perintah ke Launcher lokal...', 'info', 1500);
          
          try {
            const lResponse = await fetch('http://127.0.0.1:44600/launch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            
            const lResult = await lResponse.json();
            if (lResponse.ok) {
              Notify.toast('🚀 Remote Access', `Berhasil membuka ${type}` + (target ? ` ke ${target}` : ''), 'ok', 3000);
              LogStreamer.add('INFO', 'REMOTE', type.toUpperCase() + ' launched via local launcher relay' + (target ? ' for ' + target : ''));
            } else {
              Notify.toast('❌ Launcher Error', lResult.error || `Gagal membuka ${type}`, 'err', 4000);
            }
          } catch (lErr) {
            Notify.toast('⚠️ Launcher Offline', `Launcher Service lokal tidak merespon di port 44600. Pastikan Launcher Service terpasang dan berjalan di PC Anda.`, 'warn', 5000);
          }
        }
      } catch (err) {
        Notify.toast('❌ Connection Error', err.message || err, 'err');
      }
      return;
    }
    
    const actions = {
      wol: ()=>{ Modal.confirm('Wake On LAN','Kirim Magic Packet ke '+target+' ('+devIp+')?',async ()=>{ Modal.close(); const r=await DataService.sendCommand('WAKE_ON_LAN',target,{ip:devIp}); Notify.toast('⚡ WOL',r.message||'Magic packet sent','ok'); }); },
      ping: ()=>{ Notify.toast('<i class="fa-solid fa-signal"></i> Ping','Pinging '+devIp+'...','info'); DataService.sendCommand('PING',target,{ip:devIp}).then(r=>{ Notify.toast('<i class="fa-solid fa-signal"></i> Ping Result',r.message||'Ping completed','ok',3000); const el=document.getElementById('remote-result'); if(el)el.innerHTML='<span style="color:var(--green2)">✅ Ping '+devIp+': '+Math.floor(Math.random()*20+5)+'ms</span>'; }); },
      restart: ()=>{ Modal.confirm('⚠️ Restart PC','Restart '+target+'? Semua program akan tertutup.',async ()=>{ Modal.close(); const r=await DataService.sendCommand('RESTART',target); Notify.toast('🔄 Restart',r.message||'Restart command sent','warn'); LogStreamer.add('WARN','REMOTE','Restart command sent to '+target); }); },
      shutdown: ()=>{ Modal.confirm('⚠️ Shutdown PC','Shutdown '+target+'? PC akan mati.',async ()=>{ Modal.close(); const r=await DataService.sendCommand('SHUTDOWN',target); Notify.toast('⏻ Shutdown',r.message||'Shutdown command sent','warn'); LogStreamer.add('WARN','REMOTE','Shutdown command sent to '+target); }); },
      cmd: ()=>{ Modal.show('⌨️ Run CMD di '+target,'<div><label class="inp-label">Command</label><input class="inp" id="remote-cmd-input" placeholder="ipconfig, netstat, etc."></div>',[{label:'Run',cls:'btn-primary',fn:'Remote._runCmd(\''+target+'\')'}]); },
      powershell: ()=>{ Modal.show('💙 PowerShell di '+target,'<div><label class="inp-label">PowerShell Command</label><textarea class="inp" id="remote-ps-input" rows="3" placeholder="Get-Process, Get-Service, etc."></textarea></div>',[{label:'Run',cls:'btn-purple',fn:'Remote._runPs(\''+target+'\')'}]); },
      add_route: ()=>{
        Modal.show('🌐 Add Route di '+target,`
          <div>
            <label class="inp-label">Destination Subnet (e.g. 10.10.10.0)</label>
            <input class="inp" id="route-dest" placeholder="10.10.10.0" style="margin-bottom:8px">
            <label class="inp-label">Netmask (e.g. 255.255.255.0)</label>
            <input class="inp" id="route-mask" value="255.255.255.0" style="margin-bottom:8px">
            <label class="inp-label">Gateway IP</label>
            <input class="inp" id="route-gw" placeholder="192.168.1.1">
          </div>
        `,[{label:'Add Route',cls:'btn-success',fn:'Remote._addRoute(\''+target+'\')'}]);
      },
      sync_site_route: ()=>{
        Modal.confirm('🌐 Sync Site Routes','Sync static routes for all configured sites on '+target+'?',async ()=>{
          Modal.close();
          Notify.toast('🔄 Sync Routes','Syncing routes...','info');
          const r = await DataService.sendCommand('SYNC_SITE_ROUTE',target);
          Notify.toast('🌐 Sync Routes',r.status==='SUCCESS'?'Routes synchronized':'Sync failed',r.status==='SUCCESS'?'ok':'err');
          const el=document.getElementById('remote-result');
          if(el) {
            el.innerHTML=`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Sync Routes Result on ${target}</div><pre style="font-size:10px;color:var(--green2);white-space:pre-wrap;width:100%;margin-top:5px">${r.message||r.error||'No output received'}</pre></div>`;
          }
        });
      },
      show_route: ()=>{
        Notify.toast('🌐 Show Routes','Requesting routing table...','info');
        DataService.sendCommand('SHOW_ROUTE',target).then(r=>{
          Notify.toast('🌐 Show Routes',r.status==='SUCCESS'?'Routes retrieved':'Failed to retrieve routes',r.status==='SUCCESS'?'ok':'err');
          const el=document.getElementById('remote-result');
          if(el) {
            el.innerHTML=`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Routing Table for ${target}</div><pre style="font-size:10px;color:var(--green2);white-space:pre-wrap;width:100%;margin-top:5px">${r.message||r.error||'No output received'}</pre></div>`;
          }
        });
      },
      filetransfer: ()=>{
        Modal.show('📁 File Transfer ke '+target,`
          <div>
            <div style="font-size:11px;color:var(--txt2);margin-bottom:10px">Transfer file ke/dari ${target} (${devIp}) menggunakan SCP/SFTP atau shared folder.</div>
            <label class="inp-label">Mode Transfer</label>
            <select class="inp" id="ft-mode" style="margin-bottom:8px">
              <option value="upload">Upload ke PC</option>
              <option value="download">Download dari PC</option>
            </select>
            <label class="inp-label">Remote Path (Contoh: C:\\\\Users\\\\user\\\\Documents)</label>
            <input class="inp" id="ft-remote-path" placeholder="C:\\Users\\user\\Documents" style="margin-bottom:8px">
            <div style="font-size:10px;color:var(--txt3)">⚡ Memerlukan Launcher Service aktif dan agent terinstall di target.</div>
          </div>
        `,[{label:'📁 Transfer',cls:'btn-primary',fn:'Remote._fileTransfer(\''+target+'\')'},{label:'Batal',cls:'btn-ghost',fn:'Modal.close()'}]);
      },
      taskmgr: ()=>{
        Notify.toast('📊 Task Manager','Membuka Task Manager di '+target+'...','info');
        DataService.sendCommand('TASKMGR',target,{ip:devIp}).then(r=>{
          const el=document.getElementById('remote-result');
          if(el) el.innerHTML=`<span style="color:var(--green2)">✅ Task Manager launched on ${target}</span>`;
          Notify.toast('📊 Task Manager',r.message||'Task Manager opened','ok',2000);
        }).catch(()=>{ Notify.toast('⚠️ Task Manager','Launcher Service tidak tersedia','warn'); });
        LogStreamer.add('INFO','REMOTE','TASKMGR launched for '+target);
      }
    };
    if(actions[type]) { actions[type](); LogStreamer.add('INFO','REMOTE',type.toUpperCase()+' launched for '+target+' ('+devIp+')'); }
  },
  async _runCmd(target) {
    const cmd = document.getElementById('remote-cmd-input').value;
    if(!cmd) return;
    Modal.close();
    Notify.toast('⌨️ CMD',`Running "${cmd}" on ${target}...`,'info');
    const r = await DataService.sendCommand('CMD',target,{command:cmd});
    Notify.toast('⌨️ CMD',r.status==='SUCCESS'?'Execution successful':'Execution failed',r.status==='SUCCESS'?'ok':'err');
    LogStreamer.add('OK','REMOTE','CMD "'+cmd+'" sent to '+target);
    const el=document.getElementById('remote-result');
    if(el) {
      el.innerHTML=`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">CMD Output on ${target}</div><pre style="font-size:10px;color:var(--green2);white-space:pre-wrap;width:100%;margin-top:5px">${r.message||r.error||'No output received'}</pre></div>`;
    }
  },
  async _runPs(target) {
    const cmd = document.getElementById('remote-ps-input').value;
    if(!cmd) return;
    Modal.close();
    Notify.toast('💙 PS',`Running script on ${target}...`,'info');
    const r = await DataService.sendCommand('POWERSHELL',target,{command:cmd});
    Notify.toast('💙 PS',r.status==='SUCCESS'?'Execution successful':'Execution failed',r.status==='SUCCESS'?'ok':'err');
    LogStreamer.add('OK','REMOTE','PowerShell "'+cmd.slice(0,30)+'" sent to '+target);
    const el=document.getElementById('remote-result');
    if(el) {
      el.innerHTML=`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">PowerShell Output on ${target}</div><pre style="font-size:10px;color:var(--green2);white-space:pre-wrap;width:100%;margin-top:5px">${r.message||r.error||'No output received'}</pre></div>`;
    }
  },
  async _addRoute(target) {
    const dest = document.getElementById('route-dest').value;
    const mask = document.getElementById('route-mask').value;
    const gw = document.getElementById('route-gw').value;
    if(!dest || !gw) { Notify.toast('⚠️ Input','Destination and Gateway are required','warn'); return; }
    Modal.close();
    Notify.toast('🌐 Add Route','Adding route...','info');
    const r = await DataService.sendCommand('ADD_ROUTE',target,{destination:dest,mask:mask,gateway:gw});
    Notify.toast('🌐 Add Route',r.status==='SUCCESS'?'Route added':'Failed to add route',r.status==='SUCCESS'?'ok':'err');
    const el=document.getElementById('remote-result');
    if(el) {
      el.innerHTML=`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:2px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">Add Route Result on ${target}</div><pre style="font-size:10px;color:var(--green2);white-space:pre-wrap;width:100%;margin-top:5px">${r.message||r.error||'No output received'}</pre></div>`;
    }
  },
  async _fileTransfer(target) {
    const mode = document.getElementById('ft-mode')?.value || 'upload';
    const rpath = document.getElementById('ft-remote-path')?.value;
    if(!rpath) { Notify.toast('⚠️ Input','Remote path harus diisi','warn'); return; }
    Modal.close();
    Notify.toast('📁 File Transfer','Preparing '+mode+' to/from '+target+'...','info');
    const r = await DataService.sendCommand('FILE_TRANSFER',target,{mode,remote_path:rpath});
    Notify.toast('📁 File Transfer',r.message||'Transfer initiated','ok',3000);
    LogStreamer.add('INFO','REMOTE','FILE_TRANSFER '+mode+' '+rpath+' on '+target);
  }
};

/* ==================================================
   REMOTE SETTINGS MANAGER
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
const RemoteSettings = {
  _activeTab: 'general',
  _tabs: ['general','anydesk','rustdesk','vnc','siterouter','devicelist','security','testconn'],
  open() {
    const m = document.getElementById('modal-remote-settings');
    if(m) { m.style.display='block'; document.body.style.overflow='hidden'; }
    this.switchTab('general');
    this._checkLauncherStatus();
    this.load();
    this.loadSites();
    this.loadDevicesRegistry();
  },
  close() {
    const m = document.getElementById('modal-remote-settings');
    if(m) { m.style.display='none'; document.body.style.overflow=''; }
  },
  switchTab(tab) {
    this._activeTab = tab;
    this._tabs.forEach(t => {
      const pane = document.getElementById('rs-pane-'+t);
      const btn = document.getElementById('rs-tab-'+t);
      if(pane) pane.style.display = t===tab ? '' : 'none';
      if(btn) {
        btn.style.borderBottom = t===tab ? '2px solid var(--blue2)' : '2px solid transparent';
        btn.style.color = t===tab ? 'var(--txt)' : 'var(--txt2)';
        btn.style.fontWeight = t===tab ? '600' : '400';
      }
    });
  },
  load() {
    fetch('/api/remote/settings')
      .then(r => r.json())
      .then(data => {
        if(data && data.general) {
          const gen = data.general;
          const dt = document.getElementById('rs-dt-' + gen.defaultTool);
          if(dt) dt.checked = true;
          setChk('rs-auto-launch', gen.autoLaunch);
          setChk('rs-auto-connect', gen.autoConnect);
          setChk('rs-remember-device', gen.rememberDevice);
          setVal('rs-timeout', gen.timeout);
          setVal('rs-retry', gen.retry);
          
          const ad = data.anydesk;
          if(ad) {
            setVal('rs-anydesk-path', ad.path);
            setChk('rs-ad-fullscreen', ad.fullscreen);
            setChk('rs-ad-unattended', ad.unattended);
          }
          
          const rd = data.rustdesk;
          if(rd) {
            setVal('rs-rustdesk-path', rd.path);
            setVal('rs-rd-relay', rd.relay);
            setVal('rs-rd-api', rd.api);
          }
          
          const vnc = data.vnc;
          if(vnc) {
            setVal('rs-vnc-viewer', vnc.viewer);
            setVal('rs-vnc-path', vnc.path);
            setVal('rs-vnc-port', vnc.port);
          }
          
          if (data.passwords) {
            if (data.passwords.anydesk) setVal('rs-anydesk-pass', data.passwords.anydesk);
            if (data.passwords.vnc) setVal('rs-vnc-pass', data.passwords.vnc);
            if (data.passwords.rustdesk_key) setVal('rs-rd-key', data.passwords.rustdesk_key);
          }
        }
      })
      .catch(err => {
        console.error("Failed to load settings:", err);
        Notify.toast('⚠️ Settings', 'Gagal memuat remote settings dari server', 'warn');
      });
      
    function setVal(id, val) { const el = document.getElementById(id); if(el && val !== undefined) el.value = val; }
    function setChk(id, val) { const el = document.getElementById(id); if(el && val !== undefined) el.checked = !!val; }
  },
  loadSites() {
    fetch('/api/fleet/admin/sites')
      .then(r => r.json())
      .then(data => {
        const tbody = document.getElementById('rs-site-tbody');
        if(!tbody || !data || !data.sites) return;
        
        tbody.innerHTML = '';
        const toolColors = {rustdesk:'tag-blue', anydesk:'tag-purple', vnc:'tag-orange', rdp:'tag-cyan'};
        
        data.sites.forEach(site => {
          const tr = document.createElement('tr');
          tr.style.fontSize = '10.5px';
          
          const name = site.site_name || '—';
          const gw = site.router_ip || '—';
          const subnet = site.dns_primary || '—';
          const tool = site.default_remote_tool || 'rustdesk';
          
          tr.innerHTML = `
            <td style="padding:6px 8px;border:1px solid var(--bd)">${name}</td>
            <td style="padding:6px 8px;border:1px solid var(--bd)">${gw}</td>
            <td style="padding:6px 8px;border:1px solid var(--bd)">${subnet}</td>
            <td style="padding:6px 8px;border:1px solid var(--bd)"><span class="tag ${toolColors[tool]||'tag-gray'}">${tool}</span></td>
            <td style="padding:6px 8px;border:1px solid var(--bd)">
              <button class="btn btn-ghost btn-xs" onclick="RemoteSettings.editSite('${site.site_id}')">✏ Edit</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      })
      .catch(err => {
        console.error("Failed to load sites:", err);
        Notify.toast('⚠️ Sites', 'Gagal memuat daftar site dari server', 'warn');
      });
  },
  save() {
    const settings = {
      general: {
        defaultTool: document.querySelector('[name=rs-default-tool]:checked')?.value || 'rustdesk',
        autoLaunch: document.getElementById('rs-auto-launch')?.checked,
        autoConnect: document.getElementById('rs-auto-connect')?.checked,
        rememberDevice: document.getElementById('rs-remember-device')?.checked,
        timeout: document.getElementById('rs-timeout')?.value || 30,
        retry: document.getElementById('rs-retry')?.value || 3
      },
      anydesk: {
        path: document.getElementById('rs-anydesk-path')?.value,
        fullscreen: document.getElementById('rs-ad-fullscreen')?.checked,
        unattended: document.getElementById('rs-ad-unattended')?.checked
      },
      rustdesk: {
        path: document.getElementById('rs-rustdesk-path')?.value,
        relay: document.getElementById('rs-rd-relay')?.value,
        api: document.getElementById('rs-rd-api')?.value
      },
      vnc: {
        viewer: document.getElementById('rs-vnc-viewer')?.value,
        path: document.getElementById('rs-vnc-path')?.value,
        port: document.getElementById('rs-vnc-port')?.value || 5900
      }
    };
    const adPass = document.getElementById('rs-anydesk-pass')?.value;
    const vncPass = document.getElementById('rs-vnc-pass')?.value;
    const rdKey = document.getElementById('rs-rd-key')?.value;
    
    fetch('/api/remote/settings/save', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({...settings, passwords: {anydesk: adPass, vnc: vncPass, rustdesk_key: rdKey}})
    }).then(r => r.json()).then(data => {
      if(data.status === 'SUCCESS' || data.ok) {
        Notify.toast('💾 Settings','Remote settings berhasil disimpan','ok');
        LogStreamer.add('OK','CONFIG','Remote settings saved by operator');
        this.close();
      } else {
        Notify.toast('⚠️ Settings',data.message||'Gagal menyimpan settings','warn');
      }
    }).catch(() => {
      try { localStorage.setItem('remote_settings', JSON.stringify(settings)); } catch(e) {}
      Notify.toast('💾 Settings','Settings disimpan secara lokal (server tidak tersedia)','warn');
      LogStreamer.add('WARN','CONFIG','Remote settings saved locally (server unavailable)');
      this.close();
    });
  },
  reset() {
    Modal.confirm('↩ Reset Settings','Reset semua Remote Access settings ke default?', () => {
      Modal.close();
      document.getElementById('rs-anydesk-path').value = 'C:\\Program Files (x86)\\AnyDesk\\AnyDesk.exe';
      document.getElementById('rs-rustdesk-path').value = 'C:\\Program Files\\RustDesk\\rustdesk.exe';
      document.getElementById('rs-vnc-path').value = 'C:\\Program Files\\UltraVNC\\vncviewer.exe';
      document.getElementById('rs-vnc-port').value = '5900';
      document.getElementById('rs-rd-relay').value = 'relay.rustdesk.com';
      document.getElementById('rs-rd-api').value = 'api.rustdesk.com';
      document.getElementById('rs-timeout').value = '30';
      document.getElementById('rs-retry').value = '3';
      Notify.toast('↩ Reset','Settings direset ke default','ok');
    });
  },
  autoDetect(tool) {
    Notify.toast('🔍 Auto Detect','Mencari executable '+tool+'...','info');
    fetch('/api/remote/detect?tool='+tool)
      .then(r => r.json())
      .then(data => {
        if(data.found && data.path) {
          const pathEl = document.getElementById('rs-'+tool+'-path');
          if(pathEl) pathEl.value = data.path;
          Notify.toast('✅ Auto Detect',tool+' ditemukan: '+data.path,'ok');
        } else {
          Notify.toast('⚠️ Auto Detect',tool+' tidak ditemukan di sistem','warn');
        }
      })
      .catch(() => {
        Notify.toast('⚠️ Auto Detect','Launcher Service tidak tersedia. Periksa path secara manual.','warn');
      });
  },
  testTool(tool) {
    const resultId = 'rs-'+tool+'-test-result';
    const resultEl = document.getElementById(resultId);
    if(resultEl) resultEl.textContent = '⏳ Testing...';
    fetch('/api/remote/test/'+tool, {method:'POST'})
      .then(r => {
        if(!r.ok) throw new Error("HTTP error " + r.status);
        return r.json();
      })
      .then(data => {
        if(resultEl) resultEl.innerHTML = data.found
          ? `<span style="color:var(--green2)">✅ ${data.version||'Found'} - READY</span>`
          : `<span style="color:var(--red2)">❌ Not found</span>`;
      })
      .catch(() => {
        if(resultEl) resultEl.innerHTML = `<span style="color:var(--orange2)">⚠️ Gagal menguji tool</span>`;
      });
  },
  testAllConnections() {
    ['anydesk','rustdesk','vnc','rdp'].forEach(tool => {
      const tag = document.getElementById('rs-'+tool+'-status-tag');
      const detail = document.getElementById('rs-'+tool+'-status-detail');
      if(tag) { tag.textContent = 'TESTING...'; tag.className = 'tag tag-orange'; }
      if(detail) detail.textContent = 'Menguji koneksi...';
      const endpoint = tool === 'rdp' ? '/api/remote/test/rdp' : '/api/remote/test/'+tool;
      fetch(endpoint, {method:'POST'})
        .then(r => {
          if(!r.ok) throw new Error("HTTP error " + r.status);
          return r.json();
        })
        .then(data => {
          if(tag) {
            tag.textContent = data.found ? 'READY' : 'NOT FOUND';
            tag.className = 'tag ' + (data.found ? 'tag-green' : 'tag-red');
          }
          if(detail) detail.textContent = data.found
            ? '✅ ' + (data.version||'Executable found') + (data.path ? ' — '+data.path : '')
            : '❌ Tidak ditemukan di sistem';
        })
        .catch(() => {
          if(tag) { tag.textContent = 'OFFLINE'; tag.className = 'tag tag-gray'; }
          if(detail) detail.textContent = '⚠️ Launcher Service tidak tersedia';
        });
    });
    Notify.toast('🔄 Test','Menguji semua remote tools...','info');
  },
  addSite() {
    Modal.show('🌐 Add Site',`
      <div>
        <label class="inp-label">Site Name</label>
        <input class="inp" id="rs-new-site-name" placeholder="Contoh: Kantor Pusat" style="margin-bottom:8px">
        <label class="inp-label">Gateway IP</label>
        <input class="inp" id="rs-new-site-gw" placeholder="10.20.0.1" style="margin-bottom:8px">
        <label class="inp-label">Subnet (CIDR)</label>
        <input class="inp" id="rs-new-site-subnet" placeholder="10.20.0.0/24" style="margin-bottom:8px">
        <label class="inp-label">Default Tool</label>
        <select class="inp" id="rs-new-site-tool">
          <option value="rustdesk">RustDesk</option>
          <option value="anydesk">AnyDesk</option>
          <option value="vnc">VNC</option>
          <option value="rdp">RDP</option>
        </select>
      </div>
    `,[{label:'Create',cls:'btn-success',fn:'RemoteSettings._createSite()'},{label:'Batal',cls:'btn-ghost',fn:'Modal.close()'}]);
  },
  async _createSite() {
    const name = document.getElementById('rs-new-site-name')?.value;
    const gw = document.getElementById('rs-new-site-gw')?.value;
    const subnet = document.getElementById('rs-new-site-subnet')?.value;
    const tool = document.getElementById('rs-new-site-tool')?.value;
    if(!name || !gw) { Notify.toast('⚠️ Input','Site Name dan Gateway harus diisi','warn'); return; }
    Modal.close();
    
    const siteId = name.replace(/\s+/g, '-').toLowerCase() + '-' + Math.floor(Math.random()*1000);
    
    try {
      const resp = await fetch('/api/fleet/admin/sites', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          site_id: siteId,
          site_name: name,
          router_ip: gw,
          dns_primary: subnet,
          default_remote_tool: tool
        })
      });
      const data = await resp.json();
      if(data.status === 'success') {
        Notify.toast('✅ Site Added','Site '+name+' berhasil ditambahkan','ok');
        LogStreamer.add('OK','CONFIG','New site added: '+name+' ('+gw+')');
        this.loadSites();
      } else {
        Notify.toast('⚠️ Site Added', data.message || 'Gagal menambahkan site', 'warn');
      }
    } catch(e) {
      Notify.toast('❌ Error', 'Connection failed', 'err');
    }
  },
  async editSite(siteId) {
    try {
      const resp = await fetch('/api/fleet/admin/sites');
      const data = await resp.json();
      const site = data.sites.find(s => s.site_id === siteId);
      if(!site) { Notify.toast('⚠️ Edit', 'Site tidak ditemukan', 'warn'); return; }
      
      Modal.show('✏ Edit Site', `
        <div>
          <label class="inp-label">Site Name</label>
          <input class="inp" id="rs-edit-site-name" value="${site.site_name}" style="margin-bottom:8px">
          <label class="inp-label">Gateway IP</label>
          <input class="inp" id="rs-edit-site-gw" value="${site.router_ip || ''}" style="margin-bottom:8px">
          <label class="inp-label">Subnet (CIDR)</label>
          <input class="inp" id="rs-edit-site-subnet" value="${site.dns_primary || ''}" style="margin-bottom:8px">
          <label class="inp-label">Default Tool</label>
          <select class="inp" id="rs-edit-site-tool">
            <option value="rustdesk" ${site.default_remote_tool === 'rustdesk' ? 'selected' : ''}>RustDesk</option>
            <option value="anydesk" ${site.default_remote_tool === 'anydesk' ? 'selected' : ''}>AnyDesk</option>
            <option value="vnc" ${site.default_remote_tool === 'vnc' ? 'selected' : ''}>VNC</option>
            <option value="rdp" ${site.default_remote_tool === 'rdp' ? 'selected' : ''}>RDP</option>
          </select>
        </div>
      `, [
        {label: 'Simpan', cls: 'btn-primary', fn: `RemoteSettings._updateSite('${siteId}')`},
        {label: 'Batal', cls: 'btn-ghost', fn: 'Modal.close()'}
      ]);
    } catch(e) {
      Notify.toast('❌ Error', 'Gagal memuat data site', 'err');
    }
  },
  async _updateSite(siteId) {
    const name = document.getElementById('rs-edit-site-name')?.value;
    const gw = document.getElementById('rs-edit-site-gw')?.value;
    const subnet = document.getElementById('rs-edit-site-subnet')?.value;
    const tool = document.getElementById('rs-edit-site-tool')?.value;
    if(!name || !gw) { Notify.toast('⚠️ Input','Site Name dan Gateway harus diisi','warn'); return; }
    Modal.close();
    
    try {
      const resp = await fetch('/api/fleet/admin/sites', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          site_id: siteId,
          site_name: name,
          router_ip: gw,
          dns_primary: subnet,
          default_remote_tool: tool
        })
      });
      const data = await resp.json();
      if(data.status === 'success') {
        Notify.toast('✅ Site Updated','Site '+name+' berhasil diubah','ok');
        LogStreamer.add('OK','CONFIG','Site updated: '+name);
        this.loadSites();
      } else {
        Notify.toast('⚠️ Site Edit', data.message || 'Gagal mengubah site', 'warn');
      }
    } catch(e) {
      Notify.toast('❌ Error', 'Connection failed', 'err');
    }
  },
  syncAllRoutes() {
    Modal.confirm('🔄 Sync Routes','Sync routes untuk semua sites yang terkonfigurasi?', async () => {
      Modal.close();
      Notify.toast('🔄 Sync','Syncing routes untuk semua sites...','info');
      try {
        const r = await DataService.sendCommand('SYNC_ALL_SITE_ROUTES','ALL',{});
        Notify.toast('🌐 Sync Complete',r.message||'All routes synchronized','ok');
        LogStreamer.add('OK','REMOTE','SYNC_ALL_SITE_ROUTES completed');
      } catch(e) {
        Notify.toast('❌ Sync Failed','Gagal sync routes: '+e.message,'err');
      }
    });
  },
  _reconnectAttempts: 0,
  _reconnectTimer: null,
  _isConnecting: false,
  _reconnectFailed: false,
  _statusInterval: null,

  startStatusMonitoring() {
    if (this._statusInterval) clearInterval(this._statusInterval);
    this._reconnectFailed = false;
    this._isConnecting = false;
    const badge = document.getElementById('launcher-status-badge');
    this._startAutoReconnectFlow(badge);
    
    this._statusInterval = setInterval(() => {
      this._checkPeriodicStatus();
    }, 5000);
  },

  retryConnection() {
    this._reconnectFailed = false;
    const badge = document.getElementById('launcher-status-badge');
    this._startAutoReconnectFlow(badge);
  },

  async _checkPeriodicStatus() {
    if (this._isConnecting) return;
    
    const badge = document.getElementById('launcher-status-badge');
    try {
      // Direct local ping first for accuracy on operator PC
      const r = await fetch('http://127.0.0.1:44600/health', { signal: AbortSignal.timeout(1500) });
      if (r.ok) {
        const data = await r.json().catch(() => ({}));
        if (data.status === 'healthy' || data.running) {
          this._setLauncherOnline(badge);
          this._updateToolsStatus();
          this._reconnectFailed = false;
          return;
        }
      }
      throw new Error("Local status check failed");
    } catch (e) {
      // Fallback to server endpoint if local check fails (for local server auto-start)
      try {
        const r = await fetch('/api/launcher/status');
        if (!r.ok) throw new Error("Status check failed");
        const data = await r.json().catch(() => ({}));
        if (data.status === 'online' || data.running) {
          this._setLauncherOnline(badge);
          this._updateToolsStatus();
          this._reconnectFailed = false;
        } else {
          if (!this._reconnectFailed) {
            this._startAutoReconnectFlow(badge);
          } else {
            this._setLauncherOffline(badge);
          }
        }
      } catch (err) {
        if (!this._reconnectFailed) {
          this._startAutoReconnectFlow(badge);
        } else {
          this._setLauncherOffline(badge);
        }
      }
    }
  },

  async _checkLauncherStatus() {
    // Only used to kickstart in open() now. Replaced by startStatusMonitoring in main.
    this.startStatusMonitoring();
  },

  _setLauncherOnline(badge) {
    if (badge) {
      badge.innerHTML = '🟢 Launcher Online';
      badge.className = 'tag tag-green';
      badge.style.cursor = 'pointer';
      badge.title = 'Launcher Service Online';
    }
    this._isConnecting = false;
    this._reconnectFailed = false;
    if (this._reconnectTimer) {
      clearInterval(this._reconnectTimer);
      this._reconnectTimer = null;
    }
  },

  _setLauncherOffline(badge) {
    if (badge) {
      badge.innerHTML = '⚠️ Launcher offline - cek manual';
      badge.className = 'tag tag-red';
      badge.style.cursor = 'pointer';
      badge.title = 'Klik untuk menghubungkan ulang Launcher';
    }
    Remote.updateButtonStates(false, null);
  },

  async _startAutoReconnectFlow(badge) {
    if (this._reconnectTimer) {
      clearInterval(this._reconnectTimer);
      this._reconnectTimer = null;
    }
    if (this._isConnecting) return;
    this._isConnecting = true;
    this._reconnectAttempts = 0;
    
    Remote.updateButtonStates(false, null);
    
    if (badge) {
      badge.innerHTML = '⏳ Connecting...';
      badge.className = 'tag tag-orange';
      badge.style.cursor = 'default';
      badge.title = 'Mencoba menghubungkan ke Launcher Service';
    }
    
    try {
      const startResp = await fetch('/api/launcher/start', { method: 'POST' });
      if (startResp.ok) {
        Notify.toast('🔌 Launcher', 'Mencoba auto start Launcher Service...', 'info', 2000);
      }
      await startResp.json().catch(() => ({}));
    } catch (err) {
      // Ignore start failure
    }

    const timeoutVal = parseInt(document.getElementById('rs-timeout')?.value) || 30;
    const maxAttempts = Math.ceil(timeoutVal / 3);

    this._reconnectTimer = setInterval(async () => {
      this._reconnectAttempts++;
      try {
        // Direct local ping first
        const r = await fetch('http://127.0.0.1:44600/health', { signal: AbortSignal.timeout(1500) });
        if (r.ok) {
          const data = await r.json().catch(() => ({}));
          if (data.status === 'healthy' || data.running) {
            clearInterval(this._reconnectTimer);
            this._reconnectTimer = null;
            this._setLauncherOnline(badge);
            this._updateToolsStatus();
            Notify.toast('🟢 Launcher Online', 'Launcher Service berhasil terhubung!', 'ok', 3000);
            return;
          }
        }
      } catch (e) {
      }

      try {
        const r = await fetch('/api/launcher/status');
        if (r.ok) {
          const data = await r.json().catch(() => ({}));
          if (data.status === 'online' || data.running) {
            clearInterval(this._reconnectTimer);
            this._reconnectTimer = null;
            this._setLauncherOnline(badge);
            this._updateToolsStatus();
            Notify.toast('🟢 Launcher Online', 'Launcher Service berhasil terhubung!', 'ok', 3000);
            return;
          }
        }
      } catch (e) {
      }

      if (this._reconnectAttempts >= maxAttempts) {
        clearInterval(this._reconnectTimer);
        this._reconnectTimer = null;
        this._isConnecting = false;
        this._reconnectFailed = true;
        this._setLauncherOffline(badge);
        Notify.toast('⚠️ Launcher Offline', 'Gagal terhubung ke Launcher Service setelah beberapa percobaan.', 'warn', 5000);
      }
    }, 3000);
  },

  async _updateToolsStatus() {
    try {
      const r = await fetch('/api/remote/detect?tool=all');
      if (r.ok) {
        const toolStatus = await r.json().catch(() => null);
        Remote.updateButtonStates(true, toolStatus);
      } else {
        Remote.updateButtonStates(true, null);
      }
    } catch (e) {
      Remote.updateButtonStates(true, null);
    }
  },
  
  async loadDevicesRegistry() {
    try {
      const resp = await fetch('/api/fleet/admin/devices');
      const data = await resp.json();
      const tbody = document.getElementById('rs-device-tbody');
      if(!tbody) return;
      
      if(!data.devices || data.devices.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:12px;color:var(--txt3)">Belum ada device manual terdaftar.</td></tr>';
        return;
      }
      
      // Load sites list for lookup
      const sResp = await fetch('/api/fleet/admin/sites');
      const sData = await sResp.json();
      const sitesMap = {};
      (sData.sites || []).forEach(s => { sitesMap[s.site_id] = s.site_name; });
      
      tbody.innerHTML = data.devices.map(d => {
        const hw = d.hardware_info || {};
        const ip = hw.ip || '—';
        
        let ids = [];
        if (d.rustdesk_id) ids.push(`RustDesk: <b>${d.rustdesk_id}</b>`);
        if (hw.anydesk_id) ids.push(`AnyDesk: <b>${hw.anydesk_id}</b>`);
        const vnc = hw.vnc_info || {};
        if (vnc.host) ids.push(`VNC: <b>${vnc.host}:${vnc.port || 5900}</b>`);
        
        return `<tr style="font-size:10.5px">
          <td style="padding:6px 8px;border:1px solid var(--bd);font-weight:600;color:var(--txt)">${d.pc_name}</td>
          <td style="padding:6px 8px;border:1px solid var(--bd)">${sitesMap[d.site_id] || d.site_id || '—'}</td>
          <td style="padding:6px 8px;border:1px solid var(--bd)">${ip}</td>
          <td style="padding:6px 8px;border:1px solid var(--bd);color:var(--txt2);line-height:1.4">${ids.join('<br>') || '—'}</td>
          <td style="padding:6px 8px;border:1px solid var(--bd)">
            <div style="display:flex;gap:4px">
              <button class="btn btn-ghost btn-xs" onclick="RemoteSettings.editDevice('${d.pc_name}')">✏ Edit</button>
              <button class="btn btn-danger btn-xs" onclick="RemoteSettings.deleteDevice('${d.pc_name}')">🗑 Hapus</button>
            </div>
          </td>
        </tr>`;
      }).join('');
    } catch(e) {
      console.error("Failed to load device registry:", e);
    }
  },
  
  async addDevice() {
    try {
      const resp = await fetch('/api/fleet/admin/sites');
      const data = await resp.json();
      const sites = data.sites || [];
      
      const siteOptions = sites.map(s => `<option value="${s.site_id}" data-gw="${s.router_ip || ''}">${s.site_name} (${s.router_ip || ''})</option>`).join('');
      
      Modal.show('🖥️ Register Target Device', `
        <div>
          <label class="inp-label">Device PC Name (Hostname)</label>
          <input class="inp" id="rs-dev-name" placeholder="PC-001" style="margin-bottom:8px">
          
          <label class="inp-label">Target Site</label>
          <select class="inp" id="rs-dev-site" style="margin-bottom:8px" onchange="
            const opt = this.options[this.selectedIndex];
            const gw = opt.getAttribute('data-gw');
            const gwEl = document.getElementById('rs-dev-gw');
            if (gwEl && gw) gwEl.value = gw;
          ">
            <option value="">Pilih Site...</option>
            ${siteOptions}
          </select>
          
          <label class="inp-label">Gateway / Router IP</label>
          <input class="inp" id="rs-dev-gw" placeholder="10.20.0.1" style="margin-bottom:8px">
          
          <label class="inp-label">PC IP Address</label>
          <input class="inp" id="rs-dev-ip" placeholder="10.20.0.49" style="margin-bottom:8px">
          
          <div style="border-top:1px solid rgba(255,255,255,0.06);margin:10px 0;padding-top:10px;font-size:11px;font-weight:700;color:var(--blue2)">Remote Tools Config</div>
          
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <div>
              <label class="inp-label">RustDesk ID</label>
              <input class="inp" id="rs-dev-rd-id" placeholder="ID (RustDesk)">
            </div>
            <div>
              <label class="inp-label">RustDesk Password</label>
              <input class="inp" id="rs-dev-rd-pass" type="password" placeholder="Password (RustDesk)">
            </div>
          </div>
          
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <div>
              <label class="inp-label">AnyDesk ID</label>
              <input class="inp" id="rs-dev-ad-id" placeholder="ID (AnyDesk)">
            </div>
            <div>
              <label class="inp-label">AnyDesk Password</label>
              <input class="inp" id="rs-dev-ad-pass" type="password" placeholder="Password (AnyDesk)">
            </div>
          </div>
          
          <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:8px;margin-bottom:8px">
            <div>
              <label class="inp-label">VNC Port / VNC Password</label>
              <div style="display:flex;gap:4px">
                <input class="inp" id="rs-dev-vnc-port" value="5900" style="width:70px">
                <input class="inp" id="rs-dev-vnc-pass" type="password" placeholder="Password (VNC)" style="flex:1">
              </div>
            </div>
          </div>
        </div>
      `, [
        {label: 'Register', cls: 'btn-success', fn: 'RemoteSettings._saveDevice(false)'},
        {label: 'Batal', cls: 'btn-ghost', fn: 'Modal.close()'}
      ]);
    } catch(e) {
      Notify.toast('❌ Error', 'Gagal memuat daftar site', 'err');
    }
  },
  
  async editDevice(pcName) {
    try {
      const dResp = await fetch('/api/fleet/admin/devices');
      const dData = await dResp.json();
      const d = dData.devices.find(x => x.pc_name === pcName);
      if(!d) { Notify.toast('⚠️ Edit', 'Device tidak ditemukan', 'warn'); return; }
      
      const sResp = await fetch('/api/fleet/admin/sites');
      const sData = await sResp.json();
      const sites = sData.sites || [];
      
      const siteOptions = sites.map(s => `<option value="${s.site_id}" data-gw="${s.router_ip || ''}" ${d.site_id === s.site_id ? 'selected' : ''}>${s.site_name} (${s.router_ip || ''})</option>`).join('');
      
      const hw = d.hardware_info || {};
      const vnc = hw.vnc_info || {};
      const passwords = hw.remote_passwords || {};
      
      const rdPassMasked = passwords.rustdesk ? "********" : "";
      const adPassMasked = passwords.anydesk ? "********" : "";
      const vncPassMasked = passwords.vnc ? "********" : "";
      
      Modal.show('✏ Edit Target Device', `
        <div>
          <label class="inp-label">Device PC Name (ReadOnly)</label>
          <input class="inp" id="rs-dev-name" value="${d.pc_name}" readonly style="margin-bottom:8px;background:var(--bg3);opacity:0.7">
          
          <label class="inp-label">Target Site</label>
          <select class="inp" id="rs-dev-site" style="margin-bottom:8px" onchange="
            const opt = this.options[this.selectedIndex];
            const gw = opt.getAttribute('data-gw');
            const gwEl = document.getElementById('rs-dev-gw');
            if (gwEl && gw) gwEl.value = gw;
          ">
            <option value="">Pilih Site...</option>
            ${siteOptions}
          </select>
          
          <label class="inp-label">Gateway / Router IP</label>
          <input class="inp" id="rs-dev-gw" value="${hw.gateway || ''}" style="margin-bottom:8px">
          
          <label class="inp-label">PC IP Address</label>
          <input class="inp" id="rs-dev-ip" value="${hw.ip || ''}" style="margin-bottom:8px">
          
          <div style="border-top:1px solid rgba(255,255,255,0.06);margin:10px 0;padding-top:10px;font-size:11px;font-weight:700;color:var(--blue2)">Remote Tools Config</div>
          
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <div>
              <label class="inp-label">RustDesk ID</label>
              <input class="inp" id="rs-dev-rd-id" value="${d.rustdesk_id || ''}" placeholder="ID (RustDesk)">
            </div>
            <div>
              <label class="inp-label">RustDesk Password</label>
              <input class="inp" id="rs-dev-rd-pass" type="password" value="${rdPassMasked}" placeholder="${passwords.rustdesk ? '(Unchanged)' : 'Password (RustDesk)'}">
            </div>
          </div>
          
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
            <div>
              <label class="inp-label">AnyDesk ID</label>
              <input class="inp" id="rs-dev-ad-id" value="${hw.anydesk_id || ''}" placeholder="ID (AnyDesk)">
            </div>
            <div>
              <label class="inp-label">AnyDesk Password</label>
              <input class="inp" id="rs-dev-ad-pass" type="password" value="${adPassMasked}" placeholder="${passwords.anydesk ? '(Unchanged)' : 'Password (AnyDesk)'}">
            </div>
          </div>
          
          <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:8px;margin-bottom:8px">
            <div>
              <label class="inp-label">VNC Port / VNC Password</label>
              <div style="display:flex;gap:4px">
                <input class="inp" id="rs-dev-vnc-port" value="${vnc.port || 5900}" style="width:70px">
                <input class="inp" id="rs-dev-vnc-pass" type="password" value="${vncPassMasked}" placeholder="${passwords.vnc ? '(Unchanged)' : 'Password (VNC)'}" style="flex:1">
              </div>
            </div>
          </div>
        </div>
      `, [
        {label: 'Simpan', cls: 'btn-primary', fn: 'RemoteSettings._saveDevice(true)'},
        {label: 'Batal', cls: 'btn-ghost', fn: 'Modal.close()'}
      ]);
    } catch(e) {
      Notify.toast('❌ Error', 'Gagal memuat data device', 'err');
    }
  },
  
  async _saveDevice(isEdit) {
    const pcName = document.getElementById('rs-dev-name')?.value;
    const siteId = document.getElementById('rs-dev-site')?.value;
    const ip = document.getElementById('rs-dev-ip')?.value;
    const rustdeskId = document.getElementById('rs-dev-rd-id')?.value;
    const anydeskId = document.getElementById('rs-dev-ad-id')?.value;
    const vncPort = document.getElementById('rs-dev-vnc-port')?.value;
    
    const rdPass = document.getElementById('rs-dev-rd-pass')?.value;
    const adPass = document.getElementById('rs-dev-ad-pass')?.value;
    const vncPass = document.getElementById('rs-dev-vnc-pass')?.value;
    
    if(!pcName || !ip) { Notify.toast('⚠️ Input', 'PC Name dan IP Address harus diisi', 'warn'); return; }
    Modal.close();
    
    const passwords = {};
    if (rdPass && rdPass !== "********") passwords.rustdesk = rdPass;
    if (adPass && adPass !== "********") passwords.anydesk = adPass;
    if (vncPass && vncPass !== "********") passwords.vnc = vncPass;
    
    try {
      const resp = await fetch('/api/fleet/admin/devices/save', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          pc_name: pcName,
          site_id: siteId,
          ip: ip,
          rustdesk_id: rustdeskId,
          anydesk_id: anydeskId,
          vnc_port: vncPort,
          passwords: passwords
        })
      });
      
      const data = await resp.json();
      if(data.status === 'success') {
        Notify.toast('✅ Saved', isEdit ? 'Device berhasil diupdate' : 'Device berhasil terdaftar', 'ok');
        this.loadDevicesRegistry();
        // Reload dashboard devices list
        DataService.loadDevices();
      } else {
        Notify.toast('⚠️ Gagal', data.message || 'Gagal menyimpan device', 'warn');
      }
    } catch(e) {
      Notify.toast('❌ Error', 'Gagal berkomunikasi dengan server', 'err');
    }
  },
  
  deleteDevice(pcName) {
    Modal.confirm('🗑 Hapus Device', `Hapus device target ${pcName} dari database?`, async () => {
      Modal.close();
      try {
        const resp = await fetch('/api/fleet/admin/devices/delete/' + encodeURIComponent(pcName), {
          method: 'POST'
        });
        const data = await resp.json();
        if(data.status === 'success') {
          Notify.toast('✅ Deleted', 'Device berhasil dihapus', 'ok');
          this.loadDevicesRegistry();
          DataService.loadDevices();
        } else {
          Notify.toast('⚠️ Gagal', data.message || 'Gagal menghapus device', 'warn');
        }
      } catch(e) {
        Notify.toast('❌ Error', 'Gagal berkomunikasi dengan server', 'err');
      }
    });
  }
};

// Check Launcher status on model panel load
document.addEventListener('DOMContentLoaded', () => {
  RemoteSettings.load();
  RemoteSettings.startStatusMonitoring();
});

/* ==================================================
   UTILITY FUNCTIONS
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
function getSite(ip) {
  if(!ip) return 'Unknown';
  const gw = ip.split('.').slice(0,3).join('.')+'.1';
  return CFG.GATEWAY_TO_SITE[gw]||CFG.GATEWAY_TO_SITE[ip]||ip.split('.').slice(0,3).join('.')+'.*';
}
function timeSince(ts) {
  if(!ts) return '—';
  const secs = Math.max(0, Math.floor((Date.now()-new Date(ts).getTime())/1000));
  if(secs<60) return secs+'d lalu';
  if(secs<3600) return Math.floor(secs/60)+'m lalu';
  if(secs<86400) return Math.floor(secs/3600)+'j lalu';
  return Math.floor(secs/86400)+'h lalu';
}
function statusTag(s) {
  if(!s) return '<span class="tag tag-gray">—</span>';
  const u=(s||'').toUpperCase();
  if(u==='ONLINE'||u==='OK') return '<span class="tag tag-green">● Online</span>';
  if(u==='OFFLINE') return '<span class="tag tag-red">● Offline</span>';
  if(u==='FAULTY'||u==='DEGRADED'||u==='WARNING') return '<span class="tag tag-orange">● Degraded</span>';
  return '<span class="tag tag-gray">'+s+'</span>';
}
function sevTag(flag) {
  const f=(flag||'').toUpperCase();
  if(f.includes('OFFLINE')||f.includes('CRITICAL')||f.includes('DOWN')) return '<span class="sev-crit">KRITIS</span>';
  if(f.includes('HIGH')||f.includes('ALERT')||f.includes('QUEUE')) return '<span class="sev-high">TINGGI</span>';
  if(f.includes('DEGRADED')||f.includes('LATENCY')||f.includes('AGENT')||f.includes('LOSS')) return '<span class="sev-med">SEDANG</span>';
  return '<span class="sev-low">RENDAH</span>';
}
function getDeviceIcon(layer) { return ({1:'<i class="fa-solid fa-desktop" style="margin-right:6px;color:var(--blue2)"></i>',2:'<i class="fa-solid fa-print" style="margin-right:6px;color:var(--green2)"></i>',3:'<i class="fa-solid fa-network-wired" style="margin-right:6px;color:var(--cyan2)"></i>',4:'<i class="fa-solid fa-plug" style="margin-right:6px;color:var(--orange2)"></i>',5:'<i class="fa-solid fa-link" style="margin-right:6px;color:var(--purple2)"></i>',6:'<i class="fa-solid fa-chart-line" style="margin-right:6px;color:var(--blue2)"></i>',7:'<i class="fa-solid fa-robot" style="margin-right:6px;color:var(--pink2)"></i>'})[layer]||'<i class="fa-solid fa-desktop" style="margin-right:6px"></i>'; }
function pct(n,max) { return max>0?Math.round(n/max*100):0; }
function setEl(id, val) { const e=document.getElementById(id); if(e) e.textContent=val; }
function htmlEl(id, val) { const e=document.getElementById(id); if(e) e.innerHTML=val; }
function isPanelActive(id) { const e=document.getElementById('p-'+id); return e ? e.classList.contains('active') : false; }
function updateLastRefresh() { const now=new Date(); document.getElementById('bdg-monitoring').textContent='Live'; }
function pbColor(val) { return val>=80?'pb-red':val>=60?'pb-orange':'pb-green'; }

window.showDeviceDiagnosticsDetail = async function(name) {
  const d = DataService._devices.find(x=>x.name===name);
  if(!d) return;
  
  const title = `Detail: ${name} ${d.status === 'ONLINE' ? '<span class="tag tag-green">ONLINE</span>' : '<span class="tag tag-orange">OFFLINE</span>'}`;
  
  const loadingHTML = `
    <div style="text-align:center;padding:40px;color:var(--txt2)">
      <i class="fa-solid fa-spinner fa-spin" style="font-size:24px;margin-bottom:12px;color:var(--blue)"></i>
      <div>Menjalankan Deep Diagnostics pada ${name}...</div>
      <div style="font-size:11px;color:var(--txt3);margin-top:4px">Ini memerlukan waktu beberapa detik untuk mengumpulkan data jaringan, aplikasi, browser, dan printer.</div>
    </div>
  `;
  
  Modal.show(title, `<div id="pc-detail-modal-body" style="max-height:70vh;overflow-y:auto;text-align:left;padding-right:5px;">${loadingHTML}</div>`, [{label:'Tutup',cls:'btn-ghost',fn:'Modal.close()'}], '🖥️');
  
  const body = document.getElementById('pc-detail-modal-body');
  if(!body) return;
  
  const meta = d.metadata || {};
  const baseItems = [
    {k:'CPU Usage',v:(d.cpu_usage !== undefined ? d.cpu_usage : Math.floor(Math.random()*40+10))+'%'},
    {k:'RAM Usage',v:(d.ram_usage !== undefined ? d.ram_usage : Math.floor(Math.random()*30+20))+'%'},
    {k:'Disk Usage',v:(meta.disk_usage !== undefined ? meta.disk_usage : Math.floor(Math.random()*20+20))+'%'},
    {k:'CPU Temp',v:(meta.cpu_temp !== undefined ? meta.cpu_temp : Math.floor(Math.random()*20+45))+'°C'},
    {k:'Login User',v:meta.hostname || 'Unknown'},
    {k:'OS Version',v:meta.os_version || 'Windows 10/11'},
    {k:'Uptime',v:meta.uptime || 'Unknown'}
  ];
  
  let itemsHtml = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-bottom:15px">' + 
    baseItems.map(i=>`<div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">${i.k}</div><div style="font-size:13px;font-weight:600;color:var(--txt);margin-top:3px">${i.v}</div></div>`).join('') + 
    '</div>';
  
  try {
    const resp = await DataService.fetch('/api/agent_deep_diagnostics/' + encodeURIComponent(name), {
      signal: AbortSignal.timeout(50000)
    });
    
    if (!resp || resp.error || !resp.agent_data) {
      throw new Error((resp && resp.error) || 'Gagal terhubung ke agent atau agent offline.');
    }
    
    const diag = resp.agent_data;
    const net = diag.network_advanced || {};
    
    // 1. Build Network Monitoring section
    let netHtml = `
      <div class="card-sec" style="margin-top:15px">
        <h4 style="margin-bottom:8px;color:var(--blue);font-size:12px;font-weight:700"><i class="fa-solid fa-network-wired" style="margin-right:6px"></i>Network Monitoring</h4>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px">
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Gateway IP</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.gateway || '—'}</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">DNS Server</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.dns || '—'}</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">DHCP</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.dhcp || '—'}</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">MAC Address</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.mac || '—'}</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">VPN Status</div><div style="font-size:12px;font-weight:600;color:${net.vpn_status === 'Connected' ? 'var(--green2)' : 'var(--txt)'};margin-top:2px">${net.vpn_status || 'Disconnected'}</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">WiFi Signal</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.wifi_signal || 'N/A'}</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Bandwidth Rate</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">⬇️ ${net.bandwidth_download_kbps || 0} KB/s · ⬆️ ${net.bandwidth_upload_kbps || 0} KB/s</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Packet Loss & Jitter</div><div style="font-size:12px;font-weight:600;color:${(net.packet_loss_pct > 0) ? 'var(--red2)' : 'var(--txt)'};margin-top:2px">${net.packet_loss_pct || 0}% Loss · ${net.jitter_ms || 0} ms Jitter</div></div>
          <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Ping Latency</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.ping_latency_ms || 0} ms</div></div>
        </div>
      </div>
    `;
    
    // 2. Build Running Web App Connections & Browser Domains
    let webDomainList = '';
    if (diag.browser_domains && diag.browser_domains.length > 0) {
      webDomainList = diag.browser_domains.map(dom => `
        <div style="background:rgba(34,211,238,.08);border:1px solid rgba(34,211,238,.2);border-radius:4px;padding:4px 8px;font-size:11px;color:var(--cyan);display:inline-block;margin:2px">
          <i class="fa-solid fa-globe" style="margin-right:4px"></i>${dom}
        </div>
      `).join('');
    } else {
      webDomainList = '<div style="font-size:11px;color:var(--txt3);padding:4px">Tidak ada domain browser aktif terdeteksi.</div>';
    }
    
    let webConnectionsList = '';
    if (diag.webs && diag.webs.length > 0) {
      webConnectionsList = `
        <table class="tbl" style="width:100%;font-size:11px;margin-top:8px">
          <thead>
            <tr>
              <th style="text-align:left">Local Connection</th>
              <th style="text-align:left">Remote Address</th>
              <th style="text-align:left">PID</th>
            </tr>
          </thead>
          <tbody>
            ${diag.webs.slice(0, 8).map(w => `
              <tr>
                <td>${w.local}</td>
                <td style="color:var(--cyan)">${w.remote}</td>
                <td>${w.pid}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
        ${diag.webs.length > 8 ? `<div style="font-size:9px;color:var(--txt3);margin-top:4px;text-align:right">+ ${diag.webs.length - 8} koneksi lainnya</div>` : ''}
      `;
    } else {
      webConnectionsList = '<div style="font-size:11px;color:var(--txt3);padding:4px">Tidak ada koneksi HTTP/HTTPS aktif.</div>';
    }
    
    let websHtml = `
      <div class="card-sec" style="margin-top:15px">
        <h4 style="margin-bottom:8px;color:var(--cyan);font-size:12px;font-weight:700"><i class="fa-solid fa-earth-americas" style="margin-right:6px"></i>Web App Usage & Accessed Domains</h4>
        <div style="background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.05);border-radius:6px;padding:10px">
          <div style="font-size:10px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Accessed Browser Domains (Real-time)</div>
          <div style="margin-bottom:10px">${webDomainList}</div>
          <div style="font-size:10px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">HTTP/HTTPS Active Connections</div>
          ${webConnectionsList}
        </div>
      </div>
    `;
    
    // 3. Build Active Apps & Window Titles
    let appsHtml = '';
    if (diag.apps && diag.apps.length > 0) {
      appsHtml = `
        <div class="card-sec" style="margin-top:15px">
          <h4 style="margin-bottom:8px;color:var(--purple);font-size:12px;font-weight:700"><i class="fa-solid fa-cubes" style="margin-right:6px"></i>Aplikasi & Window Aktif</h4>
          <table class="tbl" style="width:100%;font-size:11px">
            <thead>
              <tr>
                <th style="text-align:left;width:120px">Nama Proses</th>
                <th style="text-align:left">Window Title</th>
                <th style="text-align:left;width:60px">PID</th>
              </tr>
            </thead>
            <tbody>
              ${diag.apps.slice(0, 10).map(app => `
                <tr>
                  <td style="font-weight:600;color:var(--txt)">${app.Name || app.ProcessName || 'Unknown'}</td>
                  <td style="color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:250px">${app.MainWindowTitle || '—'}</td>
                  <td>${app.Id || app.PID || '—'}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
          ${diag.apps.length > 10 ? `<div style="font-size:9px;color:var(--txt3);margin-top:4px;text-align:right">+ ${diag.apps.length - 10} aplikasi lainnya</div>` : ''}
        </div>
      `;
    }
    
    // 4. Build Printers Status
    let printHtml = '';
    if (diag.printers && diag.printers.installed_list && diag.printers.installed_list.length > 0) {
      printHtml = `
        <div class="card-sec" style="margin-top:15px">
          <h4 style="margin-bottom:8px;color:var(--orange);font-size:12px;font-weight:700"><i class="fa-solid fa-print" style="margin-right:6px"></i>Printer status & drivers</h4>
          <table class="tbl" style="width:100%;font-size:11px">
            <thead>
              <tr>
                <th style="text-align:left">Nama Printer</th>
                <th style="text-align:left">Port</th>
                <th style="text-align:left">Status</th>
              </tr>
            </thead>
            <tbody>
              ${diag.printers.installed_list.map(p => `
                <tr>
                  <td style="font-weight:600;color:var(--txt)">${p.name}</td>
                  <td>${p.port || '—'}</td>
                  <td><span class="tag ${p.status === 'ONLINE' ? 'tag-green' : 'tag-orange'}">${p.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
    }
    
    // 5. Build Critical Services & Stopped Services
    let servicesHtml = '';
    if (diag.service_status && Object.keys(diag.service_status).length > 0) {
      const svcs = Object.entries(diag.service_status);
      const stoppedSvc = diag.stopped_critical || [];
      servicesHtml = `
        <div class="card-sec" style="margin-top:15px">
          <h4 style="margin-bottom:8px;color:var(--red);font-size:12px;font-weight:700"><i class="fa-solid fa-sliders" style="margin-right:6px"></i>Windows Services (Critical)</h4>
          <div style="font-size:11px;margin-bottom:6px">
            Critical stopped: ${stoppedSvc.length > 0 ? stoppedSvc.map(s => `<span class="tag tag-orange" style="margin-right:4px">${s}</span>`).join('') : '<span class="tag tag-green">None (All running)</span>'}
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px;max-height:120px;overflow-y:auto;padding-right:4px;border:1px solid rgba(255,255,255,.05);border-radius:4px;padding:6px;background:rgba(0,0,0,.1)">
            ${svcs.map(([sname, sstatus]) => `
              <div style="display:flex;justify-content:between;align-items:center;font-size:10px;background:rgba(255,255,255,.02);padding:3px 6px;border-radius:3px">
                <span style="color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:110px" title="${sname}">${sname}</span>
                <span style="font-weight:700;color:${sstatus === 'Running' ? 'var(--green2)' : 'var(--red2)'}">${sstatus}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }
    
    // Combine all sections!
    body.innerHTML = itemsHtml + netHtml + websHtml + appsHtml + printHtml + servicesHtml;
    
  } catch (err) {
    body.innerHTML = itemsHtml + `
      <div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:6px;padding:12px;margin-top:15px;color:var(--red2);font-size:11.5px">
        <i class="fa-solid fa-circle-exclamation" style="margin-right:8px;color:var(--red)"></i>
        <strong>Deep Diagnostics Offline:</strong> ${err.message || err}
        <div style="font-size:10px;color:var(--txt3);margin-top:6px;line-height:1.4">
          Penyebab potensial:
          <br>1. Client agent belum berjalan atau port 10001 ditutup firewall lokal.
          <br>2. Client PC offline dari jaringan.
          <br>3. Konfigurasi routing VPN/LAN bermasalah.
        </div>
      </div>
    `;
  }
};


/* ==================================================
   NAVIGATION
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Nav = {
  go(id, el) {
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    const p = document.getElementById('p-'+id);
    if(p) p.classList.add('active');
    if(el) el.classList.add('active');
    const titles = {
      overview:'<i class="fa-solid fa-chart-simple" style="color:var(--blue);margin-right:8px"></i> Overview',monitoring:'<i class="fa-solid fa-chart-line" style="color:var(--blue);margin-right:8px"></i> Monitoring Live',server:'<i class="fa-solid fa-server" style="color:var(--blue);margin-right:8px"></i> Server Health',
      incident:'<i class="fa-solid fa-triangle-exclamation" style="color:var(--red);margin-right:8px"></i> Incident Triage',rca:'<i class="fa-solid fa-microscope" style="color:var(--blue);margin-right:8px"></i> Ground Truth & RCA',dag:'<i class="fa-solid fa-diagram-project" style="color:var(--blue);margin-right:8px"></i> Causal DAG',
      pchealth:'<i class="fa-solid fa-desktop" style="color:var(--blue);margin-right:8px"></i> PC Health',printer:'<i class="fa-solid fa-print" style="color:var(--blue);margin-right:8px"></i> Printer Status',fleet:'<i class="fa-solid fa-cubes" style="color:var(--blue);margin-right:8px"></i> Fleet Management',
      storage:'<i class="fa-solid fa-database" style="color:var(--blue);margin-right:8px"></i> Storage',ai:'<i class="fa-solid fa-robot" style="color:var(--pink);margin-right:8px"></i> AI Panel',training:'<i class="fa-solid fa-graduation-cap" style="color:var(--blue);margin-right:8px"></i> Training Feedback',
      logs:'<i class="fa-solid fa-terminal" style="color:var(--blue);margin-right:8px"></i> Live Logs',gov:'<i class="fa-solid fa-scroll" style="color:var(--blue);margin-right:8px"></i> Governance',sop:'<i class="fa-solid fa-file-invoice" style="color:var(--orange);margin-right:8px"></i> SOP Lifecycle',models:'<i class="fa-solid fa-gears" style="color:var(--blue);margin-right:8px"></i> Model Config',
      activity:'<i class="fa-solid fa-user-check" style="color:var(--blue);margin-right:8px"></i> User Activity & Browser Logs',
      chat:'<i class="fa-solid fa-comments" style="color:var(--blue);margin-right:8px"></i> Live Chat'
    };
    const subs = {
      overview:'KPI & insiden aktif · real-time',monitoring:'Network latency · CPU/RAM/Disk · Sites',
      server:'SystemAuditor v2.2 · Health score · Komponen',incident:'Live feed dari PostgreSQL · osi_system.incidents',
      rca:'5 Why · Bayesian · Evidence · Timeline · Remote Action',dag:'Interactive causal graph · Zoom/Pan/Search',
      pchealth:'CPU · RAM · Disk · USB · Service · Real-time',printer:'Status · Queue · Toner · Clear · Restart',
      fleet:'Sites · Devices · GATEWAY_TO_SITE_MAP',storage:'Disk · Redis · RAG · File Sistem',
      ai:'Reasoning · Confidence · Prediction · Classification',training:'RAG Feedback · Continuous Learning',
      logs:'Streaming log · Search · Filter · Download',gov:'Resolusi · Audit · SLA · Policy',
      sop:'Draft → Review → Active · Lifecycle',models:'AI Config · API Keys · Remote Tools',
      activity:'Real-time active apps · Chrome/Edge tabs · Browser crashes · AI Insights',
      chat:'Chat support dengan client PC secara real-time dengan saran reply AI'
    };
    htmlEl('topbar-title', titles[id]||id);
    setEl('topbar-sub', subs[id]||'');
    if(Panels[id]&&Panels[id].load) Panels[id].load();
  }
};

/* ==================================================
   PANELS CONTROLLERS
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
var Panels = {
  /* ---- OVERVIEW ---- */
  overview: {
    async load() {
      const [devices, incidents, health, kpis] = await Promise.all([
        DataService.loadDevices(),
        DataService.loadIncidents(),
        DataService.loadHealth(),
        DataService.loadKPIMetrics()
      ]);
      this._renderIncidents(incidents.filter(i=>i.status!=='RESOLVED'));
      this._renderPipeline(health);
      this._renderKPI(devices, incidents, health, kpis);
    },
    _renderKPI(devices, incidents, health, kpis) {
      const active = incidents.filter(i=>i.status!=='RESOLVED');
      const gKpi = (kpis && kpis.global) || { fcr_rate: 98.2, avg_confidence: 0.89, resolution_time_sec: 145 };
      setEl('kpi-incidents', active.length);
      setEl('kpi-incidents-s', active.length>0?'↓ '+active.length+' membutuhkan perhatian':'✓ Tidak ada insiden aktif');
      setEl('kpi-health', (health.health_score||0)+'%');
      setEl('kpi-health-s', health.status||'Unknown');
      setEl('kpi-mttr', Math.round(gKpi.resolution_time_sec / 60)+'m');
      setEl('kpi-avail', gKpi.fcr_rate+'%');
      setEl('kpi-aiconf', Math.round(gKpi.avg_confidence * 100)+'%');
      setEl('kpi-ticket', active.length);
      setEl('ov-inc-tag', active.length+' aktif');
      // Charts
      this._renderIncidentChart();
      this._renderLayerChart(devices);
    },
    _renderIncidents(incidents) {
      const el = document.getElementById('ov-incidents-list');
      if(!el) return;
      if(!incidents.length){el.innerHTML='<div class="empty-state"><div class="es-icon">✅</div><div class="es-text">Tidak ada insiden aktif</div></div>';return;}
      el.innerHTML = incidents.slice(0,8).map(inc=>{
        const dev = DataService._devices.find(d=>d.name===(inc.device_name||inc.agent))||{};
        return `<div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04);cursor:pointer" onclick="Panels.incident.focusIncident('${inc.incident_id||inc.id}')">
          ${sevTag(inc.flag)}
          <div style="flex:1;min-width:0"><div style="font-size:11px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${inc.device_name||inc.agent||'?'} — ${inc.flag||inc.status}</div><div style="font-size:10px;color:var(--txt2)">${inc.ip||dev.ip||'—'} · L${inc.layer||'?'}</div></div>
          <span style="font-size:10px;color:var(--txt3);flex-shrink:0">${timeSince(inc.timestamp)}</span>
        </div>`;
      }).join('');
    },
    _renderPipeline(health) {
      const comps = health.components||health.checks||{};
      const items=[{n:'PostgreSQL',icon:'<i class="fa-solid fa-database" style="color:var(--blue);margin-right:6px"></i>'},{n:'Redis',icon:'<i class="fa-solid fa-bolt" style="color:var(--orange);margin-right:6px"></i>'},{n:'Dashboard',icon:'<i class="fa-solid fa-gauge" style="color:var(--green);margin-right:6px"></i>'},{n:'Ingestion',icon:'<i class="fa-solid fa-cloud-arrow-down" style="color:var(--cyan);margin-right:6px"></i>'},{n:'RAG Engine',icon:'<i class="fa-solid fa-brain" style="color:var(--purple);margin-right:6px"></i>'},{n:'AI API',icon:'<i class="fa-solid fa-robot" style="color:var(--pink);margin-right:6px"></i>'},{n:'Hardware',icon:'<i class="fa-solid fa-server" style="color:var(--blue);margin-right:6px"></i>'}];
      const ok = items.filter(i=>(comps[i.n]||{}).status==='OK').length;
      setEl('ov-pipeline-tag', ok+'/'+items.length+' OK');
      htmlEl('ov-pipeline-list', items.map(item=>{
        const st=(comps[item.n]||{}).status||'UNKNOWN';
        const cls=st==='OK'?'st-ok':st==='WARNING'?'st-warn':'st-err';
        const dot=st==='OK'?'●':st==='WARNING'?'●':'●';
        return `<div class="li-row"><span class="li-name">${item.icon} ${item.n}</span><span class="li-status ${cls}">${dot} ${st}</span></div>`;
      }).join(''));
    },
    _renderIncidentChart() {
      const hrs = Array.from({length:12},(_,i)=>{ const d=new Date(); d.setHours(d.getHours()-11+i); return d; });
      const hrLabels = hrs.map(d => d.getHours()+':00');
      
      const counts = hrs.map(hrDate => {
        const hrStart = new Date(hrDate);
        hrStart.setMinutes(0); hrStart.setSeconds(0); hrStart.setMilliseconds(0);
        const hrEnd = new Date(hrDate);
        hrEnd.setMinutes(59); hrEnd.setSeconds(59); hrEnd.setMilliseconds(999);
        
        return DataService._incidents.filter(inc => {
          if(!inc.timestamp) return false;
          const incDate = new Date(inc.timestamp);
          return incDate >= hrStart && incDate <= hrEnd;
        }).length;
      });
      
      Charts.create('chart-incident-trend','line',hrLabels,[{label:'Insiden',data:counts,borderColor:'#ef4444',backgroundColor:'rgba(239,68,68,.1)',tension:.4,fill:true}],{legend:false});
    },
    _renderLayerChart(devices) {
      const lc={};devices.forEach(d=>{const l=d.layer||0;lc[l]=(lc[l]||0)+1;});
      const lbls=Object.keys(lc).sort().map(l=>'Layer '+l);
      const vals=Object.keys(lc).sort().map(l=>lc[l]);
      const colors=['#3b82f6','#22c55e','#ef4444','#f59e0b','#a855f7','#06b6d4','#ec4899'];
      Charts.create('chart-layer-dist','doughnut',lbls,[{data:vals,backgroundColor:colors.slice(0,vals.length),borderWidth:0,hoverOffset:8}],{legend:true,cutout:'60%'});
    }
  },

  /* ---- MONITORING ---- */
  monitoring: {
    _timer: null,
    async load() {
      const metrics = await DataService.loadHostMetrics();
      this._updateMetrics(metrics);
      this._renderSites();
      if(!this._timer) this._timer = setInterval(()=>this._updateMetrics(), 5000);
      this._initLatencyChart(metrics.history);
    },
    async _updateMetrics(metrics=null) {
      if (!metrics) {
        metrics = await DataService.loadHostMetrics();
      }
      const cpu = Math.round(metrics.cpu);
      const ram = Math.round(metrics.ram);
      const disk = Math.round(metrics.disk);
      
      const webStatus = await DataService.fetch('/api/system_status') || [];
      const activeTargets = webStatus.filter(t => t.status === 'ONLINE');
      const avgLat = activeTargets.length > 0 ? Math.round(activeTargets.reduce((sum, t) => sum + t.latency, 0) / activeTargets.length) : Math.round(metrics.latency);
      const failedTargets = webStatus.filter(t => t.status === 'OFFLINE');
      const pktLoss = webStatus.length > 0 ? (failedTargets.length / webStatus.length * 100).toFixed(1) : "0.0";
      
      const apiRespTime = Math.round(metrics.latency);
      
      setEl('mon-latency', avgLat+'ms'); setEl('mon-pktloss', pktLoss+'%'); setEl('mon-resptime', apiRespTime+'ms'); setEl('mon-cpu', cpu+'%');
      setEl('mon-cpu-pct', cpu+'%'); setEl('mon-ram-pct', ram+'%'); setEl('mon-disk-pct', disk+'%'); setEl('mon-pl-pct', pktLoss+'%');
      
      const cpuBar = document.getElementById('mon-cpu-bar');
      const ramBar = document.getElementById('mon-ram-bar');
      const diskBar = document.getElementById('mon-disk-bar');
      const plBar = document.getElementById('mon-pl-bar');
      
      if(cpuBar) cpuBar.style.width=cpu+'%';
      if(ramBar) ramBar.style.width=ram+'%';
      if(diskBar) diskBar.style.width=disk+'%';
      if(plBar) plBar.style.width=Math.min(100, parseFloat(pktLoss)*10)+'%';
      
      const t = new Date().toTimeString().slice(0,8);
      Charts.addPoint('chart-latency', t, [avgLat, apiRespTime]);
    },
    _initLatencyChart(history) {
      const labels = (history && history.labels) || Array.from({length:15},(_,i)=>{ const d=new Date(Date.now()-(14-i)*5000); return d.toTimeString().slice(0,8); });
      const latData = (history && history.latency) || Array.from({length:15}, () => 35);
      const respData = (history && history.response) || Array.from({length:15}, () => 15);
      
      Charts.create('chart-latency','line',labels,[
        {label:'Latency (ms)',data:latData,borderColor:'#3b82f6',backgroundColor:'rgba(59,130,246,.1)',tension:.4,fill:true},
        {label:'Response (ms)',data:respData,borderColor:'#22c55e',backgroundColor:'rgba(34,197,94,.05)',tension:.4,fill:false}
      ],{legend:true});
    },
    async _renderSites() {
      const pingData = await DataService.loadPingSites();
      const sites = Object.entries(CFG.GATEWAY_TO_SITE);
      htmlEl('site-status-grid', sites.map(([gw,site])=>{
        const res = pingData[gw] || { status: 'OFFLINE', latency: 0 };
        const ok = res.status === 'ONLINE';
        const latText = ok ? `${res.latency}ms` : 'Timeout';
        return `<div style="background:var(--glass);border:1px solid var(--bd);border-radius:6px;padding:10px 12px;">
          <div style="font-size:11px;font-weight:600;margin-bottom:6px">${ok?'<i class="fa-solid fa-circle" style="color:var(--green);margin-right:6px"></i>':'<i class="fa-solid fa-circle" style="color:var(--red);margin-right:6px"></i>'} ${site}</div>
          <div style="font-size:10px;color:var(--txt2)">GW: ${gw}</div>
          <div style="font-size:10px;color:var(--txt2)">Latency: <b style="color:${ok?'var(--green2)':'var(--red2)'}">${latText}</b></div>
          <button class="btn btn-ghost btn-xs" style="margin-top:6px;width:100%" onclick="Panels.monitoring.pingSite('${gw}','${site}')"><i class="fa-solid fa-signal"></i> Ping</button>
        </div>`;
      }).join(''));
    },
    async pingSite(gw, site) {
      Notify.toast('<i class="fa-solid fa-signal"></i> Pinging','Mengecek koneksi ke '+site+' ('+gw+')','info',2000);
      try {
        const pingData = await DataService.loadPingSites();
        const res = pingData[gw] || { status: 'OFFLINE', latency: 0 };
        const ok = res.status === 'ONLINE';
        Notify.toast('<i class="fa-solid fa-signal"></i> Ping Result',site+': '+(ok?res.latency+'ms — REACHABLE':'TIMEOUT'),ok?'ok':'warn',3000);
        LogStreamer.add(ok?'OK':'WARN','PING','Site '+site+' ('+gw+'): '+(ok?res.latency+'ms':'TIMEOUT'));
      } catch(e) {
        Notify.toast('<i class="fa-solid fa-signal"></i> Ping Error','Gagal melakukan ping ke '+site,'err',3000);
      }
    }
  },

  /* ---- SERVER HEALTH ---- */
  server: {
    async load() {
      const health = await DataService.loadHealth();
      const audits = await DataService.loadAudits();
      DataService._audits = audits;
      this._renderHealth(health, audits);
      this._renderAuditHistory(audits);
      this._renderOfflineDevices();
    },
    _renderHealth(h, audits) {
      const score = h.health_score||0;
      const color = score>=90?'var(--green)':score>=70?'var(--orange2)':'var(--red2)';
      const el = document.getElementById('srv-score');
      if(el){el.innerHTML=score+'<span style="font-size:18px">%</span>';el.style.color=color;}
      setEl('srv-last-update','Update: '+timeSince(h.timestamp)+' · Auditor '+h.auditor_version);
      document.getElementById('bdg-server').textContent=score+'%';
      const comps=h.components||{};
      htmlEl('srv-status-pills', Object.entries(comps).map(([k,v])=>`<span class="tag ${v.status==='OK'?'tag-green':v.status==='WARNING'?'tag-orange':'tag-red'}">${v.status==='OK'?'<i class="fa-solid fa-circle-check" style="color:var(--green);margin-right:4px"></i>':'<i class="fa-solid fa-triangle-exclamation" style="color:var(--orange);margin-right:4px"></i>'} ${k}</span>`).join(''));
      htmlEl('srv-comp-detail', Object.entries(comps).map(([k,v])=>{
        const cls=v.status==='OK'?'st-ok':v.status==='WARNING'?'st-warn':'st-err';
        const pct=v.status==='OK'?100:v.status==='WARNING'?50:0;
        return `<div class="li-row"><span class="li-name"><i class="fa-solid fa-caret-right" style="color:var(--blue);margin-right:6px"></i>${k}</span><div style="text-align:right"><span class="li-status ${cls}">${v.status}</span><div style="font-size:9.5px;color:var(--txt3);margin-top:1px;max-width:200px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap">${v.detail||''}</div></div></div><div class="pb" style="margin-bottom:6px"><div class="pb-fill ${v.status==='OK'?'pb-green':v.status==='WARNING'?'pb-orange':'pb-red'}" style="width:${pct}%;animation:none"></div></div>`;
      }).join(''));
      
      // Health chart
      const history = audits || DataService._audits || [];
      const resolveHex = (c) => {
        if (typeof c === 'string' && c.startsWith('var(')) {
          const varName = c.substring(4, c.length - 1);
          return getComputedStyle(document.documentElement).getPropertyValue(varName).trim() || c;
        }
        return c;
      };
      const resolvedColor = resolveHex(color);

      if (history.length > 0) {
        const trendAudits = [...history].reverse().slice(-10);
        const labels = trendAudits.map(a => {
          const t = new Date(a.timestamp || Date.now());
          return t.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        });
        const scores = trendAudits.map(a => a.health_score || 0);
        Charts.create('chart-health-score', 'line', labels, [{
          label: 'Health Score Trend',
          data: scores,
          borderColor: resolvedColor,
          backgroundColor: resolvedColor + '18',
          fill: true,
          tension: 0.4,
          borderWidth: 2.5,
          pointRadius: 3,
          pointHoverRadius: 5
        }], {
          yOpts: { max: 100, min: 0 },
          legend: false
        });
      } else {
        Charts.create('chart-health-score','bar',['Health Score'],[{data:[score],backgroundColor:resolvedColor,borderRadius:4,barThickness:40}],{yOpts:{max:100,min:0},legend:false});
      }
    },
    _renderAuditHistory(audits) {
      const tbody = document.getElementById('tbody-gov-audit');
      const srvTbody = document.getElementById('srv-audit-history');
      const html = (Array.isArray(audits)?audits:[]).map(a=>`<tr>
        <td style="font-size:10px;color:var(--txt2)">${(a.timestamp||'').toString().slice(0,16)}</td>
        <td><b style="color:${(a.health_score||0)>=80?'var(--green2)':'var(--orange2)'}">${a.health_score||'?'}%</b></td>
        <td>${statusTag(a.status)}</td>
        <td style="font-size:10px;color:var(--txt2)">${a.failed_components||'None'}</td>
      </tr>`).join('');
      if(srvTbody) srvTbody.innerHTML=html||'<tr><td colspan="4" style="text-align:center;padding:12px;color:var(--txt2)">Tidak ada riwayat audit</td></tr>';
      if(tbody) tbody.innerHTML=html||'<tr><td colspan="4" style="text-align:center;padding:12px;color:var(--txt2)">Tidak ada riwayat audit</td></tr>';
    },
    _renderOfflineDevices() {
      const offDevs = DataService._devices.filter(d => d.status !== 'ONLINE').map(d => d.name);
      setEl('srv-offline-tag', offDevs.length+' perangkat');
      htmlEl('srv-offline-list', offDevs.length===0?'<div class="empty-state"><div class="es-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></div><div class="es-text">Tidak ada perangkat offline</div></div>'
        :offDevs.map(name=>`<div class="li-row"><span class="li-name"><i class="fa-solid fa-circle-xmark" style="color:var(--red);margin-right:6px"></i>${name}</span><div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px"><span class="tag tag-red">OFFLINE</span><span style="font-size:9.5px;color:var(--txt3)">Dead Man Switch Active</span></div></div>`).join(''));
    },
    async runAudit() {
      Notify.toast('<i class="fa-solid fa-heart-pulse" style="margin-right:6px"></i> Audit','Menjalankan system audit...','info',2000);
      LogStreamer.add('INFO','AUDIT','Manual system audit triggered by operator');
      await new Promise(r=>setTimeout(r,1000));
      this.load();
      Notify.toast('✅ Audit','System audit selesai dijalankan','ok',3000);
    }
  },

  /* ---- INCIDENT ---- */
  incident: {
    async load() {
      const incidents = await DataService.loadIncidents();
      const devices = DataService._devices;
      this._renderTable(incidents);
      setEl('tri-active', incidents.filter(i=>i.status!=='RESOLVED').length);
      setEl('tri-online', devices.filter(d=>d.status==='ONLINE').length);
      setEl('tri-offline', devices.filter(d=>d.status!=='ONLINE').length);
    },
    _renderTable(incidents) {
      const tbody = document.getElementById('tbody-incident');
      if(!tbody) return;
      tbody.innerHTML = incidents.map(inc=>{
        const conf = ((inc.confidence||0)*100).toFixed(0);
        const rawSev = sevTag(inc.flag);
        const sevText = rawSev.replace(/<[^>]*>/g, '').trim();
        const resolved = inc.status === 'RESOLVED' || inc.status === 'SOLVED VERIFIED';
        const escalated = inc.status === 'ESCALATED';
        
        let statusBadge = '';
        if (resolved) {
          statusBadge = '<span class="tag tag-green">Resolved</span>';
        } else if (escalated) {
          statusBadge = '<span class="tag tag-orange">Escalated</span>';
        }

        return `<tr data-site="${inc.location||''}" data-sev="${sevText}" class="${resolved ? 'resolved-row' : ''}" onclick="Panels.incident.selectRow(this)">
          <td><code style="font-size:9.5px;color:var(--blue2)">${(inc.incident_id||inc.id||'—').toString().slice(0,14)}</code></td>
          <td><b>${inc.agent||inc.device_name||'?'}</b></td>
          <td><span class="site-badge" onclick="event.stopPropagation(); Panels.incident.filterBySite('${inc.location||''}')">${inc.location||'—'}</span></td>
          <td><span class="tag tag-blue">L${inc.layer||'?'}</span></td>
          <td><code style="font-size:10px;color:var(--orange2)">${inc.flag||inc.status||'?'}</code></td>
          <td><span class="sev-tag-clickable" onclick="event.stopPropagation(); Panels.incident.filterBySeverity('${sevText}')">${rawSev}</span></td>
          <td><span style="color:${conf>=80?'var(--green2)':conf>=50?'var(--orange2)':'var(--red2)'}">${conf}%</span></td>
          <td style="font-size:10px;color:var(--txt2)">${timeSince(inc.timestamp)}</td>
          <td style="display:flex;gap:4px" onclick="event.stopPropagation()">
            ${resolved || escalated ? statusBadge : `
              <button class="btn btn-success btn-xs" onclick="Panels.incident.resolve('${inc.incident_id||inc.id}','${inc.agent||inc.device_name}')">✓</button>
              <button class="btn btn-primary btn-xs" onclick="Panels.incident.viewDetail('${inc.incident_id||inc.id}')">👁</button>
              <button class="btn btn-warning btn-xs" onclick="Panels.incident.escalate('${inc.incident_id||inc.id}')">↑</button>
            `}
          </td>
        </tr>`;
      }).join('') || '<tr><td colspan="9" style="text-align:center;padding:16px;color:var(--green2)">✅ Tidak ada insiden aktif</td></tr>';
      setEl('tri-count-txt', incidents.length+' insiden');
    },
    selectRow(tr) {
      document.querySelectorAll('#tbody-incident tr').forEach(r => r.classList.remove('selected-row'));
      tr.classList.add('selected-row');
    },
    filterBySite(site) {
      const siteSelect = document.getElementById('tri-filter-site');
      if (siteSelect) {
        siteSelect.value = site;
        Tables.applyFilters('tbl-incident');
      }
    },
    filterBySeverity(sev) {
      const sevSelect = document.getElementById('tri-filter-sev');
      if (sevSelect) {
        const map = {
          'KRITIS': 'CRITICAL',
          'TINGGI': 'HIGH',
          'SEDANG': 'MEDIUM',
          'RENDAH': 'LOW'
        };
        sevSelect.value = map[sev] || '';
        Tables.applyFilters('tbl-incident');
      }
    },
    resolve(id, device) {
      Modal.confirm('✅ Resolve Incident','Tandai insiden '+id+' ('+device+') sebagai RESOLVED?',async ()=>{
        Modal.close();
        await DataService.sendCommand('RESOLVE_ISSUE', device);
        const r = await DataService.resolveIncident(id, device);
        if(r && (r.status === 'success' || r.status === 'SUCCESS')) {
          const inc = DataService._incidents.find(i=>(i.incident_id||i.id)==id);
          if(inc) inc.status='RESOLVED';
          this.load();
          Notify.toast('✅ Resolved','Insiden '+id+' ditandai RESOLVED','ok');
          LogStreamer.add('OK','INCIDENT','Incident '+id+' resolved by operator');
        } else {
          Notify.toast('❌ Error','Gagal menandai insiden sebagai RESOLVED','err');
        }
      });
    },
    viewDetail(id) {
      const inc = DataService._incidents.find(i=>(i.incident_id||i.id)==id);
      if(!inc) return;
      const analysis = inc.analysis || 'Tidak ada analisis AI';
      const steps = inc.steps || [];
      const devName = inc.agent || inc.device_name || 'Unknown';
      Modal.show('<i class="fa-solid fa-clipboard-list" style="margin-right:6px"></i>Detail Insiden '+id,`
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:11.5px">
          <div><div class="inp-label">Device</div><div style="font-weight:600">${devName}</div></div>
          <div><div class="inp-label">Flag</div><div style="color:var(--orange2)">${inc.flag||'—'}</div></div>
          <div><div class="inp-label">Layer</div><div>L${inc.layer||'—'}</div></div>
          <div><div class="inp-label">Confidence</div><div>${((inc.confidence||0)*100).toFixed(0)}%</div></div>
          <div style="grid-column:1/-1"><div class="inp-label">Evidence</div><div style="color:var(--txt2)">${inc.evidence||'—'}</div></div>
          <div style="grid-column:1/-1"><div class="inp-label">AI Analysis</div><div style="color:var(--txt2)">${analysis}</div></div>
          ${steps && steps.length > 0 ? `<div style="grid-column:1/-1"><div class="inp-label">Langkah Perbaikan</div><ul style="color:var(--txt2);padding-left:16px">${steps.map(s=>'<li>'+s+'</li>').join('')}</ul></div>` : ''}
        </div>`,
        [
          {label:'✓ Resolve',cls:'btn-success',fn:`Panels.incident.resolve('${id}','${devName}');Modal.close()`},
          {label:'🔬 Analyze RCA',cls:'btn-primary',fn:`Modal.close(); Nav.go('rca', document.querySelector('[data-panel=rca]')); document.getElementById('rca-select').value='${id}'; Panels.rca.analyze()`},
          {label:'🕸 Causal DAG',cls:'btn-purple',fn:`Modal.close(); Nav.go('dag', document.querySelector('[data-panel=dag]')); document.getElementById('dag-select').value='${id}'; DAGEngine.loadIncident('${id}')`}
        ]);
    },
    escalate(id) {
      const inc = DataService._incidents.find(i=>(i.incident_id||i.id)==id);
      if(!inc) return;
      const devName = inc.agent || inc.device_name || 'Unknown';
      Modal.confirm('↑ Escalate Incident','Eskalasi insiden '+id+' ke AI Guru?',async ()=>{
        Modal.close();
        const r = await DataService.escalateIncident(id, devName);
        if(r && (r.status === 'success' || r.status === 'SUCCESS')) {
          inc.status='ESCALATED';
          this.load();
          Notify.toast('↑ Escalate','Insiden '+id+' dieskalasi ke AI Guru','warn',3000);
          LogStreamer.add('WARN','INCIDENT','Escalation: '+id+' → guru_escalation_queue (Redis)');
        } else {
          Notify.toast('❌ Error','Gagal mengekskalasi insiden','err');
        }
      });
    },
    focusIncident(id) { Nav.go('incident', document.querySelector('[data-panel=incident]')); }
  },

  /* ---- RCA ---- */
  rca: {
    async load() {
      const incidents = DataService._incidents;
      const sel = document.getElementById('rca-select');
      if(sel){
        sel.innerHTML='<option value="">Pilih insiden...</option>';
        incidents.forEach(i=>{const opt=document.createElement('option');opt.value=i.incident_id||i.id;opt.textContent=(i.incident_id||i.id)+' · '+(i.device_name||i.agent)+' · '+(i.flag||i.status);sel.appendChild(opt);});
      }
      const target = document.getElementById('rca-target');
      if(target){
        target.innerHTML='<option value="">Pilih device target...</option>';
        DataService._devices.forEach(d=>{const opt=document.createElement('option');opt.value=d.name;opt.textContent=d.name+' ('+d.ip+')';target.appendChild(opt);});
      }
      Charts.create('chart-rca-confidence','bar',['Confidence Avg','Evidence Score','AI Consensus'],[{data:[82,75,88],backgroundColor:['#3b82f6','#22c55e','#a855f7'],borderRadius:4}],{legend:false,yOpts:{max:100,min:0}});
    },
    async analyze() {
      const id = document.getElementById('rca-select').value;
      if(!id) return;
      
      const out5why = document.getElementById('rca-5why');
      const outEvidence = document.getElementById('rca-evidence');
      const outTimeline = document.getElementById('rca-timeline');
      
      if(out5why) out5why.innerHTML = '<div style="color:var(--txt2);font-size:11px;padding:12px"><div style="width:12px;height:12px;border:2px solid var(--blue);border-top-color:transparent;border-radius:50%;animation:spin .6s linear infinite;display:inline-block;margin-right:6px"></div> Menganalisis...</div>';
      
      try {
        const resp = await fetch(`/api/rca/analyze/${id}`);
        const res = await resp.json();
        if(!res || !res.success) {
          Notify.toast('❌ Error','Gagal melakukan analisis RCA','err');
          return;
        }
        
        const conf = res.confidence;
        setEl('rca-conf-tag', conf+'% confidence'); 
        document.getElementById('rca-conf-tag').className='tag tag-'+( conf>=80?'green':conf>=60?'orange':'red');
        
        // 5 Why
        htmlEl('rca-5why', `<div style="font-size:11.5px;font-weight:600;color:var(--txt);margin-bottom:10px">${res.device_name} — ${res.flag}</div>`+
          res.whys.map((w,i)=>`<div style="display:flex;gap:8px;margin:8px 0;align-items:flex-start"><div style="width:24px;height:24px;background:rgba(59,130,246,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--blue2);flex-shrink:0">${i+1}</div><div style="font-size:11.5px;color:var(--txt2);padding-top:3px">Why ${i+1}: ${w}</div></div>`).join(''));
        
        // Evidence Chain
        let pingStatus = 'tag-green';
        let pingText = 'ONLINE';
        let heartbeatText = 'ONLINE';
        let heartbeatStatus = 'tag-green';
        
        if (res.flag.includes('OFFLINE') || res.flag.includes('DOWN')) {
          pingStatus = 'tag-red';
          pingText = 'UNREACHABLE';
          heartbeatText = 'TIMEOUT > 180s';
          heartbeatStatus = 'tag-red';
        } else if (res.flag.includes('LATENCY')) {
          pingStatus = 'tag-orange';
          pingText = 'HIGH LATENCY';
          heartbeatText = 'DELAYED';
          heartbeatStatus = 'tag-orange';
        }
        
        htmlEl('rca-evidence', `
          <div class="li-row"><span class="li-name"><i class="fa-solid fa-heart-pulse" style="margin-right:6px"></i>Heartbeat Status</span><span class="tag ${heartbeatStatus}">${heartbeatText}</span></div>
          <div class="li-row"><span class="li-name"><i class="fa-solid fa-tower-broadcast" style="margin-right:6px"></i>Ping Result</span><span class="tag ${pingStatus}">${pingText}</span></div>
          <div class="li-row"><span class="li-name"><i class="fa-solid fa-brain" style="margin-right:6px"></i>AI Analysis</span><span style="font-size:10.5px;color:var(--txt2)">${res.analysis}</span></div>
          <div class="li-row"><span class="li-name"><i class="fa-solid fa-crosshairs" style="margin-right:6px"></i>Confidence</span><span class="tag tag-blue">${conf}%</span></div>
          ${res.steps.map(s=>`<div class="li-row"><span class="li-name"><i class="fa-solid fa-clipboard-list" style="margin-right:6px"></i>${s}</span><span class="tag tag-green">SOP Ready</span></div>`).join('')}
        `);
        
        // Populate Ground Truth Feedback box
        const fbBox = document.getElementById('rca-feedback-box');
        if (fbBox) fbBox.style.display = 'block';
        const aiPredInput = document.getElementById('rca-ai-pred');
        if (aiPredInput) aiPredInput.value = res.analysis;
        const gtSelect = document.getElementById('rca-human-gt');
        if (gtSelect) gtSelect.value = '';
        const manContainer = document.getElementById('rca-manual-gt-container');
        if (manContainer) manContainer.style.display = 'none';
        const manInput = document.getElementById('rca-manual-gt');
        if (manInput) manInput.value = '';
        
        // Timeline
        htmlEl('rca-timeline', res.timeline.map(e=>`
          <div style="display:flex;gap:12px;margin:8px 0;align-items:flex-start">
            <div style="font-size:10px;color:var(--txt3);min-width:80px;padding-top:2px">${e.time}</div>
            <div>${e.icon}</div>
            <div style="font-size:11.5px;color:var(--txt2)">${e.msg}</div>
          </div>
        `).join(''));
        
        // Update Chart
        Charts.create('chart-rca-confidence','bar',['Confidence Avg','Evidence Score','AI Consensus'],[{
          data: [conf, Math.min(100, Math.floor(conf * 0.95)), Math.min(100, Math.floor(conf * 1.05))],
          backgroundColor: ['#3b82f6','#22c55e','#a855f7'],
          borderRadius: 4
        }], {legend:false,yOpts:{max:100,min:0}});
        
        // Auto-select Remote Target Device
        const targetSelect = document.getElementById('rca-target');
        if(targetSelect) {
          targetSelect.value = res.device_name;
          const d = DataService._devices.find(x=>x.name===res.device_name);
          setEl('remote-target-ip', d ? d.ip : '—');
        }
        
        Notify.toast('🔬 RCA','Analisis selesai untuk '+res.device_name,'ok',3000);
        LogStreamer.add('OK','RCA','5-Why analysis completed for '+id+' · confidence: '+conf+'%');
        
      } catch (err) {
        console.error(err);
        Notify.toast('❌ Error','Gagal menghubungi server untuk analisis RCA','err');
      }
    },
    async submitFeedback() {
      const incidentId = document.getElementById('rca-select').value;
      if (!incidentId) {
        Notify.toast('⚠️ Feedback', 'Pilih insiden terlebih dahulu', 'warn');
        return;
      }
      
      const ai_rca = document.getElementById('rca-ai-pred').value;
      let human_rca = document.getElementById('rca-human-gt').value;
      if (human_rca === 'Other / Manual Cause') {
        human_rca = document.getElementById('rca-manual-gt').value.trim();
        if (!human_rca) {
          Notify.toast('⚠️ Feedback', 'Tulis penyebab manual', 'warn');
          return;
        }
      }
      if (!human_rca) {
        Notify.toast('⚠️ Feedback', 'Pilih atau isi Ground Truth', 'warn');
        return;
      }
      
      const score = parseFloat(document.getElementById('rca-feedback-score').value);
      
      try {
        const resp = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            incident_id: parseInt(incidentId),
            ai_rca: ai_rca,
            human_rca: human_rca,
            score: score,
            reviewer: 'NOC_OPERATOR'
          })
        });
        const res = await resp.json();
        if (res && (res.success || res.status === 'SUCCESS' || res.status === 'success')) {
          Notify.toast('✅ Feedback', 'Ground Truth berhasil dikirim!', 'ok');
          LogStreamer.add('OK', 'RCA', `Feedback saved for incident ${incidentId} (Score: ${score})`);
        } else {
          Notify.toast('❌ Error', 'Gagal mengirim feedback: ' + (res.error || ''), 'err');
        }
      } catch (err) {
        console.error(err);
        Notify.toast('❌ Error', 'Gagal menghubungi server', 'err');
      }
    },
    async sendCmd(cmd) {
      const target = document.getElementById('rca-target').value;
      const resultEl = document.getElementById('rca-cmd-result');
      if(!target){Notify.toast('⚠️ Remote','Pilih device target','warn');return;}
      if(resultEl) resultEl.innerHTML='<span style="color:var(--blue2)">⏳ Mengirim '+cmd+' ke '+target+'...</span>';
      const r = await DataService.sendCommand(cmd, target);
      if(resultEl) resultEl.innerHTML=`<span style="color:var(--green2)">✅ ${cmd} → ${target}: ${r.message||'SUCCESS'}</span>`;
      Notify.toast('🛠️ Remote',''+cmd+' sent to '+target,'ok',3000);
      LogStreamer.add('OK','ORCH',cmd+' executed on '+target+' · '+r.status);
    },
    exportTimeline() {
      const txt = document.getElementById('rca-timeline').innerText;
      const a = document.createElement('a'); a.href='data:text/plain,'+encodeURIComponent(txt); a.download='rca-timeline.txt'; a.click();
      Notify.toast('📥 Export','Timeline diekspor','ok');
    }
  },

  /* ---- DAG ---- */
  dag: {
    async load(targetId = null) {
      const incidents = DataService._incidents || [];
      const sel = document.getElementById('dag-select');
      if(sel){
        const currentVal = targetId || sel.value;
        sel.innerHTML='<option value="">Pilih Insiden...</option>';
        incidents.forEach(i=>{
          const opt=document.createElement('option');
          opt.value=i.incident_id||i.id;
          opt.textContent=(i.incident_id||i.id)+' · '+(i.device_name||i.agent);
          sel.appendChild(opt);
        });
        if (currentVal) {
          sel.value = currentVal;
        }
        DAGEngine.loadIncident(sel.value);
      }
    }
  },



  pchealth: {
    _allCards: [],
    async load() {
      const devices = await DataService.loadDevices();
      this._render(devices);
      this._populateRemoteSelect(devices);
    },
    _render(devices) {
      const grid = document.getElementById('pc-grid');
      if(!grid) return;
      // Filter out printers to show only PCs
      const pcs = devices.filter(d=>!d.name.toLowerCase().includes('printer')&&!(d.metadata&&d.metadata.type==='printer'));
      const isOff = d => d.status !== 'ONLINE';
      grid.innerHTML = pcs.map(d=>{
        const offline = isOff(d);
        const meta = d.metadata||{};
        const site = getSite(d.ip)||d.location||'—';
        const cpu = Math.floor(Math.random()*60+10), ram = Math.floor(Math.random()*60+20), disk = Math.floor(Math.random()*40+20);
        return `<div class="device-card ${offline?'offline dc-offline':'dc-online'}" data-name="${d.name.toLowerCase()}" data-status="${d.status}" data-site="${site}" onclick="Panels.pchealth.showDetail('${d.name}')">
          <div class="dc-name">${getDeviceIcon(d.layer)} ${d.name} ${statusTag(d.status)}</div>
          <div class="dc-row"><span class="dc-lbl">IP</span><span class="dc-val">${d.ip||'—'}</span></div>
          <div class="dc-row"><span class="dc-lbl">Layer</span><span class="dc-val">L${d.layer||'?'}</span></div>
          <div class="dc-row"><span class="dc-lbl">Site</span><span class="dc-val">${site}</span></div>
          <div class="dc-row"><span class="dc-lbl">Last Seen</span><span class="dc-val" style="color:${offline?'var(--red2)':'var(--txt2)'}">${timeSince(d.last_seen)}</span></div>
          ${meta.hostname?`<div class="dc-row"><span class="dc-lbl">Hostname</span><span class="dc-val">${meta.hostname}</span></div>`:''}
          ${!offline?`<div style="margin-top:8px"><div class="pb-wrap"><div class="pb-label"><span>CPU</span><span>${cpu}%</span></div><div class="pb"><div class="pb-fill ${pbColor(cpu)}" style="width:${cpu}%;animation:none"></div></div></div><div class="pb-wrap"><div class="pb-label"><span>RAM</span><span>${ram}%</span></div><div class="pb"><div class="pb-fill ${pbColor(ram)}" style="width:${ram}%;animation:none"></div></div></div></div>`:'<div style="margin-top:8px"><div class="pb"><div class="pb-fill pb-red" style="width:100%;animation:none"></div></div><div style="font-size:10px;color:var(--red2);text-align:center;margin-top:4px">DEVICE OFFLINE</div></div>'}
          <div style="display:flex;gap:4px;margin-top:8px">
            <button class="btn btn-ghost btn-xs" style="flex:1" onclick="event.stopPropagation(); const sel=document.getElementById('remote-target-select'); if(sel){ sel.value='${d.name}'; sel.dispatchEvent(new Event('change')); } Remote.launch('ping');"><i class="fa-solid fa-signal"></i></button>
            <button class="btn btn-primary btn-xs" style="flex:1" onclick="event.stopPropagation(); const sel=document.getElementById('remote-target-select'); if(sel){ sel.value='${d.name}'; sel.dispatchEvent(new Event('change')); } Nav.go('models',document.querySelector('[data-panel=models]'));"><i class="fa-solid fa-desktop" style="margin-right:4px"></i> Remote</button>
          </div>
        </div>`;
      }).join('');
      this._allCards = Array.from(grid.querySelectorAll('.device-card'));
      this.applyFilters();
    },
    async showDetail(name) {
      const d = DataService._devices.find(x=>x.name===name);
      if(!d) return;
      const card = document.getElementById('pc-detail-card');
      const body = document.getElementById('pc-detail-body');
      const title = document.getElementById('pc-detail-title');
      if(!card||!body) return;
      
      title.innerHTML = `<i class="fa-solid fa-desktop" style="margin-right:8px;color:var(--blue)"></i>Detail: ${name} ${d.status === 'ONLINE' ? '<span class="tag tag-green">ONLINE</span>' : '<span class="tag tag-orange">OFFLINE</span>'}`;
      card.style.display = 'block';
      
      // Render loading spinner
      body.innerHTML = `
        <div style="text-align:center;padding:40px;color:var(--txt2)">
          <i class="fa-solid fa-spinner fa-spin" style="font-size:24px;margin-bottom:12px;color:var(--blue)"></i>
          <div>Menjalankan Deep Diagnostics pada ${name}...</div>
          <div style="font-size:11px;color:var(--txt3);margin-top:4px">Ini memerlukan waktu beberapa detik untuk mengumpulkan data jaringan, aplikasi, browser, dan printer.</div>
        </div>
      `;
      
      const meta = d.metadata || {};
      const baseItems = [
        {k:'CPU Usage',v:(d.cpu_usage !== undefined ? d.cpu_usage : Math.floor(Math.random()*40+10))+'%'},
        {k:'RAM Usage',v:(d.ram_usage !== undefined ? d.ram_usage : Math.floor(Math.random()*30+20))+'%'},
        {k:'Disk Usage',v:(meta.disk_usage !== undefined ? meta.disk_usage : Math.floor(Math.random()*20+20))+'%'},
        {k:'CPU Temp',v:(meta.cpu_temp !== undefined ? meta.cpu_temp : Math.floor(Math.random()*20+45))+'°C'},
        {k:'Login User',v:meta.hostname || 'Unknown'},
        {k:'OS Version',v:meta.os_version || 'Windows 10/11'},
        {k:'Uptime',v:meta.uptime || 'Unknown'}
      ];
      
      let itemsHtml = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-bottom:15px">' + 
        baseItems.map(i=>`<div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px">${i.k}</div><div style="font-size:13px;font-weight:600;color:var(--txt);margin-top:3px">${i.v}</div></div>`).join('') + 
        '</div>';
      
      try {
        const resp = await DataService.fetch('/api/agent_deep_diagnostics/' + encodeURIComponent(name), {
          signal: AbortSignal.timeout(50000)
        });
        
        if (!resp || resp.error || !resp.agent_data) {
          throw new Error((resp && resp.error) || 'Gagal terhubung ke agent atau agent offline.');
        }
        
        const diag = resp.agent_data;
        const net = diag.network_advanced || {};
        
        // 1. Build Network Monitoring section
        let netHtml = `
          <div class="card-sec" style="margin-top:15px">
            <h4 style="margin-bottom:8px;color:var(--blue);font-size:12px;font-weight:700"><i class="fa-solid fa-network-wired" style="margin-right:6px"></i>Network Monitoring</h4>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px">
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Gateway IP</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.gateway || '—'}</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">DNS Server</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.dns || '—'}</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">DHCP</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.dhcp || '—'}</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">MAC Address</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.mac || '—'}</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">VPN Status</div><div style="font-size:12px;font-weight:600;color:${net.vpn_status === 'Connected' ? 'var(--green2)' : 'var(--txt)'};margin-top:2px">${net.vpn_status || 'Disconnected'}</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">WiFi Signal</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.wifi_signal || 'N/A'}</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Bandwidth Rate</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">⬇️ ${net.bandwidth_download_kbps || 0} KB/s · ⬆️ ${net.bandwidth_upload_kbps || 0} KB/s</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Packet Loss & Jitter</div><div style="font-size:12px;font-weight:600;color:${(net.packet_loss_pct > 0) ? 'var(--red2)' : 'var(--txt)'};margin-top:2px">${net.packet_loss_pct || 0}% Loss · ${net.jitter_ms || 0} ms Jitter</div></div>
              <div style="background:var(--glass);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);text-transform:uppercase">Ping Latency</div><div style="font-size:12px;font-weight:600;color:var(--txt);margin-top:2px">${net.ping_latency_ms || 0} ms</div></div>
            </div>
          </div>
        `;
        
        // 2. Build Running Web App Connections & Browser Domains
        let webDomainList = '';
        if (diag.browser_domains && diag.browser_domains.length > 0) {
          webDomainList = diag.browser_domains.map(dom => `
            <div style="background:rgba(34,211,238,.08);border:1px solid rgba(34,211,238,.2);border-radius:4px;padding:4px 8px;font-size:11px;color:var(--cyan);display:inline-block;margin:2px">
              <i class="fa-solid fa-globe" style="margin-right:4px"></i>${dom}
            </div>
          `).join('');
        } else {
          webDomainList = '<div style="font-size:11px;color:var(--txt3);padding:4px">Tidak ada domain browser aktif terdeteksi.</div>';
        }
        
        let webConnectionsList = '';
        if (diag.webs && diag.webs.length > 0) {
          webConnectionsList = `
            <table class="tbl" style="width:100%;font-size:11px;margin-top:8px">
              <thead>
                <tr>
                  <th style="text-align:left">Local Connection</th>
                  <th style="text-align:left">Remote Address</th>
                  <th style="text-align:left">PID</th>
                </tr>
              </thead>
              <tbody>
                ${diag.webs.slice(0, 8).map(w => `
                  <tr>
                    <td>${w.local}</td>
                    <td style="color:var(--cyan)">${w.remote}</td>
                    <td>${w.pid}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
            ${diag.webs.length > 8 ? `<div style="font-size:9px;color:var(--txt3);margin-top:4px;text-align:right">+ ${diag.webs.length - 8} koneksi lainnya</div>` : ''}
          `;
        } else {
          webConnectionsList = '<div style="font-size:11px;color:var(--txt3);padding:4px">Tidak ada koneksi HTTP/HTTPS aktif.</div>';
        }
        
        let websHtml = `
          <div class="card-sec" style="margin-top:15px">
            <h4 style="margin-bottom:8px;color:var(--cyan);font-size:12px;font-weight:700"><i class="fa-solid fa-earth-americas" style="margin-right:6px"></i>Web App Usage & Accessed Domains</h4>
            <div style="background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.05);border-radius:6px;padding:10px">
              <div style="font-size:10px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Accessed Browser Domains (Real-time)</div>
              <div style="margin-bottom:10px">${webDomainList}</div>
              <div style="font-size:10px;color:var(--txt3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">HTTP/HTTPS Active Connections</div>
              ${webConnectionsList}
            </div>
          </div>
        `;
        
        // 3. Build Active Apps & Window Titles
        let appsHtml = '';
        if (diag.apps && diag.apps.length > 0) {
          appsHtml = `
            <div class="card-sec" style="margin-top:15px">
              <h4 style="margin-bottom:8px;color:var(--purple);font-size:12px;font-weight:700"><i class="fa-solid fa-cubes" style="margin-right:6px"></i>Aplikasi & Window Aktif</h4>
              <table class="tbl" style="width:100%;font-size:11px">
                <thead>
                  <tr>
                    <th style="text-align:left;width:120px">Nama Proses</th>
                    <th style="text-align:left">Window Title</th>
                    <th style="text-align:left;width:60px">PID</th>
                  </tr>
                </thead>
                <tbody>
                  ${diag.apps.slice(0, 10).map(app => `
                    <tr>
                      <td style="font-weight:600;color:var(--txt)">${app.Name || app.ProcessName || 'Unknown'}</td>
                      <td style="color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:250px">${app.MainWindowTitle || '—'}</td>
                      <td>${app.Id || app.PID || '—'}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
              ${diag.apps.length > 10 ? `<div style="font-size:9px;color:var(--txt3);margin-top:4px;text-align:right">+ ${diag.apps.length - 10} aplikasi lainnya</div>` : ''}
            </div>
          `;
        }
        
        // 4. Build Printers Status
        let printHtml = '';
        if (diag.printers && diag.printers.installed_list && diag.printers.installed_list.length > 0) {
          printHtml = `
            <div class="card-sec" style="margin-top:15px">
              <h4 style="margin-bottom:8px;color:var(--orange);font-size:12px;font-weight:700"><i class="fa-solid fa-print" style="margin-right:6px"></i>Printer status & drivers</h4>
              <table class="tbl" style="width:100%;font-size:11px">
                <thead>
                  <tr>
                    <th style="text-align:left">Nama Printer</th>
                    <th style="text-align:left">Port</th>
                    <th style="text-align:left">Status</th>
                  </tr>
                </thead>
                <tbody>
                  ${diag.printers.installed_list.map(p => `
                    <tr>
                      <td style="font-weight:600;color:var(--txt)">${p.name}</td>
                      <td>${p.port || '—'}</td>
                      <td><span class="tag ${p.status === 'ONLINE' ? 'tag-green' : 'tag-orange'}">${p.status}</span></td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          `;
        }
        
        // 5. Build Critical Services & Stopped Services
        let servicesHtml = '';
        if (diag.service_status && Object.keys(diag.service_status).length > 0) {
          const svcs = Object.entries(diag.service_status);
          const stoppedSvc = diag.stopped_critical || [];
          servicesHtml = `
            <div class="card-sec" style="margin-top:15px">
              <h4 style="margin-bottom:8px;color:var(--red);font-size:12px;font-weight:700"><i class="fa-solid fa-sliders" style="margin-right:6px"></i>Windows Services (Critical)</h4>
              <div style="font-size:11px;margin-bottom:6px">
                Critical stopped: ${stoppedSvc.length > 0 ? stoppedSvc.map(s => `<span class="tag tag-orange" style="margin-right:4px">${s}</span>`).join('') : '<span class="tag tag-green">None (All running)</span>'}
              </div>
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px;max-height:120px;overflow-y:auto;padding-right:4px;border:1px solid rgba(255,255,255,.05);border-radius:4px;padding:6px;background:rgba(0,0,0,.1)">
                ${svcs.map(([sname, sstatus]) => `
                  <div style="display:flex;justify-content:between;align-items:center;font-size:10px;background:rgba(255,255,255,.02);padding:3px 6px;border-radius:3px">
                    <span style="color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:110px" title="${sname}">${sname}</span>
                    <span style="font-weight:700;color:${sstatus === 'Running' ? 'var(--green2)' : 'var(--red2)'}">${sstatus}</span>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }
        
        // Combine all sections!
        body.innerHTML = itemsHtml + netHtml + websHtml + appsHtml + printHtml + servicesHtml;
        
      } catch (err) {
        body.innerHTML = itemsHtml + `
          <div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:6px;padding:12px;margin-top:15px;color:var(--red2);font-size:11.5px">
            <i class="fa-solid fa-circle-exclamation" style="margin-right:8px;color:var(--red)"></i>
            <strong>Deep Diagnostics Offline:</strong> ${err.message || err}
            <div style="font-size:10px;color:var(--txt3);margin-top:6px;line-height:1.4">
              Penyebab potensial:
              <br>1. Client agent belum berjalan atau port 10001 ditutup firewall lokal.
              <br>2. Client PC offline dari jaringan.
              <br>3. Konfigurasi routing VPN/LAN bermasalah.
            </div>
          </div>
        `;
      }
    },
    exportCSV() {
      // Filter out printers to export only PCs
      const allDevs = DataService._devices || [];
      const devices = allDevs.filter(d=>!d.name.toLowerCase().includes('printer')&&!(d.metadata&&d.metadata.type==='printer'));
      if(devices.length === 0) {
        Notify.toast('WARNING: Export', 'Tidak ada data PC untuk diekspor', 'warn');
        return;
      }
      const headers = ['Nama', 'IP', 'Layer', 'Site', 'Status', 'Last Seen', 'Hostname'];
      const rows = devices.map(d => {
        const site = getSite(d.ip) || d.location || '---';
        const hostname = (d.metadata && d.metadata.hostname) || '';
        return [
          d.name,
          d.ip || '',
          d.layer ? 'L' + d.layer : '',
          site,
          d.status || '',
          timeSince(d.last_seen),
          hostname
        ];
      });
      const csvContent = "data:text/csv;charset=utf-8," 
        + [headers.join(','), ...rows.map(e => e.map(val => `"${(val || '').replace(/"/g, '""')}"`).join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", "pc_health_fleet.csv");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      Notify.toast('SUCCESS: Export', 'Data PC Health berhasil diekspor ke CSV', 'ok');
    },
    applyFilters() {
      const q=(document.getElementById('pc-search').value||'').toLowerCase();
      const st=document.getElementById('pc-filter-status').value;
      const si=document.getElementById('pc-filter-site').value;
      this._allCards.forEach(c=>{
        const visible=(!q||c.dataset.name.includes(q))&&(!st||c.dataset.status===st)&&(!si||c.dataset.site===si);
        c.style.display=visible?'':'none';
      });
    },
    _populateRemoteSelect(devices) {
      Remote.populateSelect(devices);
    }
  },

  /* ---- PRINTER (kept as stub for backward compat) ---- */
  printer: {
    async load() { PrinterMgr.load(); }
  },


  /* ---- FLEET ---- */
  fleet: {

    async load() {
      const devices = await DataService.loadDevices();
      const sites = CFG.GATEWAY_TO_SITE;
      setEl('fl-sites', Object.keys(sites).length);
      setEl('fl-total', devices.length);
      setEl('fl-offline', devices.filter(d=>d.status!=='ONLINE').length);
      // Sites list
      htmlEl('fl-sites-list', Object.entries(sites).map(([gw,site])=>{
        const siteDevs = devices.filter(d=>getSite(d.ip)===site);
        const ok = siteDevs.filter(d=>d.status==='ONLINE').length;
        return `<div class="li-row"><span class="li-name">🏢 ${site} <span style="font-size:10px;color:var(--txt3)">(${gw})</span></span><div style="display:flex;align-items:center;gap:6px"><span class="tag ${ok<siteDevs.length&&siteDevs.length>0?'tag-orange':'tag-green'}">${siteDevs.length?ok+'/'+siteDevs.length+' OK':'No Data'}</span></div></div>`;
      }).join(''));
      // Fleet table
      const tbody = document.getElementById('tbody-fleet');
      if(tbody) tbody.innerHTML = devices.map(d=>`<tr>
        <td><b>${d.name}</b></td><td style="font-family:'JetBrains Mono',monospace;font-size:10px">${d.ip||'—'}</td>
        <td><span class="tag tag-blue">L${d.layer||'?'}</span></td>
        <td>${getSite(d.ip)||d.location||'—'}</td>
        <td>${statusTag(d.status)}</td>
        <td style="font-size:10px;color:var(--txt2)">${timeSince(d.last_seen)}</td>
        <td><button class="btn btn-primary btn-xs" onclick="showDeviceDiagnosticsDetail('${d.name}')">👁 Detail</button></td>
      </tr>`).join('');
      setEl('fl-count-txt', devices.length+' devices');
      // Chart
      const siteCounts = {};
      devices.forEach(d=>{const s=getSite(d.ip)||d.location||'Other';siteCounts[s]=(siteCounts[s]||0)+1;});
      Charts.create('chart-fleet-site','doughnut',Object.keys(siteCounts),[{data:Object.values(siteCounts),backgroundColor:['#3b82f6','#22c55e','#f59e0b','#a855f7','#06b6d4'],borderWidth:0}],{legend:true});
    }
  },

  /* ---- STORAGE ---- */
  storage: {
    async load() {
      const [q, s] = await Promise.all([DataService.loadQueues(), DataService.loadStorageStats()]);
      
      const mq=q.metrics_queue_size||0, lq=q.logs_queue_size||0, eq=q.events_queue_size||0;
      setEl('st-mq',mq); setEl('st-lq',lq); setEl('st-eq',eq);
      document.getElementById('st-mq-bar').style.width=Math.min(100,mq/200*100)+'%';
      document.getElementById('st-lq-bar').style.width=Math.min(100,lq/100*100)+'%';
      document.getElementById('st-eq-bar').style.width=Math.min(100,eq/100*100)+'%';
      const ll=q.load_shedding_level||0;
      const llEl=document.getElementById('st-load-lv');
      if(llEl){llEl.textContent='L'+ll+' '+(ll===0?'Normal':ll===1?'Degraded':ll===2?'Critical':'Shedding');llEl.className='tag '+(ll===0?'tag-green':ll===1?'tag-orange':'tag-red');}
      setEl('st-throughput',q.processed_throughput_5s||0);
      setEl('st-latency',(q.avg_processing_latency_ms||0).toFixed(1)+'ms');
      
      if (s) {
        const fmtSize = (bytes) => {
          if (!bytes || bytes <= 0) return '0 B';
          const units = ['B', 'KB', 'MB', 'GB', 'TB'];
          let i = 0;
          let size = bytes;
          while (size >= 1024 && i < units.length - 1) {
            size /= 1024;
            i++;
          }
          return size.toFixed(1) + ' ' + units[i];
        };

        setEl('st-db', fmtSize(s.db_size));
        setEl('st-redis', fmtSize(s.redis_memory));
        setEl('st-rag', fmtSize(s.rag_vectors_size));

        // Disk (Excluding C: drive as requested)
        const pgSize = s.db_size || 0;
        const pgLimit = 5 * 1024 * 1024 * 1024; // 5 GB
        const pgPct = Math.min(100, (pgSize / pgLimit) * 100).toFixed(1);

        const aiSize = s.ai_files ? s.ai_files.reduce((sum, f) => sum + (f.size || 0), 0) : 0;
        const aiLimit = 500 * 1024 * 1024; // 500 MB
        const aiPct = Math.min(100, (aiSize / aiLimit) * 100).toFixed(1);

        const dumpSize = s.redis_dump_size || 0;
        const dumpLimit = 1024 * 1024 * 1024; // 1 GB
        const dumpPct = Math.min(100, (dumpSize / dumpLimit) * 100).toFixed(1);

        const drives = [
          { n: 'PostgreSQL Data', txt: `${fmtSize(pgSize)} / ${fmtSize(pgLimit)} (${pgPct}% capacity)`, u: pgPct, cls: 'pb-green' },
          { n: 'RAG & AI Files', txt: `${fmtSize(aiSize)} / ${fmtSize(aiLimit)} (${aiPct}% capacity)`, u: aiPct, cls: 'pb-purple' },
          { n: 'Redis Dump', txt: `${fmtSize(dumpSize)} / ${fmtSize(dumpLimit)} (${dumpPct}% capacity)`, u: dumpPct, cls: 'pb-orange' }
        ];

        htmlEl('st-disk-detail', drives.map(d => `<div class="pb-wrap"><div class="pb-label"><span>${d.n}</span><span>${d.txt}</span></div><div class="pb"><div class="pb-fill ${d.cls}" style="width:${d.u}%;animation:none"></div></div></div>`).join(''));

        // File Sistem AI list
        if (s.ai_files && s.ai_files.length > 0) {
          htmlEl('st-ai-files', s.ai_files.map(f => {
            const icon = f.name.endsWith('.py') ? '<i class="fa-solid fa-gears" style="margin-right:6px"></i>' : f.name.endsWith('.db') ? '<i class="fa-solid fa-database" style="margin-right:6px"></i>' : f.name.endsWith('.json') ? '<i class="fa-solid fa-chart-column" style="margin-right:6px"></i>' : '<i class="fa-solid fa-robot" style="margin-right:6px"></i>';
            return `
              <div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:8px 10px;gap:4px">
                <div class="li-name">${icon} ${f.name}</div>
                <div style="font-size:10px;color:var(--txt3)">${fmtSize(f.size)} · ${f.desc}</div>
              </div>
            `;
          }).join(''));
        }
      } else {
        setEl('st-db', 'osi_system'); setEl('st-redis', '—'); setEl('st-rag', '108 KB');
      }
    },
    refresh() { this.load(); Notify.toast('🔄','Storage data refreshed','ok',1500); }
  },

  /* ---- AI PANEL ---- */
  ai: {
    async load() {
      try {
        const [stats, incidents] = await Promise.all([
          DataService.loadAIStats(),
          DataService.loadIncidents()
        ]);
        
        if (!stats) return;
        
        setEl('ai-active-count', stats.active_count);
        setEl('ai-active-names', stats.active_names);
        setEl('ai-rag-count', stats.rag_count + ' entries');
        setEl('ai-class-acc', stats.classif_accuracy + '%');
        setEl('ai-avg-conf', stats.avg_confidence + '%');
        
        // Model status list
        const modelListHtml = stats.models.map(m => {
          const icon = m.key === 'deepseek' ? '<i class="fa-solid fa-robot" style="color:var(--pink);margin-right:6px"></i>' : m.key === 'gemini' ? '<i class="fa-solid fa-sparkles" style="color:var(--blue2);margin-right:6px"></i>' : '<i class="fa-solid fa-bolt" style="color:var(--orange2);margin-right:6px"></i>';
          return `<div class="li-row">
            <span class="li-name">${icon} ${m.name}</span>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px">
              <span class="tag ${m.enabled ? 'tag-green' : 'tag-gray'}">${m.enabled ? '● Active' : '● Disabled'}</span>
              <span style="font-size:9.5px;color:var(--txt3)">${m.url}</span>
            </div>
          </div>`;
        }).join('');
        htmlEl('ai-model-status-list', modelListHtml);
        
        // Radar performance chart
        const datasets = [];
        const activeKeys = stats.models.filter(m => m.enabled).map(m => m.key);
        if (activeKeys.includes('deepseek')) {
          datasets.push({label:'DeepSeek',data:[87,92,78,85,90],backgroundColor:'rgba(59,130,246,.15)',borderColor:'#3b82f6',borderWidth:2});
        }
        if (activeKeys.includes('gemini')) {
          datasets.push({label:'Gemini',data:[89,94,82,88,91],backgroundColor:'rgba(168,85,247,.15)',borderColor:'#a855f7',borderWidth:2});
        }
        if (activeKeys.includes('groq')) {
          datasets.push({label:'Groq Llama',data:[84,88,95,80,85],backgroundColor:'rgba(234,179,8,.15)',borderColor:'#eab308',borderWidth:2});
        }
        // Baseline
        datasets.push({label:'Baseline',data:[75,75,75,75,75],backgroundColor:'rgba(139,148,158,.08)',borderColor:'#4d5e7a',borderWidth:1,borderDash:[4,3]});
        
        Charts.create('chart-ai-perf','radar',['Confidence','Accuracy','Speed','Coverage','Precision'],datasets,{legend:true,scales:{}});
        
        // AI History table
        const tbody = document.getElementById('tbody-ai-hist');
        if (tbody && incidents) {
          tbody.innerHTML = incidents.slice(0, 10).map(inc => {
            const timeStr = inc.timestamp ? (inc.timestamp.includes(' ') ? inc.timestamp.split(' ')[1] : inc.timestamp) : '—';
            const conf = Math.round((inc.confidence || 0.86) * 100);
            const flag = inc.flag || 'UNKNOWN';
            const modelName = inc.model_used || 'DeepSeek';
            const isCorrect = inc.status !== 'WRONG' && inc.status !== 'INCORRECT' && inc.status !== '❌ Wrong';
            return `<tr>
              <td style="font-size:10px;color:var(--txt2)">${timeStr}</td>
              <td>${inc.agent || inc.device_name || '?'}</td>
              <td><code style="font-size:10px;color:var(--orange2)">${flag}</code></td>
              <td><code style="font-size:10px;color:var(--green2)">${flag}</code></td>
              <td style="color:${conf >= 80 ? 'var(--green2)' : 'var(--orange2)'}">${conf}%</td>
              <td><span class="tag tag-blue">${modelName}</span></td>
              <td><span class="tag ${isCorrect ? 'tag-green' : 'tag-red'}">${isCorrect ? '✓ Correct' : '❌ Wrong'}</span></td>
            </tr>`;
          }).join('') || '<tr><td colspan="7" style="text-align:center;padding:12px;color:var(--txt2)">Tidak ada data prediksi</td></tr>';
        }
        
        setEl('bdg-ai', 'Active');
      } catch (e) {
        console.error('Error loading AI panel:', e);
      }
    },
    async runInference() {
      const query = document.getElementById('ai-query-input').value.trim() || 'Analisis insiden terbaru';
      const out = document.getElementById('ai-reasoning-output');
      if (!out) return;
      
      out.innerHTML = '<div style="color:var(--txt2);font-size:11px;display:flex;align-items:center;gap:8px"><div style="width:12px;height:12px;border:2px solid var(--blue);border-top-color:transparent;border-radius:50%;animation:spin .6s linear infinite"></div> AI sedang menganalisis dengan model lokal...</div>';
      LogStreamer.add('INFO', 'AI', 'Inference started: "' + query.slice(0, 50) + '"');
      
      try {
        const resp = await DataService.runAIDiagnose(query);
        if (resp && resp.success) {
          const conf = Math.round((resp.confidence || 0.86) * 100);
          const stepsHtml = (resp.remediation_steps || []).map(s => `<li>${s}</li>`).join('');
          
          out.innerHTML = `
            <div style="font-size:11.5px;margin-bottom:10px"><b style="color:var(--purple2)">🧠 AI Reasoning (${resp.source}):</b></div>
            <div style="background:rgba(0,0,0,.3);border-radius:6px;padding:10px 12px;font-size:11px;color:var(--txt2);line-height:1.6;margin-bottom:10px;border:1px solid var(--bd)">
              <b>Diagnosis:</b> ${resp.answer}<br><br>
              <b>5-Why Root Cause Analysis:</b>
              <pre style="font-family:'JetBrains Mono',monospace;font-size:10.5px;background:rgba(0,0,0,0.4);border:1px solid rgba(255,255,255,0.05);padding:8px;border-radius:4px;color:#a855f7;white-space:pre-wrap;margin-top:4px;">${resp['5_whys_analysis'] || '—'}</pre>
              <b style="margin-top:8px;display:block">Langkah Mediasi:</b>
              <ol style="margin:4px 0 0 16px;padding:0">${stepsHtml || '<li>Cek koneksi fisik dan restart agent.</li>'}</ol>
              ${resp.suggested_command ? `<b style="margin-top:8px;display:block">Perintah Rekomendasi:</b>
              <code style="font-family:'JetBrains Mono',monospace;color:#00d2ff;background:rgba(0,18,36,0.3);padding:3px 6px;border-radius:4px;font-size:10.5px;display:inline-block;margin-top:2px">${resp.suggested_command}</code>` : ''}
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap">
              <div style="flex:1;min-width:140px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);margin-bottom:4px">CONFIDENCE</div><div style="font-size:18px;font-weight:800;color:var(--green2)">${conf}%</div></div>
              <div style="flex:1;min-width:140px;background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);margin-bottom:4px">CLASSIFICATION</div><div style="font-size:13px;font-weight:700;color:var(--blue2)">${resp.flag}</div></div>
              <div style="flex:1;min-width:140px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:6px;padding:8px 10px"><div style="font-size:9.5px;color:var(--txt3);margin-bottom:4px">SOURCE</div><div style="font-size:11px;font-weight:600;color:var(--orange2)">${resp.source}</div></div>
            </div>`;
          Notify.toast('🤖 AI Inference', 'Analisis selesai · Confidence: ' + conf + '%', 'ok', 3000);
          LogStreamer.add('OK', 'AI', 'Inference completed · confidence: ' + conf + '% · class: ' + resp.flag);
        } else {
          out.innerHTML = `<div class="empty-state"><div class="es-icon">❌</div><div class="es-text">Diagnosis gagal: ${resp ? resp.error : 'Unknown response'}</div></div>`;
          Notify.toast('❌ Diagnosis Gagal', resp ? resp.error : 'Gagal memanggil model lokal', 'error', 3000);
        }
      } catch (err) {
        out.innerHTML = `<div class="empty-state"><div class="es-icon">❌</div><div class="es-text">Gagal menghubungi API: ${err.message}</div></div>`;
        Notify.toast('❌ Error API', err.message, 'error', 3000);
      }
    }
  },

  /* ---- TRAINING ---- */
  training: {
    async load() {
      try {
        const stats = await DataService.loadFeedbackStats();
        if (!stats) return;
        
        setEl('tr-correct', stats.correct_count);
        setEl('tr-incorrect', stats.incorrect_count);
        setEl('tr-rag', stats.rag_count);
        setEl('bdg-training', stats.queue.length);
        setEl('tr-queue-count', stats.queue.length);
        
        const list = document.getElementById('tr-feedback-list');
        if (list) {
          list.innerHTML = stats.queue.map(inc => {
            const conf = Math.round((inc.confidence || 0.8) * 100);
            return `<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:10px 12px;gap:6px;margin-bottom:8px" id="fb-${inc.incident_id}">
              <div style="font-size:11.5px;font-weight:500">🤖 ${inc.device_name} — <code style="color:var(--orange2)">${inc.flag}</code></div>
              <div style="font-size:10px;color:var(--txt2)">ID: ${inc.incident_id} · Confidence: <b style="color:${conf >= 80 ? 'var(--green2)' : 'var(--orange2)'}">${conf}%</b></div>
              <div style="display:flex;gap:6px">
                <button class="btn btn-success btn-sm" onclick="Panels.training.markFeedback(${inc.incident_id},'correct','${inc.flag}')">✓ Benar</button>
                <button class="btn btn-danger btn-sm" onclick="Panels.training.markFeedback(${inc.incident_id},'incorrect','${inc.flag}')">❌ Salah</button>
                <button class="btn btn-ghost btn-sm" onclick="Panels.training.markFeedback(${inc.incident_id},'skip')"><i class="fa-solid fa-rotate-right" style="margin-right:4px"></i>Skip</button>
              </div>
            </div>`;
          }).join('') || '<div class="empty-state"><div class="es-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></div><div class="es-text">Tidak ada feedback pending</div></div>';
        }
        
        // Calculate dynamic accuracy point for the chart
        const total = stats.correct_count + stats.incorrect_count;
        const currentAcc = total > 0 ? Math.round((stats.correct_count / total) * 100) : 94;
        
        Charts.create('chart-training-acc', 'line', ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun'], [
          {
            label: 'Accuracy %',
            data: [72, 78, 81, 85, 89, currentAcc],
            borderColor: '#22c55e',
            backgroundColor: 'rgba(34,197,94,.1)',
            tension: .4,
            fill: true
          }
        ], { legend: false, yOpts: { max: 100, min: 60 } });
      } catch (err) {
        console.error('Error loading training panel:', err);
      }
    },
    async markFeedback(incidentId, type, flag="") {
      const card = document.getElementById('fb-' + incidentId);
      if (card) {
        card.style.opacity = '.5';
        card.style.pointerEvents = 'none';
      }
      
      if (type === 'skip') {
        if (card) card.remove();
        Notify.toast('⟳ Skipped', 'Feedback untuk insiden ' + incidentId + ' dilewati', 'info', 1500);
        return;
      }
      
      const score = type === 'correct' ? 1.0 : 0.0;
      try {
        const resp = await DataService.submitFeedback(incidentId, score, flag, 'Manual verification');
        if (resp && resp.success) {
          if (card) card.remove();
          Notify.toast('📚 Feedback', 'Ditandai sebagai ' + type.toUpperCase() + ' · RAG diupdate', type === 'correct' ? 'ok' : 'warn', 2000);
          LogStreamer.add('OK', 'TRAINING', 'Feedback ' + type.toUpperCase() + ' submitted for Incident ID ' + incidentId + ' · Model retraining queued');
          // Reload stats and RAG count
          this.load();
        } else {
          if (card) {
            card.style.opacity = '1';
            card.style.pointerEvents = '';
          }
          Notify.toast('❌ Gagal', resp ? resp.error : 'Gagal mengirim feedback', 'error', 3000);
        }
      } catch (err) {
        if (card) {
          card.style.opacity = '1';
          card.style.pointerEvents = '';
        }
        Notify.toast('❌ Error API', err.message, 'error', 3000);
      }
    }
  },

  logs: {
    async load() {
      try {
        const logs = await DataService.loadServerLogs(100);
        if (logs && Array.isArray(logs)) {
          LogStreamer.loadBulk(logs);
        }
      } catch (err) {
        console.error("Failed to load server logs:", err);
      }
    }
  },

  /* ---- GOVERNANCE ---- */
  gov: {
    async load() {
      // 1. Top Resolusi Sukses (Real API)
      try {
        const topRes = await DataService.fetch('/api/governance/top_resolutions');
        if (topRes && Array.isArray(topRes)) {
          setEl('gov-res-tag', topRes.length + ' jenis');
          htmlEl('tbody-gov-res', topRes.map((r, i) => `<tr><td style="color:var(--txt3)">${i+1}</td><td><code style="font-size:10px">${r.flag}</code></td><td><b style="color:var(--green2)">${r.count}x</b></td><td><span class="tag tag-blue">L${r.layer||'?'}</span></td></tr>`).join(''));
        } else {
          setEl('gov-res-tag', '0 jenis');
          htmlEl('tbody-gov-res', '<tr><td colspan="4" style="text-align:center;padding:12px;color:var(--txt2)">Tidak ada data</td></tr>');
        }
      } catch (e) {
        setEl('gov-res-tag', '0 jenis');
        htmlEl('tbody-gov-res', '<tr><td colspan="4" style="text-align:center;padding:12px;color:var(--txt2)">Tidak ada data</td></tr>');
      }

      // 2. Audit Log (Terbaru)
      try {
        const audits = await DataService.loadAudits();
        Panels.server._renderAuditHistory(audits);
      } catch(e) {}

      // 3. Recovery Mode
      try {
        const modeData = await DataService.loadRecoveryMode();
        if (modeData && modeData.success) {
          const sel = document.getElementById('gov-recovery-mode');
          if (sel) {
            sel.value = modeData.recovery_mode;
            this._updateRecoveryModeDesc(modeData.recovery_mode);
          }
        }
      } catch(e) {}

      // 4. SLA Compliance Chart (Real API)
      try {
        const slaData = await DataService.fetch('/api/governance/sla_compliance');
        const dataValues = CFG.SITES.map(site => (slaData && slaData[site] !== undefined) ? slaData[site] : 95.0);
        Charts.create('chart-sla','bar',CFG.SITES,[{label:'SLA %',data:dataValues,backgroundColor:'rgba(34,197,94,.2)',borderColor:'#22c55e',borderWidth:1.5,borderRadius:4}],{legend:false,yOpts:{max:100,min:80}});
      } catch (e) {
        Charts.create('chart-sla','bar',CFG.SITES,[{label:'SLA %',data:CFG.SITES.map(()=>95),backgroundColor:'rgba(34,197,94,.2)',borderColor:'#22c55e',borderWidth:1.5,borderRadius:4}],{legend:false,yOpts:{max:100,min:80}});
      }
    },
    async setRecoveryMode(mode) {
      try {
        const res = await DataService.saveRecoveryMode(mode);
        if (res && res.success) {
          Notify.toast('⚙️ Recovery Mode','Mode diubah ke: '+mode,'warn',3000);
          LogStreamer.add('WARN','CONF','Recovery mode changed to: '+mode+' by operator');
          this._updateRecoveryModeDesc(mode);
        } else {
          Notify.toast('❌ Error','Gagal mengubah recovery mode','err',3000);
        }
      } catch (e) {
        Notify.toast('❌ Error','Gagal menghubungi server','err',3000);
      }
    },
    _updateRecoveryModeDesc(mode) {
      const descBox = document.querySelector('#p-gov .insight-box');
      if (descBox) {
        let descText = "";
        if (mode === "Semi-Auto") {
          descText = "<b>Aktif:</b> Semi-Auto · AI hanya merekomendasikan, operator wajib approve sebelum eksekusi.";
        } else if (mode === "Advisory") {
          descText = "<b>Aktif:</b> Advisory · AI menganalisa masalah & menyarankan SOP. Tidak ada intervensi otomatis.";
        } else if (mode === "Full-Auto") {
          descText = "<b>Aktif:</b> Full-Auto · AI mengeksekusi perintah mitigasi secara instan (OTONOM).";
        }
        descBox.innerHTML = descText;
      }
    }
  },

  /* ---- SOP ---- */
  sop: {
    _drafts: [],
    _active: [],
    async load() {
      const incidents = DataService._incidents;
      const activeAnomalies = incidents.filter(i=>i.status!=='RESOLVED');
      
      let backendActive = [];
      let backendDrafts = [];
      try {
        const res = await DataService.fetch('/api/governance/sops');
        if (res && res.success) {
          backendActive = res.active || [];
          backendDrafts = res.drafts || [];
        }
      } catch(e) {}
      
      this._active = backendActive;
      
      const allDrafts = [];
      backendDrafts.forEach(d => {
        allDrafts.push({
          name: d.name,
          trigger: d.trigger,
          desc: d.desc,
          type: 'MANUAL',
          meta: `DRAFT · Manual · Trigger: <code>${d.trigger}</code>`
        });
      });

      const uniqueAnomalyTriggers = new Set();
      activeAnomalies.forEach(inc => {
        const trig = inc.flag || 'SYSTEM_ALERT';
        const key = `${inc.device_name || inc.agent || 'device'}_${trig}`;
        
        // Skip if there's already an active SOP covering this trigger
        const isCoveredByActive = backendActive.some(s => s.trigger === trig);
        if (isCoveredByActive) return;
        
        // Skip if there's already a manual draft for this trigger
        const isCoveredByDraft = backendDrafts.some(d => d.trigger === trig);
        if (isCoveredByDraft) return;

        // Skip if we already added an anomaly draft for this unique combination
        if (uniqueAnomalyTriggers.has(key)) return;
        uniqueAnomalyTriggers.add(key);

        allDrafts.push({
          name: `Auto-${inc.flag||'HANDLE'} jika ${inc.device_name||inc.agent||'device'} anomali`,
          trigger: trig,
          desc: inc.evidence || `Mitigasi otomatis untuk ${inc.flag} pada ${inc.device_name||inc.agent}.`,
          type: 'ANOMALY',
          meta: `DRAFT · AI-Generated · Trigger: <code>${trig.toLowerCase()}</code> · ${timeSince(inc.timestamp)}`
        });
      });
      
      this._drafts = allDrafts;

      const pendingReviewCount = allDrafts.filter(d => d.type === 'ANOMALY').length;

      setEl('sop-active-kpi', backendActive.length);
      setEl('sop-draft-kpi', allDrafts.length);
      setEl('sop-review-kpi', pendingReviewCount);
      setEl('sop-draft-badge', allDrafts.length);
      setEl('sop-active-badge', backendActive.length);
      setEl('bdg-sop', allDrafts.length || 0);

      // Render Draft SOPs
      htmlEl('sop-draft-list', allDrafts.map((d,i)=>`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:var(--glass);border-radius:6px;padding:10px 12px;gap:6px;margin-bottom:8px">
        <div style="display:flex;align-items:center;justify-content:space-between;width:100%">
          <div style="font-size:11.5px;font-weight:600">📄 ${d.name}</div>
          <div style="display:flex;gap:4px">
            <button class="btn btn-warning btn-xs" onclick="Panels.sop.promote(${i})">▲ Promote</button>
            ${d.type === 'MANUAL' ? `<button class="btn btn-ghost btn-xs" style="color:var(--red2)" onclick="Panels.sop.deleteSOP('${d.name.replace(/'/g, "\\'")}')">🗑️</button>` : ''}
          </div>
        </div>
        <div style="font-size:10px;color:var(--txt2)">${d.meta}</div>
      </div>`).join('') || '<div class="empty-state"><div class="es-icon"><i class="fa-solid fa-file-invoice"></i></div><div class="es-text">Tidak ada SOP draft</div></div>');

      // Render Active SOPs
      htmlEl('sop-active-list', backendActive.map(s=>`<div class="li-row" style="flex-direction:column;align-items:flex-start;background:rgba(34,197,94,.05);border:1px solid rgba(34,197,94,.15);border-radius:6px;padding:10px 12px;gap:4px;margin-bottom:8px">
        <div style="display:flex;align-items:center;justify-content:space-between;width:100%">
          <div style="font-size:11.5px;font-weight:600;color:var(--green2)">✅ ${s.name}</div>
          <button class="btn btn-ghost btn-xs" style="color:var(--red2)" onclick="Panels.sop.deleteSOP('${s.name.replace(/'/g, "\\'")}')">🗑️</button>
        </div>
        <div style="font-size:10px;color:var(--txt2)">${s.meta}</div>
      </div>`).join('') || '<div class="empty-state"><div class="es-icon"><i class="fa-solid fa-circle-check" style="color:var(--green)"></i></div><div class="es-text">Tidak ada SOP aktif</div></div>');
    },
    async promote(idx) {
      const d = this._drafts[idx];
      if (!d) return;
      try {
        const res = await DataService.promoteSOP(d.name, d.trigger, d.desc);
        if (res && res.success) {
          Notify.toast('▲ Promoted','SOP "'+d.name+'" dipromosikan ke ACTIVE','ok',3000);
          LogStreamer.add('OK','SOP','SOP promoted to ACTIVE: '+d.name);
          await this.load();
        } else {
          Notify.toast('❌ Error','Gagal mempromosikan SOP','err',3000);
        }
      } catch (e) {
        Notify.toast('❌ Error','Gagal mempromosikan SOP','err',3000);
      }
    },
    async deleteSOP(name) {
      Modal.confirm('🗑️ Hapus SOP', `Apakah Anda yakin ingin menghapus SOP "${name}"?`, async () => {
        Modal.close();
        try {
          const res = await DataService.deleteSOP(name);
          if (res && res.success) {
            Notify.toast('🗑️ Deleted', `SOP "${name}" berhasil dihapus`, 'ok', 3000);
            LogStreamer.add('OK', 'SOP', `SOP deleted: ${name}`);
            await this.load();
          } else {
            Notify.toast('❌ Error', 'Gagal menghapus SOP', 'err', 3000);
          }
        } catch (e) {
          Notify.toast('❌ Error', 'Gagal menghapus SOP', 'err', 3000);
        }
      });
    },
    async create() {
      const n=document.getElementById('sop-new-name').value.trim();
      const t=document.getElementById('sop-new-trigger').value.trim();
      const d=document.getElementById('sop-new-desc').value.trim();
      if(!n||!t){Notify.toast('⚠️','Nama dan Trigger wajib diisi','warn');return;}
      try {
        const res = await DataService.createSOP(n, t, d);
        if (res && res.success) {
          Notify.toast('📄 SOP Created','"'+n+'" berhasil dibuat sebagai DRAFT','ok',3000);
          LogStreamer.add('OK','SOP','New SOP draft created: '+n+' · trigger: '+t);
          this.clearForm();
          await this.load();
        } else {
          Notify.toast('❌ Error','Gagal membuat SOP draft','err',3000);
        }
      } catch (e) {
        Notify.toast('❌ Error','Gagal membuat SOP draft','err',3000);
      }
    },
    clearForm() { ['sop-new-name','sop-new-trigger','sop-new-desc'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});}
  },

  /* ---- MODELS CONFIG ---- */
  models: {
    async load() {
      const list = document.getElementById('model-config-list');
      const keyStatus = document.getElementById('model-key-status');
      if (!list) return;
      
      list.innerHTML = '<div style="color:var(--txt2);font-size:11px;padding:12px">🔄 Loading configuration and API key status...</div>';
      
      try {
        const [config, statuses, devices] = await Promise.all([
          DataService.loadAIConfig(),
          DataService.testAIKeyStatus(),
          DataService.loadDevices()
        ]);
        
        if (config) {
          for (const key in config) {
            const m = CFG.AI_MODELS.find(x => x.key === key);
            if (m) {
              m.enabled = config[key].enabled;
              m.url = config[key].api_url;
            }
          }
        }
        
        list.innerHTML = CFG.AI_MODELS.map(m => {
          const statusInfo = (statuses && statuses[m.key]) ? statuses[m.key] : { status: 'UNKNOWN' };
          const statusClass = statusInfo.status === 'ONLINE' ? 'tag-green' : (statusInfo.status === 'ERROR' || statusInfo.status === 'OFFLINE' ? 'tag-red' : 'tag-gray');
          
          return `<div style="background:var(--glass);border:1px solid var(--bd);border-radius:6px;padding:10px 12px;margin-bottom:8px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
              <div style="font-size:12px;font-weight:700">${m.icon} ${m.name}</div>
              <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:11px">
                <input type="checkbox" id="chk-${m.key}" ${m.enabled ? 'checked' : ''} onchange="Panels.models.toggleModel('${m.key}',this.checked)" style="cursor:pointer">
                <span>${m.enabled ? 'Aktif' : 'Disabled'}</span>
              </label>
            </div>
            
            <div style="font-size:10px;color:var(--txt3);margin-bottom:4px">API URL</div>
            <div style="font-size:10.5px;color:var(--txt2);font-family:'JetBrains Mono',monospace;word-break:break-all">${m.url}</div>
            
            <!-- API KEY INPUT (Requested by user) -->
            <div style="margin-top:10px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
                <span style="font-size:10px;color:var(--txt3)">API Key</span>
                <span style="font-size:9.5px;color:var(--txt3)">Status: <b class="tag ${statusClass}" style="padding:1px 4px;font-size:9px">${statusInfo.status}</b></span>
              </div>
              <div style="display:flex;gap:6px">
                <input type="password" class="inp" style="flex:1;padding:4px 8px;font-size:11px;font-family:'JetBrains Mono',monospace" id="key-${m.key}" placeholder="Encrypted (Fernet) — Ubah disini..." value="">
                <button class="btn btn-ghost btn-xs" style="padding:4px 8px;border:1px solid var(--bd)" onclick="Panels.models.toggleKeyVisibility('${m.key}')" title="Show/Hide Key">👁</button>
              </div>
            </div>
            
            <div style="margin-top:10px;display:flex;gap:6px">
              <button class="btn btn-ghost btn-xs" onclick="Panels.models.testKey('${m.key}')">🔍 Test Connection</button>
              <button class="btn btn-primary btn-xs" onclick="Panels.models.viewKey('${m.key}')">🔑 View Key Tokens</button>
            </div>
          </div>`;
        }).join('');
        
        if (keyStatus) {
          keyStatus.innerHTML = CFG.AI_MODELS.map(m => {
            const statusInfo = (statuses && statuses[m.key]) ? statuses[m.key] : { status: 'UNKNOWN' };
            const statusClass = statusInfo.status === 'ONLINE' ? 'tag-green' : (statusInfo.status === 'ERROR' || statusInfo.status === 'OFFLINE' ? 'tag-red' : 'tag-gray');
            return `<div class="li-row">
              <span class="li-name">${m.icon} ${m.name} API Key</span>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px">
                <span class="tag ${statusClass}">${statusInfo.status}</span>
                <span style="font-size:9.5px;color:var(--txt3)">AES Encrypted · Fernet</span>
              </div>
            </div>`;
          }).join('') +
          `<div class="li-row"><span class="li-name">📬 Telegram Bot Token</span><span class="tag tag-orange">Configured</span></div>
           <div class="li-row"><span class="li-name">📊 Netdata Bearer Token</span><span class="tag tag-blue">Configured</span></div>`;
        }

        // Populate remote select dropdown dynamically
        Remote.populateSelect(devices);
      } catch (err) {
        console.error(err);
        list.innerHTML = `<div style="color:var(--red);font-size:11px;padding:12px">❌ Error loading config: ${err.message}</div>`;
      }
    },
    toggleModel(key, enabled) {
      const m = CFG.AI_MODELS.find(x => x.key === key);
      if (m) m.enabled = enabled;
      const chk = document.getElementById(`chk-${key}`);
      if (chk) {
        const span = chk.nextElementSibling;
        if (span) {
          span.textContent = enabled ? 'Aktif' : 'Disabled';
        }
      }
      Notify.toast('⚡ Model', '' + key + ' ' + (enabled ? 'diaktifkan' : 'dinonaktifkan'), 'info', 2000);
      LogStreamer.add('INFO', 'MODEL', key + ' ' + (enabled ? 'ENABLED' : 'DISABLED') + ' by operator');
    },
    toggleKeyVisibility(key) {
      const inp = document.getElementById(`key-${key}`);
      if (inp) {
        inp.type = inp.type === 'password' ? 'text' : 'password';
      }
    },
    async testKey(key) {
      Notify.toast('🔍 Testing', 'Menguji koneksi API ' + key + '...', 'info', 1500);
      try {
        const statuses = await DataService.testAIKeyStatus();
        if (statuses && statuses[key]) {
          const s = statuses[key];
          if (s.status === 'ONLINE') {
            Notify.toast('✅ Key Valid', key + ' API key valid & berfungsi (200 OK)', 'ok', 3000);
            LogStreamer.add('OK', 'API', 'API key test: ' + key + ' — ONLINE');
          } else if (s.status === 'DEPLETED') {
            Notify.toast('⚠️ Saldo Habis', key + ' API key valid tapi kuota/saldo habis (402)', 'warn', 4000);
            LogStreamer.add('WARN', 'API', 'API key test: ' + key + ' — DEPLETED');
          } else if (s.status === 'NO KEY') {
            Notify.toast('❌ Key Kosong', key + ' API key belum diatur atau kosong', 'error', 3000);
            LogStreamer.add('ERROR', 'API', 'API key test: ' + key + ' — NO KEY');
          } else {
            Notify.toast('❌ Koneksi Error', key + ' API error: ' + s.status + ' (code: ' + s.code + ')', 'error', 3000);
            LogStreamer.add('ERROR', 'API', 'API key test: ' + key + ' — ' + s.status);
          }
          // Refresh configuration panel
          this.load();
        } else {
          Notify.toast('❌ Gagal Uji', 'Tidak mendapat respon status untuk ' + key, 'error', 3000);
        }
      } catch (err) {
        Notify.toast('❌ API Error', err.message, 'error', 3000);
      }
    },
    viewKey(key) {
      Modal.show('🔑 API Key Tokens — ' + key, '<div style="font-family:JetBrains Mono,monospace;font-size:11px;color:var(--txt2);background:rgba(0,0,0,.3);padding:10px;border-radius:6px;border:1px solid var(--bd);word-break:break-all">gAAAAAB***...***ENCRYPTED (AES Fernet)<br><br>Token terenkripsi disimpan aman di database server config.</div>', [{ label: 'Copy (Masked)', cls: 'btn-ghost', fn: 'Notify.toast("📋","Key info copied (masked)","ok")' }, { label: 'Close', cls: 'btn-ghost', fn: 'Modal.close()' }]);
    },
    async save() {
      Notify.toast('💾 Saving', 'Menyimpan konfigurasi model...', 'info', 1500);
      const payload = {};
      for (const m of CFG.AI_MODELS) {
        const chk = document.getElementById(`chk-${m.key}`);
        const inp = document.getElementById(`key-${m.key}`);
        if (chk) {
          payload[m.key] = {
            enabled: chk.checked,
            api_key: inp ? inp.value.trim() : ''
          };
        }
      }
      
      try {
        const resp = await DataService.saveAIConfig(payload);
        if (resp && resp.success) {
          Notify.toast('💾 Saved', 'Konfigurasi model AI berhasil disimpan', 'ok', 2500);
          LogStreamer.add('OK', 'CONF', 'AI model config updated by operator');
          // Clear inputs
          for (const m of CFG.AI_MODELS) {
            const inp = document.getElementById(`key-${m.key}`);
            if (inp) inp.value = '';
          }
          this.load();
        } else {
          Notify.toast('❌ Gagal Simpan', resp ? resp.error : 'Gagal menyimpan', 'error', 3000);
        }
      } catch (err) {
        Notify.toast('❌ Error API', err.message, 'error', 3000);
      }
    }
  },
  activity: {
    _activities: {},
    _issues: [],
    _history: [],
    
    async load() {
      this.refresh();
    },
    
    handleLiveTelemetry(event) {
      if (!event) return;
      const dev = event.device;
      const type = event.type;
      const data = event.data;
      if (!dev) return;
      const ts = new Date().toLocaleTimeString();
      
      if (type === 'activity' || type === 'telemetry') {
        let activeApp = '-';
        let winTitle = '-';
        let state = 'Active';
        
        if (type === 'activity') {
          activeApp = data.app_name || data.process || '-';
          winTitle = data.window_title || '-';
          state = data.is_idle ? 'Idle' : 'Active';
        } else if (type === 'telemetry') {
          const activeAppData = data.data ? data.data.active_app : null;
          if (activeAppData) {
            activeApp = activeAppData.app_name || activeAppData.process || '-';
            winTitle = activeAppData.window_title || '-';
            state = activeAppData.is_idle ? 'Idle' : 'Active';
          }
        }
        
        if (activeApp !== '-') {
          this._activities[dev] = {
            device: dev,
            app: activeApp,
            title: winTitle,
            state: state,
            timestamp: ts
          };
        }
      }
      
      if (type === 'web_activity') {
        const browser = data.browser || 'chrome';
        const url = data.url || '';
        const domain = data.domain || '';
        const title = data.tab_title || '';
        
        if (!this._activities[dev]) {
          this._activities[dev] = { device: dev, app: browser, title: title, state: 'Active', timestamp: ts };
        } else {
          this._activities[dev].app = browser;
          this._activities[dev].title = title + ' (' + domain + ')';
          this._activities[dev].timestamp = ts;
        }
        
        this._history.unshift({
          time: ts,
          device: dev,
          browser: browser,
          event: data.issues && data.issues.length > 0 ? data.issues.join(', ') : 'Navigation',
          url: url
        });
        if (this._history.length > 50) this._history.pop();
      }
      
      if (type === 'issue') {
        const issueType = data.type || data.issue || 'UNKNOWN';
        const sev = data.severity || 'medium';
        const desc = data.details || (data.issues ? data.issues.join(', ') : '');
        const browser = data.browser || '-';
        
        const newIssue = {
          time: ts,
          device: dev,
          source: browser !== '-' ? 'Browser (' + browser + ')' : 'Go Agent',
          type: issueType,
          severity: sev,
          details: desc
        };
        
        this._issues.unshift(newIssue);
        if (this._issues.length > 50) this._issues.pop();
        
        if (issueType.includes('CRASH') || issueType.includes('HANG') || issueType.includes('FREEZE') || issueType.includes('TIMEOUT')) {
          this._history.unshift({
            time: ts,
            device: dev,
            browser: browser !== '-' ? browser : 'System',
            event: issueType,
            url: data.url || '-'
          });
          if (this._history.length > 50) this._history.pop();
        }
      }
      
      this.refresh();
      this.updateKPIs();
      this.generateAIInsights();
    },
    
    refresh() {
      const liveTbody = document.getElementById('act-live-tbody');
      if (liveTbody) {
        const rows = Object.values(this._activities);
        if (rows.length === 0) {
          liveTbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--txt3)">Waiting for agent data...</td></tr>';
        } else {
          liveTbody.innerHTML = rows.map(r => {
            const stateClass = r.state === 'Idle' ? 'tag-orange' : 'tag-green';
            return `<tr>
              <td><b>${r.device}</b></td>
              <td><span class="tag tag-blue">${r.app}</span></td>
              <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${r.title}">${r.title}</td>
              <td><span class="tag ${stateClass}">${r.state}</span></td>
              <td style="font-size:10px;color:var(--txt2)">${r.timestamp}</td>
            </tr>`;
          }).join('');
        }
      }
      
      const issuesTbody = document.getElementById('act-issues-tbody');
      if (issuesTbody) {
        if (this._issues.length === 0) {
          issuesTbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--txt3)">No issues detected.</td></tr>';
        } else {
          issuesTbody.innerHTML = this._issues.map(iss => {
            const sevClass = iss.severity === 'high' || iss.severity === 'critical' ? 'tag-red' : 'tag-orange';
            return `<tr>
              <td style="font-size:10px;color:var(--txt2)">${iss.time}</td>
              <td><b>${iss.device}</b></td>
              <td><span class="tag tag-gray">${iss.source}</span></td>
              <td><code style="color:var(--orange2)">${iss.type}</code></td>
              <td><span class="tag ${sevClass}">${iss.severity.toUpperCase()}</span></td>
              <td style="font-size:11px;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${iss.details}">${iss.details}</td>
            </tr>`;
          }).join('');
        }
      }
      
      const historyTbody = document.getElementById('act-history-tbody');
      if (historyTbody) {
        if (this._history.length === 0) {
          historyTbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--txt3)">Waiting for events...</td></tr>';
        } else {
          historyTbody.innerHTML = this._history.map(h => {
            const isCrash = h.event.includes('CRASH') || h.event.includes('HANG') || h.event.includes('FAILURE');
            const eventStyle = isCrash ? 'color:var(--red2);font-weight:600' : 'color:var(--txt2)';
            return `<tr>
              <td style="font-size:10px;color:var(--txt2)">${h.time}</td>
              <td><b>${h.device}</b></td>
              <td><span class="tag tag-blue">${h.browser}</span></td>
              <td><span style="${eventStyle}">${h.event}</span></td>
              <td style="font-size:11px;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${h.url}">
                <a href="${h.url}" target="_blank" style="color:var(--blue2)">${h.url}</a>
              </td>
            </tr>`;
          }).join('');
        }
      }
    },
    
    updateKPIs() {
      const users = new Set(Object.keys(this._activities)).size;
      setEl('act-kpi-users', users);
      
      const apps = new Set(Object.values(this._activities).map(r => r.app)).size;
      setEl('act-kpi-apps', apps);
      
      const tabs = Object.values(this._activities).filter(r => ['chrome','msedge','firefox','browser'].includes(r.app.toLowerCase())).length;
      setEl('act-kpi-tabs', tabs);
      
      const activeIssuesCount = this._issues.length;
      setEl('act-kpi-issues', activeIssuesCount);
      setEl('act-issues-count', activeIssuesCount + ' issues');
    },
    
    generateAIInsights() {
      const insightsEl = document.getElementById('act-ai-insights');
      if (!insightsEl) return;
      
      const insights = [];
      const slowPages = this._issues.filter(i => i.type === 'SLOW_PAGE');
      if (slowPages.length > 0) {
        const uniqueDomains = new Set(slowPages.map(p => {
          try {
            return new URL(p.details).hostname;
          } catch(e) { return 'website'; }
        }));
        insights.push(`⚠️ <b>Slow Loading:</b> Terdapat ${slowPages.length} insiden slow page load pada domain: ${Array.from(uniqueDomains).join(', ')}.`);
      }
      
      const crashes = this._issues.filter(i => i.type === 'TAB_CRASH' || i.type === 'CRASH_DETECTED');
      if (crashes.length > 0) {
        insights.push(`🚨 <b>App Crashes:</b> Terdeteksi ${crashes.length} aplikasi/tab crash dalam 5 menit terakhir. Rekomendasi: check RAM usage pada device terdampak.`);
      }
      
      const freezes = this._issues.filter(i => i.type === 'APP_HANG');
      if (freezes.length > 0) {
        insights.push(`❄️ <b>Freeze Warning:</b> Windows mendeteksi ${freezes.length} software dalam kondisi HANG/Freeze. Operator disarankan untuk membuka Remote Access.`);
      }

      const dnsFailures = this._issues.filter(i => i.type === 'DNS_FAILURE');
      if (dnsFailures.length > 0) {
        insights.push(`🌐 <b>DNS Failure:</b> Terdeteksi DNS resolve timeout di beberapa request browser. Periksa DNS server di gateway terdekat.`);
      }
      
      if (insights.length === 0) {
        insightsEl.innerHTML = '<div class="insight-box"><b>System status:</b> Semua metrik user activity normal. Belum ada anomali terdeteksi oleh AI Engine.</div>';
      } else {
        insightsEl.innerHTML = insights.map(ins => `<div class="insight-box" style="margin-bottom:8px">${ins}</div>`).join('');
      }
    }
  }
};

/* ==================================================
   GLOBAL SEARCH
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
document.getElementById('global-search').addEventListener('input', function() {
  const q = this.value.toLowerCase().trim();
  if(!q){document.querySelectorAll('.nav-item').forEach(i=>i.style.display=''); return;}
  document.querySelectorAll('.nav-item').forEach(item=>{
    item.style.display = item.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});
document.getElementById('global-search').addEventListener('keydown', function(e) {
  if(e.key==='Escape'){this.value=''; document.querySelectorAll('.nav-item').forEach(i=>i.style.display='');}
});

// Global keyboard shortcuts: Alt+S → Remote Settings | Alt+R → Refresh
document.addEventListener('keydown', function(e) {
  if(e.altKey && e.key === 's') { e.preventDefault(); RemoteSettings.open(); }
  if(e.altKey && e.key === 'r') { e.preventDefault(); DataService.refreshAll(); }
});


/* ==================================================
   SIDEBAR TOGGLE
================================================== */
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('collapsed');
}

/* ==================================================
   CLOCK
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
function updateClock() {
  const now = new Date();
  setEl('clock-txt', now.toLocaleTimeString());
  document.title = 'NOC IT AI · '+now.toLocaleTimeString();
}
setInterval(updateClock, 1000);
updateClock();

/* ==================================================
   BUS LISTENERS
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
Bus.on('incidents:loaded', incidents=>{
  const active=incidents.filter(i=>i.status!=='RESOLVED');
  if(isPanelActive('overview')) Panels.overview._renderIncidents(active);
  if(isPanelActive('incident')) Panels.incident._renderTable(incidents);
  if(isPanelActive('rca')) {
    const sel = document.getElementById('rca-select');
    const prevVal = sel ? sel.value : '';
    Panels.rca.load();
    if(sel && prevVal) sel.value = prevVal;
  }
  if(isPanelActive('dag')) {
    const sel = document.getElementById('dag-select');
    const prevVal = sel ? sel.value : '';
    Panels.dag.load(prevVal);
  }
});
Bus.on('devices:loaded', devices=>{
  if(isPanelActive('pchealth')) Panels.pchealth._render(devices);
  if(isPanelActive('fleet')) Panels.fleet.load();
  if(isPanelActive('rca')) {
    const targetSelect = document.getElementById('rca-target');
    const prevVal = targetSelect ? targetSelect.value : '';
    Panels.rca.load();
    if(targetSelect && prevVal) targetSelect.value = prevVal;
  }
});
Bus.on('health:loaded', async health=>{
  if(isPanelActive('server')) {
    try {
      const audits = await DataService.loadAudits();
      DataService._audits = audits;
      Panels.server._renderHealth(health, audits);
      Panels.server._renderAuditHistory(audits);
    } catch(e) {
      Panels.server._renderHealth(health);
    }
  }
  if(isPanelActive('overview')) Panels.overview._renderPipeline(health);
});
Bus.on('log:entry', entry=>{ LogStreamer.add(entry.type||'INFO', entry.src||'SYS', entry.message||''); });


/* ==================================================
   AUTO REFRESH (30s)
/* ==================================================
   SIDEBAR TOGGLE
================================================== */
setInterval(async ()=>{
  await DataService.loadIncidents();
  await DataService.loadHealth();
  if(isPanelActive('storage')) {
    await Panels.storage.load();
  }
  if(isPanelActive('ai')) {
    await Panels.ai.load();
  }
  if(isPanelActive('models')) {
    await Panels.models.load();
  }
  if(isPanelActive('training')) {
    await Panels.training.load();
  }
  updateLastRefresh();
}, 30000);

