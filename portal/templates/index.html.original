      </div>
      <div class="lk-div"><div class="lk-div-ln"></div><div class="lk-div-tx"><i class="fa-solid fa-lock" style="color:var(--blue);margin-right:6px"></i> Secure Login</div><div class="lk-div-ln"></div></div>
      <div class="lk-ig">
        <div class="lk-il"><i class="fa-solid fa-user" style="margin-right:6px"></i> Username</div>
        <div class="lk-iw"><span class="lk-ii"><i class="fa-solid fa-user"></i></span><input id="login-user" type="text" class="lk-if" placeholder="Masukkan username..." autocomplete="username" autofocus></div>
