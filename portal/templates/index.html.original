    <div class="lk-stat-card lk-s2"><div class="lk-slbl"><i class="fa-solid fa-triangle-exclamation" style="margin-right:6px;color:var(--red)"></i> Error Logs</div><div class="lk-sval" id="lk-v2">2,345</div><div class="lk-ssub" style="color:#f87171;">↑ 8.2% perlu perhatian</div></div>
    <div class="lk-stat-card lk-s3"><div class="lk-slbl"><i class="fa-solid fa-bolt" style="margin-right:6px;color:var(--orange)"></i> Warning Logs</div><div class="lk-sval" id="lk-v3">4,567</div><div class="lk-ssub" style="color:#fbbf24;">↑ 3.1% monitoring</div></div>
    <div class="lk-stat-card lk-s4"><div class="lk-slbl"><i class="fa-solid fa-circle-check" style="margin-right:6px;color:var(--green)"></i> Info Logs</div><div class="lk-sval" id="lk-v4">121,838</div><div class="lk-ssub" style="color:#4ade80;">↑ 15.7% normal ops</div></div>
  </div>

  <!-- Right AI Panel -->
