{
  "manifest_version": 3,
  "name": "OSI AI Incident Analysis Extension",
  "version": "1.0.0",
  "description": "Monitors active web tabs, URLs, navigation events, page loads, and crashes for real-time IT analysis.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:9999/*",
    "http://localhost:18800/*",
    "http://127.0.0.1:9999/*",
    "http://127.0.0.1:18800/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
