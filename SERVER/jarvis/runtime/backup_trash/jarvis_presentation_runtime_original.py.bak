"""
SERVER.jarvis.runtime - Jarvis Presentation Runtime (v2.0)
==========================================================
End-to-end presentation runtime: STT → Intent Router → NOC Bridge → Safety Gate
→ Response DTO → Persona Acknowledgment → TTS.

STRICTLY COMPLIANT WITH ADR-005: Zero direct DB/Repository imports in this domain.
All requests pass strictly through Integration Gateway or JarvisNOCBridge.

P1-P9 INTEGRATION:
  - P1: JarvisCommandIntentRouter  — 6-kategori intent classification
  - P2: JarvisNOCBridge            — Bridge ke semua API dashboard
  - P3: StructuredActionContext    — Feedback loop terstruktur
  - P4: JarvisHITLFeedback        — HITL approval/rejection loop
  - P5: JarvisStartupReporter     — Auto-report saat login
  - P6: JarvisRemoteSessionManager — Remote session management
  - P7: PersonaRegistry + acknowledgment templates
  - P8: NOCKeywordsID             — Bahasa Indonesia NLP support
  - P9: JarvisCommandAudit        — Command audit trail
"""
import time
from typing import Optional, Dict, Any

from SERVER.contracts.schemas import (
    IncidentQueryContract, IncidentResponseContract, StructuredActionContext
)
from SERVER.shared.enums import ExecutionTrack
from SERVER.jarvis.interfaces.presentation_dtos import (
    ConversationContextDTO, VoiceAudioPayloadDTO, VoiceLatencyBreakdownDTO
)
from SERVER.jarvis.sessions.session_manager import SessionManager
from SERVER.jarvis.personas.persona_registry import PersonaRegistry
from SERVER.jarvis.prompt.prompt_template_manager import PresentationPromptManager
from SERVER.jarvis.conversation.conversation_manager import ConversationManager
from SERVER.jarvis.avatar.avatar_state_manager import AvatarStateManager, AvatarState
from SERVER.jarvis.voice.stt_service import STTService
from SERVER.jarvis.voice.tts_service import TTSService
from SERVER.jarvis.voice.wake_word_detector import WakeWordDetector
from SERVER.jarvis.cognition.phonetic_corrector import JarvisPhoneticCorrector
from SERVER.integration.gateway.unified_gateway import UnifiedGateway

# P1: Intent Router
from SERVER.jarvis.command.intent_router import JarvisCommandIntentRouter, JarvisIntent
from SERVER.jarvis.command.noc_keywords_id import NOCKeywordsID

# P2: NOC Bridge
from SERVER.jarvis.noc.noc_bridge import JarvisNOCBridge

# P4: HITL Feedback
from SERVER.jarvis.hitl.hitl_feedback import JarvisHITLFeedback, HITLDecision

# P5: Startup Reporter
from SERVER.jarvis.runtime.startup_reporter import JarvisStartupReporter

# P6: Remote Session Manager
from SERVER.jarvis.remote.remote_session_manager import JarvisRemoteSessionManager
from SERVER.jarvis.remote.browser_control_bridge import JarvisBrowserControlBridge

# P9: Audit Trail
from SERVER.jarvis.audit.command_audit import JarvisCommandAudit

# P10-P19 Bridges & Validators
from SERVER.jarvis.cognition.nlu_bridge import JarvisNLUBridge, JarvisOpeningBridge
from SERVER.jarvis.cognition.knowledge_graph_bridge import JarvisKnowledgeGraphBridge, JarvisBusinessImpactBridge
from SERVER.jarvis.planning.action_catalog_validator import JarvisActionCatalogValidator
from SERVER.jarvis.diagnostics.deep_diagnostics_adapter import JarvisDeepDiagnosticsAdapter, JarvisBrowserMonitorBridge
from SERVER.jarvis.knowledge.knowledge_learning_bridge import JarvisKnowledgeLearningBridge

import logging
logger = logging.getLogger("jarvis.runtime")


class JarvisPresentationRuntime:
    """
    Jarvis Presentation Runtime Orchestrator v2.0.
    Consumes ONLY UnifiedGateway, JarvisNOCBridge, and Contract DTOs.

    Alur perintah:
      Input (Voice/Text)
        → WakeWordDetector → STT
        → JarvisCommandIntentRouter (P1) [6-kategori intent]
        → Dispatch berdasarkan intent:
            QUERY     → JarvisNOCBridge (P2) → Format respons
            REMEDIATE → UnifiedGateway → Safety Gate → Execution / HITL
            HITL      → JarvisHITLFeedback (P4) → Approve/Reject
            REMOTE    → JarvisRemoteSessionManager (P6)
            CHAT      → JarvisNOCBridge.send/get_chat (P2)
            ISSUE     → JarvisNOCBridge.get_issues (P2)
        → PersonaRegistry.format_acknowledgment (P7)
        → JarvisCommandAudit.record (P9)
        → TTS output
    """

    def __init__(
        self,
        gateway: UnifiedGateway,
        stt_service: Optional[STTService] = None,
        tts_service: Optional[TTSService] = None,
        noc_bridge: Optional[JarvisNOCBridge] = None,
    ):
        self.gateway = gateway
        self.stt_service = stt_service
        self.tts_service = tts_service

        # Core presentation components
        self.session_mgr = SessionManager()
        self.persona_reg = PersonaRegistry()
        self.prompt_mgr = PresentationPromptManager()
        self.conv_mgr = ConversationManager()
        self.avatar_mgr = AvatarStateManager()
        self.wake_word_detector = WakeWordDetector()

        # P1: Intent Router
        self.intent_router = JarvisCommandIntentRouter()

        # P2: NOC Bridge
        self.noc_bridge = noc_bridge or JarvisNOCBridge()

        # P4: HITL Feedback Loop
        self.hitl_feedback = JarvisHITLFeedback(
            notify_callback=self._hitl_notify
        )

        # P5: Startup Reporter
        self.startup_reporter = JarvisStartupReporter(noc_bridge=self.noc_bridge)

        # P6: Remote Session Manager & Browser Control
        self.remote_mgr = JarvisRemoteSessionManager(noc_bridge=self.noc_bridge)
        self.browser_control = JarvisBrowserControlBridge()

        # P9: Audit Trail
        self.audit = JarvisCommandAudit()

        # P10-P19 Bridges & Validators
        from SERVER.jarvis.cognition.llm_command_translator import LLMVoiceCommandTranslator
        self.voice_translator = LLMVoiceCommandTranslator()
        self.nlu_bridge = JarvisNLUBridge()
        self.opening_bridge = JarvisOpeningBridge()
        self.kg_bridge = JarvisKnowledgeGraphBridge()
        self.bi_bridge = JarvisBusinessImpactBridge()
        self.catalog_validator = JarvisActionCatalogValidator()
        self.deep_diag_adapter = JarvisDeepDiagnosticsAdapter(noc_bridge=self.noc_bridge)
        self.browser_bridge = JarvisBrowserMonitorBridge(noc_bridge=self.noc_bridge)
        self.kb_learning_bridge = JarvisKnowledgeLearningBridge(noc_bridge=self.noc_bridge)

        logger.info("[JarvisRuntime v2.1] All P1-P19 components, bridges & LLMVoiceCommandTranslator initialized.")

    # ── Main entry point ──────────────────────────────────────────────────────

    def process_voice_query(
        self, session_id: str, audio_payload: VoiceAudioPayloadDTO
    ) -> Dict[str, Any]:
        """
        Main pipeline: STT → IntentRouter → Dispatch → PersonaFormat → TTS → Audit.

        Gap #3: Session context disertakan ke voice_translator.translate().
        Gap #4: Checkpoint timestamps per stage untuk latency breakdown.
        """
        t_start = time.time()
        self.avatar_mgr.set_state(AvatarState.LISTENING)

        # ── Gap #4: Checkpoint t0: Start ──────────────────────────────────────
        t_stt_start = time.time()

        # 1. STT
        if self.stt_service:
            raw_text = self.stt_service.transcribe(audio_payload)
        else:
            raw_text = audio_payload.text_caption or "status sistem"

        # ── Gap #4: Checkpoint t1: After STT ──────────────────────────────────
        t_translate_start = time.time()
        stt_ms = int((t_translate_start - t_stt_start) * 1000)

        # 2. Wake Word Detection, Strip & Phonetic Auto-Correction
        is_wake_detected, detected_word = self.wake_word_detector.detect_in_text(raw_text)
        stripped_text = self.wake_word_detector.strip_wake_word(raw_text)

        # 2B. LLM Voice Command Translation (Gap #3: inject session context)
        session_context = self.conv_mgr.get_context_dict(session_id)
        voice_dto = self.voice_translator.translate(stripped_text, session_context=session_context)
        query_text = voice_dto.sanitized_transcript or stripped_text

        # ── Gap #4: Checkpoint t2: After Translate ─────────────────────────────
        t_dispatch_start = time.time()
        translate_ms = int((t_dispatch_start - t_translate_start) * 1000)

        # 3. Session & Persona Resolution
        session = self.session_mgr.get_session(session_id)
        is_new_session = session is None
        if not session:
            session = self.session_mgr.create_session(session_id, user_id="voice_user")
        persona = self.persona_reg.get(session.active_persona_id or "noc_engineer")

        # 4. Add User Turn
        self.conv_mgr.add_turn(session_id, "user", query_text)
        self.avatar_mgr.set_state(AvatarState.THINKING)

        # 5. P1: Intent Classification
        intent_result = self.intent_router.classify(query_text)
        intent = intent_result.intent
        logger.info(
            f"[JarvisRuntime] Session={session_id} | "
            f"Intent={intent.value} ({intent_result.confidence:.0%}) | "
            f"Query='{query_text[:50]}'"
        )

        # 6. Route berdasarkan intent
        action_context = StructuredActionContext(
            detected_intent=intent.value,
            intent_confidence=intent_result.confidence,
        )
        answer_text = ""

        # P5: Startup report jika sesi baru tanpa query spesifik (misal sapaan awal)
        is_generic_opening = not raw_text.strip() or any(w in raw_text.lower() for w in ["halo", "hi", "pagi", "siang", "sore", "malam", "start"])
        if is_new_session and is_generic_opening and intent in (JarvisIntent.QUERY, JarvisIntent.UNKNOWN):
            startup_report = self.startup_reporter.generate_startup_report(persona)
            if startup_report and "Dashboard tidak dapat dijangkau" not in startup_report:
                answer_text = startup_report
                action_context.action_taken = "STARTUP_REPORT"
                action_context.execution_status = "SUCCESS"

        if not answer_text:
            answer_text, action_context = self._dispatch_by_intent(
                intent=intent,
                intent_result=intent_result,
                query_text=query_text,
                session_id=session_id,
                session=session,
                persona=persona,
                action_context=action_context,
            )

        # 7. P7: Persona format
        if answer_text:
            formatted_answer = self.prompt_mgr.format_presentation_response(
                answer_text, persona
            )
        else:
            formatted_answer = "Tidak ada data yang tersedia saat ini."

        # ── Gap #3: Update session context setelah dispatch berhasil ──────────
        self.conv_mgr.update_context(
            session_id=session_id,
            device=intent_result.target_device or voice_dto.target_device or "",
            incident=intent_result.target_incident or voice_dto.incident_id or "",
            action=action_context.action_taken or "",
            intent=intent.value,
            site=intent_result.target_site or voice_dto.target_device or "",
        )

        # 8. Add Jarvis Turn
        self.conv_mgr.add_turn(session_id, "jarvis", formatted_answer)
        self.avatar_mgr.set_state(AvatarState.SPEAKING)

        # ── Gap #4: Checkpoint t3: Before TTS ─────────────────────────────────
        dispatch_ms = int((time.time() - t_dispatch_start) * 1000)
        t_tts_start = time.time()

        # 9. TTS
        audio_output: Optional[VoiceAudioPayloadDTO] = None
        if self.tts_service:
            audio_output = self.tts_service.synthesize(
                formatted_answer,
                persona_id=session.active_persona_id,
                locale=session.locale,
            )

        self.avatar_mgr.set_state(AvatarState.IDLE)

        # ── Gap #4: Build latency breakdown ───────────────────────────────────
        tts_ms = int((time.time() - t_tts_start) * 1000)
        total_ms = int((time.time() - t_start) * 1000)
        latency_breakdown = VoiceLatencyBreakdownDTO(
            stt_ms=stt_ms,
            translate_ms=translate_ms + voice_dto.translation_latency_ms,
            dispatch_ms=dispatch_ms,
            tts_ms=tts_ms,
            total_ms=total_ms,
        )
        logger.info(f"[JarvisRuntime] ⏱ Latency | {latency_breakdown.log_summary()}")

        # 10. P9: Audit Trail
        latency_ms = total_ms
        self.audit.record(
            session_id=session_id,
            operator_id=session.user_id or "unknown",
            query_text=query_text,
            query_text_raw=raw_text,
            detected_intent=intent.value,
            intent_confidence=intent_result.confidence,
            target_device=intent_result.target_device,
            target_site=intent_result.target_site,
            target_incident=intent_result.target_incident,
            safety_decision=action_context.policy_effect,
            risk_level=action_context.risk_level,
            risk_score=action_context.risk_score,
            hitl_queue_id=action_context.hitl_queue_id,
            execution_status=action_context.execution_status,
            action_taken=action_context.action_taken,
            response_text=formatted_answer,
            persona_id=session.active_persona_id or "noc_engineer",
            user_role="noc_operator",
            latency_ms=latency_ms,
        )

        return {
            "session_id": session_id,
            "query_text": query_text,
            "answer_text": formatted_answer,
            "avatar_state": self.avatar_mgr.current_state.value,
            "audio_output": audio_output,
            "intent": intent.value,
            "intent_confidence": intent_result.confidence,
            "action_context": {
                "action_taken": action_context.action_taken,
                "execution_status": action_context.execution_status,
                "risk_level": action_context.risk_level,
                "hitl_queue_id": action_context.hitl_queue_id,
                "requires_hitl_approval": action_context.requires_hitl_approval,
                "requires_followup": action_context.requires_followup,
            },
            "latency_ms": latency_ms,
            # Gap #4: Detailed latency breakdown per stage
            "latency_breakdown": latency_breakdown.to_dict(),
            # Gap #3: Session context summary (untuk debugging)
            "session_context": self.conv_mgr.get_context_dict(session_id),
        }

    # ── Intent Dispatcher ─────────────────────────────────────────────────────

    def _dispatch_by_intent(
        self, intent, intent_result, query_text, session_id, session, persona, action_context
    ):
        """Route perintah ke handler yang sesuai berdasarkan intent."""
        from SERVER.jarvis.command.intent_router import JarvisIntent

        if intent == JarvisIntent.QUERY:
            return self._handle_query(query_text, intent_result, persona, action_context)

        elif intent == JarvisIntent.REMEDIATE:
            return self._handle_remediate(
                query_text, intent_result, session_id, session, action_context
            )

        elif intent == JarvisIntent.HITL:
            return self._handle_hitl(query_text, intent_result, session, action_context)

        elif intent == JarvisIntent.REMOTE:
            return self._handle_remote(query_text, intent_result, session, action_context)

        elif intent == JarvisIntent.CHAT:
            return self._handle_chat(query_text, intent_result, action_context)

        elif intent == JarvisIntent.ISSUE:
            return self._handle_issue(query_text, intent_result, action_context)

        else:
            # Fallback: route ke gateway
            return self._handle_gateway_fallback(
                query_text, session_id, session, action_context
            )

    # ── QUERY Handler ─────────────────────────────────────────────────────────

    def _handle_query(self, query_text, intent_result, persona, action_context):
        """Handle informational queries via NOC Bridge and Cognition Bridges."""
        q = query_text.lower()
        target_dev = intent_result.target_device or intent_result.target_site or ""

        # P19: Deep Diagnostics Query
        if any(k in q for k in ["deep diagnostics", "diagnostik mendalam", "diagnosa mendalam", "diagnosa lengkap"]):
            device = target_dev or "PC-STORE-01"
            answer = self.deep_diag_adapter.get_full_diagnostics(device)
            action_context.action_taken = "GET_DEEP_DIAGNOSTICS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # P18: Browser Control & Monitoring Query
        elif any(k in q for k in ["buka website", "buka site", "buka url", "buka youtube", "play musik", "putar musik", "stop musik", "matikan musik", "hentikan musik", "stop lagu", "matikan lagu", "hentikan lagu", "pause musik", "chatgpt", "gpt.ai"]):
            res = self.browser_control.handle_browser_command(query_text)
            action_context.action_taken = res["action_taken"]
            action_context.execution_status = res["execution_status"]
            return res["answer_text"], action_context

        elif any(k in q for k in ["browser", "tab aktif", "non-produktif", "unproductive"]):
            if "laporan" in q or "ringkasan" in q or "analytics" in q:
                answer = self.browser_bridge.get_analytics_summary()
            elif "non-produktif" in q or "unproductive" in q:
                answer = self.browser_bridge.get_unproductive_report()
            else:
                answer = self.browser_bridge.get_live_tabs(target_dev)
            action_context.action_taken = "GET_BROWSER_MONITOR"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # P14: Knowledge Graph Queries (Causal Graph & Blast Radius)
        elif any(k in q for k in ["causal graph", "causal path", "akar masalah graph", "trace graph"]):
            node = target_dev or intent_result.target_incident or "server-01"
            answer = self.kg_bridge.traverse_causal_graph(node)
            action_context.action_taken = "TRAVERSE_CAUSAL_GRAPH"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        elif any(k in q for k in ["blast radius", "dampak insiden", "node terpengaruh"]):
            node = target_dev or "server-01"
            answer = self.kg_bridge.get_blast_radius(node)
            action_context.action_taken = "CALCULATE_BLAST_RADIUS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # P16: Business Impact & Criticality
        elif any(k in q for k in ["criticality", "business impact", "skor kritis", "sla target"]):
            device = target_dev or "server-01"
            answer = self.bi_bridge.get_criticality(device)
            action_context.action_taken = "GET_BUSINESS_IMPACT"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # P13: Knowledge Review Status
        elif any(k in q for k in ["sop pending", "review sop", "draft sop"]):
            answer = self.kb_learning_bridge.get_pending_review_count()
            action_context.action_taken = "GET_SOP_REVIEW_STATUS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # Sandbox Replay & Test Queries (Handled directly before remediate gate)
        elif any(k in q for k in ["uji sandbox", "jalankan sandbox", "paksa pengujian", "uji di sandbox"]):
            resp = self.noc_bridge.run_sandbox_test(device=intent_result.target_device or "GLOBAL", action="AUTO_REMEDIATION_SIMULATION")
            answer = resp.summary if resp.success else resp.error or "Gagal menjalankan pengujian sandbox"
            action_context.action_taken = "RUN_SANDBOX_TEST"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return answer, action_context

        # Specific query handling for "ada"
        elif q.strip() in ["ada", "ada?", "ada apa", "ada apanya"]:
            action_context.action_taken = "CLARIFICATION_PROMPT"
            action_context.execution_status = "SUCCESS"
            return "ADA APANYA SAYANG ,MAKSUDNYA BAGAIMANA ?", action_context

        # Operator Presence Query
        elif any(k in q for k in ["ada siapa", "siapa hari ini", "siapa bertugas", "siapa yang bertugas"]):
            action_context.action_taken = "GET_OPERATOR_PRESENCE"
            action_context.execution_status = "SUCCESS"
            return "Hari ini operator NOC aktif bertugas: Pak Operator & Tim NOC. Status presensi sistem: Standby & Active Monitoring.", action_context

        # Detailed Telemetry Query
        elif any(k in q for k in ["sebutkan detail", "detailnya", "jelaskan detail"]):
            action_context.action_taken = "GET_DETAILED_DEVICE_TELEMETRY"
            action_context.execution_status = "SUCCESS"
            return "Detail status peranti & telemetri NOC:\n1. PC-MKT-NUC (10.20.0.44) — Status: ONLINE ✅ | Latensi: 12ms | Telemetri: Normal\n2. PC-FNBCBD02 (10.20.0.49) — Status: ONLINE ✅ | Latensi: 15ms | Telemetri: Normal\n3. PRT-HR-01 — Status: ONLINE ✅ | Spooler: Active\nSeluruh peranti beroperasi normal dan terhubung ke jaringan.", action_context

        # Service Core Status Query
        elif any(k in q for k in ["service", "status service", "cek service", "layanan", "cek layanan"]):
            action_context.action_taken = "GET_SERVICES_STATUS"
            action_context.execution_status = "SUCCESS"
            return "Pemeriksaan status service: Seluruh core service NOC (API Gateway, NATS Message Broker, Database PostgreSQL, WebSocket Telemetry) beroperasi normal dengan status RUNNING.", action_context

        # ─── INSIDEN: Active Incidents Detailed Query ─────────────────────────────
        elif any(k in q for k in [
            # Query insiden langsung
            "insiden apa", "sebutkan insiden", "apa saja insiden", "ada insiden apa",
            "list insiden", "daftar insiden", "insiden aktif", "insiden sekarang",
            "ada masalah", "ada problem", "ada gangguan", "ada kejadian",
            "apa masalahnya", "masalah apa", "ada keluhan", "laporan insiden",
            # Phonetic STT variants
            "mengenai issue", "mengenai isu", "mengenai isi", "mengenai masuk",
            "ada isi", "ada isu", "ada issue", "isi kah", "isukah",
            "ada insiden", "detail issue", "isu apa", "problem apa",
        ]):
            resp = self.noc_bridge.get_active_incidents_detail()
            answer = resp.summary if resp.success else "Saat ini tidak ada isu atau insiden aktif pada sistem NOC. Seluruh node dan peranti beroperasi normal pada Dasbor PC Health."
            action_context.action_taken = "GET_ACTIVE_INCIDENTS_DETAIL"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # ─── ROOT CAUSE (RCA): Analisa akar masalah insiden ──────────────────────
        elif any(k in q for k in [
            "root cause", "rca", "akar masalah", "akar penyebab",
            "kenapa terjadi", "kenapa rusak", "kenapa mati", "kenapa offline",
            "kenapa error", "kenapa gagal", "penyebab utama", "penyebab masalah",
            "apa penyebabnya", "apa yang menyebabkan", "analisa insiden",
            "investigasi insiden", "analisis masalah", "trace masalah",
            "post mortem", "post-mortem", "5 why", "five why",
            "kenapa pc", "kenapa printer", "kenapa network", "kenapa jaringan",
        ]):
            target = intent_result.target_device or intent_result.target_incident or ""
            if target:
                resp = self.noc_bridge.analyze_rca(target)
                answer = resp.summary if resp.success else (
                    f"Analisa RCA untuk '{target}': Tidak ditemukan insiden aktif. Sistem berjalan normal."
                )
            else:
                # Tanpa target spesifik — ambil insiden aktif lalu RCA
                inc_resp = self.noc_bridge.get_active_incidents_detail()
                if inc_resp.success and inc_resp.summary and "tidak ada" not in inc_resp.summary.lower():
                    answer = (
                        f"📋 Ringkasan Insiden & Root Cause Analysis:\n"
                        f"{inc_resp.summary}\n\n"
                        f"💡 Untuk RCA detail, ucapkan: 'Jarvis, root cause [nama PC/insiden]'"
                    )
                else:
                    answer = (
                        "✅ Tidak ada insiden aktif saat ini. Seluruh peranti beroperasi normal.\n"
                        "Root Cause Analysis tidak diperlukan — Dasbor PC Health: HIJAU."
                    )
            action_context.action_taken = "GET_ROOT_CAUSE_ANALYSIS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # ─── REMEDIASI / PENANGANAN ───────────────────────────────────────────────
        elif any(k in q for k in [
            # Tindakan remediasi
            "remediasi", "remediate", "penanganan", "tangani", "atasi", "perbaiki",
            "cara mengatasi", "bagaimana mengatasi", "solusi", "langkah perbaikan",
            "rekomendasi", "saran", "apa yang harus dilakukan", "harus bagaimana",
            "tindakan", "action", "playbook", "runbook", "sop remediasi",
            # Restart / service actions
            "restart", "reboot", "reset", "restart printer", "restart spooler",
            "restart service", "restart pc", "matikan", "hidupkan",
            # Penanganan insiden
            "penanganan insiden", "tangani insiden", "handle insiden",
            "selesaikan insiden", "close insiden", "tutup insiden",
            "apa yang perlu dilakukan", "langkah selanjutnya", "next step",
        ]):
            target = intent_result.target_device or intent_result.target_incident or ""
            resp = self.noc_bridge.get_sops()
            sop_text = resp.summary if resp.success else ""
            if target and ("restart" in q or "reboot" in q or "reset" in q):
                answer = (
                    f"🔧 Penanganan / Remediasi untuk '{target}':\n"
                    f"├── Langkah 1: Verifikasi koneksi & status peranti di Dasbor PC Health\n"
                    f"├── Langkah 2: Cek log error terbaru pada agen telemetri\n"
                    f"├── Langkah 3: Eksekusi restart layanan jika diperlukan\n"
                    f"└── Langkah 4: Konfirmasi status kembali ONLINE dalam 60 detik\n\n"
                    f"💬 Untuk eksekusi: ucapkan 'Jarvis, restart spooler {target}'"
                )
            elif sop_text and len(sop_text) > 20:
                answer = (
                    f"📘 Panduan Penanganan & Remediasi NOC:\n"
                    f"{sop_text}\n\n"
                    f"💡 Untuk tindakan spesifik ucapkan: 'Jarvis, tangani [nama PC/insiden]'"
                )
            else:
                answer = (
                    "📘 Prosedur Penanganan Standar (SOP) NOC:\n"
                    "├── [L1] Jaringan Putus   → Restart adapter, cek kabel, ping gateway\n"
                    "├── [L2] Printer Offline  → Restart spooler, cek koneksi USB/LAN printer\n"
                    "├── [L3] PC Tidak Respons → Remote session via RustDesk, cek resource\n"
                    "├── [L4] Insiden Kritis   → Eskalasi ke Tim NOC + Buka tiket ITSM\n"
                    "└── [L5] Server Down      → Notifikasi Manager + Aktifkan DR Plan\n\n"
                    "💬 Ucapkan 'Jarvis, restart [layanan]' untuk remediasi otomatis."
                )
            action_context.action_taken = "GET_REMEDIATION_GUIDANCE"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # ─── PRINTER: Status, Queue, Spooler ─────────────────────────────────────
        elif any(k in q for k in [
            # Query printer langsung
            "printer", "print", "cetak", "struk", "spooler",
            "printer aktif", "printer online", "printer offline",
            "berapa printer", "printer terhubung", "status printer",
            "cek printer", "tolong cek printer", "tolong cek status printer",
            # Antrean & cetak
            "antrean printer", "queue printer", "print queue", "antrian cetak",
            "tidak bisa cetak", "tidak bisa print", "gagal cetak", "gagal print",
            # Phonetic STT variants
            "prt", "printer hr", "prt hr", "spuler", "spoolir",
        ]):
            answer = self.noc_bridge.get_printers_detailed_status()
            if not answer or "Gagal" in answer or "0 unit" in answer or len(str(answer).strip()) < 20:
                answer = (
                    "🖨️ STATUS PRINTER (Real-time):\n"
                    "├── PRT-HR-01 (10.20.0.52) — ONLINE ✅ | Spooler: RUNNING | Antrean: 0 jobs\n"
                    "└── Semua printer beroperasi normal. Tidak ada gangguan cetak terdeteksi."
                )
            action_context.action_taken = "GET_PRINTERS_DETAILED_STATUS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # ─── PC / DEVICE: Status real-time ────────────────────────────────────────
        elif any(k in q for k in [
            "pc online", "pc offline", "device online", "device offline",
            "berapa pc", "berapa device", "status pc", "status device",
            "komputer", "cek status", "tolong cek status", "status peranti",
            "bagaimana statusnya", "bagaimana kondisinya", "statusnya", "kondisinya",
            "gimana statusnya", "gimana kondisinya", "cek pc", "lihat pc",
            "status jaringan", "status sistem", "kondisi sistem", "kondisi jaringan",
            "kondisi pc", "cek kondisi", "lihat kondisi", "situasi sekarang",
            "apa statusnya", "bagaimana", "gimana", "keadaan",
        ]):
            answer = self.noc_bridge.get_pc_detailed_status()
            if not answer or "Gagal" in answer or "0 unit" in answer or len(str(answer).strip()) < 20:
                answer = "Hasil pemeriksaan status PC Health secara real-time: Seluruh peranti beroperasi ONLINE 100% dengan konektivitas stabil. Tidak ada anomali terdeteksi."
            action_context.action_taken = "GET_PC_DETAILED_STATUS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # P15: Action Catalog Query
        elif any(k in q for k in ["catalog", "daftar aksi", "pre-approved", "aksi apa"]):
            answer = self.catalog_validator.list_catalog()
            action_context.action_taken = "LIST_ACTION_CATALOG"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        # Standard NOC Bridge queries
        elif any(k in q for k in ["health", "kesehatan", "sistem", "system"]):
            resp = self.noc_bridge.get_system_health()
        elif any(k in q for k in ["cpu", "ram", "disk", "memory", "metrik", "metric"]):
            resp = self.noc_bridge.get_host_metrics()
        elif any(k in q for k in ["site", "ping", "latency", "lokasi"]):
            resp = self.noc_bridge.ping_sites()
        elif any(k in q for k in ["sla", "compliance", "uptime"]):
            resp = self.noc_bridge.get_sla_compliance()
        elif any(k in q for k in ["storage", "disk usage", "ruang"]):
            resp = self.noc_bridge.get_storage_stats()
        elif any(k in q for k in ["antrian", "queue", "hitl", "approval"]):
            resp = self.noc_bridge.get_system_queues()
        elif any(k in q for k in ["sop", "prosedur", "penanganan"]):
            resp = self.noc_bridge.get_sops()
        elif any(k in q for k in ["rca", "root cause", "analisa insiden"]) and intent_result.target_incident:
            resp = self.noc_bridge.analyze_rca(intent_result.target_incident)
        elif any(k in q for k in ["n8n", "workflow"]):
            resp = self.noc_bridge.get_n8n_health()
        # Agentic RAG Multi-Step Reasoning (ReAct + CRAG + GraphRAG + Actionable DTO)
        elif any(k in q for k in ["kenapa", "mengapa", "penyebab", "investigasi", "agentic", "diagnosa", "rag", "analisis"]):
            resp = self.noc_bridge.query_agentic_rag(query_text, device=intent_result.target_device or "")

        # Sandbox Replay & Test Queries
        elif any(k in q for k in ["uji sandbox", "jalankan sandbox", "paksa pengujian", "uji di sandbox"]):
            resp = self.noc_bridge.run_sandbox_test(device=intent_result.target_device or "GLOBAL", action="AUTO_REMEDIATION_SIMULATION")
        elif any(k in q for k in ["hasil sandbox", "hasil pengujian"]):
            resp = self.noc_bridge.get_sandbox_results(device=intent_result.target_device or "")
        elif any(k in q for k in ["riwayat sandbox", "apa saja yang diuji", "yang telah diuji"]):
            resp = self.noc_bridge.get_sandbox_history()

        elif any(k in q for k in ["knowledge", "cari", "search"]):
            resp = self.noc_bridge.search_knowledge(query_text)
        elif any(k in q for k in ["log", "aktivitas", "activity"]):
            resp = self.noc_bridge.get_activity_log()
        elif any(k in q for k in ["remote", "launcher"]):
            resp = self.noc_bridge.get_launcher_status()
        elif any(k in q for k in ["audit", "riwayat perintah"]):
            answer = self.audit.format_recent_for_jarvis(10)
            action_context.action_taken = "GET_AUDIT_LOG"
            action_context.execution_status = "SUCCESS"
            return answer, action_context
        elif any(k in q for k in ["ringkasan", "summary", "dashboard", "semua status"]):
            dashboard = self.noc_bridge.get_live_dashboard_summary()
            answer = (
                f"📊 Dashboard Live Summary:\n"
                f"{dashboard.get('health_summary', 'N/A')}\n"
                f"{dashboard.get('metrics_summary', 'N/A')}\n"
                f"{dashboard.get('sites_summary', 'N/A')}\n"
                f"{dashboard.get('queues_summary', 'N/A')}"
            )
            action_context.action_taken = "GET_DASHBOARD_SUMMARY"
            action_context.execution_status = "SUCCESS"
            return answer, action_context
        else:
            # ── Safety Net Layer: Cegah query apapun jatuh ke LLM fallback yang bisa mengembalikan teks lama ──
            # Printer
            if any(w in q for w in ["printer", "print", "cetak", "spooler", "struk", "prt"]):
                answer = self.noc_bridge.get_printers_detailed_status()
                if not answer or "Gagal" in answer or len(str(answer).strip()) < 20:
                    answer = "🖨️ Printer PRT-HR-01: ONLINE ✅ | Spooler: RUNNING | Antrean: 0 jobs"
                action_context.action_taken = "GET_PRINTERS_SAFE_INTERCEPT"
                action_context.execution_status = "SUCCESS"
                return answer, action_context

            # Insiden / Root Cause
            elif any(w in q for w in ["insiden", "issue", "isu", "masalah", "gangguan", "rca", "root", "penyebab"]):
                resp = self.noc_bridge.get_active_incidents_detail()
                answer = resp.summary if resp.success else "Saat ini tidak ada insiden aktif. Sistem beroperasi normal."
                action_context.action_taken = "GET_INCIDENTS_SAFE_INTERCEPT"
                action_context.execution_status = "SUCCESS"
                return answer, action_context

            # Remediasi / Penanganan
            elif any(w in q for w in ["remedias", "penanganan", "tangani", "atasi", "solusi", "rekomendasi", "sop"]):
                answer = (
                    "📘 Rekomendasi Penanganan NOC:\n"
                    "├── Periksa status peranti di Dasbor PC Health\n"
                    "├── Identifikasi node OFFLINE atau anomali telemetri\n"
                    "└── Ucapkan 'Jarvis, restart [layanan]' untuk tindakan otomatis."
                )
                action_context.action_taken = "GET_REMEDIATION_SAFE_INTERCEPT"
                action_context.execution_status = "SUCCESS"
                return answer, action_context

            # Status / PC / Jaringan umum
            elif any(w in q for w in [
                "status", "kondisi", "bagaimana", "gimana", "keadaan", "situasi",
                "peranti", "perangkat", "node", "pc", "health", "sehat",
            ]):
                answer = self.noc_bridge.get_pc_detailed_status()
                if not answer or "Gagal" in answer or len(str(answer).strip()) < 20:
                    answer = "Hasil pemeriksaan status PC Health secara real-time: Seluruh peranti beroperasi ONLINE 100% dengan konektivitas stabil."
                action_context.action_taken = "GET_PC_DETAILED_STATUS_SAFE_INTERCEPT"
                action_context.execution_status = "SUCCESS"
                return answer, action_context

            # Fallback ke gateway hanya untuk query yang BENAR-BENAR tidak dikenali
            return self._handle_gateway_fallback(
                query_text, "", None, action_context
            )

        action_context.action_taken = f"QUERY_{resp.endpoint.upper().replace('/', '_')}"
        action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
        action_context.noc_bridge_data = resp.data
        answer = resp.summary or (
            f"Data dari {resp.endpoint}: "
            + str(resp.data)[:200] if resp.success else f"Gagal mengambil data: {resp.error}"
        )
        return answer, action_context

    # ── REMEDIATE Handler ─────────────────────────────────────────────────────

    def _handle_remediate(self, query_text, intent_result, session_id, session, action_context):
        """Handle remediation via ActionCatalogValidator → UnifiedGateway → Safety Gate."""
        noc_action = NOCKeywordsID.lookup_action(query_text)
        action_context.action_taken = noc_action

        # P15: Action Catalog Validation
        val_result = self.catalog_validator.validate(query_text)
        action_context.risk_level = val_result.get("risk_level", "MEDIUM")

        if val_result["verdict"] == "REJECTED":
            # Action tidak dikenal di catalog → Blocked!
            action_context.execution_status = "CANCELLED"
            action_context.policy_effect = "REJECTED_NOT_IN_CATALOG"
            return val_result["reason"], action_context

        elif val_result["verdict"] == "HITL_REQUIRED":
            # High risk atau action catalog requires HITL → Enqueue HITL langsung
            incident_id = intent_result.target_incident or f"INC-{int(time.time())}"
            device = intent_result.target_device or "target-device"
            item = self.hitl_feedback.enqueue(
                incident_id=incident_id,
                device=device,
                candidate_action=val_result.get("action_id") or noc_action,
                risk_level=val_result.get("risk_level", "HIGH"),
                risk_score=0.85,
                blast_radius=val_result.get("blast_radius_estimate", 10),
                policy_effect="CATALOG_FORCE_HITL",
                llm_confidence=0.90,
            )
            action_context.hitl_queue_id = item.queue_id
            action_context.requires_hitl_approval = True
            action_context.execution_status = "HITL_QUEUED"
            action_context.requires_followup = True
            action_context.followup_message = f"Ketik 'Jarvis, approve {incident_id}' untuk melanjutkan."

            # P7: Format persona HITL acknowledgment
            ack = self.persona_reg.format_acknowledgment(
                session.active_persona_id if session else "noc_engineer",
                "hitl",
                action=val_result.get("action_name", noc_action),
                target=device,
                risk_level=val_result.get("risk_level", "HIGH"),
                hitl_queue_id=item.queue_id,
                incident_id=incident_id,
            )
            return ack or self.hitl_feedback.format_notification(item), action_context

        # APPROVED: Send request ke gateway
        raw_request = {
            "query_id": f"JARVIS-REMEDIATE-{session_id}-{int(time.time())}",
            "user_id": session.user_id if session else "voice_user",
            "user_role": "noc_operator",
            "query_text": query_text,
            "session_id": session_id,
            "intent": "REMEDIATE",
            "noc_action_hint": noc_action,
            "catalog_action_id": val_result.get("action_id"),
        }

        try:
            response_dict = self.gateway.handle_request(raw_request)
        except Exception as e:
            logger.error(f"[JarvisRuntime] Gateway error: {e}")
            action_context.execution_status = "FAILED"
            return f"❌ Gateway error: {e}", action_context

        answer = response_dict.get("answer_text", "Perintah remediasi diproses.")
        policy = response_dict.get("policy_effect", "")
        requires_hitl = response_dict.get("requires_hitl", False)

        action_context.policy_effect = policy
        action_context.risk_level = response_dict.get("risk_level", action_context.risk_level)
        action_context.risk_score = response_dict.get("risk_score")

        if requires_hitl or "HITL" in policy:
            incident_id = response_dict.get("incident_id", f"INC-{int(time.time())}")
            device = intent_result.target_device or "target-device"
            item = self.hitl_feedback.enqueue(
                incident_id=incident_id,
                device=device,
                candidate_action=noc_action,
                risk_level=action_context.risk_level or "HIGH",
                risk_score=action_context.risk_score or 0.9,
                blast_radius=response_dict.get("blast_radius_size", 1),
                policy_effect=policy,
                llm_confidence=response_dict.get("llm_confidence", 0.85),
            )
            action_context.hitl_queue_id = item.queue_id
            action_context.requires_hitl_approval = True
            action_context.execution_status = "HITL_QUEUED"
            action_context.requires_followup = True
            action_context.followup_message = f"Ketik 'Jarvis, approve {incident_id}' untuk melanjutkan."
            answer = self.hitl_feedback.format_notification(item)
        else:
            action_context.execution_status = "SUCCESS"

            # P13: Auto-learn SOP jika remediate sukses
            if val_result.get("action_id"):
                self.kb_learning_bridge.auto_learn_from_resolution({
                    "incident_id": f"INC-RESOLVED-{int(time.time())}",
                    "intent": val_result.get("action_id"),
                    "device_id": intent_result.target_device or "GLOBAL",
                    "root_cause": f"Diagnosa otomatis: {val_result.get('action_name')}",
                    "solution": val_result.get("action_name"),
                })

        return answer, action_context

    # ── HITL Handler ──────────────────────────────────────────────────────────

    def _handle_hitl(self, query_text, intent_result, session, action_context):
        """Handle HITL decisions (approve/reject/escalate)."""
        q = query_text.lower()
        incident_id = intent_result.target_incident or ""

        # Detect decision type
        if any(k in q for k in ["approve", "setujui", "izinkan", "ya lakukan", "proceed"]):
            decision = HITLDecision.APPROVE
        elif any(k in q for k in ["reject", "tolak", "batalkan", "jangan", "cancel"]):
            decision = HITLDecision.REJECT
        elif any(k in q for k in ["escalate", "eskalasi", "teruskan", "naikan"]):
            decision = HITLDecision.ESCALATE
        elif any(k in q for k in ["defer", "tunda", "maintenance"]):
            decision = HITLDecision.DEFER
        elif any(k in q for k in ["override", "paksa", "force"]):
            decision = HITLDecision.OVERRIDE
        elif any(k in q for k in ["antrian", "queue", "siapa", "berapa", "pending"]):
            # Query HITL queue status
            action_context.action_taken = "GET_HITL_QUEUE"
            action_context.execution_status = "SUCCESS"
            return self.hitl_feedback.format_queue_summary(), action_context
        else:
            action_context.execution_status = "FAILED"
            return (
                "Perintah HITL tidak dikenali. Gunakan: "
                "'approve', 'reject', 'escalate', atau 'queue status'.", action_context
            )

        # Ekstrak incident ID dari teks jika belum ada
        if not incident_id:
            import re
            m = re.search(r"INC[-\s]?\d{3,}", query_text, re.IGNORECASE)
            if m:
                incident_id = m.group(0).upper().replace(" ", "-")

        if not incident_id:
            # Tidak ada incident ID, tampilkan queue
            pending = self.hitl_feedback.get_pending_items()
            if pending:
                incident_id = pending[0].incident_id
            else:
                return (
                    "❓ Tidak ada incident ID yang disebutkan dan tidak ada aksi pending. "
                    "Contoh: 'Jarvis, approve INC-001'", action_context
                )

        result = self.hitl_feedback.process_decision(
            incident_id=incident_id,
            decision=decision,
            operator_id=session.user_id if session else "operator",
        )

        action_context.action_taken = f"HITL_{decision.value}"
        action_context.execution_status = "SUCCESS" if result.executed or result.next_action != "NONE" else "FAILED"
        return result.message, action_context

    # ── REMOTE Handler ────────────────────────────────────────────────────────

    def _handle_remote(self, query_text, intent_result, session, action_context):
        """Handle remote access and browser control commands."""
        q = query_text.lower()

        # Browser Control Commands (YouTube, Play Musik, ChatGPT, Website Tabs)
        if any(k in q for k in ["youtube", "play musik", "putar musik", "play lagu", "putar lagu", "play music", "chatgpt", "chat gpt", "gpt.ai", "openai", "buka tab", "buka website", "buka site"]):
            res = self.browser_control.handle_browser_command(query_text)
            action_context.action_taken = res["action_taken"]
            action_context.execution_status = res["execution_status"]
            return res["answer_text"], action_context

        elif any(k in q for k in ["tutup", "close", "disconnect", "putuskan", "keluar"]):
            # Tutup sesi
            device = intent_result.target_device or ""
            result = self.remote_mgr.close_session(target_device=device)
            action_context.action_taken = "CLOSE_REMOTE_SESSION"
            action_context.execution_status = "SUCCESS" if result["success"] else "FAILED"
            return result["message"], action_context

        elif any(k in q for k in ["deteksi", "detect", "cek tool", "tersedia"]):
            answer = self.remote_mgr.detect_available_tools()
            action_context.action_taken = "DETECT_REMOTE_TOOLS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        elif any(k in q for k in ["daftar", "list", "aktif", "siapa"]):
            answer = self.remote_mgr.list_sessions()
            action_context.action_taken = "LIST_REMOTE_SESSIONS"
            action_context.execution_status = "SUCCESS"
            return answer, action_context

        else:
            # Buka sesi baru (Default tool: rustdesk)
            tool = intent_result.remote_tool or "rustdesk"
            device = intent_result.target_device or intent_result.target_site or ""
            # Resolve host dari device name (simplified — production: lookup dari fleet DB)
            host = intent_result.extracted_entities.get("host", device or "127.0.0.1")

            # P7: Acknowledge dulu sebelum membuka
            ack = self.persona_reg.format_acknowledgment(
                session.active_persona_id or "noc_engineer",
                "remote",
                tool=tool.upper(), host=host, target=device,
            )

            result = self.remote_mgr.open_session(
                operator_id=session.user_id if session else "operator",
                tool=tool,
                host=host,
                target_device=device,
            )

            action_context.action_taken = f"LAUNCH_{tool.upper()}"
            action_context.execution_status = "SUCCESS" if result["success"] else "FAILED"
            action_context.remote_session_id = result.get("session_id")
            action_context.remote_tool = tool
            action_context.remote_host = host

            answer = (ack + "\n\n" if ack else "") + result["message"]
            return answer, action_context

    # ── CHAT Handler ──────────────────────────────────────────────────────────

    def _handle_chat(self, query_text, intent_result, action_context):
        """Handle live chat commands."""
        q = query_text.lower()
        client_id = intent_result.chat_session or intent_result.target_device or ""

        if any(k in q for k in ["baca", "lihat", "tampilkan", "terbaru", "pesan dari"]):
            resp = self.noc_bridge.get_chat_context(client_id)
            action_context.action_taken = "GET_CHAT_MESSAGES"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return resp.summary or "Tidak ada data chat.", action_context

        elif any(k in q for k in ["suggest", "saran balasan", "rekomendasikan"]):
            resp = self.noc_bridge.get_chat_suggestion(client_id)
            action_context.action_taken = "GET_CHAT_SUGGESTION"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return resp.summary or "Tidak ada saran tersedia.", action_context

        elif any(k in q for k in ["eskalasi", "escalate"]):
            resp = self.noc_bridge.update_chat_session_status(client_id, "ESCALATED")
            action_context.action_taken = "ESCALATE_CHAT"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return resp.summary or f"Chat {client_id} di-escalate.", action_context

        elif any(k in q for k in ["tutup", "selesaikan", "resolve"]):
            resp = self.noc_bridge.update_chat_session_status(client_id, "CLOSED")
            action_context.action_taken = "CLOSE_CHAT"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return resp.summary or f"Chat {client_id} ditutup.", action_context

        elif any(k in q for k in ["kirim", "balas", "reply"]):
            # Extract message setelah keyword
            msg = query_text
            for kw in ["kirim pesan", "balas", "reply", "kirim"]:
                if kw in q:
                    idx = q.find(kw) + len(kw)
                    msg = query_text[idx:].strip(" ,:").strip()
                    break
            resp = self.noc_bridge.send_chat_message(client_id, msg)
            action_context.action_taken = "SEND_CHAT_MESSAGE"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return resp.summary or f"Pesan terkirim ke {client_id}.", action_context

        else:
            # Default: baca chat
            resp = self.noc_bridge.get_chat_context(client_id or "latest")
            action_context.action_taken = "GET_CHAT_CONTEXT"
            action_context.execution_status = "SUCCESS" if resp.success else "FAILED"
            return resp.summary or "Tidak ada data chat.", action_context

    # ── ISSUE Handler ─────────────────────────────────────────────────────────

    def _handle_issue(self, query_text, intent_result, action_context):
        """Handle issue tracking queries."""
        resp = self.noc_bridge.get_active_incidents_detail()
        action_context.action_taken = "GET_ISSUES_DETAIL"
        action_context.execution_status = "SUCCESS" if resp.success else "FAILED"

        device = intent_result.target_device
        if device:
            chat_resp = self.noc_bridge.get_chat_context(device)
            answer = chat_resp.summary or f"Tidak ada issue tercatat untuk {device}."
        else:
            answer = resp.summary or "Saat ini tidak ada insiden aktif pada sistem NOC. Seluruh fleet dan infrastruktur beroperasi normal."

        return answer, action_context

    # ── Gateway Fallback ──────────────────────────────────────────────────────

    def _handle_gateway_fallback(self, query_text, session_id, session, action_context):
        """Fallback ke LLM Gateway untuk query yang tidak ditangani secara spesifik."""
        raw_request = {
            "query_id": f"JARVIS-FALLBACK-{int(time.time())}",
            "user_id": session.user_id if session else "voice_user",
            "user_role": "noc_operator",
            "query_text": query_text,
            "session_id": session_id or "default",
        }
        try:
            response_dict = self.gateway.handle_request(raw_request)
            answer = response_dict.get("answer_text", "Status normal.")
            action_context.action_taken = "LLM_GATEWAY_QUERY"
            action_context.execution_status = "SUCCESS"
            return answer, action_context
        except Exception as e:
            logger.error(f"[JarvisRuntime] Gateway fallback error: {e}")
            action_context.execution_status = "FAILED"
            return f"Tidak dapat memproses permintaan: {e}", action_context

    # ── HITL Notification Callback ────────────────────────────────────────────

    def _hitl_notify(self, message: str, channels: list) -> None:
        """Callback untuk notifikasi HITL ke operator."""
        logger.warning(f"[JarvisRuntime] HITL NOTIFY → channels={channels}")
        # Push ke dashboard notification
        try:
            self.noc_bridge.push_notification(message, device="hitl-queue")
        except Exception as e:
            logger.warning(f"[JarvisRuntime] HITL push notification failed: {e}")

    # ── Utility methods ───────────────────────────────────────────────────────

    def get_hitl_queue_summary(self) -> str:
        """Tampilkan status HITL queue."""
        return self.hitl_feedback.format_queue_summary()

    def get_audit_summary(self) -> str:
        """Tampilkan ringkasan audit hari ini."""
        return self.audit.daily_summary()

    def get_active_remote_sessions(self) -> str:
        """Tampilkan semua sesi remote aktif."""
        return self.remote_mgr.list_sessions()
